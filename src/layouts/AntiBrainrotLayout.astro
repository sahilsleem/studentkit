---
import Layout from './Layout.astro';
import type { AntiBrainrotModule } from '../data/antiBrainrotRegistry';
import AdSlot from '../components/AdSlot.astro';

export interface Props {
  module: AntiBrainrotModule;
  title?: string;
  description?: string;
  showProtocolCard?: boolean;
}

const {
  module,
  title = `${module.title} — Anti-Brainrot Training`,
  description = module.description,
  showProtocolCard = (module.slug === 'quick-math')
} = Astro.props;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://studentkit.in/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Anti-Brainrot",
      "item": "https://studentkit.in/anti-brainrot/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": module.title,
      "item": `https://studentkit.in/anti-brainrot/${module.slug}/`
    }
  ]
};
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <div class="max-w-4xl mx-auto mb-8 sm:mb-12">
    <!-- Breadcrumbs -->
    <nav style="--stagger: 0;" class="reveal flex items-center text-sm text-slate-muted mb-6 sm:mb-8 overflow-x-auto whitespace-nowrap pb-2 no-scrollbar" aria-label="Breadcrumb">
      <a href="/" class="hover:text-brand transition-colors focus-ring rounded-sm">Home</a>
      <span class="mx-2 text-border-line">/</span>
      <a href="/anti-brainrot" class="hover:text-brand transition-colors focus-ring rounded-sm">Anti-Brainrot</a>
      <span class="mx-2 text-border-line">/</span>
      <span class="text-ink font-medium" aria-current="page">{module.title}</span>
    </nav>

    <!-- Module Header -->
    <div class="mb-8">
      <div style="--stagger: 1;" class="reveal flex flex-wrap items-center gap-2.5 mb-3">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-brand/10 text-brand border border-brand/20">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          ANTI-BRAINROT TRAINING
        </span>
        {module.badge && (
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
            {module.badge}
          </span>
        )}
      </div>

      <div style="--stagger: 2;" class="reveal">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-ink tracking-tight mb-2">
          {module.title}
        </h1>
        <p class="text-base sm:text-lg text-slate-muted max-w-2xl leading-relaxed mb-4">
          {module.tagline}
        </p>
      </div>

      <div style="--stagger: 3;" class="reveal flex flex-wrap items-center gap-2 text-xs text-slate-muted">
        <span class="font-medium text-ink">Skills Trained:</span>
        {module.skills.map((skill) => (
          <span class="px-2.5 py-1 bg-slate-100 text-slate-700 rounded-md font-medium">
            {skill}
          </span>
        ))}
        <span class="text-slate-300">•</span>
        <span>{module.duration}</span>
      </div>
    </div>

    <!-- Main Content & Sidebar -->
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-6 sm:gap-8 items-start">
      <main class="w-full">
        <slot />
      </main>

      <aside class={`space-y-6 lg:sticky lg:top-24 ${!showProtocolCard ? 'hidden lg:block' : ''}`}>
        {showProtocolCard && (
          <div class="bg-card rounded-2xl border border-border-line/60 p-5 shadow-xs">
            <h3 class="text-sm font-semibold text-ink flex items-center gap-2 mb-3">
              <svg class="w-4 h-4 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0A6.002 6.002 0 0 0 6 6.75m6 6A6.002 6.002 0 0 1 18 6.75" />
              </svg>
              Training Protocol
            </h3>
            <ul class="text-xs text-slate-muted space-y-2 leading-relaxed">
              <li class="flex items-start gap-1.5">
                <span class="text-brand font-bold">•</span>
                <span><strong>Trust your instinct:</strong> First calculations are often correct. Avoid second-guessing on easy items.</span>
              </li>
              <li class="flex items-start gap-1.5">
                <span class="text-brand font-bold">•</span>
                <span><strong>Keyboard speed:</strong> Use keys 1–4 to answer instantly without lifting your hand for the mouse.</span>
              </li>
              <li class="flex items-start gap-1.5">
                <span class="text-brand font-bold">•</span>
                <span><strong>Daily consistency:</strong> 3 minutes of high-speed calculation sharpens active working memory.</span>
              </li>
            </ul>
          </div>
        )}

        <!-- Ad Slot -->
        <div style="--stagger: 5;" class="reveal bg-card rounded-2xl border border-border-line/40 p-4 shadow-xs hidden lg:block">
          <p class="text-[10px] text-slate-muted/60 uppercase tracking-wider mb-3 text-center">Advertisement</p>
          <AdSlot id="anti-brainrot-sidebar-ad" class="min-h-[200px] flex items-center justify-center bg-slate-50/50 rounded-lg" />
        </div>
      </aside>
    </div>
  </div>
</Layout>