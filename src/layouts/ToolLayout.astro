---
import Layout from './Layout.astro';
import { tools } from '../data/registry';
import type { Tool } from '../data/registry';
import { getRelatedTools } from '../utils/relatedTools';
import { toolContent } from '../data/toolContent';

export interface Props {
  tool: Tool;
}

const { tool } = Astro.props;

// Find related tools using the new ranking engine
const relatedTools = getRelatedTools(tool, 3);

// Generate Breadcrumb schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://studentkit.in/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": tool.category,
      "item": `https://studentkit.in/category/${tool.category.toLowerCase().replace(/\\s+/g, '-')}`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": tool.title,
      "item": `https://studentkit.in/tools/${tool.slug}`
    }
  ]
};

// Generate WebApplication schema
const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": tool.title,
  "description": tool.description,
  "applicationCategory": "EducationalApplication",
  "operatingSystem": "All",
  "url": `https://studentkit.in/tools/${tool.slug}`
};
---

<Layout 
  title={tool.seoTitle || tool.title} 
  description={tool.seoDescription || tool.description}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(appSchema)}></script>
    <link rel="canonical" href={`https://studentkit.in/tools/${tool.slug}`} />
  </Fragment>

  <div class="max-w-4xl mx-auto">
    <!-- Breadcrumbs -->
    <nav class="flex text-sm text-gray-500 mb-6" aria-label="Breadcrumb">
      <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
          <a href="/" class="inline-flex items-center hover:text-emerald-600 transition-colors">
            <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20"><path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path></svg>
            Home
          </a>
        </li>
        <li>
          <div class="flex items-center">
            <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
            <a href={`/category/${tool.category.toLowerCase().replace(/\\s+/g, '-')}`} class="ml-1 md:ml-2 hover:text-emerald-600 transition-colors">{tool.category}</a>
          </div>
        </li>
        <li aria-current="page">
          <div class="flex items-center">
            <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
            <span class="ml-1 md:ml-2 text-gray-700 font-medium">{tool.title}</span>
          </div>
        </li>
      </ol>
    </nav>

    <!-- Header -->
    <div class="mb-8 text-center sm:text-left relative">
      <div class="flex justify-between items-start">
        <div>
          <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight mb-2 pr-12">{tool.title}</h1>
          <p class="text-lg text-gray-500">{tool.description}</p>
        </div>
        <button id="favorite-btn" class="absolute top-0 right-0 sm:relative sm:top-auto sm:right-auto p-2 rounded-full hover:bg-gray-100 text-gray-400 hover:text-red-500 transition-colors focus:outline-none focus:ring-2 focus:ring-emerald-500" aria-label="Add to favorites">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
        </button>
      </div>
    </div>

    <!-- The actual tool component goes here -->
    <slot />

    <!-- Educational Content (Phase 9 SEO) -->
    {toolContent[tool.id] && (
      <article class="prose max-w-none mt-16 pt-8 border-t border-gray-100">
        {toolContent[tool.id].whatIsIt && (
          <section class="mb-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-3">What is this calculator?</h2>
            <p class="text-gray-600 leading-relaxed">{toolContent[tool.id].whatIsIt}</p>
          </section>
        )}

        {toolContent[tool.id].formula && (
          <section class="mb-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-3">Formula</h2>
            <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 font-mono text-lg text-emerald-800 text-center overflow-x-auto">
              {toolContent[tool.id].formula.split('\n').map((line: string) => <div>{line}</div>)}
            </div>
          </section>
        )}

        {toolContent[tool.id].variables && (
          <section class="mb-8">
            <h2 class="text-xl font-bold text-gray-900 mb-3">Variables Explained</h2>
            <ul class="list-disc pl-5 space-y-2 text-gray-600">
              {Object.entries(toolContent[tool.id].variables!).map(([k, v]) => (
                <li><strong class="font-semibold text-gray-800">{k}:</strong> {v}</li>
              ))}
            </ul>
          </section>
        )}

        {toolContent[tool.id].howToUse && (
          <section class="mb-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-3">How to Use</h2>
            <p class="text-gray-600 leading-relaxed">{toolContent[tool.id].howToUse}</p>
          </section>
        )}

        {toolContent[tool.id].example && (
          <section class="mb-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-3">Worked Example</h2>
            <div class="bg-emerald-50 border-l-4 border-emerald-500 p-4 text-emerald-900 rounded-r-lg">
              <p>{toolContent[tool.id].example}</p>
            </div>
          </section>
        )}

        {toolContent[tool.id].whenToUse && (
          <section class="mb-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-3">Practical Applications</h2>
            <p class="text-gray-600 leading-relaxed">{toolContent[tool.id].whenToUse}</p>
          </section>
        )}

        {toolContent[tool.id].commonMistakes && (
          <section class="mb-8">
            <h2 class="text-xl font-bold text-gray-900 mb-3 text-red-700">Common Mistakes</h2>
            <p class="text-gray-600 leading-relaxed">{toolContent[tool.id].commonMistakes}</p>
          </section>
        )}

        {toolContent[tool.id].faq && (
          <section class="mb-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Frequently Asked Questions</h2>
            <div class="space-y-4">
              {toolContent[tool.id].faq!.map((item: any) => (
                <div class="border border-gray-200 rounded-lg p-4">
                  <h3 class="font-bold text-gray-800 mb-2">{item.q}</h3>
                  <p class="text-gray-600">{item.a}</p>
                </div>
              ))}
            </div>
          </section>
        )}
      </article>
    )}

    <!-- Related Tools -->
    {relatedTools.length > 0 && (
      <div class="pt-8 border-t border-gray-200 mt-12">
        <h3 class="text-xl font-bold text-gray-900 mb-6">Related Tools</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          {relatedTools.map(t => (
            <a href={`/tools/${t.slug}`} class="group block p-4 bg-white rounded-lg border border-gray-200 hover:border-emerald-500 transition-colors">
              <h4 class="font-semibold text-gray-900 group-hover:text-emerald-600 flex items-center gap-2">
                <span class="w-5 h-5 text-emerald-600" set:html={t.icon} />
                {t.title}
              </h4>
              <p class="text-sm text-gray-500 mt-1 line-clamp-2">{t.description}</p>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</Layout>

<script define:vars={{ toolId: tool.id }}>
  // This script runs client-side on the tool page
  const initToolState = () => {
    // 1. Add to Recently Used
    let recent = [];
    try {
      recent = JSON.parse(localStorage.getItem('studentkit_recent') || '[]');
    } catch(e){}
    
    recent = recent.filter(id => id !== toolId);
    recent.unshift(toolId);
    if(recent.length > 8) recent.pop();
    localStorage.setItem('studentkit_recent', JSON.stringify(recent));

    // 2. Handle Favorites
    const favBtn = document.getElementById('favorite-btn');
    if (!favBtn) return;
    
    let favs = [];
    try {
      favs = JSON.parse(localStorage.getItem('studentkit_favorites') || '[]');
    } catch(e){}

    const isFav = favs.includes(toolId);
    const svg = favBtn.querySelector('svg');
    
    if (isFav) {
      svg.setAttribute('fill', 'currentColor');
      favBtn.classList.add('text-red-500');
    }

    favBtn.addEventListener('click', () => {
      let currentFavs = JSON.parse(localStorage.getItem('studentkit_favorites') || '[]');
      const index = currentFavs.indexOf(toolId);
      
      if (index === -1) {
        currentFavs.push(toolId);
        svg.setAttribute('fill', 'currentColor');
        favBtn.classList.add('text-red-500');
      } else {
        currentFavs.splice(index, 1);
        svg.setAttribute('fill', 'none');
        favBtn.classList.remove('text-red-500');
      }
      
      localStorage.setItem('studentkit_favorites', JSON.stringify(currentFavs));
    });
  };

  initToolState();
  document.addEventListener('astro:page-load', initToolState);
</script>
