---
import Layout from './Layout.astro';
import type { Tool } from '../data/registry';
import { getCategorySlug } from '../data/registry';
import { getRelatedTools } from '../utils/relatedTools';
import { toolContent } from '../data/toolContent';
import AdSlot from '../components/AdSlot.astro';

export interface Props {
  tool: Tool;
}

const { tool } = Astro.props;

const relatedTools = getRelatedTools(tool, 3);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://studentkit.in/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": tool.category,
      "item": `https://studentkit.in/category/${getCategorySlug(tool.category)}`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": tool.title,
      "item": `https://studentkit.in/tools/${tool.slug}`
    }
  ]
};

const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": tool.title,
  "description": tool.description,
  "applicationCategory": "EducationalApplication",
  "operatingSystem": "All",
  "url": `https://studentkit.in/tools/${tool.slug}`
};
---

<Layout
  title={tool.seoTitle || tool.title}
  description={tool.seoDescription || tool.description}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(appSchema)}></script>
  </Fragment>

  <div class="max-w-4xl mx-auto">
    <!-- Breadcrumbs -->
    <nav class="flex text-xs text-slate-500 mb-3" aria-label="Breadcrumb">
      <ol class="inline-flex items-center space-x-1 sm:space-x-1.5">
        <li class="inline-flex items-center">
          <a href="/" class="inline-flex items-center hover:text-blue-600 transition-colors">
            <svg class="w-3.5 h-3.5 mr-1 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
            </svg>
            Home
          </a>
        </li>
        <li>
          <div class="flex items-center">
            <svg class="w-3.5 h-3.5 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
            </svg>
            <a href="/tools" class="ml-1 hover:text-blue-600 transition-colors">Tools</a>
          </div>
        </li>
        <li aria-current="page">
          <div class="flex items-center">
            <svg class="w-3.5 h-3.5 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
            </svg>
            <span class="ml-1 text-slate-900 font-medium truncate max-w-[160px] sm:max-w-none">{tool.title}</span>
          </div>
        </li>
      </ol>
    </nav>

    <!-- Tool Header -->
    <div class="mb-5">
      <h1 class="text-xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-1">{tool.title}</h1>
      <p class="text-xs sm:text-sm text-slate-500 max-w-xl">{tool.description}</p>
    </div>

    <!-- Active Tool Interactive Container -->
    <div class="mb-6">
      <slot />
    </div>

    <AdSlot variant="horizontal" class="my-6" />

    <!-- Educational Content -->
    {toolContent[tool.id] && (
      <article class="prose prose-slate max-w-none mt-6 pt-5 border-t border-slate-200">
        {toolContent[tool.id].whatIsIt && (
          <section class="mb-5 last:mb-0">
            <h2 class="text-lg font-bold text-slate-900 mb-2">What is this calculator?</h2>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{toolContent[tool.id].whatIsIt}</p>
          </section>
        )}

        {toolContent[tool.id].formula && (
          <section class="mb-5 last:mb-0">
            <h2 class="text-lg font-bold text-slate-900 mb-2">Formula</h2>
            <div class="bg-slate-900 text-blue-300 rounded-xl p-3 font-mono text-sm text-center overflow-x-auto shadow-inner">
              {toolContent[tool.id].formula.split('\n').map((line: string) => <div>{line}</div>)}
            </div>
          </section>
        )}

        {toolContent[tool.id].variables && (
          <section class="mb-5 last:mb-0">
            <h2 class="text-lg font-bold text-slate-900 mb-2">Variables</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
              {Object.entries(toolContent[tool.id].variables!).map(([k, v]) => (
                <div class="p-2.5 bg-white border border-slate-200 rounded-lg">
                  <span class="font-semibold text-slate-800 text-xs sm:text-sm">{k}</span>
                  <p class="text-xs text-slate-500 mt-0.5">{v}</p>
                </div>
              ))}
            </div>
          </section>
        )}

        {toolContent[tool.id].howToUse && (
          <section class="mb-5 last:mb-0">
            <h2 class="text-lg font-bold text-slate-900 mb-2">How to Use</h2>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed whitespace-pre-line">{toolContent[tool.id].howToUse}</p>
          </section>
        )}

        {toolContent[tool.id].example && (
          <section class="mb-5 last:mb-0">
            <h2 class="text-lg font-bold text-slate-900 mb-2">Worked Example</h2>
            <div class="bg-blue-50/80 border-l-4 border-blue-600 p-3 rounded-r-xl text-slate-800 text-xs sm:text-sm leading-relaxed">
              {toolContent[tool.id].example}
            </div>
          </section>
        )}
      </article>
    )}

    <!-- Related Tools Grid -->
    {relatedTools.length > 0 && (
      <div class="pt-5 border-t border-slate-200 mt-6">
        <h3 class="text-base font-bold text-slate-900 mb-3">Related Tools</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 sm:gap-3">
          {relatedTools.map(t => (
            <a href={`/tools/${t.slug}`} class="group flex items-center p-3 bg-white rounded-xl border border-slate-200 hover:border-blue-500 hover:shadow-xs transition-all min-h-[44px]">
              <h4 class="font-semibold text-slate-900 group-hover:text-blue-600 text-xs sm:text-sm truncate">{t.title}</h4>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</Layout>

<script define:vars={{ toolId: tool.id }}>
  const initToolState = () => {
    let recent = [];
    try {
      recent = JSON.parse(localStorage.getItem('studentkit_recent') || '[]');
    } catch(e){}
    recent = recent.filter(id => id !== toolId);
    recent.unshift(toolId);
    if (recent.length > 8) recent.pop();
    localStorage.setItem('studentkit_recent', JSON.stringify(recent));
  };

  initToolState();
  document.addEventListener('astro:page-load', initToolState);
</script>
