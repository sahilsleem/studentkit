<script id="hero-search-index" type="application/json" set:html={JSON.stringify(searchIndex).replace(/</g, '\\u003c')} />

<script>
  interface SearchItem {
    s: string;  // slug
    t: string;  // title
    c: string;  // category
    sc: string; // subcategory
    a: string[]; // aliases
    k: string[]; // keywords
  }

  const setupHeroSearch = () => {
    const rawDataEl = document.getElementById('hero-search-index');
    const input = document.getElementById('hero-search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('hero-search-clear');
    const resultsContainer = document.getElementById('hero-search-results');

    if (!rawDataEl || !input || !resultsContainer) return;

    let searchItems: SearchItem[] = [];
    try {
      searchItems = JSON.parse(rawDataEl.textContent || '[]');
    } catch (e) {
      searchItems = [];
    }

    const normalize = (str: string) => str ? str.toLowerCase().trim().replace(/\s+/g, ' ') : '';
    const getWords = (str: string) => str.toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim().split(/\s+/).filter(Boolean);

    const indexedItems = searchItems.map(item => {
      const titleNorm = normalize(item.t);
      const titleWords = getWords(item.t);
      const slugNorm = normalize(item.s.replace(/-/g, ' '));
      const slugWords = getWords(item.s);
      const categoryNorm = normalize(item.c);
      const categoryWords = getWords(item.c);
      const aliases = (item.a || []).map(normalize);
      const keywords = (item.k || []).map(normalize);

      const allPhrases = [titleNorm, slugNorm, ...aliases, ...keywords];
      const allWords = [...titleWords, ...slugWords, ...aliases.flatMap(getWords), ...keywords.flatMap(getWords)];

      return {
        ...item,
        titleNorm,
        allPhrases,
        allWords,
        categoryWords
      };
    });

    let selectedIdx = -1;
    let filteredResults: { s: string; t: string }[] = [];

    const runQuery = (q: string): { s: string; t: string }[] => {
      const normQ = normalize(q);
      if (!normQ) return [];

      const qWords = getWords(normQ);
      const results: { s: string; t: string; score: number }[] = [];

      for (const item of indexedItems) {
        let isMatch = false;
        let score = 0;

        // 1. Exact or prefix match on title
        if (item.titleNorm.startsWith(normQ)) {
          isMatch = true;
          score += 200;
        } else if (item.titleNorm.includes(normQ)) {
          if (normQ.length <= 3) {
            if (item.allWords.some(w => w.startsWith(normQ) || w === normQ)) {
              isMatch = true;
              score += 150;
            }
          } else {
            isMatch = true;
            score += 120;
          }
        }

        // 2. Keyword / Alias / Phrase match
        if (!isMatch) {
          for (const phrase of item.allPhrases) {
            if (phrase.includes(normQ)) {
              if (normQ.length <= 3) {
                if (item.allWords.some(w => w.startsWith(normQ) || w === normQ)) {
                  isMatch = true;
                  score += 100;
                  break;
                }
              } else {
                isMatch = true;
                score += 90;
                break;
              }
            }
          }
        }

        // 3. Multi-word query check
        if (!isMatch && qWords.length > 1) {
          const allPresent = qWords.every(qw =>
            item.allWords.some(w => w.startsWith(qw) || w === qw) ||
            item.allPhrases.some(p => p.includes(qw))
          );
          if (allPresent) {
            isMatch = true;
            score += 80;
          }
        }

        // 4. Category match
        if (!isMatch) {
          if (item.categoryWords.some(w => w === normQ || (normQ.length >= 4 && w.startsWith(normQ)))) {
            isMatch = true;
            score += 30;
          }
        }

        if (isMatch) {
          results.push({ s: item.s, t: item.t, score });
        }
      }

      results.sort((a, b) => b.score - a.score || a.t.length - b.t.length);
      return results.slice(0, 10).map(r => ({ s: r.s, t: r.t }));
    };

    const updateSelection = (idx: number) => {
      const options = resultsContainer.querySelectorAll<HTMLElement>('a[role="option"]');
      options.forEach((opt, i) => {
        if (i === idx) {
          opt.classList.add('bg-brand-light', 'text-brand');
          opt.scrollIntoView({ block: 'nearest' });
        } else {
          opt.classList.remove('bg-brand-light', 'text-brand');
        }
      });
      selectedIdx = idx;
    };

    input.addEventListener('input', (e) => {
      const q = (e.target as HTMLInputElement).value;

      if (!q.trim()) {
        filteredResults = [];
        selectedIdx = -1;
        if (clearBtn) clearBtn.classList.add('hidden');
        resultsContainer.innerHTML = '';
        resultsContainer.classList.add('hidden');
        input.setAttribute('aria-expanded', 'false');
        return;
      }

      if (clearBtn) clearBtn.classList.remove('hidden');
      filteredResults = runQuery(q);
      selectedIdx = -1;

      if (filteredResults.length === 0) {
        resultsContainer.innerHTML = '<div class="p-3 text-center text-xs sm:text-sm text-slate-muted">No tools found.</div>';
        resultsContainer.classList.remove('hidden');
        input.setAttribute('aria-expanded', 'true');
        return;
      }

      resultsContainer.innerHTML = filteredResults.map((tool, idx) => `
        <a
          href="/tools/${tool.s}"
          role="option"
          id="hero-result-${idx}"
          class="block px-3.5 py-2.5 rounded-lg text-xs sm:text-sm font-semibold text-ink hover:text-brand hover:bg-page transition-colors truncate"
        >
          ${tool.t}
        </a>
      `).join('');
      resultsContainer.classList.remove('hidden');
      input.setAttribute('aria-expanded', 'true');
    });

    clearBtn?.addEventListener('click', () => {
      input.value = '';
      filteredResults = [];
      selectedIdx = -1;
      clearBtn.classList.add('hidden');
      resultsContainer.innerHTML = '';
      resultsContainer.classList.add('hidden');
      input.setAttribute('aria-expanded', 'false');
      input.focus();
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        resultsContainer.classList.add('hidden');
        input.setAttribute('aria-expanded', 'false');
        return;
      }

      if (filteredResults.length === 0) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        const next = selectedIdx < filteredResults.length - 1 ? selectedIdx + 1 : 0;
        updateSelection(next);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        const prev = selectedIdx > 0 ? selectedIdx - 1 : filteredResults.length - 1;
        updateSelection(prev);
      } else if (e.key === 'Enter') {
        if (selectedIdx >= 0 && selectedIdx < filteredResults.length) {
          e.preventDefault();
          window.location.href = `/tools/${filteredResults[selectedIdx].s}`;
        }
      }
    });

    // Close dropdown on click outside
    document.addEventListener('click', (e) => {
      const wrap = document.getElementById('hero-search-wrapper');
      if (wrap && !wrap.contains(e.target as HTMLElement)) {
        resultsContainer.classList.add('hidden');
        input.setAttribute('aria-expanded', 'false');
      }
    });
  };

  setupHeroSearch();
  document.addEventListener('astro:page-load', setupHeroSearch);
</script>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);



  // Initialize GSAP Parallax
  const initGSAP = () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    
    // Parallax fade out hero content on scroll
    gsap.to('.hero-content', {
      scrollTrigger: {
        trigger: '.hero-section',
        start: 'top top',
        end: 'bottom top',
        scrub: 1
      },
      y: 80,
      opacity: 0,
      ease: 'none'
    });
  };

  // Run on load and Astro page transitions
  const initAll = () => {
    
    initGSAP();
  };
  initAll();
  document.addEventListener('astro:page-load', initAll);
</script>

