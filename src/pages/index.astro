---
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';
import { tools, categories, getCategorySlug } from '../data/registry';

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "StudentKit",
  "url": "https://studentkit.in/",
  "description": "Simple tools for grades, maths, science, and everyday student life."
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "StudentKit",
  "url": "https://studentkit.in/",
  "logo": "https://studentkit.in/favicon.svg"
};

const categoryIcons: Record<string, string> = {
  'academic-grades': `<path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342" />`,
  'everyday-finance': `<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6H2.25m0 0v10.5m0-10.5h19.5m0 0v10.5m-19.5 0h19.5m0 0a.75.75 0 0 1 .75.75v.75m0 0a60.07 60.07 0 0 0-15.797 2.101c-.727.198-1.453-.342-1.453-1.096V18.75M6.75 9h10.5m-10.5 3h10.5m-10.5 3h5.25" />`,
  'mathematics': `<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 15.75V18a2.25 2.25 0 0 1-2.25 2.25h-6A2.25 2.25 0 0 1 5.25 18v-6A2.25 2.25 0 0 1 7.5 9.75h2.25m4.5 0a2.25 2.25 0 0 0-2.25-2.25h-6A2.25 2.25 0 0 0 3.75 9.75v6A2.25 2.25 0 0 0 6 18h2.25" />`,
  'geometry-trigonometry-matrices': `<path stroke-linecap="round" stroke-linejoin="round" d="M5.25 7.5A2.25 2.25 0 0 1 7.5 5.25h9a2.25 2.25 0 0 1 2.25 2.25v9a2.25 2.25 0 0 1-2.25 2.25h-9a2.25 2.25 0 0 1-2.25-2.25v-9Z" />`,
  'calculus-advanced-math': `<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-3-3m10.5 3-3-3" />`,
  'statistics-probability': `<path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />`,
  'physics': `<path stroke-linecap="round" stroke-linejoin="round" d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z" />`,
  'chemistry': `<path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 0 1-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 0 1 4.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.942A4.5 4.5 0 0 1 15.918 17H8.082a4.5 4.5 0 0 1-2.312-.758L4.2 15.3" />`,
  'biology-health': `<path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />`,
  'computer-science-logic': `<path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" />`,
  'study-productivity-writing': `<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />`,
  'universal-converters': `<path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />`
};

const categoryCards = categories.map(cat => ({
  id: cat.id,
  name: cat.name,
  slug: getCategorySlug(cat.name),
  icon: categoryIcons[cat.id] || `<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 15.75V18a2.25 2.25 0 0 1-2.25 2.25h-6A2.25 2.25 0 0 1 5.25 18v-6A2.25 2.25 0 0 1 7.5 9.75h2.25" />`
}));

const searchIndex = tools.map(tool => ({
  s: tool.slug,
  t: tool.title,
  c: tool.category,
  sc: tool.subcategory || '',
  a: tool.aliases || [],
  k: tool.keywords || []
}));
---

<Layout title="Student Calculators & Study Tools" description="Simple tools for grades, maths, science, and everyday student life.">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
  </Fragment>

  <!-- Clean, Left-Aligned Hero -->
  <section class="text-left pt-1 pb-5 sm:pt-4 sm:pb-6">
    <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight max-w-3xl leading-tight mb-2">
      Useful tools for <span class="text-blue-600">everyday studying</span>.
    </h1>

    <p class="text-sm sm:text-base text-slate-600 max-w-xl mb-4 leading-relaxed">
      Simple tools for grades, maths, science, and everyday student life.
    </p>

    <!-- Prominent Interactive Search Field (Inline) -->
    <div class="max-w-xl relative" id="hero-search-wrapper">
      <div class="relative flex items-center">
        <div class="absolute inset-y-0 left-0 pl-3.5 sm:pl-4 flex items-center pointer-events-none text-slate-400">
          <svg class="w-5 h-5 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
          </svg>
        </div>
        <input
          type="text"
          id="hero-search-input"
          class="w-full pl-11 pr-10 py-2.5 sm:py-3 bg-white border border-slate-200 hover:border-blue-500 focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 rounded-xl shadow-sm text-slate-900 placeholder-slate-400 text-sm sm:text-base transition-all focus:outline-hidden"
          placeholder="Search tools, formulas, or topics..."
          autocomplete="off"
          spellcheck="false"
          aria-label="Search tools"
          role="combobox"
          aria-expanded="false"
          aria-autocomplete="list"
          aria-controls="hero-search-results"
        />
        <button
          type="button"
          id="hero-search-clear"
          class="hidden absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600 cursor-pointer"
          aria-label="Clear search"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Hero Inline Results Container (Below input in normal page flow) -->
      <div
        id="hero-search-results"
        role="listbox"
        aria-label="Search results"
        class="hidden mt-2 bg-white rounded-xl border border-slate-200 shadow-md max-h-72 overflow-y-auto p-1.5 text-left z-20"
      >
      </div>
    </div>
  </section>

  <!-- Category Grid Section (Core Discovery) -->
  <section class="pt-5 pb-2 sm:pt-6 sm:pb-4 border-t border-slate-200">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg sm:text-xl font-bold text-slate-900 tracking-tight">Browse by Category</h2>
      <a href="/tools" class="inline-flex items-center gap-1 text-xs sm:text-sm font-semibold text-blue-600 hover:text-blue-700 transition-colors">
        <span>View all</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5 sm:gap-3">
      {categoryCards.map(cat => (
        <a
          href={`/category/${cat.slug}`}
          class="group flex items-center gap-2.5 sm:gap-3 p-2.5 sm:p-3 bg-white rounded-xl border border-slate-200/80 hover:border-blue-500 hover:shadow-xs transition-all min-h-[44px]"
        >
          <div class="flex items-center justify-center w-6 h-6 rounded-md bg-blue-50/80 text-blue-600 shrink-0 group-hover:bg-blue-600 group-hover:text-white transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" set:html={cat.icon} />
          </div>
          <span class="text-[13px] sm:text-sm font-semibold text-slate-900 group-hover:text-blue-600 transition-colors leading-tight sm:truncate flex-1 min-w-0">
            {cat.name}
          </span>
        </a>
      ))}
    </div>
  </section>

  <AdSlot variant="horizontal" />
</Layout>

<script id="hero-search-index" type="application/json" set:html={JSON.stringify(searchIndex).replace(/</g, '\\u003c')} />

<script>
  interface SearchItem {
    s: string;  // slug
    t: string;  // title
    c: string;  // category
    sc: string; // subcategory
    a: string[]; // aliases
    k: string[]; // keywords
  }

  const setupHeroSearch = () => {
    const rawDataEl = document.getElementById('hero-search-index');
    const input = document.getElementById('hero-search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('hero-search-clear');
    const resultsContainer = document.getElementById('hero-search-results');

    if (!rawDataEl || !input || !resultsContainer) return;

    let searchItems: SearchItem[] = [];
    try {
      searchItems = JSON.parse(rawDataEl.textContent || '[]');
    } catch (e) {
      searchItems = [];
    }

    const normalize = (str: string) => str ? str.toLowerCase().trim().replace(/\s+/g, ' ') : '';
    const getWords = (str: string) => str.toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim().split(/\s+/).filter(Boolean);

    const indexedItems = searchItems.map(item => {
      const titleNorm = normalize(item.t);
      const titleWords = getWords(item.t);
      const slugNorm = normalize(item.s.replace(/-/g, ' '));
      const slugWords = getWords(item.s);
      const categoryNorm = normalize(item.c);
      const categoryWords = getWords(item.c);
      const aliases = (item.a || []).map(normalize);
      const keywords = (item.k || []).map(normalize);

      const allPhrases = [titleNorm, slugNorm, ...aliases, ...keywords];
      const allWords = [...titleWords, ...slugWords, ...aliases.flatMap(getWords), ...keywords.flatMap(getWords)];

      return {
        ...item,
        titleNorm,
        allPhrases,
        allWords,
        categoryWords
      };
    });

    let selectedIdx = -1;
    let filteredResults: { s: string; t: string }[] = [];

    const runQuery = (q: string): { s: string; t: string }[] => {
      const normQ = normalize(q);
      if (!normQ) return [];

      const qWords = getWords(normQ);
      const results: { s: string; t: string; score: number }[] = [];

      for (const item of indexedItems) {
        let isMatch = false;
        let score = 0;

        // 1. Exact or prefix match on title
        if (item.titleNorm.startsWith(normQ)) {
          isMatch = true;
          score += 200;
        } else if (item.titleNorm.includes(normQ)) {
          if (normQ.length <= 3) {
            if (item.allWords.some(w => w.startsWith(normQ) || w === normQ)) {
              isMatch = true;
              score += 150;
            }
          } else {
            isMatch = true;
            score += 120;
          }
        }

        // 2. Keyword / Alias / Phrase match
        if (!isMatch) {
          for (const phrase of item.allPhrases) {
            if (phrase.includes(normQ)) {
              if (normQ.length <= 3) {
                if (item.allWords.some(w => w.startsWith(normQ) || w === normQ)) {
                  isMatch = true;
                  score += 100;
                  break;
                }
              } else {
                isMatch = true;
                score += 90;
                break;
              }
            }
          }
        }

        // 3. Multi-word query check
        if (!isMatch && qWords.length > 1) {
          const allPresent = qWords.every(qw =>
            item.allWords.some(w => w.startsWith(qw) || w === qw) ||
            item.allPhrases.some(p => p.includes(qw))
          );
          if (allPresent) {
            isMatch = true;
            score += 80;
          }
        }

        // 4. Category match
        if (!isMatch) {
          if (item.categoryWords.some(w => w === normQ || (normQ.length >= 4 && w.startsWith(normQ)))) {
            isMatch = true;
            score += 30;
          }
        }

        if (isMatch) {
          results.push({ s: item.s, t: item.t, score });
        }
      }

      results.sort((a, b) => b.score - a.score || a.t.length - b.t.length);
      return results.slice(0, 10).map(r => ({ s: r.s, t: r.t }));
    };

    const updateSelection = (idx: number) => {
      const options = resultsContainer.querySelectorAll<HTMLElement>('a[role="option"]');
      options.forEach((opt, i) => {
        if (i === idx) {
          opt.classList.add('bg-blue-50', 'text-blue-600');
          opt.scrollIntoView({ block: 'nearest' });
        } else {
          opt.classList.remove('bg-blue-50', 'text-blue-600');
        }
      });
      selectedIdx = idx;
    };

    input.addEventListener('input', (e) => {
      const q = (e.target as HTMLInputElement).value;

      if (!q.trim()) {
        filteredResults = [];
        selectedIdx = -1;
        if (clearBtn) clearBtn.classList.add('hidden');
        resultsContainer.innerHTML = '';
        resultsContainer.classList.add('hidden');
        input.setAttribute('aria-expanded', 'false');
        return;
      }

      if (clearBtn) clearBtn.classList.remove('hidden');
      filteredResults = runQuery(q);
      selectedIdx = -1;

      if (filteredResults.length === 0) {
        resultsContainer.innerHTML = '<div class="p-3 text-center text-xs sm:text-sm text-slate-500">No tools found.</div>';
        resultsContainer.classList.remove('hidden');
        input.setAttribute('aria-expanded', 'true');
        return;
      }

      resultsContainer.innerHTML = filteredResults.map((tool, idx) => `
        <a
          href="/tools/${tool.s}"
          role="option"
          id="hero-result-${idx}"
          class="block px-3.5 py-2.5 rounded-lg text-xs sm:text-sm font-semibold text-slate-800 hover:text-blue-600 hover:bg-slate-50 transition-colors truncate"
        >
          ${tool.t}
        </a>
      `).join('');
      resultsContainer.classList.remove('hidden');
      input.setAttribute('aria-expanded', 'true');
    });

    clearBtn?.addEventListener('click', () => {
      input.value = '';
      filteredResults = [];
      selectedIdx = -1;
      clearBtn.classList.add('hidden');
      resultsContainer.innerHTML = '';
      resultsContainer.classList.add('hidden');
      input.setAttribute('aria-expanded', 'false');
      input.focus();
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        resultsContainer.classList.add('hidden');
        input.setAttribute('aria-expanded', 'false');
        return;
      }

      if (filteredResults.length === 0) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        const next = selectedIdx < filteredResults.length - 1 ? selectedIdx + 1 : 0;
        updateSelection(next);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        const prev = selectedIdx > 0 ? selectedIdx - 1 : filteredResults.length - 1;
        updateSelection(prev);
      } else if (e.key === 'Enter') {
        if (selectedIdx >= 0 && selectedIdx < filteredResults.length) {
          e.preventDefault();
          window.location.href = `/tools/${filteredResults[selectedIdx].s}`;
        }
      }
    });

    // Close dropdown on click outside
    document.addEventListener('click', (e) => {
      const wrap = document.getElementById('hero-search-wrapper');
      if (wrap && !wrap.contains(e.target as HTMLElement)) {
        resultsContainer.classList.add('hidden');
        input.setAttribute('aria-expanded', 'false');
      }
    });
  };

  setupHeroSearch();
  document.addEventListener('astro:page-load', setupHeroSearch);
</script>
