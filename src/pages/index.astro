---
import Layout from '../layouts/Layout.astro';
import ToolCard from '../components/ToolCard.astro';
import { tools, getActiveCategories, getCategorySlug } from '../data/registry';
import AdSlot from '../components/AdSlot.astro';
const categories = getActiveCategories();

const popularTools = [
  "Quadratic Equation Solver",
  "Percentile Calculator",
  "Trigonometric Calculator",
  "Derivative Calculator",
  "Speed Calculator",
  "Molar Mass Calculator",
  "Punnett Square Calculator",
  "Base Conversion Calculator",
  "Attendance Calculator",
  "Age Calculator"
];

const featuredTools = tools.filter(tool => popularTools.includes(tool.title));

const uniqueIcons: string[] = [];
const iconMap = new Map<string, number>();

function getIconIndex(svg: string): number {
  let idx = iconMap.get(svg);
  if (idx === undefined) {
    idx = uniqueIcons.length;
    uniqueIcons.push(svg);
    iconMap.set(svg, idx);
  }
  return idx;
}

const searchData = {
  icons: uniqueIcons,
  tools: tools.map(tool => ({
    id: tool.id,
    slug: tool.slug,
    title: tool.title,
    description: tool.description,
    category: tool.category,
    subcategory: tool.subcategory,
    aliases: tool.aliases,
    keywords: tool.keywords,
    icon: getIconIndex(tool.icon || '')
  }))
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "StudentKit",
  "url": "https://studentkit.in/",
  "description": "Everything you need for student life. Calculate marks, check attendance, and use simple study tools — all in one place."
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "StudentKit",
  "url": "https://studentkit.in/",
  "logo": "https://studentkit.in/favicon.svg"
};
---

<Layout title="Home" description="Everything you need for student life. Calculate marks, check attendance, and use simple study tools — all in one place.">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
  </Fragment>
  
  <!-- Hero Section -->
  <section class="py-16 sm:py-24 text-center">
    <div class="inline-flex items-center px-3 py-1 rounded-full bg-emerald-50 text-emerald-600 text-sm font-semibold mb-6 tracking-wide">
      FREE STUDENT TOOLS
    </div>
    <h1 class="text-4xl sm:text-5xl font-extrabold text-gray-900 tracking-tight mb-6">
      Everything you need for student life.
    </h1>
    <p class="text-lg sm:text-xl text-gray-600 max-w-2xl mx-auto mb-10">
      Calculate marks, check attendance, convert grades, manage dates and use simple study tools — all in one place.
    </p>

    <!-- Search Box -->
    <div class="max-w-xl mx-auto relative group">
      <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
        <svg class="h-5 w-5 text-gray-400 group-focus-within:text-emerald-500 transition-colors" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
        </svg>
      </div>
      <input 
        type="text" 
        id="home-search" 
        aria-label="Search tools"
        role="combobox"
        aria-expanded="false"
        aria-haspopup="listbox"
        aria-autocomplete="list"
        aria-controls="search-results"
        class="block w-full pl-11 pr-4 py-4 border border-gray-200 rounded-xl leading-5 bg-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 sm:text-lg transition-all shadow-sm" 
        placeholder="Search for a tool" 
      />
      
      <!-- Search Results Dropdown -->
      <div 
        id="search-results" 
        role="listbox" 
        aria-label="Search results" 
        class="absolute z-10 w-full mt-2 bg-white rounded-lg shadow-lg border border-gray-100 hidden max-h-80 overflow-y-auto text-left"
      >
        <!-- Results injected here by JS -->
      </div>
      <script id="search-data" type="application/json" set:html={JSON.stringify(searchData).replace(/</g, '\\u003c')} />
    </div>
  </section>

  <AdSlot variant="horizontal" />

  <!-- Category Discovery Section -->
  <section class="py-12 border-t border-gray-100">
    <div class="mb-8 text-center sm:text-left">
      <h2 class="text-2xl font-bold text-gray-900 tracking-tight">Explore Categories</h2>
      <p class="text-gray-500 mt-2">Discover over 450 specialized student tools across various subjects.</p>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
      {categories.map(cat => (
        <a href={`/category/${getCategorySlug(cat.name)}`} class="group block p-6 bg-white rounded-xl border border-gray-200 hover:border-emerald-500 hover:shadow-md transition-all relative overflow-hidden">
          <div class="absolute inset-0 bg-emerald-50 opacity-0 group-hover:opacity-10 transition-opacity"></div>
          <h3 class="text-xl font-bold text-gray-900 group-hover:text-emerald-700 transition-colors mb-2">{cat.name}</h3>
          <p class="text-sm text-gray-600 line-clamp-2">{cat.description}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Popular Tools Section -->
  <section class="py-12 border-t border-gray-100">
    <div class="flex justify-between items-end mb-8">
      <h2 class="text-2xl font-bold text-gray-900 tracking-tight">Popular Tools</h2>
      <a href="/tools" class="text-emerald-600 hover:text-emerald-700 font-medium text-sm flex items-center gap-1 transition-colors">
        Explore all tools
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      </a>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {featuredTools.map(tool => (
        <ToolCard 
          title={tool.title} 
          description={tool.description} 
          url={`/tools/${tool.slug}`} 
          icon={tool.icon} 
          category={tool.category}
          subcategory={tool.subcategory}
          keywords={tool.keywords}
        />
      ))}
    </div>
  </section>

  <AdSlot variant="horizontal" />

  <!-- Why StudentKit -->
  <section class="py-16 mt-8 bg-white border border-gray-100 rounded-2xl px-6 sm:px-12 text-center">
    <h2 class="text-2xl font-bold text-gray-900 mb-8">Why StudentKit?</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <div class="w-12 h-12 bg-emerald-50 rounded-full flex items-center justify-center mx-auto mb-4 text-emerald-600">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">All tools are free</h3>
        <p class="text-gray-500 text-sm">No paywalls, no subscriptions. Everything here is 100% free forever.</p>
      </div>
      <div>
        <div class="w-12 h-12 bg-emerald-50 rounded-full flex items-center justify-center mx-auto mb-4 text-emerald-600">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">No sign-up required</h3>
        <p class="text-gray-500 text-sm">Jump right in and start calculating. We don't want your email address.</p>
      </div>
      <div>
        <div class="w-12 h-12 bg-emerald-50 rounded-full flex items-center justify-center mx-auto mb-4 text-emerald-600">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Works instantly</h3>
        <p class="text-gray-500 text-sm">Most calculations run locally in your browser. Fast, private, and designed to work offline where supported.</p>
      </div>
    </div>
  </section>
</Layout>

<script>
  interface SearchTool {
    id: string;
    slug: string;
    title: string;
    description: string;
    category: string;
    subcategory?: string;
    aliases?: string[];
    keywords?: string[];
    icon: number | string;
  }

  const initSearch = () => {
    const searchInput = document.getElementById('home-search') as HTMLInputElement | null;
    const searchResults = document.getElementById('search-results');
    const dataEl = document.getElementById('search-data');
    
    if (!searchInput || !searchResults || !dataEl) return;

    let tools: SearchTool[] = [];
    let icons: string[] = [];
    try {
      const raw = JSON.parse(dataEl.textContent || '{}');
      if (Array.isArray(raw)) {
        tools = raw;
      } else {
        tools = raw.tools || [];
        icons = raw.icons || [];
      }
    } catch (e) {
      console.error('Failed to parse search data', e);
      return;
    }

    let debounceTimer: ReturnType<typeof setTimeout> | null = null;
    let selectedIndex = -1;
    let currentResults: SearchTool[] = [];

    const updateSelection = (index: number) => {
      selectedIndex = index;
      const items = searchResults.querySelectorAll<HTMLAnchorElement>('.search-result-item');
      items.forEach((item, i) => {
        if (i === selectedIndex) {
          item.classList.add('bg-emerald-50');
          item.setAttribute('aria-selected', 'true');
          item.scrollIntoView({ block: 'nearest' });
          searchInput.setAttribute('aria-activedescendant', item.id);
        } else {
          item.classList.remove('bg-emerald-50');
          item.setAttribute('aria-selected', 'false');
        }
      });
      if (selectedIndex === -1) {
        searchInput.removeAttribute('aria-activedescendant');
      }
    };

    const performSearch = (query: string) => {
      if (query.length < 2) {
        searchResults.classList.add('hidden');
        searchInput.setAttribute('aria-expanded', 'false');
        searchResults.innerHTML = '';
        currentResults = [];
        updateSelection(-1);
        return;
      }

      const searchStr = query.toLowerCase();
      const results = tools.map(tool => {
        let score = 0;
        const toolTitle = tool.title.toLowerCase();
        
        if (toolTitle === searchStr) score += 100;
        else if (toolTitle.includes(searchStr)) score += 50;
        
        if (tool.aliases && tool.aliases.some((a: string) => a.toLowerCase().includes(searchStr))) score += 40;
        
        if (tool.description.toLowerCase().includes(searchStr)) score += 20;
        if (tool.keywords && tool.keywords.some((k: string) => k.toLowerCase().includes(searchStr))) score += 15;
        if (tool.subcategory && tool.subcategory.toLowerCase().includes(searchStr)) score += 10;
        if (tool.category && tool.category.toLowerCase().includes(searchStr)) score += 5;
        
        return { tool, score };
      })
      .filter(t => t.score > 0)
      .sort((a, b) => b.score - a.score)
      .slice(0, 7)
      .map(t => t.tool);

      currentResults = results;
      updateSelection(-1);

      if (results.length > 0) {
        searchResults.innerHTML = results.map((tool, idx) => {
          const toolUrl = ['', 'tools', tool.slug].join('/');
          const iconSvg = typeof tool.icon === 'number' ? (icons[tool.icon] || '') : (tool.icon || '');
          return `
          <a id="search-result-${idx}" href="${toolUrl}" role="option" aria-selected="false" class="search-result-item block px-4 py-3 hover:bg-emerald-50 border-b border-gray-100 last:border-0 transition-colors">
            <div class="flex items-center gap-3">
              <div class="text-emerald-500 w-5 h-5 flex-shrink-0">${iconSvg}</div>
              <div>
                <div class="text-sm font-medium text-gray-900">${tool.title}</div>
                <div class="text-xs text-gray-500 line-clamp-1">${tool.description}</div>
              </div>
            </div>
          </a>
        `;
        }).join('');
        searchResults.classList.remove('hidden');
        searchInput.setAttribute('aria-expanded', 'true');

        const items = searchResults.querySelectorAll<HTMLAnchorElement>('.search-result-item');
        items.forEach((item, idx) => {
          item.addEventListener('mouseenter', () => updateSelection(idx));
        });
      } else {
        searchResults.innerHTML = '';
        const emptyDiv = document.createElement('div');
        emptyDiv.className = "px-4 py-4 text-sm text-gray-500 text-center";
        emptyDiv.textContent = `No tools found for "${query}"`;
        searchResults.appendChild(emptyDiv);
        searchResults.classList.remove('hidden');
        searchInput.setAttribute('aria-expanded', 'true');
      }
    };

    searchInput.addEventListener('input', (e) => {
      if (debounceTimer) clearTimeout(debounceTimer);
      const val = (e.target as HTMLInputElement).value.trim();
      debounceTimer = setTimeout(() => {
        performSearch(val);
      }, 120);
    });

    searchInput.addEventListener('keydown', (e) => {
      if (searchResults.classList.contains('hidden') || currentResults.length === 0) {
        if (e.key === 'ArrowDown' && searchInput.value.trim().length >= 2) {
          performSearch(searchInput.value.trim());
        }
        return;
      }

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        const nextIndex = selectedIndex < currentResults.length - 1 ? selectedIndex + 1 : 0;
        updateSelection(nextIndex);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (selectedIndex <= 0) {
          updateSelection(-1);
          searchInput.focus();
        } else {
          updateSelection(selectedIndex - 1);
        }
      } else if (e.key === 'Enter') {
        e.preventDefault();
        const targetIndex = selectedIndex >= 0 ? selectedIndex : 0;
        const targetTool = currentResults[targetIndex];
        if (targetTool) {
          window.location.href = `/tools/${targetTool.slug}`;
        }
      } else if (e.key === 'Escape') {
        searchResults.classList.add('hidden');
        searchInput.setAttribute('aria-expanded', 'false');
        updateSelection(-1);
        searchInput.focus();
      }
    });

    // Close dropdown on outside click
    document.addEventListener('click', (e) => {
      if (!searchInput.contains(e.target as Node) && !searchResults.contains(e.target as Node)) {
        searchResults.classList.add('hidden');
        searchInput.setAttribute('aria-expanded', 'false');
        updateSelection(-1);
      }
    });

    searchInput.addEventListener('focus', () => {
      if (currentResults.length > 0 && searchInput.value.trim().length >= 2) {
        searchResults.classList.remove('hidden');
        searchInput.setAttribute('aria-expanded', 'true');
      }
    });
  };

  initSearch();
  document.addEventListener('astro:page-load', initSearch);
</script>
