---
import Layout from '../layouts/Layout.astro';

const termsSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Terms of Service - StudentKit",
  "url": "https://studentkit.in/terms"
};
---

<Layout title="Terms of Service" description="StudentKit Terms of Service and Educational Usage Disclaimer.">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(termsSchema)}></script>
  </Fragment>

  <div class="max-w-3xl mx-auto">
    <div class="mb-4">
      <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-1">Terms of Service</h1>
      <p class="text-xs sm:text-sm text-slate-500">Last Updated: September 2026</p>
    </div>

    <div class="prose prose-slate max-w-none space-y-5 text-slate-600 bg-white p-4 sm:p-8 rounded-xl border border-slate-200/80 shadow-xs">

      <section>
        <h2 class="text-lg font-bold text-slate-900 mb-2">1. Agreement to Terms</h2>
        <p class="text-sm leading-relaxed">
          By accessing or using StudentKit (https://studentkit.in), you agree to be bound by these Terms of Service. If you do not agree to these terms, please do not use our website.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-bold text-slate-900 mb-2">2. Educational Use Disclaimer</h2>
        <p class="text-sm leading-relaxed">
          StudentKit tools, calculators, formulas, and educational content are provided strictly for educational and informational purposes. While we strive for rigorous mathematical and scientific accuracy, calculations should always be independently verified for critical academic, medical, legal, or professional submissions.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-bold text-slate-900 mb-2">3. Intellectual Property</h2>
        <p class="text-sm leading-relaxed">
          All website designs, layout interfaces, code, and original educational explanations on StudentKit are protected by applicable copyright and intellectual property laws.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-bold text-slate-900 mb-2">4. Limitation of Liability</h2>
        <p class="text-sm leading-relaxed">
          StudentKit and its creators shall not be liable for any direct, indirect, incidental, or consequential damages resulting from the use or inability to use our tools or reliance on calculated results.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-bold text-slate-900 mb-2">5. Contact</h2>
        <p class="text-sm leading-relaxed">
          Questions about these Terms may be directed via <a href="mailto:sahilsleem01@gmail.com" class="text-blue-600 underline hover:text-blue-700 font-medium">Email</a>.
        </p>
      </section>

    </div>
  </div>
</Layout>
