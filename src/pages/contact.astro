---
import Layout from '../layouts/Layout.astro';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact StudentKit",
  "description": "Contact the StudentKit team for calculator requests, bug reports, and feedback.",
  "url": "https://studentkit.in/contact"
};
---

<Layout title="Contact" description="Get in touch with the StudentKit team. Report an issue, ask a question, or share feedback.">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(contactSchema)}></script>
  </Fragment>

  <div class="max-w-2xl mx-auto">
    <div class="mb-6 text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold uppercase tracking-wider mb-2">
        Reach Out
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-2">Contact & Feedback</h1>
      <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
        We value your feedback. Let us know if you find a bug, need an edge case handled, or have any questions.
      </p>
    </div>

    <div>
      <div class="bg-white p-4 sm:p-6 rounded-xl border border-slate-200/80 shadow-xs">
        <h2 class="text-lg sm:text-xl font-bold text-slate-900 mb-1.5">Direct Email</h2>
        <p class="text-xs sm:text-sm text-slate-500 mb-3">For inquiries, questions, or technical feedback:</p>
        <a
          href="mailto:sahilsleem01@gmail.com"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs sm:text-sm transition-colors shadow-xs"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
          </svg>
          Email
        </a>
      </div>
    </div>
  </div>
</Layout>
