---
import Layout from '../layouts/Layout.astro';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact StudentKit",
  "description": "Contact the StudentKit team for calculator requests, bug reports, and feedback.",
  "url": "https://studentkit.in/contact"
};
---

<Layout title="Contact" description="Get in touch with the StudentKit team. Report an issue, ask a question, or share feedback.">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(contactSchema)}></script>
  </Fragment>

  <main class="max-w-4xl mx-auto pb-12">
    <!-- Hero -->
    <div style="--stagger: 1" class="reveal mb-10 sm:mb-12 text-left pt-6 sm:pt-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-light text-brand-accent text-[10px] sm:text-xs font-semibold uppercase tracking-wider mb-3 sm:mb-4">
        Contact & Feedback
      </div>
      <h1 class="text-3|e sm:text-4xl md:text-5xl font-extrabold text-ink tracking-tight mb-4">
        <span class="letter-blip inline-block cursor-default">G</span><span class="letter-blip inline-block cursor-default">e</span><span class="letter-blip inline-block cursor-default">t</span> <span class="letter-blip inline-block cursor-default">i</span><span class="letter-blip inline-block cursor-default">n</span> <span class="letter-blip inline-block cursor-default">t</span><span class="letter-blip inline-block cursor-default">o</span><span class="letter-blip inline-block cursor-default">u</span><span class="letter-blip inline-block cursor-default">c</span><span class="letter-blip inline-block cursor-default">h</span> <span class="letter-blip inline-block cursor-default">w</span><span class="letter-blip inline-block cursor-default">i</span><span class="letter-blip inline-block cursor-default">t</span><span class="letter-blip inline-block cursor-default">h</span> <span class="letter-blip inline-block cursor-default">u</span><span class="letter-blip inline-block cursor-default">s</span><span class="letter-blip inline-block cursor-default">.</span>
      </h1>
      <p class="text-sm sm:text-base text-slate-muted leading-relaxed max-w-2xl">
        User feedback helps us identify broken tools, correct mathematical errors, and build useful new features. We actively review and appreciate your input.
      </p>
    </div>

    <!-- 2-Column Info Cards -->
    <div style="--stagger: 2" class="reveal grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 mb-8">
      <section class="bg-card p-6 rounded-2xl border border-border-line/60 shadow-xs group hover:-translate-y-1.5 hover:scale-[1.02] hover:border-brand hover:shadow-xl transition-all duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)]">
        <div class="w-10 h-10 rounded-xl bg-red-50 text-red-500 flex items-center justify-center mb-4 group-hover:scale-110 group-hover:bg-red-500 group-hover:text-white transition-all">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <h2 class="text-lg font-bold text-ink mb-2 group-hover:text-brand transition-colors">Report a Problem</h2>
        <p class="text-sm text-slate-muted leading-relaxed">
          Please contact us if you notice a broken link, a tool failing to load on mobile, or a calculator returning an unexpected or mathematically incorrect result.
        </p>
      </section>

      <section class="bg-card p-6 rounded-2xl border border-border-line/60 shadow-xs group hover:-translate-y-1.5 hover:scale-[1.02] hover:border-brand hover:shadow-xl transition-all duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)]">
        <div class="w-10 h-10 rounded-xl bg-brand-light/50 text-brand flex items-center justify-center mb-4 group-hover:scale-110 group-hover:bg-brand group-hover:text-card transition-all">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
        </div>
        <h2 class="text-lg font-bold text-ink mb-2 group-hover:text-brand transition-colors">Share Feedback</h2>
        <p class="text-sm text-slate-muted leading-relaxed">
          We welcome suggestions for new calculators, missing formulas, or general usability improvements. If a tool is missing a crucial edge case, let us know.
        </p>
      </section>
    </div>

    <!-- How to write a useful report -->
    <div style="--stagger: 3" class="reveal mb-8"><section class="group bg-card p-6 sm:p-8 rounded-2xl border border-border-line/60 shadow-xs hover:-translate-y-1.5 hover:scale-[1.02] hover:border-brand hover:shadow-xl transition-all duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)]">
      <h2 class="text-lg font-bold text-ink mb-4 group-hover:text-brand transition-colors">What to include in your message</h2>
      <p class="text-sm text-slate-muted mb-5">To help us reproduce and fix issues faster, please consider including:</p>
      <ul class="space-y-3 text-sm text-slate-muted">
        <li class="flex items-start gap-3">
          <span class="text-brand shrink-0 mt-0.5">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
          </span>
          <span><strong>The specific tool:</strong> The URL, or the exact name of the calculator or assessment.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-brand shrink-0 mt-0.5">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
          </span>
          <span><strong>Expected vs. Actual:</strong> What result you expected to get, and what the tool actually outputted.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-brand shrink-0 mt-0.5">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
          </span>
          <span><strong>Your setup:</strong> The device (e.g., iPhone, Windows PC) and browser you were using.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-brand shrink-0 mt-0.5">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
          </span>
          <span><strong>Screenshots:</strong> If visual layouts are broken, attaching a screenshot is highly appreciated.</span>
        </li>
      </ul>
    </section></div>

    <!-- Contact CTA -->
    <section style="--stagger: 4" class="reveal bg-brand-light/40 p-6 sm:p-8 rounded-3xl border border-brand/20 text-center">
      <h2 class="text-lg sm:text-xl font-bold text-ink mb-2">Ready to reach out?</h2>
      <p class="text-sm text-slate-muted mb-6 max-w-lg mx-auto">
        Whether you've found a bug or simply want to share a suggestion, you're welcome to get in touch.
      </p>
      <a
        href="mailto:sahilsleem01@gmail.com"
        class="has-ripple relative overflow-hidden inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-xl bg-brand hover:bg-brand-accent text-card font-semibold text-sm transition-all shadow-xs focus:outline-hidden focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-brand"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.50v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
        </svg>
        Send us an Email
      </a>
    </section>

  </main>
</Layout>
