---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact StudentKit" description="Contact page for StudentKit.">
  <div class="max-w-3xl mx-auto py-12">
    <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight mb-8">Contact StudentKit</h1>
    <div class="prose prose-emerald prose-lg text-gray-600">
      <p>Have a question, feedback, bug report, or suggestion? Feel free to reach out via email.</p>
      <p>Email: <a href="mailto:sahilsleem01@gmail.com" class="text-emerald-600 hover:underline">sahilsleem01@gmail.com</a></p>
      <p>When reporting a problem, please include the name or URL of the affected tool to help us investigate more quickly.</p>
    </div>
  </div>
</Layout>
