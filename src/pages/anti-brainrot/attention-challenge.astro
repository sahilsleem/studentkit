---
import AntiBrainrotLayout from '../../layouts/AntiBrainrotLayout.astro';
import { getAntiBrainrotModule } from '../../data/antiBrainrotRegistry';

// Safe fallback in case registry changes
const module = getAntiBrainrotModule('attention-challenge') || {
  id: 'attention-challenge',
  slug: 'attention-challenge',
  title: 'Attention Challenge',
  tagline: 'Visual discrimination and noticing what matters.',
  description: 'Fast visual discrimination drills: spot subtle pattern changes, identify anomalies, and filter out visual noise against tight per-round timers.',
  skills: ['Visual Discrimination', 'Selective Attention', 'Detail Recall'],
  duration: '30 Rounds • ~3 Mins',
  icon: 'eye',
  status: 'coming-soon' as const
};
---

<AntiBrainrotLayout
  module={module}
  title="Attention Challenge — Visual Discrimination & Focus Training | StudentKit"
  description="Train your selective attention and visual discrimination with rapid-fire 30-round symbol and pattern drills. Fast, adaptive, and stored locally."
>
  <div class="reveal max-w-2xl mx-auto bg-card rounded-3xl border border-border-line p-8 sm:p-12 text-center shadow-xs my-8">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-brand-light/80 text-brand mb-6 shadow-xs">
      <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
      </svg>
    </div>
    
    <h2 class="text-2xl sm:text-3xl font-extrabold text-ink tracking-tight mb-4">
      Attention Challenge is Coming Soon
    </h2>
    
    <p class="text-slate-muted text-base sm:text-lg max-w-lg mx-auto mb-10 leading-relaxed">
      We are currently rebuilding this module to provide a highly polished, distraction-free visual discrimination exercise. Check back soon!
    </p>
    
    <a 
      href="/anti-brainrot" 
      class="has-ripple inline-flex items-center gap-2 px-6 py-3.5 bg-brand hover:bg-brand/90 text-card font-bold rounded-xl shadow-md shadow-brand/20 transition-all duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] transform hover:-translate-y-0.5 active:scale-[0.98] focus-ring"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Back to Anti-Brainrot
    </a>
  </div>
</AntiBrainrotLayout>
