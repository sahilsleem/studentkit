---
import TestLayout from '../../layouts/TestLayout.astro';
import IQTestEngine from '../../components/tests/IQTestEngine.astro';
import { testsRegistry } from '../../data/testsRegistry';

const testMetadata = testsRegistry.find(t => t.slug === 'iq-test');
if (!testMetadata) throw new Error("IQ Test metadata not found in registry");
---

<TestLayout test={testMetadata}>
  <div class="bg-card rounded-2xl border border-border-line/40 shadow-sm overflow-hidden">
    <IQTestEngine />
  </div>
</TestLayout>
