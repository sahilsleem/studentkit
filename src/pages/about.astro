---
import Layout from '../layouts/Layout.astro';

const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About StudentKit",
  "description": "About StudentKit — the lightweight, fast, and completely free collection of precision study tools for students.",
  "url": "https://studentkit.in/about"
};
---

<Layout title="About" description="Learn about StudentKit — our mission to provide clean, fast, privacy-first academic utilities with no paywalls or sign-ups.">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(aboutSchema)}></script>
  </Fragment>

  <main class="max-w-4xl mx-auto pb-12">
    <!-- Hero -->
    <div style="--stagger: 1" class="reveal mb-10 sm:mb-12 text-left pt-6 sm:pt-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-light text-brand-accent text-[10px] sm:text-xs font-semibold uppercase tracking-wider mb-3 sm:mb-4">
        About StudentKit
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-ink tracking-tight mb-4">
        <span class="letter-blip inline-block cursor-default">F</span><span class="letter-blip inline-block cursor-default">r</span><span class="letter-blip inline-block cursor-default">e</span><span class="letter-blip inline-block cursor-default">e</span> <span class="letter-blip inline-block cursor-default">S</span><span class="letter-blip inline-block cursor-default">t</span><span class="letter-blip inline-block cursor-default">u</span><span class="letter-blip inline-block cursor-default">d</span><span class="letter-blip inline-block cursor-default">e</span><span class="letter-blip inline-block cursor-default">n</span><span class="letter-blip inline-block cursor-default">t</span> <span class="letter-blip inline-block cursor-default">T</span><span class="letter-blip inline-block cursor-default">o</span><span class="letter-blip inline-block cursor-default">o</span><span class="letter-blip inline-block cursor-default">l</span><span class="letter-blip inline-block cursor-default">s</span> <span class="letter-blip inline-block cursor-default">f</span><span class="letter-blip inline-block cursor-default">o</span><span class="letter-blip inline-block cursor-default">r</span> <span class="letter-blip inline-block cursor-default">S</span><span class="letter-blip inline-block cursor-default">m</span><span class="letter-blip inline-block cursor-default">a</span><span class="letter-blip inline-block cursor-default">r</span><span class="letter-blip inline-block cursor-default">t</span><span class="letter-blip inline-block cursor-default">e</span><span class="letter-blip inline-block cursor-default">r</span> <span class="letter-blip inline-block cursor-default">L</span><span class="letter-blip inline-block cursor-default">e</span><span class="letter-blip inline-block cursor-default">a</span><span class="letter-blip inline-block cursor-default">r</span><span class="letter-blip inline-block cursor-default">n</span><span class="letter-blip inline-block cursor-default">i</span><span class="letter-blip inline-block cursor-default">n</span><span class="letter-blip inline-block cursor-default">g</span><span class="letter-blip inline-block cursor-default">.</span>
      </h1>
      <p class="text-sm sm:text-base text-slate-muted leading-relaxed max-w-2xl">
        <span class="font-bold text-ink"><span class="letter-blip inline-block cursor-default">S</span><span class="letter-blip inline-block cursor-default">t</span><span class="letter-blip inline-block cursor-default">u</span><span class="letter-blip inline-block cursor-default">d</span><span class="letter-blip inline-block cursor-default">e</span><span class="letter-blip inline-block cursor-default">n</span><span class="letter-blip inline-block cursor-default">t</span><span class="text-brand-accent"><span class="letter-blip letter-blip-brand inline-block cursor-default">K</span><span class="letter-blip letter-blip-brand inline-block cursor-default">i</span><span class="letter-blip letter-blip-brand inline-block cursor-default">t</span></span></span> is a collection of free tools built to make studying and everyday academic tasks simpler. We provide calculators for complex problems, assessments for self-checking, Anti-Brainrot exercises for mental training, and practical utilities for daily student needs.
      </p>
    </div>

    <!-- The Three Pillars -->
    <section style="--stagger: 2" class="reveal mb-12 sm:mb-16">
      <h2 class="text-xl sm:text-2xl font-bold text-ink mb-6">The StudentKit Ecosystem</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
        
        <a href="/tools" class="group block bg-card p-5 sm:p-6 rounded-2xl border border-border-line/60 shadow-xs hover:-translate-y-1.5 hover:scale-[1.02] hover:border-brand hover:shadow-xl transition-all duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] focus:outline-hidden focus-visible:ring-2 focus-visible:ring-brand-accent">
          <div class="w-10 h-10 rounded-xl bg-brand-light/50 text-brand flex items-center justify-center mb-4 group-hover:scale-110 group-hover:bg-brand group-hover:text-card transition-all">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2zM10 8.5a.5.5 0 11-1 0 .5.5 0 011 0zm5 5a.5.5 0 11-1 0 .5.5 0 011 0z" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-ink mb-2 group-hover:text-brand transition-colors">Calculators & Academic Tools</h3>
          <p class="text-xs sm:text-sm text-slate-muted leading-relaxed">
            Work through common student tasks with our directory of calculators, measurement converters, grade estimators, and science utilities.
          </p>
        </a>

        <a href="/tests" class="group block bg-card p-5 sm:p-6 rounded-2xl border border-border-line/60 shadow-xs hover:-translate-y-1.5 hover:scale-[1.02] hover:border-brand hover:shadow-xl transition-all duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] focus:outline-hidden focus-visible:ring-2 focus-visible:ring-brand-accent">
          <div class="w-10 h-10 rounded-xl bg-brand-light/50 text-brand flex items-center justify-center mb-4 group-hover:scale-110 group-hover:bg-brand group-hover:text-card transition-all">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-ink mb-2 group-hover:text-brand transition-colors">Tests & Assessments</h3>
          <p class="text-xs sm:text-sm text-slate-muted leading-relaxed">
            Interactive cognitive and numerical reasoning assessments designed for practice, skill-building, and self-evaluation.
          </p>
        </a>

        <a href="/anti-brainrot" class="group block bg-card p-5 sm:p-6 rounded-2xl border border-border-line/60 shadow-xs hover:-translate-y-1.5 hover:scale-[1.02] hover:border-brand hover:shadow-xl transition-all duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] focus:outline-hidden focus-visible:ring-2 focus-visible:ring-brand-accent">
          <div class="w-10 h-10 rounded-xl bg-brand-light/50 text-brand flex items-center justify-center mb-4 group-hover:scale-110 group-hover:bg-brand group-hover:text-card transition-all">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4_14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-ink mb-2 group-hover:text-brand transition-colors">Anti-Brainrot</h3>
          <p class="text-xs sm:text-sm text-slate-muted leading-relaxed">
            Short, focused cognitive exercises and mental math challenges designed to sharpen attention, focus, and working memory.
          </p>
        </a>

      </div>
    </section>

    <!-- Core Philosophy -->
    <section style="--stagger: 3" class="reveal mb-12 sm:mb-16">
      <h2 class="text-xl sm:text-2xl font-bold text-ink mb-6">Our Core Philosophy</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
        <div class="group p-5 bg-card rounded-2xl border border-border-line/60 shadow-xs hover:-translate-y-1.5 hover:scale-[1.02] hover:border-brand hover:shadow-xl transition-all duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)]">
          <h3 class="text-sm font-bold text-ink mb-2 group-hover:text-brand transition-colors">1. Tool-First Experience</h3>
          <p class="text-sm text-slate-muted leading-relaxed">When you open a tool or assessment, you get straight to the activity. We don't bury our utilities under thousands of words of search engine filler.</p>
        </div>
        <div class="group p-5 bg-card rounded-2xl border border-border-line/60 shadow-xs hover:-translate-y-1.5 hover:scale-[1.02] hover:border-brand hover:shadow-xl transition-all duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)]">
          <h3 class="text-sm font-bold text-ink mb-2 group-hover:text-brand transition-colors">2. Privacy Conscious</h3>
          <p class="text-sm text-slate-muted leading-relaxed">Almost all calculations execute entirely on your own device using vanilla JavaScript. We do not transmit or store your tool inputs on remote servers.</p>
        </div>
        <div class="group p-5 bg-card rounded-2xl border border-border-line/60 shadow-xs hover:-translate-y-1.5 hover:scale-[1.02] hover:border-brand hover:shadow-xl transition-all duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)]">
          <h3 class="text-sm font-bold text-ink mb-2 group-hover:text-brand transition-colors">3. Mobile-First Speed</h3>
          <p class="text-sm text-slate-muted leading-relaxed">StudentKit is optimized for fast mobile performance so you can reliably use the tools in the middle of a class, lab, or library session.</p>
        </div>
        <div class="group p-5 bg-card rounded-2xl border border-border-line/60 shadow-xs hover:-translate-y-1.5 hover:scale-[1.02] hover:border-brand hover:shadow-xl transition-all duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)]">
          <h3 class="text-sm font-bold text-ink mb-2 group-hover:text-brand transition-colors">4. Zero Friction</h3>
          <p class="text-sm text-slate-muted leading-relaxed">No logins, no passwords, no paywalls, and no verification emails. Every tool is available immediately and completely free of charge.</p>
        </div>
      </div>
    </section>

    <!-- Closing CTA -->
    <section style="--stagger: 4" class="reveal bg-brand-light/40 p-6 sm:p-8 rounded-3xl border border-brand/20 text-center">
      <h2 class="text-lg sm:text-xl font-bold text-ink mb-3">Ready to get started?</h2>
      <p class="text-sm text-slate-muted mb-6 max-w-lg mx-auto">
        Explore our directory of utilities or challenge yourself with an assessment.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
        <a href="/tools" class="has-ripple relative overflow-hidden inline-flex items-center justify-center w-full sm:w-auto px-6 py-2.5 rounded-xl bg-brand hover:bg-brand-accent text-card font-semibold text-sm transition-all shadow-xs focus:outline-hidden focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-brand">
          Explore Tools
        </a>
        <a href="/tests" class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-2.5 rounded-xl bg-card border border-border-line/80 hover:border-brand/40 text-ink hover:text-brand font-semibold text-sm transition-all shadow-xs focus:outline-hidden focus-visible:ring-2 focus-visible:ring-brand">
          Try an Assessment
        </a>
      </div>
    </section>

  </main>
</Layout>