---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found" description="The requested page could not be found.">
  <div class="flex flex-col items-center justify-center min-h-[50vh] text-center px-4">
    <h1 class="text-6xl font-extrabold text-blue-600 mb-4 font-mono">404</h1>
    <h2 class="text-2xl font-bold text-slate-900 mb-2">Page Not Found</h2>
    <p class="text-slate-500 mb-8 max-w-md mx-auto">
      The tool or page you are looking for doesn't exist or has been moved.
    </p>
    <a href="/tools" class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl shadow-sm transition-all">
      Browse All Tools
    </a>
  </div>
</Layout>