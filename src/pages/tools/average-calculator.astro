---
import Layout from '../../layouts/Layout.astro';
import { tools } from '../../data/tools.js';

const tool = tools.find(t => t.url === '/tools/average-calculator');
const relatedTools = tools.filter(t => t.category === 'Everyday' && t.url !== tool?.url).slice(0, 3);
---

<Layout title={tool?.title || 'Average Calculator'} description={tool?.description}>
  <div class="max-w-4xl mx-auto">
    <div class="mb-8 text-center sm:text-left">
      <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight mb-2">{tool?.title}</h1>
      <p class="text-lg text-gray-500">{tool?.description}</p>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden mb-12">
      <div class="p-6 sm:p-8">
        <form id="calculator-form" class="space-y-6">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Enter numbers separated by commas or spaces</label>
            <textarea id="number-input" rows="4" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500 sm:text-base resize-y" placeholder="e.g. 10, 15, 20, 25"></textarea>
          </div>

          <div class="flex gap-4">
            <button type="submit" class="flex-1 bg-emerald-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-emerald-700 transition-colors">
              Calculate Average
            </button>
            <button type="button" id="reset-btn" class="px-6 py-3 border border-gray-300 rounded-lg text-gray-700 font-medium hover:bg-gray-50 transition-colors">
              Reset
            </button>
          </div>
        </form>

        <div id="result-section" class="mt-8 pt-8 border-t border-gray-100 hidden">
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
            <div class="bg-emerald-50 rounded-lg p-4 border border-emerald-100 col-span-2 sm:col-span-4 mb-2">
              <p class="text-sm text-emerald-700 mb-1 font-medium">Mean (Average)</p>
              <div class="text-4xl font-bold text-emerald-800" id="res-mean">--</div>
            </div>
            
            <div class="bg-gray-50 rounded-lg p-4 border border-gray-100">
              <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Count</p>
              <div class="text-xl font-bold text-gray-900" id="res-count">--</div>
            </div>
            <div class="bg-gray-50 rounded-lg p-4 border border-gray-100">
              <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Sum</p>
              <div class="text-xl font-bold text-gray-900" id="res-sum">--</div>
            </div>
            <div class="bg-gray-50 rounded-lg p-4 border border-gray-100">
              <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Min</p>
              <div class="text-xl font-bold text-gray-900" id="res-min">--</div>
            </div>
            <div class="bg-gray-50 rounded-lg p-4 border border-gray-100">
              <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Max</p>
              <div class="text-xl font-bold text-gray-900" id="res-max">--</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const initCalculator = () => {
    const form = document.getElementById('calculator-form') as HTMLFormElement;
    if (!form) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const input = (document.getElementById('number-input') as HTMLTextAreaElement).value;
      
      // Parse numbers from commas, spaces, or newlines
      const rawNums = input.split(/[\s,]+/).filter(n => n.trim() !== '');
      const nums = rawNums.map(n => parseFloat(n)).filter(n => !isNaN(n));
      
      if (nums.length === 0) {
        alert("Please enter at least one valid number.");
        return;
      }

      const count = nums.length;
      const sum = nums.reduce((a, b) => a + b, 0);
      const mean = sum / count;
      const min = Math.min(...nums);
      const max = Math.max(...nums);

      document.getElementById('res-mean')!.textContent = mean % 1 === 0 ? mean.toString() : mean.toFixed(4).replace(/\.?0+$/, '');
      document.getElementById('res-count')!.textContent = count.toString();
      document.getElementById('res-sum')!.textContent = sum % 1 === 0 ? sum.toString() : sum.toFixed(4).replace(/\.?0+$/, '');
      document.getElementById('res-min')!.textContent = min.toString();
      document.getElementById('res-max')!.textContent = max.toString();

      document.getElementById('result-section')?.classList.remove('hidden');
    });

    document.getElementById('reset-btn')?.addEventListener('click', () => {
      form.reset();
      document.getElementById('result-section')?.classList.add('hidden');
    });
  };

  initCalculator();
  document.addEventListener('astro:page-load', initCalculator);
</script>
