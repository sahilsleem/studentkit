---
import Layout from '../../layouts/Layout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { tools, categories, getCategorySlug } from '../../data/registry';

const toolsData = tools.map(tool => ({
  id: tool.id,
  slug: tool.slug,
  title: tool.title,
  description: tool.description,
  category: tool.category,
  subcategory: tool.subcategory,
  icon: tool.icon
}));
---

<Layout title="All Tools" description="Browse student tools and calculators. Academic grades, maths, physics, chemistry, and study utilities.">

  <!-- Header -->
  <div class="mb-4 text-left">
    <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-1">Student Tools Directory</h1>
    <p class="text-xs sm:text-sm text-slate-500">Browse study calculators and problem-solving tools.</p>
  </div>

  <!-- Search & Filter Controls -->
  <div class="flex flex-col md:flex-row gap-3 sm:gap-4 mb-4">
    <div class="flex-grow relative">
      <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
        </svg>
      </div>
      <input
        type="text"
        id="tools-search"
        aria-label="Filter tools"
        class="block w-full pl-10 pr-4 py-2.5 border border-slate-300 rounded-xl leading-5 bg-white placeholder-slate-400 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-blue-600 text-sm transition-all shadow-xs"
        placeholder="Search tools by name, topic, or keyword..."
      />
    </div>

    <div class="md:w-64 flex-shrink-0">
      <select
        id="category-filter"
        aria-label="Filter by category"
        class="block w-full pl-3.5 pr-10 py-2.5 text-sm border border-slate-300 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-blue-600 rounded-xl bg-white text-slate-700 shadow-xs cursor-pointer"
      >
        <option value="all">All Categories</option>
        {categories.map(c => (
          <option value={c.name.toLowerCase()}>{c.name}</option>
        ))}
      </select>
    </div>
  </div>

  <!-- Results Meta Bar (Only shows reset button when filtered) -->
  <div class="flex items-center justify-end text-xs text-slate-500 mb-2 px-1" id="results-meta">
    <button
      type="button"
      id="reset-filter-btn"
      class="text-blue-600 hover:text-blue-700 font-medium hidden cursor-pointer"
    >
      Clear filters
    </button>
  </div>

  <!-- Tools Grid (Compact) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5 sm:gap-3" id="tools-grid">
    {tools.map(tool => (
      <ToolCard
        title={tool.title}
        description={tool.description}
        url={`/tools/${tool.slug}`}
        icon={tool.icon}
        category={tool.category}
        subcategory={tool.subcategory}
        keywords={tool.keywords}
        aliases={tool.aliases}
      />
    ))}
  </div>

  <!-- Empty Search / Filter State -->
  <div id="no-results" class="hidden py-8 px-6 bg-white rounded-2xl border border-slate-200 text-center max-w-md mx-auto my-4">
    <div class="w-10 h-10 rounded-xl bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-2">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
      </svg>
    </div>
    <h3 class="text-sm font-bold text-slate-900 mb-1">No matching tools found</h3>
    <p class="text-xs text-slate-500 mb-3">Try adjusting your search terms or selecting a different category.</p>
    <button
      type="button"
      id="empty-reset-btn"
      class="px-3.5 py-1.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-lg transition-colors cursor-pointer"
    >
      Clear All Filters
    </button>
  </div>

  <script>
    function setupToolFiltering() {
      const searchInput = document.getElementById('tools-search') as HTMLInputElement | null;
      const categoryFilter = document.getElementById('category-filter') as HTMLSelectElement | null;
      const toolCards = document.querySelectorAll<HTMLElement>('.tool-card');
      const noResultsEl = document.getElementById('no-results');
      const resetBtn = document.getElementById('reset-filter-btn');
      const emptyResetBtn = document.getElementById('empty-reset-btn');

      const slugify = (str: string) =>
        str.toLowerCase().replace(/&amp;/g, 'and').replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

      const normalize = (str: string) => str ? str.toLowerCase().trim().replace(/\s+/g, ' ') : '';
      const getWords = (str: string) => str.toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim().split(/\s+/).filter(Boolean);

      function filter() {
        const query = normalize(searchInput?.value || '');
        const qWords = getWords(query);
        const selectedVal = (categoryFilter?.value || 'all').trim();
        const selectedSlug = selectedVal === 'all' ? 'all' : slugify(selectedVal);

        let visibleCount = 0;

        toolCards.forEach(card => {
          const title = (card.getAttribute('data-title') || '').toLowerCase();
          const rawCat = (card.getAttribute('data-category') || '').toLowerCase();
          const cardCatSlug = slugify(rawCat);
          const sub = (card.getAttribute('data-subcategory') || '').toLowerCase();
          const keywords = (card.getAttribute('data-keywords') || '').toLowerCase();
          const aliases = (card.getAttribute('data-aliases') || '').toLowerCase();

          const allText = [title, sub, keywords, aliases].join(' ');
          const allWords = getWords(allText);

          const matchesCategory = selectedSlug === 'all' || cardCatSlug === selectedSlug;

          let matchesQuery = !query;
          if (!matchesQuery) {
            if (title.startsWith(query)) {
              matchesQuery = true;
            } else if (title.includes(query)) {
              matchesQuery = query.length > 3 || allWords.some(w => w.startsWith(query) || w === query);
            } else if (keywords.includes(query) || aliases.includes(query)) {
              matchesQuery = query.length > 3 || allWords.some(w => w.startsWith(query) || w === query);
            } else if (qWords.length > 1) {
              matchesQuery = qWords.every(qw => allWords.some(w => w.startsWith(qw) || w === qw) || allText.includes(qw));
            }
          }

          if (matchesCategory && matchesQuery) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (noResultsEl) {
          if (visibleCount === 0) {
            noResultsEl.classList.remove('hidden');
          } else {
            noResultsEl.classList.add('hidden');
          }
        }

        if (resetBtn) {
          if (query || selectedSlug !== 'all') {
            resetBtn.classList.remove('hidden');
          } else {
            resetBtn.classList.add('hidden');
          }
        }
      }

      function resetAll() {
        if (searchInput) searchInput.value = '';
        if (categoryFilter) categoryFilter.value = 'all';
        filter();
      }

      searchInput?.addEventListener('input', filter);
      categoryFilter?.addEventListener('change', filter);
      resetBtn?.addEventListener('click', resetAll);
      emptyResetBtn?.addEventListener('click', resetAll);

      // Handle category query param on initial load
      const urlParams = new URLSearchParams(window.location.search);
      const catParam = urlParams.get('category');
      if (catParam && categoryFilter) {
        const targetSlug = slugify(catParam);
        for (let i = 0; i < categoryFilter.options.length; i++) {
          const opt = categoryFilter.options[i];
          if (slugify(opt.value) === targetSlug) {
            categoryFilter.selectedIndex = i;
            break;
          }
        }
      }

      const qParam = urlParams.get('q');
      if (qParam && searchInput) {
        searchInput.value = qParam;
      }

      filter();
    }

    document.addEventListener('DOMContentLoaded', setupToolFiltering);
    setupToolFiltering();
  </script>
</Layout>
