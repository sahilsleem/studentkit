---
import Layout from '../../layouts/Layout.astro';
import { tools } from '../../data/tools.js';

const tool = tools.find(t => t.url === '/tools/date-difference');
const relatedTools = tools.filter(t => t.category === 'Date & Time' && t.url !== tool?.url).slice(0, 3);
---

<Layout title={tool?.title || 'Date Difference Calculator'} description={tool?.description}>
  <div class="max-w-4xl mx-auto">
    <div class="mb-8 text-center sm:text-left">
      <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight mb-2">{tool?.title}</h1>
      <p class="text-lg text-gray-500">{tool?.description}</p>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden mb-12">
      <div class="p-6 sm:p-8">
        <form id="calculator-form" class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Start Date</label>
              <input type="date" id="start-date" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500 sm:text-base">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">End Date</label>
              <input type="date" id="end-date" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500 sm:text-base">
            </div>
          </div>

          <div class="flex gap-4 pt-4">
            <button type="submit" class="flex-1 bg-emerald-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-emerald-700 transition-colors">
              Calculate Difference
            </button>
          </div>
        </form>

        <div id="result-section" class="mt-8 pt-8 border-t border-gray-100 hidden">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="bg-emerald-50 rounded-lg p-5 border border-emerald-100 text-center">
              <p class="text-xs text-emerald-600 uppercase tracking-wide mb-1 font-medium">Days</p>
              <div class="text-3xl font-bold text-emerald-700" id="res-days">--</div>
            </div>
            <div class="bg-gray-50 rounded-lg p-5 border border-gray-100 text-center">
              <p class="text-xs text-gray-500 uppercase tracking-wide mb-1 font-medium">Weeks</p>
              <div class="text-3xl font-bold text-gray-900" id="res-weeks">--</div>
            </div>
            <div class="bg-gray-50 rounded-lg p-5 border border-gray-100 text-center">
              <p class="text-xs text-gray-500 uppercase tracking-wide mb-1 font-medium">Months (Approx)</p>
              <div class="text-3xl font-bold text-gray-900" id="res-months">--</div>
            </div>
            <div class="bg-gray-50 rounded-lg p-5 border border-gray-100 text-center">
              <p class="text-xs text-gray-500 uppercase tracking-wide mb-1 font-medium">Years (Approx)</p>
              <div class="text-3xl font-bold text-gray-900" id="res-years">--</div>
            </div>
          </div>
          
          <div class="mt-6 text-center text-sm text-gray-500 bg-gray-50 rounded-lg p-4" id="detailed-text">
            --
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const initCalculator = () => {
    const form = document.getElementById('calculator-form') as HTMLFormElement;
    if (!form) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const start = new Date((document.getElementById('start-date') as HTMLInputElement).value);
      const end = new Date((document.getElementById('end-date') as HTMLInputElement).value);
      
      const diffTime = Math.abs(end.getTime() - start.getTime());
      
      const totalDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));
      const totalWeeks = (totalDays / 7).toFixed(1);
      const totalMonths = (totalDays / 30.44).toFixed(1);
      const totalYears = (totalDays / 365.25).toFixed(1);
      
      const earlyDate = start < end ? start : end;
      const lateDate = start < end ? end : start;

      let years = lateDate.getFullYear() - earlyDate.getFullYear();
      let months = lateDate.getMonth() - earlyDate.getMonth();
      let days = lateDate.getDate() - earlyDate.getDate();

      if (days < 0) {
        months--;
        const prevMonth = new Date(lateDate.getFullYear(), lateDate.getMonth(), 0);
        days += prevMonth.getDate();
      }
      if (months < 0) {
        years--;
        months += 12;
      }

      document.getElementById('res-days')!.textContent = totalDays.toString();
      document.getElementById('res-weeks')!.textContent = totalWeeks;
      document.getElementById('res-months')!.textContent = totalMonths;
      document.getElementById('res-years')!.textContent = totalYears;
      
      document.getElementById('detailed-text')!.innerHTML = `Exact difference: <strong>${years} years, ${months} months, and ${days} days</strong>.`;

      document.getElementById('result-section')?.classList.remove('hidden');
    });
  };

  initCalculator();
  document.addEventListener('astro:page-load', initCalculator);
</script>
