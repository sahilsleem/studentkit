---
import Layout from '../../layouts/Layout.astro';
import { tools } from '../../data/tools.js';

const tool = tools.find(t => t.url === '/tools/required-marks');
const relatedTools = tools.filter(t => t.category === 'Academic' && t.url !== tool?.url).slice(0, 3);
---

<Layout title={tool?.title || 'Required Marks Calculator'} description={tool?.description}>
  <div class="max-w-4xl mx-auto">
    <div class="mb-8 text-center sm:text-left">
      <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight mb-2">{tool?.title}</h1>
      <p class="text-lg text-gray-500">{tool?.description}</p>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden mb-12">
      <div class="p-6 sm:p-8">
        <form id="calculator-form" class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Current Marks Obtained</label>
              <input type="number" id="current-marks" min="0" step="0.5" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500 sm:text-base">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Current Total Possible Marks</label>
              <input type="number" id="current-total" min="1" step="0.5" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500 sm:text-base">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Remaining Marks (e.g. Final Exam Total)</label>
              <input type="number" id="remaining-marks" min="1" step="0.5" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500 sm:text-base">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Overall Target Percentage (%)</label>
              <input type="number" id="target-percent" min="1" max="100" step="0.5" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500 sm:text-base" placeholder="e.g. 80">
            </div>
          </div>

          <div class="flex gap-4 pt-4">
            <button type="submit" class="flex-1 bg-emerald-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-emerald-700 transition-colors">
              Calculate Required Marks
            </button>
            <button type="button" id="reset-btn" class="px-6 py-3 border border-gray-300 rounded-lg text-gray-700 font-medium hover:bg-gray-50 transition-colors">
              Reset
            </button>
          </div>
        </form>

        <div id="result-section" class="mt-8 pt-8 border-t border-gray-100 hidden">
          <div class="text-center">
            <p class="text-sm text-gray-500 mb-1">You need to score</p>
            <div class="text-4xl sm:text-5xl font-bold text-gray-900 mb-2" id="required-score">--</div>
            <p class="text-sm font-medium" id="status-message"></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const initCalculator = () => {
    const form = document.getElementById('calculator-form') as HTMLFormElement;
    if (!form) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const currentMarks = parseFloat((document.getElementById('current-marks') as HTMLInputElement).value);
      const currentTotal = parseFloat((document.getElementById('current-total') as HTMLInputElement).value);
      const remainingMarks = parseFloat((document.getElementById('remaining-marks') as HTMLInputElement).value);
      const targetPercent = parseFloat((document.getElementById('target-percent') as HTMLInputElement).value);

      if (currentMarks > currentTotal) {
        alert("Current marks cannot exceed current total possible marks.");
        return;
      }

      const finalTotalMarks = currentTotal + remainingMarks;
      const requiredTotalMarks = (targetPercent / 100) * finalTotalMarks;
      const neededMarks = requiredTotalMarks - currentMarks;
      
      const reqScoreEl = document.getElementById('required-score');
      const statusEl = document.getElementById('status-message');
      const resultSection = document.getElementById('result-section');

      if (reqScoreEl && statusEl) {
        if (neededMarks > remainingMarks) {
          reqScoreEl.textContent = 'Impossible';
          reqScoreEl.className = 'text-4xl sm:text-5xl font-bold text-red-600 mb-2';
          statusEl.textContent = `Even if you score 100% (${remainingMarks}/${remainingMarks}), you will only reach ${(((currentMarks + remainingMarks)/finalTotalMarks)*100).toFixed(2)}%.`;
          statusEl.className = 'text-sm font-medium text-red-600';
        } else if (neededMarks <= 0) {
          reqScoreEl.textContent = '0';
          reqScoreEl.className = 'text-4xl sm:text-5xl font-bold text-emerald-600 mb-2';
          statusEl.textContent = 'You have already reached your target percentage!';
          statusEl.className = 'text-sm font-medium text-emerald-600';
        } else {
          reqScoreEl.textContent = `${neededMarks.toFixed(1)} / ${remainingMarks}`;
          reqScoreEl.className = 'text-4xl sm:text-5xl font-bold text-gray-900 mb-2';
          
          const percentageNeeded = (neededMarks / remainingMarks) * 100;
          statusEl.textContent = `You need to score ${percentageNeeded.toFixed(1)}% on your remaining exams.`;
          statusEl.className = 'text-sm font-medium text-gray-600';
        }
      }

      resultSection?.classList.remove('hidden');
      resultSection?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });

    document.getElementById('reset-btn')?.addEventListener('click', () => {
      form.reset();
      document.getElementById('result-section')?.classList.add('hidden');
    });
  };

  initCalculator();
  document.addEventListener('astro:page-load', initCalculator);
</script>
