---
import ToolLayout from '../../layouts/ToolLayout.astro';
import FormulaCalculator from '../../components/ui/FormulaCalculator.astro';
import { tools } from '../../data/registry';
import type { Tool } from '../../data/registry';

export function getStaticPaths() {
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

export interface Props {
  tool: Tool;
}

const { tool } = Astro.props;

// Dynamically import the component for this tool based on its slug.
// We use import.meta.glob to gather all tool components.
const componentFiles = import.meta.glob('../../components/tools/*.astro', { eager: true });
const componentName = tool.component || tool.slug;
const componentPath = `../../components/tools/${componentName}.astro`;

let ToolComponent = null;
if (componentPath in componentFiles) {
  // @ts-ignore
  ToolComponent = componentFiles[componentPath].default;
}
---

<ToolLayout tool={tool}>
  {ToolComponent ? (
    <ToolComponent />
  ) : tool.formulaConfig ? (
    <FormulaCalculator config={tool.formulaConfig} toolId={tool.id} />
  ) : (
    <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 p-6 rounded-lg text-center mb-12">
      <h2 class="text-xl font-semibold mb-2">Under Construction</h2>
      <p>The <strong>{tool.title}</strong> is currently being built and will be available soon.</p>
    </div>
  )}
</ToolLayout>
