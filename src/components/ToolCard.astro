---
export interface Props {
  title: string;
  description: string;
  url: string;
  icon: string;
  category?: string;
  subcategory?: string;
  keywords?: string[];
}

const { title, description, url, icon, category, subcategory, keywords } = Astro.props;
---

<a href={url} class="group block p-6 bg-white rounded-lg border border-gray-200 hover:border-emerald-500 hover:shadow-sm transition-all tool-card" data-title={title.toLowerCase()} data-desc={description.toLowerCase()} data-category={category?.toLowerCase() || ''} data-subcategory={subcategory?.toLowerCase() || ''} data-keywords={keywords ? keywords.join(' ').toLowerCase() : ''}>
  <div class="flex items-center gap-4 mb-3">
    <div class="flex items-center justify-center w-10 h-10 rounded bg-emerald-50 text-emerald-600 group-hover:bg-emerald-100 transition-colors" set:html={icon}>
    </div>
    <h3 class="text-lg font-semibold text-gray-900 group-hover:text-emerald-600 transition-colors">{title}</h3>
  </div>
  <p class="text-sm text-gray-500 mb-2">{description}</p>
  {category && <span class="inline-block px-2 py-1 text-xs font-medium text-gray-600 bg-gray-100 rounded mr-2">{category}</span>}
  {subcategory && <span class="inline-block px-2 py-1 text-xs font-medium text-gray-600 bg-gray-100 rounded">{subcategory}</span>}
</a>
