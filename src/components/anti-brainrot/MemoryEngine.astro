---
export interface Props {
  mode?: 'standard';
}
const { mode = 'standard' } = Astro.props;
---

<div class="reveal group bg-card/80 backdrop-blur-sm rounded-3xl border border-border-line/80 hover:border-brand hover:shadow-xl hover:-translate-y-1.5 hover:scale-[1.02] transition-all duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] overflow-hidden relative" id="memory-container">

  <!-- SCREEN 1: INTRO SCREEN -->
  <div id="screen-intro" class="p-6 sm:p-10 text-center flex flex-col items-center transition-all duration-300">
    <div class="w-16 h-16 rounded-2xl bg-brand-light/80 text-brand flex items-center justify-center mb-6 shadow-sm border border-brand/20 group-hover:bg-gradient-to-br group-hover:from-violet-500 group-hover:to-teal-400 group-hover:text-white transition-all duration-300 group-hover:scale-110 group-hover:-rotate-3">
      <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
      </svg>
    </div>

    <h2 class="text-2xl sm:text-3xl font-extrabold text-ink tracking-tight mb-3 group-hover:text-brand transition-colors duration-300">Memory Challenge</h2>
    <p class="text-sm sm:text-base text-slate-muted max-w-sm mx-auto mb-8 leading-relaxed">
      Memorize the sequence of highlighted tiles. The sequence grows longer and faster with each level.
    </p>

    <div class="w-full max-w-xs space-y-4">
      <button id="btn-start" class="w-full py-4 bg-brand hover:bg-brand/90 text-white font-bold rounded-2xl shadow-sm transition-all transform hover:scale-[1.02] active:scale-[0.98] focus-ring">
        Start Training
      </button>

      <div id="intro-pb-box" class="hidden bg-slate-50 border border-border-line/60 rounded-xl p-3 text-sm font-semibold text-slate-muted">
        Personal Best: <span id="intro-pb-val" class="text-brand">Lvl 1</span>
      </div>
    </div>
  </div>

  <!-- SCREEN 2: GAME SCREEN -->
  <div id="screen-game" class="hidden p-4 sm:p-8 flex-col h-full w-full">
    <!-- Header: Stats -->
    <div class="flex items-center justify-between mb-6 sm:mb-8 bg-card border border-border-line/60 p-3 sm:p-4 rounded-2xl shadow-sm relative z-10">
      <div class="flex flex-col">
        <span class="text-[10px] sm:text-xs font-bold text-slate-muted uppercase tracking-wider mb-0.5">Level</span>
        <span class="text-lg sm:text-xl font-extrabold text-ink tabular-nums leading-none" id="game-level">1</span>
      </div>
      <div class="flex flex-col items-center">
        <span class="text-[10px] sm:text-xs font-bold text-slate-muted uppercase tracking-wider mb-0.5">Lives</span>
        <div class="flex items-center gap-1 text-brand" id="game-lives">
          <!-- Populated by JS -->
        </div>
      </div>
      <div class="flex flex-col items-end">
        <span class="text-[10px] sm:text-xs font-bold text-slate-muted uppercase tracking-wider mb-0.5">Score</span>
        <span class="text-lg sm:text-xl font-extrabold text-brand tabular-nums leading-none" id="game-score">0</span>
      </div>
    </div>

    <!-- Central Grid -->
    <div class="flex-1 flex flex-col items-center justify-center relative">
      <div id="game-status" class="text-sm sm:text-base font-bold text-slate-muted mb-6 h-6 flex items-center justify-center transition-colors">
        Get ready...
      </div>

      <div class="grid grid-cols-3 gap-3 sm:gap-4 w-full max-w-[280px] sm:max-w-[320px] aspect-square mx-auto p-3 sm:p-4 bg-slate-50/50 rounded-3xl border border-border-line/50">
        <!-- 9 Tiles generated by JS -->
      </div>
    </div>
  </div>

  <!-- SCREEN 3: RESULTS SCREEN -->
  <div id="screen-results" class="hidden p-6 sm:p-10 text-center flex-col items-center justify-center h-full">
    <div class="w-20 h-20 rounded-3xl bg-card border-2 border-brand/20 flex items-center justify-center mb-6 shadow-md relative group-hover:scale-105 transition-transform duration-500">
      <div class="absolute inset-0 bg-brand/5 rounded-3xl"></div>
      <svg class="w-10 h-10 text-brand relative z-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
    </div>

    <h2 class="text-2xl sm:text-3xl font-extrabold text-ink tracking-tight mb-2">Training Complete</h2>
    <p class="text-slate-muted mb-8 text-sm sm:text-base">You've tested your spatial working memory.</p>

    <!-- Stats Grid -->
    <div class="grid grid-cols-2 gap-3 sm:gap-4 w-full max-w-sm mx-auto mb-8">
      <div class="bg-card border border-border-line/60 rounded-2xl p-4 flex flex-col items-center justify-center shadow-sm">
        <span class="text-[11px] sm:text-xs font-bold text-slate-muted uppercase tracking-wider mb-1">Final Score</span>
        <span class="text-2xl sm:text-3xl font-black text-ink tabular-nums leading-none" id="res-score">0</span>
      </div>
      <div class="bg-card border border-border-line/60 rounded-2xl p-4 flex flex-col items-center justify-center shadow-sm relative overflow-hidden">
        <div id="results-new-pb" class="hidden absolute top-0 inset-x-0 h-1 bg-green-500"></div>
        <span class="text-[11px] sm:text-xs font-bold text-slate-muted uppercase tracking-wider mb-1">Highest Level</span>
        <span class="text-2xl sm:text-3xl font-black text-brand tabular-nums leading-none" id="res-level">1</span>
      </div>
    </div>

    <div class="w-full max-w-xs mx-auto space-y-3">
      <button id="btn-restart" class="w-full py-4 bg-ink hover:bg-ink/90 text-white font-bold rounded-2xl shadow-sm transition-all transform hover:scale-[1.02] active:scale-[0.98] focus-ring">
        Play Again
      </button>
      <a href="/anti-brainrot" class="w-full py-3.5 bg-slate-100 hover:bg-slate-200 text-ink font-semibold rounded-2xl transition-all transform hover:scale-[1.02] active:scale-[0.98] focus-ring flex items-center justify-center">
        Back to Hub
      </a>
    </div>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    // Clean up any previous Memory Engine instance
    if ((window as any).__memoryEngineAbort) (window as any).__memoryEngineAbort.abort();
    const memAbort = new AbortController();
    (window as any).__memoryEngineAbort = memAbort;

    const container = document.getElementById('memory-container');
    if (!container) return;

    const STORAGE_KEY = 'studentkit_memory_v1';

    // Screens
    const screenIntro = container.querySelector('#screen-intro');
    const screenGame = container.querySelector('#screen-game');
    const screenResults = container.querySelector('#screen-results');

    // Elements
    const btnStart = container.querySelector('#btn-start');
    const btnRestart = container.querySelector('#btn-restart');
    const introPbBox = container.querySelector('#intro-pb-box');
    const introPbVal = container.querySelector('#intro-pb-val');

    const uiLevel = container.querySelector('#game-level');
    const uiScore = container.querySelector('#game-score');
    const uiLives = container.querySelector('#game-lives');
    const uiStatus = container.querySelector('#game-status');
    const gridContainer = container.querySelector('.grid');

    const resScore = container.querySelector('#res-score');
    const resLevel = container.querySelector('#res-level');
    const resNewPb = container.querySelector('#results-new-pb');

    // Game State
    let level = 1;
    let score = 0;
    let lives = 3;
    let sequence: number[] = [];
    let userProgress = 0;
    let gameState: 'intro' | 'showing' | 'recalling' | 'results' = 'intro';

    let playbackTimeout: number | null = null;
    const tileFeedbackTimeouts = new Map<number, number>();
    let lastClickedTileIndex: number | null = null;
    let lastClickTime = 0;
    let tiles: HTMLElement[] = [];

    // Cleanup timer on SPA navigation
    memAbort.signal.addEventListener('abort', () => {
      if (playbackTimeout) window.clearTimeout(playbackTimeout);
      tileFeedbackTimeouts.forEach(timeoutId => window.clearTimeout(timeoutId));
      tileFeedbackTimeouts.clear();
    });

    // Initialize Grid
    function createGrid() {
      if (!gridContainer) return;
      gridContainer.innerHTML = '';
      tiles = [];
      for (let i = 0; i < 9; i++) {
        const btn = document.createElement('button');
        btn.className = 'w-full h-full aspect-square rounded-2xl border-2 border-border-line/70 bg-card hover:bg-slate-50 transition-all duration-200 focus:outline-hidden transform active:scale-95 touch-manipulation cursor-default';
        btn.dataset.index = i.toString();

        btn.addEventListener('click', () => {
          if (gameState !== 'recalling') return;
          handleTileClick(i);
        }, { signal: memAbort.signal });

        gridContainer.appendChild(btn);
        tiles.push(btn);
      }
    }

    function loadPB() {
      try {
        const stored = localStorage.getItem(STORAGE_KEY);
        if (stored) {
          const pb = JSON.parse(stored);
          if (pb && pb.level) {
            introPbBox?.classList.remove('hidden');
            if (introPbVal) introPbVal.textContent = `Lvl ${pb.level}`;
            return pb;
          }
        }
      } catch (e) {}
      return { level: 0, score: 0 };
    }

    function savePB(newLevel: number, newScore: number) {
      try {
        const pb = loadPB();
        if (newLevel > pb.level || (newLevel === pb.level && newScore > pb.score)) {
          localStorage.setItem(STORAGE_KEY, JSON.stringify({ level: newLevel, score: newScore }));
          return true;
        }
      } catch (e) {}
      return false;
    }

    function updateUI() {
      if (uiLevel) uiLevel.textContent = level.toString();
      if (uiScore) uiScore.textContent = score.toString();

      if (uiLives) {
        uiLives.innerHTML = '';
        for (let i = 0; i < 3; i++) {
          const heart = document.createElement('span');
          heart.innerHTML = `<svg class="w-4 h-4 sm:w-5 sm:h-5 ${i < lives ? 'text-brand' : 'text-slate-200'}" fill="currentColor" viewBox="0 0 24 24"><path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z"/></svg>`;
          uiLives.appendChild(heart);
        }
      }
    }

    function setStatus(text: string, state: 'neutral' | 'success' | 'error' = 'neutral') {
      if (!uiStatus) return;
      uiStatus.textContent = text;
      uiStatus.className = 'text-sm sm:text-base font-bold mb-6 h-6 flex items-center justify-center transition-colors ' +
        (state === 'success' ? 'text-green-500' : state === 'error' ? 'text-red-500' : 'text-slate-muted');
    }

    function generateSequence() {
      const length = Math.floor((level - 1) / 2) + 3; // Starts at 3, increases every 2 levels
      sequence = [];
      let last = -1;
      for (let i = 0; i < length; i++) {
        let next;
        do {
          next = Math.floor(Math.random() * 9);
        } while (next === last);
        sequence.push(next);
        last = next;
      }
    }

    function highlightTile(index: number, duration: number, callback?: () => void) {
      const tile = tiles[index];
      if (!tile) {
        if (callback) callback();
        return;
      }

      tile.classList.remove('bg-card', 'border-border-line/70', 'hover:bg-slate-50');
      tile.classList.add('bg-brand', 'border-brand', 'scale-105', 'shadow-md');

      playbackTimeout = window.setTimeout(() => {
        tile.classList.add('bg-card', 'border-border-line/70', 'hover:bg-slate-50');
        tile.classList.remove('bg-brand', 'border-brand', 'scale-105', 'shadow-md');
        if (callback) {
          playbackTimeout = window.setTimeout(callback, 150); // Gap
        }
      }, duration);
    }

    function playSequence() {
      gameState = 'showing';
      userProgress = 0;
      updateUI();
      setStatus('Watch the sequence...', 'neutral');

      tiles.forEach(t => t.classList.remove('cursor-pointer'));
      tiles.forEach(t => t.classList.add('cursor-default'));

      let highlightDuration = 500;
      if (level >= 4) highlightDuration = 400;
      if (level >= 8) highlightDuration = 300;
      if (level >= 12) highlightDuration = 250;

      let i = 0;
      function nextHighlight() {
        if (i < sequence.length) {
          highlightTile(sequence[i], highlightDuration, () => {
            i++;
            nextHighlight();
          });
        } else {
          gameState = 'recalling';
          setStatus('Repeat the sequence', 'neutral');
          tiles.forEach(t => t.classList.remove('cursor-default'));
          tiles.forEach(t => t.classList.add('cursor-pointer'));
        }
      }

      playbackTimeout = window.setTimeout(nextHighlight, 800);
    }

    function handleTileClick(index: number) {
      if (gameState !== 'recalling') return;

      const now = Date.now();
      if (lastClickedTileIndex === index && now - lastClickTime < 50) {
        return;
      }
      lastClickedTileIndex = index;
      lastClickTime = now;

      const expected = sequence[userProgress];
      const tile = tiles[index];

      if (index === expected) {
        // Correct
        userProgress++;

        tile.classList.remove('bg-card', 'hover:bg-slate-50', 'border-border-line/70');
        tile.classList.add('bg-green-500', 'border-green-600');

        if (tileFeedbackTimeouts.has(index)) {
          window.clearTimeout(tileFeedbackTimeouts.get(index));
        }

        const tid = window.setTimeout(() => {
          tile.classList.add('bg-card', 'hover:bg-slate-50', 'border-border-line/70');
          tile.classList.remove('bg-green-500', 'border-green-600');
          tileFeedbackTimeouts.delete(index);
        }, 200);
        tileFeedbackTimeouts.set(index, tid);

        if (userProgress === sequence.length) {
          gameState = 'showing';
          score += level * 100;
          level++;
          setStatus('Perfect!', 'success');

          if (playbackTimeout) window.clearTimeout(playbackTimeout);
          playbackTimeout = window.setTimeout(() => {
            generateSequence();
            playSequence();
          }, 1000);
        }
      } else {
        // Incorrect
        gameState = 'showing';
        lives--;
        updateUI();

        tile.classList.remove('bg-card', 'hover:bg-slate-50', 'border-border-line/70');
        tile.classList.add('bg-red-500', 'border-red-600');

        if (tileFeedbackTimeouts.has(index)) {
          window.clearTimeout(tileFeedbackTimeouts.get(index));
        }

        const tid = window.setTimeout(() => {
          tile.classList.add('bg-card', 'hover:bg-slate-50', 'border-border-line/70');
          tile.classList.remove('bg-red-500', 'border-red-600');
          tileFeedbackTimeouts.delete(index);
        }, 400);
        tileFeedbackTimeouts.set(index, tid);

        if (lives > 0) {
          setStatus('Incorrect. Watch again.', 'error');
          if (playbackTimeout) window.clearTimeout(playbackTimeout);
          playbackTimeout = window.setTimeout(() => {
            playSequence();
          }, 1200);
        } else {
          setStatus('Game Over', 'error');
          if (playbackTimeout) window.clearTimeout(playbackTimeout);
          playbackTimeout = window.setTimeout(() => {
            finishSession();
          }, 1000);
        }
      }
    }

    function initSession() {
      if (playbackTimeout) window.clearTimeout(playbackTimeout);
      tileFeedbackTimeouts.forEach(timeoutId => window.clearTimeout(timeoutId));
      tileFeedbackTimeouts.clear();

      screenIntro?.classList.add('hidden');
      screenResults?.classList.add('hidden');
      screenGame?.classList.remove('hidden');
      screenGame?.classList.add('flex');

      level = 1;
      score = 0;
      lives = 3;
      userProgress = 0;
      lastClickedTileIndex = null;
      lastClickTime = 0;

      createGrid();
      updateUI();
      generateSequence();
      playSequence();
    }

    function finishSession() {
      if (playbackTimeout) window.clearTimeout(playbackTimeout);
      tileFeedbackTimeouts.forEach(timeoutId => window.clearTimeout(timeoutId));
      tileFeedbackTimeouts.clear();

      screenGame?.classList.add('hidden');
      screenGame?.classList.remove('flex');
      screenResults?.classList.remove('hidden');
      screenResults?.classList.add('flex');

      if (resScore) resScore.textContent = score.toString();
      if (resLevel) resLevel.textContent = level.toString();

      const isPb = savePB(level, score);
      if (isPb) {
        resNewPb?.classList.remove('hidden');
      } else {
        resNewPb?.classList.add('hidden');
      }
    }

    loadPB();

    if (btnStart) btnStart.addEventListener('click', initSession, { signal: memAbort.signal });
    if (btnRestart) btnRestart.addEventListener('click', initSession, { signal: memAbort.signal });
  });
</script>
