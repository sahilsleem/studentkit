---
export interface Props {
  moduleSlug: string;
  moduleTitle: string;
}

const { moduleSlug, moduleTitle } = Astro.props;
---

<div class="reveal has-ripple group bg-card/80 backdrop-blur-sm rounded-3xl border border-border-line/80 hover:border-brand hover:shadow-xl hover:-translate-y-1.5 hover:scale-[1.02] p-8 sm:p-12 text-center shadow-xs transition-all duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] overflow-hidden">
  <div class="w-16 h-16 rounded-2xl bg-brand-light/80 text-brand flex items-center justify-center mx-auto mb-6 group-hover:bg-gradient-to-br group-hover:from-violet-500 group-hover:to-teal-400 group-hover:text-white transition-all duration-300 group-hover:scale-110 group-hover:-rotate-3 shadow-xs">
    <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.67 2.67 0 0021 17.25l-5.83-5.83M3 3l18 18" />
    </svg>
  </div>

  <h2 class="text-2xl sm:text-3xl font-extrabold text-ink mb-3 tracking-tight group-hover:text-brand transition-colors duration-300">
    {moduleTitle}
  </h2>
  <p class="text-slate-muted max-w-md mx-auto mb-8 text-sm sm:text-base leading-relaxed">
    This training module is currently in final QA for Phase 2. Start with our live flagship Quick Math training session to begin your daily focus routine.
  </p>

  <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
    <a
      href="/anti-brainrot/quick-math"
      class="has-ripple w-full sm:w-auto px-6 py-3.5 bg-brand hover:bg-brand/90 text-white font-bold rounded-xl shadow-md shadow-brand/20 transition-all duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] transform active:scale-[0.98] hover:scale-[1.02] focus-ring text-sm"
    >
      ⚡ Train Quick Math Now
    </a>
    <a
      href="/anti-brainrot"
      class="has-ripple w-full sm:w-auto px-6 py-3.5 bg-slate-100 hover:bg-slate-200 text-ink font-semibold rounded-xl transition-all duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] transform active:scale-[0.98] hover:scale-[1.02] focus-ring text-sm"
    >
      Back to Training Hub
    </a>
  </div>
</div>