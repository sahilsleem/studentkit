            }

            incDecNote.textContent = `Note: Intervals represent numerical regions within [-100, 100] where f'(${v}) is positive (increasing) or negative (decreasing). Critical points and domain boundaries are excluded.`;
            incDecSec.classList.remove('hidden');
          }
        }
        else if (mode === 'extrema') {
          const d1 = math.derivative(expr, v);
          let d2 = null;
          try {
            d2 = math.derivative(d1, v);
          } catch {
            d2 = null;
          }
          labelStr = `f'(${v}) = df/d${v} =`;
          resultStr = math.simplify(d1).toString();

          const evalF = (val) => {
            try {
              const res = math.evaluate(expr, { [v]: val });
              return (typeof res === 'number' && isFinite(res)) ? res : null;
            } catch {
