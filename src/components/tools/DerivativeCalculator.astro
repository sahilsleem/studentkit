          const incIntervals = mergedIntervals.filter(i => i.type === 'increasing').map(formatInterval);
          const decIntervals = mergedIntervals.filter(i => i.type === 'decreasing').map(formatInterval);
          const constIntervals = mergedIntervals.filter(i => i.type === 'constant').map(formatInterval);

          if (incDecSec && incDecList && incDecNote) {
            incDecList.innerHTML = '';

            if (constIntervals.length > 0 && incIntervals.length === 0 && decIntervals.length === 0) {
