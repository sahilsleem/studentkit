          };

          const upIntervals = mergedIntervals.filter(i => i.type === 'up').map(formatInterval);
          const downIntervals = mergedIntervals.filter(i => i.type === 'down').map(formatInterval);
          const flatIntervals = mergedIntervals.filter(i => i.type === 'flat').map(formatInterval);

