            }
          };

          const evalD1 = (val) => {
            try {
              const res = d1.evaluate({ [v]: val });
              return (typeof res === 'number' && isFinite(res)) ? res : null;
            } catch {
              return null;
            }
          };

          const evalD2 = (val) => {
            try {
              if (d2) {
                const res = d2.evaluate({ [v]: val });
                if (typeof res === 'number' && isFinite(res)) return res;
              }
              const h = 1e-5;
              const dPlus = evalD1(val + h);
              const dMinus = evalD1(val - h);
              if (dPlus !== null && dMinus !== null) return (dPlus - dMinus) / (2 * h);
              return null;
            } catch {
              return null;
            }
          };

          const candidateRoots = findRoots(evalD1, -100, 100);
          const classifiedPoints = [];

          for (let i = 0; i < candidateRoots.length; i++) {
            const c = candidateRoots[i];
            const fc = evalF(c);
            if (fc === null) continue; // Skip non-finite / outside domain

            let delta = 0.01;
            if (i > 0) delta = Math.min(delta, Math.abs(c - candidateRoots[i - 1]) / 4);
            if (i < candidateRoots.length - 1) delta = Math.min(delta, Math.abs(candidateRoots[i + 1] - c) / 4);

            const dL = evalD1(c - delta);
            const dR = evalD1(c + delta);
            const d2Val = evalD2(c);

            let type = 'neither';
            if (dL !== null && dR !== null) {
              if (dL > 1e-6 && dR < -1e-6) {
                type = 'max';
              } else if (dL < -1e-6 && dR > 1e-6) {
                type = 'min';
              } else if (dL * dR > 0) {
                type = 'neither';
              } else if (d2Val !== null && Math.abs(d2Val) > 1e-5) {
                type = d2Val > 0 ? 'min' : 'max';
              } else {
                type = 'neither';
              }
            } else if (d2Val !== null && Math.abs(d2Val) > 1e-5) {
              type = d2Val > 0 ? 'min' : 'max';
            } else {
              type = 'neither';
            }

            classifiedPoints.push({ x: c, y: fc, type });
          }

          if (extremaSec && extremaList && extremaNote) {
            extremaList.innerHTML = '';
            if (classifiedPoints.length === 0) {
              extremaList.innerHTML = '<div class="p-3 bg-amber-50 rounded border border-amber-200 text-amber-800 text-sm">No local extrema found in the numerical search range [-100, 100].</div>';
              extremaNote.textContent = `Note: Local extrema occur at stationary points where f'(${v}) = 0 and f' changes sign. Function endpoints, vertical asymptotes, and non-differentiable cusps are excluded.`;
            } else {
              classifiedPoints.forEach((pt) => {
                const item = document.createElement('div');
                item.className = 'bg-white p-3 rounded-lg border border-gray-200 flex items-center justify-between text-sm shadow-sm';

                let badgeHtml = '';
                if (pt.type === 'max') {
                  badgeHtml = '<span class="ml-2 text-xs px-2 py-0.5 rounded font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200">Local Maximum</span>';
                } else if (pt.type === 'min') {
