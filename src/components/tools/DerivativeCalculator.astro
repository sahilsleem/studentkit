                upItem.className = 'bg-white p-3 rounded-lg border border-emerald-200 shadow-sm';
                upItem.innerHTML = `<div class="text-xs font-bold text-emerald-800 uppercase tracking-wide mb-1">Concave Up (f'' > 0)</div><div class="font-mono text-base font-bold text-emerald-900">${upIntervals.join(' ∪ ')}</div>`;
                concList.appendChild(upItem);
              }
              if (downIntervals.length > 0) {
                const downItem = document.createElement('div');
                downItem.className = 'bg-white p-3 rounded-lg border border-indigo-200 shadow-sm';
                downItem.innerHTML = `<div class="text-xs font-bold text-indigo-800 uppercase tracking-wide mb-1">Concave Down (f'' < 0)</div><div class="font-mono text-base font-bold text-indigo-900">${downIntervals.join(' ∪ ')}</div>`;
                concList.appendChild(downItem);
              }
            }

            concNote.textContent = `Note: Intervals represent numerical regions within [-100, 100] where f''(${v}) is positive (concave up) or negative (concave down). Points/intervals outside the function domain are excluded.`;
            concSec.classList.remove('hidden');
          }
        }
        else if (mode === 'increasing-decreasing') {
          const d1 = math.derivative(expr, v);
          labelStr = `f'(${v}) = df/d${v} =`;
          resultStr = math.simplify(d1).toString();

          const evalF = (val) => {
            try {
              const res = math.evaluate(expr, { [v]: val });
              return (typeof res === 'number' && isFinite(res)) ? res : null;
            } catch {
              return null;
            }
          };

          const evalD1 = (val) => {
            try {
              const res = d1.evaluate({ [v]: val });
              return (typeof res === 'number' && isFinite(res)) ? res : null;
            } catch {
              return null;
            }
          };

          const candidateRoots = findRoots(evalD1, -100, 100);

          // Discontinuity / domain boundary detection
          const discPoints = [];
          const scanSamples = [-100];
          for (let s = -99; s <= 100; s += 1) scanSamples.push(s);
          for (let s = -2; s <= 2; s += 0.1) scanSamples.push(Math.round(s * 10) / 10);
          scanSamples.sort((a, b) => a - b);

          let prevValid = evalF(scanSamples[0]) !== null && evalD1(scanSamples[0]) !== null;
          for (let i = 1; i < scanSamples.length; i++) {
            const currX = scanSamples[i];
            const currValid = evalF(currX) !== null && evalD1(currX) !== null;
            if (prevValid !== currValid) {
              let bA = scanSamples[i - 1], bB = currX;
              for (let k = 0; k < 20; k++) {
                const mid = (bA + bB) / 2;
                const vMid = evalF(mid) !== null && evalD1(mid) !== null;
                if (vMid === prevValid) bA = mid; else bB = mid;
              }
              const disc = Math.abs((bA + bB) / 2) < 1e-4 ? 0 : Math.round(((bA + bB) / 2) * 10000) / 10000;
              if (!discPoints.some(d => Math.abs(d - disc) < 0.05)) {
                discPoints.push(disc);
              }
            }
            prevValid = currValid;
          }

          // Combine partition boundaries
          const allBoundaries = [];
          for (const r of candidateRoots) {
            if (r > -100 && r < 100 && !allBoundaries.some(b => Math.abs(b - r) < 1e-3)) allBoundaries.push(r);
          }
          for (const d of discPoints) {
            if (d > -100 && d < 100 && !allBoundaries.some(b => Math.abs(b - d) < 1e-3)) allBoundaries.push(d);
          }
          allBoundaries.sort((a, b) => a - b);

          const partitionNodes = [-100, ...allBoundaries, 100];
          const rawIntervals = [];

          for (let i = 0; i < partitionNodes.length - 1; i++) {
            const start = partitionNodes[i];
            const end = partitionNodes[i + 1];
            if (Math.abs(end - start) < 1e-4) continue;

            const mid = (start + end) / 2;
            const fMid = evalF(mid);
            const d1Mid = evalD1(mid);

            if (fMid === null || d1Mid === null) {
              rawIntervals.push({ start, end, type: 'undefined' });
            } else if (d1Mid > 1e-6) {
              rawIntervals.push({ start, end, type: 'increasing' });
            } else if (d1Mid < -1e-6) {
              rawIntervals.push({ start, end, type: 'decreasing' });
            } else {
              rawIntervals.push({ start, end, type: 'constant' });
            }
          }

          // Merge contiguous intervals of identical type when domain is smooth across the boundary
          const mergedIntervals = [];
          for (const seg of rawIntervals) {
            if (seg.type === 'undefined') continue;
            if (mergedIntervals.length > 0) {
