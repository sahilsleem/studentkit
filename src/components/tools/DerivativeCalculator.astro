            } else if (incIntervals.length === 0 && decIntervals.length === 0) {
              incDecList.innerHTML = '<div class="p-3 bg-amber-50 rounded border border-amber-200 text-amber-800 text-sm">No valid increasing or decreasing intervals found in the searched numerical range [-100, 100].</div>';
            } else {
              if (incIntervals.length > 0) {
                const incItem = document.createElement('div');
                incItem.className = 'bg-white p-3 rounded-lg border border-emerald-200 shadow-sm';
                incItem.innerHTML = `<div class="text-xs font-bold text-emerald-800 uppercase tracking-wide mb-1">Increasing Intervals (f' > 0)</div><div class="font-mono text-base font-bold text-emerald-900">${incIntervals.join(' ∪ ')}</div>`;
                incDecList.appendChild(incItem);
              }
              if (decIntervals.length > 0) {
                const decItem = document.createElement('div');
                decItem.className = 'bg-white p-3 rounded-lg border border-indigo-200 shadow-sm';
                decItem.innerHTML = `<div class="text-xs font-bold text-indigo-800 uppercase tracking-wide mb-1">Decreasing Intervals (f' < 0)</div><div class="font-mono text-base font-bold text-indigo-900">${decIntervals.join(' ∪ ')}</div>`;
