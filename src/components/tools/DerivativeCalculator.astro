---
import { tools } from '../../data/registry';
const { tool } = Astro.props;

// Determine mode from slug
let mode = 'first'; // first, second, partial, implicit, marginal, critical, inflection, concavity, increasing-decreasing, extrema, logarithmic, optimization, related-rates
if (tool.slug.includes('second-derivative')) mode = 'second';
if (tool.slug.includes('partial-derivative')) mode = 'partial';
if (tool.slug.includes('implicit-differentiation')) mode = 'implicit';
if (tool.slug.includes('marginal')) mode = 'marginal';
if (tool.slug.includes('tangent') || tool.slug.includes('normal')) mode = 'tangent';
if (tool.slug.includes('critical-point')) mode = 'critical';
if (tool.slug.includes('inflection')) mode = 'inflection';
if (tool.slug.includes('concavity')) mode = 'concavity';
if (tool.slug.includes('increasing-decreasing')) mode = 'increasing-decreasing';
if (tool.slug.includes('extrema')) mode = 'extrema';
if (tool.slug.includes('logarithmic-differentiation')) mode = 'logarithmic';
if (tool.slug.includes('optimization')) mode = 'optimization';
if (tool.slug.includes('related-rates')) mode = 'related-rates';
---

<div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden max-w-3xl mx-auto">
  <div class="p-6 sm:p-8">
    <form id="deriv-form" class="space-y-5">
      {mode === 'related-rates' && (
        <div>
          <label for="rr-preset-select" class="block text-sm font-medium text-gray-700 mb-2">Preset Problem Model (Optional)</label>
          <select id="rr-preset-select" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-emerald-500 bg-white text-sm">
            <option value="custom">Custom Equation (General Solver)</option>
            <option value="circle_area">Circle Area: A = pi * r^2</option>
            <option value="sphere_volume">Sphere Volume: V = (4/3) * pi * r^3</option>
            <option value="sphere_surface">Sphere Surface Area: S = 4 * pi * r^2</option>
            <option value="pythagorean">Right Triangle / Ladder: x^2 + y^2 = z^2</option>
            <option value="cone_volume">Cone Volume: V = (1/3) * pi * r^2 * h</option>
            <option value="cylinder_volume">Cylinder Volume: V = pi * r^2 * h</option>
            <option value="rectangle_area">Rectangle Area: A = x * y</option>
          </select>
        </div>
      )}

      <div>
        <label for="fn-expr" class="block text-sm font-medium text-gray-700 mb-2">
          {mode === 'implicit' ? 'Equation F(x,y) = 0' : (mode === 'marginal' ? 'Cost/Revenue Function C(x)' : (mode === 'optimization' ? 'Objective Function f(x)' : (mode === 'related-rates' ? 'Governing Relationship / Equation' : 'Function f(x, y, ...)')))}
        </label>
        <div class="flex items-center gap-3">
          <span class="font-mono text-gray-500 font-bold">{mode === 'implicit' ? 'F(x,y) =' : (mode === 'marginal' ? 'C(x) =' : (mode === 'related-rates' ? 'Eq:' : 'f(...) ='))}</span>
          <input type="text" id="fn-expr" required class="flex-1 p-3 border border-gray-300 rounded-lg focus:ring-emerald-500 font-mono text-lg" placeholder={mode === 'implicit' ? 'x^2 + y^2 - 25' : (mode === 'logarithmic' ? 'x^x' : (mode === 'related-rates' ? 'A = pi * r^2' : (mode === 'critical' || mode === 'inflection' || mode === 'concavity' || mode === 'increasing-decreasing' || mode === 'extrema' || mode === 'optimization' ? 'x^3 - 3x' : 'x^2 * sin(x)')))}>
        </div>
        <p class="text-xs text-gray-500 mt-2">{mode === 'related-rates' ? 'Example: A = pi * r^2, x^2 + y^2 = z^2, V = (4/3)*pi*r^3' : 'Example: 2x^3 - 4x + 1, sin(x)*e^x, 1/x'}</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {mode !== 'implicit' && mode !== 'marginal' && mode !== 'related-rates' && (
          <div>
            <label for="fn-var" class="block text-sm font-medium text-gray-700 mb-2">Respect to Variable</label>
            <input type="text" id="fn-var" value="x" required class="w-full p-3 border border-gray-300 rounded-lg focus:ring-emerald-500 font-mono text-center">
          </div>
        )}

        {(mode === 'first' || mode === 'marginal' || mode === 'tangent' || mode === 'logarithmic') && (
          <div>
            <label for="fn-eval" class="block text-sm font-medium text-gray-700 mb-2">Evaluate at (Optional)</label>
            <input type="number" step="any" inputmode="decimal" id="fn-eval" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-emerald-500 font-mono text-center" placeholder="e.g. 2">
          </div>
        )}

        {mode === 'optimization' && (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 col-span-full">
            <div>
              <label for="opt-lower" class="block text-sm font-medium text-gray-700 mb-2">Interval Lower Bound a (Optional)</label>
              <input type="number" step="any" inputmode="decimal" id="opt-lower" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-emerald-500 font-mono text-center" placeholder="e.g. -5">
            </div>
            <div>
              <label for="opt-upper" class="block text-sm font-medium text-gray-700 mb-2">Interval Upper Bound b (Optional)</label>
              <input type="number" step="any" inputmode="decimal" id="opt-upper" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-emerald-500 font-mono text-center" placeholder="e.g. 5">
            </div>
          </div>
        )}

        {mode === 'related-rates' && (
          <div class="col-span-full space-y-4 pt-2 border-t border-gray-100">
            <div class="flex items-center justify-between">
              <h4 class="text-sm font-semibold text-gray-800">Known Values &amp; Known Rates (w.r.t. time t)</h4>
              <span class="text-xs text-gray-500">Auto-detected from equation</span>
            </div>
            <div id="rr-vars-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Dynamically rendered variable values and rates -->
            </div>
            <div>
              <label for="rr-target-select" class="block text-sm font-medium text-gray-700 mb-2">Target Rate to Solve For</label>
              <select id="rr-target-select" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-emerald-500 bg-white font-mono text-base font-semibold text-emerald-800">
                <!-- Dynamically populated -->
              </select>
            </div>
          </div>
        )}
      </div>

      <div class="pt-4">
        <button type="submit" class="w-full bg-emerald-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors shadow-sm cursor-pointer">
          {mode === 'critical' ? 'Find Critical Points' : (mode === 'inflection' ? 'Find Inflection Points' : (mode === 'concavity' ? 'Analyze Concavity' : (mode === 'increasing-decreasing' ? 'Find Increasing/Decreasing Intervals' : (mode === 'extrema' ? 'Find Local Extrema' : (mode === 'logarithmic' ? 'Differentiate Using Logarithms' : (mode === 'optimization' ? 'Optimize Function' : (mode === 'related-rates' ? 'Solve Related Rates' : 'Calculate Derivative')))))))}
        </button>
      </div>
    </form>

    <div id="deriv-result" class="mt-8 pt-6 border-t border-gray-100 hidden" aria-live="polite">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-lg font-semibold text-gray-900">Result</h3>
        <button
          type="button"
          id="deriv-copy-btn"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-emerald-700 bg-white hover:bg-emerald-50 active:bg-emerald-100 border border-emerald-200 rounded-md transition-colors shadow-xs focus:outline-none focus:ring-2 focus:ring-emerald-500 cursor-pointer"
          aria-label="Copy derivative result to clipboard"
        >
          <svg class="w-3.5 h-3.5 copy-icon text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
          </svg>
          <span class="copy-text">Copy Result</span>
        </button>
      </div>

      <div id="deriv-err" class="hidden bg-red-50 text-red-700 p-4 rounded-lg text-sm font-medium border border-red-100 mb-4"></div>

      <div id="deriv-ans" class="bg-gray-50 p-6 rounded-xl border border-gray-200 overflow-x-auto">
        <div class="flex flex-col gap-4">
          <div class="text-gray-600 font-mono text-sm" id="ans-label"></div>
          <div class="text-2xl font-bold font-mono text-gray-900 whitespace-nowrap" id="ans-val"></div>
          <div id="eval-section" class="hidden mt-4 pt-4 border-t border-gray-200">
            <div class="text-gray-600 font-mono text-sm" id="eval-label"></div>
            <div class="text-xl font-bold font-mono text-emerald-700" id="eval-val"></div>
          </div>
          <div id="tangent-section" class="hidden mt-4 pt-4 border-t border-gray-200 space-y-3">
             <div class="bg-white p-3 rounded border border-gray-200">
               <p class="text-xs text-gray-500 uppercase mb-1 font-bold">Tangent Line</p>
               <p class="font-mono text-lg font-bold text-indigo-700" id="tangent-eq"></p>
             </div>
             <div class="bg-white p-3 rounded border border-gray-200">
               <p class="text-xs text-gray-500 uppercase mb-1 font-bold">Normal Line</p>
               <p class="font-mono text-lg font-bold text-purple-700" id="normal-eq"></p>
             </div>
          </div>
          <div id="critical-section" class="hidden mt-4 pt-4 border-t border-gray-200 space-y-3">
             <div class="flex items-center justify-between">
               <p class="text-xs text-gray-500 uppercase font-bold tracking-wide">Stationary Critical Points</p>
               <span class="text-xs text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 font-medium">Numerical search [-100, 100]</span>
             </div>
             <div id="critical-points-list" class="space-y-2"></div>
             <p id="critical-note" class="text-xs text-gray-500 italic mt-2"></p>
          </div>
          <div id="inflection-section" class="hidden mt-4 pt-4 border-t border-gray-200 space-y-3">
             <div class="flex items-center justify-between">
               <p class="text-xs text-gray-500 uppercase font-bold tracking-wide">Inflection Points</p>
               <span class="text-xs text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 font-medium">Numerical search [-100, 100]</span>
             </div>
             <div id="inflection-points-list" class="space-y-2"></div>
             <p id="inflection-note" class="text-xs text-gray-500 italic mt-2"></p>
          </div>
          <div id="concavity-section" class="hidden mt-4 pt-4 border-t border-gray-200 space-y-3">
             <div class="flex items-center justify-between">
               <p class="text-xs text-gray-500 uppercase font-bold tracking-wide">Concavity Intervals</p>
               <span class="text-xs text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 font-medium">Numerical search [-100, 100]</span>
             </div>
             <div id="concavity-intervals-list" class="space-y-2"></div>
             <p id="concavity-note" class="text-xs text-gray-500 italic mt-2"></p>
          </div>
          <div id="inc-dec-section" class="hidden mt-4 pt-4 border-t border-gray-200 space-y-3">
             <div class="flex items-center justify-between">
               <p class="text-xs text-gray-500 uppercase font-bold tracking-wide">Monotonicity Intervals</p>
               <span class="text-xs text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 font-medium">Numerical search [-100, 100]</span>
             </div>
             <div id="inc-dec-intervals-list" class="space-y-2"></div>
             <p id="inc-dec-note" class="text-xs text-gray-500 italic mt-2"></p>
          </div>
          <div id="extrema-section" class="hidden mt-4 pt-4 border-t border-gray-200 space-y-3">
             <div class="flex items-center justify-between">
               <p class="text-xs text-gray-500 uppercase font-bold tracking-wide">Local Extrema</p>
               <span class="text-xs text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 font-medium">Numerical search [-100, 100]</span>
             </div>
             <div id="extrema-points-list" class="space-y-2"></div>
             <p id="extrema-note" class="text-xs text-gray-500 italic mt-2"></p>
          </div>
          <div id="log-diff-section" class="hidden mt-4 pt-4 border-t border-gray-200 space-y-4">
             <div class="flex items-center justify-between">
               <p class="text-xs text-gray-500 uppercase font-bold tracking-wide">Logarithmic Differentiation Steps</p>
               <span class="text-xs text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 font-medium">Step-by-Step Method</span>
             </div>
             <div id="log-diff-steps" class="space-y-3 font-mono text-sm"></div>
             <div id="log-diff-domain-note" class="hidden p-3 bg-amber-50 rounded border border-amber-200 text-amber-800 text-xs"></div>
             <div id="log-diff-app-note" class="hidden p-3 bg-blue-50 rounded border border-blue-200 text-blue-800 text-xs"></div>
          </div>
          <div id="optimization-section" class="hidden mt-4 pt-4 border-t border-gray-200 space-y-4">
             <div class="flex items-center justify-between">
               <p class="text-xs text-gray-500 uppercase font-bold tracking-wide">Optimization Analysis</p>
               <span id="opt-badge" class="text-xs text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 font-medium">Closed Interval Method</span>
             </div>
             <div id="opt-discontinuity-warning" class="hidden p-3 bg-amber-50 rounded border border-amber-200 text-amber-800 text-xs font-medium"></div>
             <div id="opt-global-cards" class="grid grid-cols-1 sm:grid-cols-2 gap-3"></div>
             <div id="opt-local-section" class="hidden space-y-2">
               <p class="text-xs text-gray-500 uppercase font-bold tracking-wide">Local Extrema in Search Region [-100, 100]</p>
               <div id="opt-local-list" class="space-y-2"></div>
             </div>
             <div id="opt-candidates-section" class="space-y-2">
               <p class="text-xs text-gray-500 uppercase font-bold tracking-wide">Evaluated Candidates</p>
               <div id="opt-candidates-list" class="space-y-2"></div>
             </div>
             <p id="opt-note" class="text-xs text-gray-500 italic mt-2"></p>
          </div>
          <div id="related-rates-section" class="hidden mt-4 pt-4 border-t border-gray-200 space-y-4">
            <div class="flex items-center justify-between">
              <p class="text-xs text-gray-500 uppercase font-bold tracking-wide">Related Rates Solution</p>
              <span class="text-xs text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 font-medium">Chain Rule &amp; Implicit Differentiation</span>
            </div>
            <div id="rr-steps-list" class="space-y-3 font-mono text-sm"></div>
            <div id="rr-interpretation-note" class="p-3 bg-blue-50 rounded border border-blue-200 text-blue-800 text-xs"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div id="deriv-config" data-mode={mode} class="hidden"></div>
<script>
  const mode = document.getElementById('deriv-config')?.getAttribute('data-mode') || 'first';
  import * as math from 'mathjs';
  import { formatResultNumber, copyToClipboard } from '../../utils/formatters';

  const initDeriv = () => {
    const form = document.getElementById('deriv-form') as HTMLFormElement;
    const exprIn = document.getElementById('fn-expr') as HTMLInputElement;
    const varIn = document.getElementById('fn-var') as HTMLInputElement;
    const evalIn = document.getElementById('fn-eval') as HTMLInputElement;

    const resSec = document.getElementById('deriv-result');
    const errBox = document.getElementById('deriv-err');
    const ansBox = document.getElementById('deriv-ans');
    const ansLabel = document.getElementById('ans-label');
    const ansVal = document.getElementById('ans-val');
    const copyBtn = document.getElementById('deriv-copy-btn');
    const evalSec = document.getElementById('eval-section');
    const evalLabel = document.getElementById('eval-label');
    const evalVal = document.getElementById('eval-val');

    const tangSec = document.getElementById('tangent-section');
    const tangEq = document.getElementById('tangent-eq');
    const normEq = document.getElementById('normal-eq');

    if (!form || !exprIn) return;

    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        const valText = ansVal?.textContent?.trim() || '';
        if (!valText) return;
        const lblText = ansLabel?.textContent?.trim() || 'Result';
        let copyText = `${lblText} ${valText}`;
        if (evalSec && !evalSec.classList.contains('hidden') && evalVal?.textContent) {
          copyText += `\n${evalLabel?.textContent || 'Evaluated'}: ${evalVal.textContent}`;
        }

        const success = await copyToClipboard(copyText);
        if (success) {
          const copyTextEl = copyBtn.querySelector('.copy-text');
          const originalText = copyTextEl ? copyTextEl.textContent : 'Copy Result';
          if (copyTextEl) copyTextEl.textContent = 'Copied!';
          copyBtn.classList.add('bg-emerald-100', 'text-emerald-800');
          setTimeout(() => {
            if (copyTextEl) copyTextEl.textContent = originalText;
            copyBtn.classList.remove('bg-emerald-100', 'text-emerald-800');
          }, 2000);
        }
      });
    }

    const critSec = document.getElementById('critical-section');
    const critList = document.getElementById('critical-points-list');
    const critNote = document.getElementById('critical-note');

    const inflSec = document.getElementById('inflection-section');
    const inflList = document.getElementById('inflection-points-list');
    const inflNote = document.getElementById('inflection-note');

    const concSec = document.getElementById('concavity-section');
    const concList = document.getElementById('concavity-intervals-list');
    const concNote = document.getElementById('concavity-note');

    const incDecSec = document.getElementById('inc-dec-section');
    const incDecList = document.getElementById('inc-dec-intervals-list');
    const incDecNote = document.getElementById('inc-dec-note');

    const extremaSec = document.getElementById('extrema-section');
    const extremaList = document.getElementById('extrema-points-list');
    const extremaNote = document.getElementById('extrema-note');

    const logDiffSec = document.getElementById('log-diff-section');
    const logDiffSteps = document.getElementById('log-diff-steps');
    const logDiffDomainNote = document.getElementById('log-diff-domain-note');
    const logDiffAppNote = document.getElementById('log-diff-app-note');

    const optLowerIn = document.getElementById('opt-lower');
    const optUpperIn = document.getElementById('opt-upper');
    const optSec = document.getElementById('optimization-section');
    const optBadge = document.getElementById('opt-badge');
    const optDiscWarning = document.getElementById('opt-discontinuity-warning');
    const optGlobalCards = document.getElementById('opt-global-cards');
    const optLocalSec = document.getElementById('opt-local-section');
    const optLocalList = document.getElementById('opt-local-list');
    const optCandSec = document.getElementById('opt-candidates-section');
    const optCandList = document.getElementById('opt-candidates-list');
    const optNote = document.getElementById('opt-note');

    const rrPresetSelect = document.getElementById('rr-preset-select') as HTMLSelectElement | null;
    const rrVarsGrid = document.getElementById('rr-vars-grid');
    const rrTargetSelect = document.getElementById('rr-target-select') as HTMLSelectElement | null;
    const rrSec = document.getElementById('related-rates-section');
    const rrStepsList = document.getElementById('rr-steps-list');
    const rrInterpNote = document.getElementById('rr-interpretation-note');

    if (!form) return;

    const cleanExpr = (str) => {
      return str.replace(/(\d)([a-zA-Z])/g, '$1*$2'); // Fix implicit mult 2x -> 2*x
    };

    const findRoots = (evalDerivFn, searchMin = -100, searchMax = 100) => {
      const refineRoot = (x1, x2) => {
        let y1 = evalDerivFn(x1), y2 = evalDerivFn(x2);
        if (y1 === null || y2 === null) return null;
        if (Math.abs(y1) < 1e-10) return x1;
        if (Math.abs(y2) < 1e-10) return x2;

        let a = x1, b = x2, fa = y1, fb = y2;
        if (fa * fb <= 0) {
          for (let i = 0; i < 50; i++) {
            const mid = (a + b) / 2;
            const fmid = evalDerivFn(mid);
            if (fmid === null) break;
            if (Math.abs(fmid) < 1e-10 || (b - a) / 2 < 1e-10) return mid;
            if (fa * fmid <= 0) { b = mid; fb = fmid; } else { a = mid; fa = fmid; }
          }
          return (a + b) / 2;
        } else {
          let xCurr = (x1 + x2) / 2;
          for (let i = 0; i < 30; i++) {
            const fx = evalDerivFn(xCurr);
            if (fx === null) break;
            if (Math.abs(fx) < 1e-10) return xCurr;
            const h = 1e-5;
            const dPlus = evalDerivFn(xCurr + h);
            const dMinus = evalDerivFn(xCurr - h);
            if (dPlus === null || dMinus === null) break;
            const dfx = (dPlus - dMinus) / (2 * h);
            if (Math.abs(dfx) < 1e-12) break;
            const step = fx / dfx;
            xCurr -= step;
            if (Math.abs(step) < 1e-10) break;
          }
          const valAtRoot = evalDerivFn(xCurr);
          if (valAtRoot !== null && Math.abs(valAtRoot) < 1e-6) {
            const left = evalDerivFn(xCurr - 0.01);
            const right = evalDerivFn(xCurr + 0.01);
            if (left !== null && right !== null) {
              if (left * right > 0 && Math.abs(valAtRoot) < Math.abs(left) * 0.1 && Math.abs(valAtRoot) < Math.abs(right) * 0.1) {
                return xCurr;
              }
            }
          }
          return null;
        }
      };

      const rawRoots = [];
      const scanRegions = [
        { start: -5, end: 5, step: 0.02 },
        { start: -50, end: -5, step: 0.1 },
        { start: 5, end: 50, step: 0.1 },
        { start: searchMin, end: -50, step: 0.5 },
        { start: 50, end: searchMax, step: 0.5 }
      ];

      for (const region of scanRegions) {
        let prevX = region.start;
        let prevY = evalDerivFn(prevX);
        for (let x = region.start + region.step; x <= region.end; x += region.step) {
          const y = evalDerivFn(x);
          if (y === null || prevY === null) { prevX = x; prevY = y; continue; }
          if (prevY * y <= 0) {
            const r = refineRoot(prevX, x);
            if (r !== null && isFinite(r)) rawRoots.push(r);
          } else if (Math.abs(y) < 0.05 && (prevY - y) * (y - (evalDerivFn(x + region.step) || y)) <= 0) {
            const r = refineRoot(prevX, x + region.step);
            if (r !== null && isFinite(r)) rawRoots.push(r);
          }
          prevX = x;
          prevY = y;
        }
      }

      const uniqueRoots = [];
      rawRoots.sort((a, b) => a - b);
      for (const r of rawRoots) {
        const cleaned = Math.abs(r) < 1e-6 ? 0 : Math.round(r * 1e6) / 1e6;
        if (!uniqueRoots.some(ex => Math.abs(ex - cleaned) < 1e-3)) {
          const dVal = evalDerivFn(cleaned);
          if (dVal !== null && Math.abs(dVal) < 1e-4) {
            uniqueRoots.push(cleaned);
          }
        }
      }
      return uniqueRoots;
    };

    const fmt = (num) => {
      if (Math.abs(num) < 1e-9) return '0';
      const rounded = Math.round(num * 10000) / 10000;
      return String(rounded);
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      errBox.classList.add('hidden');
      ansBox.classList.remove('hidden');
      evalSec.classList.add('hidden');
      if (tangSec) tangSec.classList.add('hidden');
