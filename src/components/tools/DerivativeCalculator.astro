                  badgeHtml = '<span class="ml-2 text-xs px-2 py-0.5 rounded font-semibold bg-gray-100 text-gray-700 border border-gray-200">Stationary Point (Neither)</span>';
                }

                item.innerHTML = `<div><span class="text-gray-500 font-mono text-xs">${v} =</span> <strong class="font-mono text-gray-900 text-base">${fmt(pt.x)}</strong>${badgeHtml}</div><div class="font-mono font-bold text-gray-800 bg-gray-50 px-3 py-1 rounded border border-gray-200">Point: (${fmt(pt.x)}, ${fmt(pt.y)})</div>`;
                extremaList.appendChild(item);
              });
              extremaNote.textContent = `Found ${classifiedPoints.length} stationary point(s) classified using the First and Second Derivative Tests within [-100, 100].`;
            }
            extremaSec.classList.remove('hidden');
          }
        }
        else if (mode === 'logarithmic') {
          const parsed = math.parse(expr);

          const unwrapParens = (node) => {
            let curr = node;
            while (curr && curr.isParenthesisNode) {
              curr = curr.content;
            }
            return curr;
          };

          const rootNode = unwrapParens(parsed);

          let step1 = '';
          let step2 = '';
          let step3 = '';
          let step4 = '';
          let domainNoteText = '';
          let appNoteText = '';
          let isPower = false;
          let isQuotient = false;
          let isProduct = false;

          let baseNode = null;
          let expNode = null;
          let numNode = null;
          let denNode = null;
          let leftNode = null;
          let rightNode = null;

          if (rootNode.isOperatorNode && rootNode.op === '^') {
            isPower = true;
            baseNode = unwrapParens(rootNode.args[0]);
            expNode = unwrapParens(rootNode.args[1]);

            const uStr = baseNode.toString();
            const vStr = expNode.toString();

            const uDeriv = math.derivative(baseNode, v);
            const vDeriv = math.derivative(expNode, v);

            const uDerivStr = math.simplify(uDeriv).toString();
            const vDerivStr = math.simplify(vDeriv).toString();

            step1 = `y = (${uStr})^(${vStr})`;
            step2 = `ln(y) = (${vStr}) * ln(${uStr})`;

            let term1 = '';
            if (vDerivStr === '1') {
              term1 = `ln(${uStr})`;
            } else if (vDerivStr === '0') {
              term1 = '0';
            } else {
              term1 = `(${vDerivStr}) * ln(${uStr})`;
            }

            let term2 = '';
            if (uDerivStr === '1') {
              term2 = `(${vStr}) / (${uStr})`;
            } else if (uDerivStr === '0') {
              term2 = '0';
            } else {
              term2 = `[(${vStr}) * (${uDerivStr})] / (${uStr})`;
            }

            let rhsLogDeriv = '';
            if (term1 === '0' && term2 === '0') rhsLogDeriv = '0';
            else if (term1 === '0') rhsLogDeriv = term2;
            else if (term2 === '0') rhsLogDeriv = term1;
            else rhsLogDeriv = `${term1} + ${term2}`;

            step3 = `y'/y = ${rhsLogDeriv}`;
            step4 = `y' = (${uStr})^(${vStr}) * [${rhsLogDeriv}]`;

            labelStr = `f'(${v}) = df/d${v} =`;
            resultStr = `(${uStr})^(${vStr}) * [${rhsLogDeriv}]`;
            domainNoteText = `Note: Real-valued logarithmic differentiation requires the base u(${v}) = ${uStr} > 0.`;
          } else if (rootNode.isOperatorNode && rootNode.op === '/') {
            isQuotient = true;
            numNode = unwrapParens(rootNode.args[0]);
            denNode = unwrapParens(rootNode.args[1]);

            const uStr = numNode.toString();
            const vStr = denNode.toString();

            const uDeriv = math.derivative(numNode, v);
            const vDeriv = math.derivative(denNode, v);

            const uDerivStr = math.simplify(uDeriv).toString();
            const vDerivStr = math.simplify(vDeriv).toString();

            step1 = `y = (${uStr}) / (${vStr})`;
            step2 = `ln(y) = ln(${uStr}) - ln(${vStr})`;
            step3 = `y'/y = (${uDerivStr})/(${uStr}) - (${vDerivStr})/(${vStr})`;
            step4 = `y' = [(${uStr})/(${vStr})] * [(${uDerivStr})/(${uStr}) - (${vDerivStr})/(${vStr})]`;

            labelStr = `f'(${v}) = df/d${v} =`;
            try {
              const fullD = math.derivative(expr, v);
              resultStr = math.simplify(fullD).toString();
            } catch {
              resultStr = `[(${uStr})/(${vStr})] * [(${uDerivStr})/(${uStr}) - (${vDerivStr})/(${vStr})]`;
            }
            domainNoteText = `Note: Logarithmic differentiation assumes positive numerator and denominator (${uStr} > 0 and ${vStr} > 0).`;
          } else if (rootNode.isOperatorNode && rootNode.op === '*') {
            isProduct = true;
            leftNode = unwrapParens(rootNode.args[0]);
            rightNode = unwrapParens(rootNode.args[1]);

            const uStr = leftNode.toString();
            const vStr = rightNode.toString();

            const uDeriv = math.derivative(leftNode, v);
            const vDeriv = math.derivative(rightNode, v);

            const uDerivStr = math.simplify(uDeriv).toString();
            const vDerivStr = math.simplify(vDeriv).toString();

            step1 = `y = (${uStr}) * (${vStr})`;
            step2 = `ln(y) = ln(${uStr}) + ln(${vStr})`;
            step3 = `y'/y = (${uDerivStr})/(${uStr}) + (${vDerivStr})/(${vStr})`;
            step4 = `y' = [(${uStr}) * (${vStr})] * [(${uDerivStr})/(${uStr}) + (${vDerivStr})/(${vStr})]`;

            labelStr = `f'(${v}) = df/d${v} =`;
            try {
              const fullD = math.derivative(expr, v);
              resultStr = math.simplify(fullD).toString();
            } catch {
              resultStr = `[(${uStr})*(${vStr})] * [(${uDerivStr})/(${uStr}) + (${vDerivStr})/(${vStr})]`;
            }
            domainNoteText = `Note: Logarithmic differentiation assumes positive factors (${uStr} > 0 and ${vStr} > 0).`;
          } else {
            const fStr = rootNode.toString();
            const fDeriv = math.derivative(rootNode, v);
            const fDerivStr = math.simplify(fDeriv).toString();

            step1 = `y = ${fStr}`;
            step2 = `ln(y) = ln(${fStr})`;
            step3 = `y'/y = (${fDerivStr}) / (${fStr})`;
            step4 = `y' = (${fStr}) * [(${fDerivStr}) / (${fStr})] = ${fDerivStr}`;

            labelStr = `f'(${v}) = df/d${v} =`;
            resultStr = fDerivStr;
            appNoteText = `Logarithmic differentiation is especially useful for powers with variable exponents, complex products, and quotients. For this expression, the logarithmic identity yields the standard derivative f'(${v}) = ${fDerivStr}.`;
          }

          if (logDiffSec && logDiffSteps) {
            logDiffSteps.innerHTML = `
              <div class="bg-white p-3 rounded-lg border border-gray-200 shadow-sm space-y-1">
                <div class="text-xs font-bold text-gray-500 uppercase tracking-wide">Step 1 — Set up equation</div>
                <div class="text-base font-bold text-gray-900 font-mono">${step1}</div>
              </div>
              <div class="bg-white p-3 rounded-lg border border-gray-200 shadow-sm space-y-1">
                <div class="text-xs font-bold text-gray-500 uppercase tracking-wide">Step 2 — Take natural logarithm of both sides</div>
                <div class="text-base font-bold text-gray-900 font-mono">${step2}</div>
              </div>
              <div class="bg-white p-3 rounded-lg border border-gray-200 shadow-sm space-y-1">
                <div class="text-xs font-bold text-gray-500 uppercase tracking-wide">Step 3 — Differentiate implicitly with respect to ${v}</div>
                <div class="text-base font-bold text-gray-900 font-mono">${step3}</div>
              </div>
              <div class="bg-white p-3 rounded-lg border border-emerald-200 shadow-sm space-y-1 bg-emerald-50/30">
                <div class="text-xs font-bold text-emerald-800 uppercase tracking-wide">Step 4 — Multiply by y to isolate y'</div>
                <div class="text-base font-bold text-emerald-900 font-mono">${step4}</div>
              </div>
            `;

            if (domainNoteText && logDiffDomainNote) {
              logDiffDomainNote.textContent = domainNoteText;
              logDiffDomainNote.classList.remove('hidden');
            }
            if (appNoteText && logDiffAppNote) {
              logDiffAppNote.textContent = appNoteText;
              logDiffAppNote.classList.remove('hidden');
            }

            logDiffSec.classList.remove('hidden');
          }

          if (evalAt !== '') {
            const xVal = parseFloat(evalAt);
            if (isNaN(xVal)) {
              evalLabel.textContent = `Evaluation at ${v} = ${evalAt}`;
              evalVal.textContent = 'Invalid evaluation number.';
              evalSec.classList.remove('hidden');
            } else {
              const scope = { [v]: xVal, e: Math.E, pi: Math.PI };
              try {
                const yc = math.evaluate(expr, scope);
                if (typeof yc !== 'number' || !isFinite(yc)) {
                  evalLabel.textContent = `Evaluation at ${v} = ${xVal}`;
                  evalVal.textContent = `f(${xVal}) is undefined or non-finite.`;
                  evalSec.classList.remove('hidden');
                } else if (isPower) {
                  const uVal = baseNode.evaluate(scope);
                  if (typeof uVal !== 'number' || uVal <= 0) {
                    evalLabel.textContent = `Evaluation at ${v} = ${xVal}`;
                    evalVal.textContent = `Base u(${xVal}) = ${fmt(uVal)} ≤ 0. Real-valued logarithmic differentiation is undefined for non-positive bases.`;
                    evalSec.classList.remove('hidden');
                  } else {
                    const vVal = expNode.evaluate(scope);
                    const uPrime = math.derivative(baseNode, v).evaluate(scope);
                    const vPrime = math.derivative(expNode, v).evaluate(scope);
                    const logDerivVal = vPrime * Math.log(uVal) + (vVal * uPrime) / uVal;
                    const dyVal = yc * logDerivVal;

                    evalLabel.textContent = `Evaluated at ${v} = ${xVal}`;
                    evalVal.textContent = `f(${xVal}) = ${fmt(yc)},   f'(${xVal}) = ${fmt(dyVal)}`;
                    evalSec.classList.remove('hidden');
                  }
                } else if (isQuotient) {
                  const uVal = numNode.evaluate(scope);
                  const vVal = denNode.evaluate(scope);
                  if (vVal === 0) {
                    evalLabel.textContent = `Evaluation at ${v} = ${xVal}`;
                    evalVal.textContent = `Denominator is 0 at ${v} = ${xVal} (vertical asymptote).`;
                    evalSec.classList.remove('hidden');
                  } else if (uVal <= 0 || vVal <= 0) {
                    evalLabel.textContent = `Evaluation at ${v} = ${xVal}`;
                    evalVal.textContent = `Logarithmic transformation requires positive arguments (${fmt(uVal)} > 0 and ${fmt(vVal)} > 0). Outside positive domain.`;
                    evalSec.classList.remove('hidden');
                  } else {
                    const uPrime = math.derivative(numNode, v).evaluate(scope);
                    const vPrime = math.derivative(denNode, v).evaluate(scope);
                    const logDerivVal = uPrime / uVal - vPrime / vVal;
                    const dyVal = yc * logDerivVal;

                    evalLabel.textContent = `Evaluated at ${v} = ${xVal}`;
                    evalVal.textContent = `f(${xVal}) = ${fmt(yc)},   f'(${xVal}) = ${fmt(dyVal)}`;
                    evalSec.classList.remove('hidden');
                  }
                } else {
                  if (yc <= 0) {
                    evalLabel.textContent = `Evaluation at ${v} = ${xVal}`;
                    evalVal.textContent = `f(${xVal}) = ${fmt(yc)} ≤ 0. Real logarithm ln(f(${xVal})) is undefined.`;
                    evalSec.classList.remove('hidden');
                  } else {
                    const fPrime = math.derivative(expr, v).evaluate(scope);
                    evalLabel.textContent = `Evaluated at ${v} = ${xVal}`;
                    evalVal.textContent = `f(${xVal}) = ${fmt(yc)},   f'(${xVal}) = ${fmt(fPrime)}`;
                    evalSec.classList.remove('hidden');
                  }
                }
              } catch (evalErr) {
                evalLabel.textContent = `Evaluation at ${v} = ${xVal}`;
                evalVal.textContent = `Error during evaluation: ${evalErr.message}`;
                evalSec.classList.remove('hidden');
              }
            }
          }
        }
        else if (mode === 'optimization') {
          const lowerValStr = optLowerIn ? optLowerIn.value.trim() : '';
          const upperValStr = optUpperIn ? optUpperIn.value.trim() : '';

          const hasLower = lowerValStr !== '';
          const hasUpper = upperValStr !== '';

          if ((hasLower && !hasUpper) || (!hasLower && hasUpper)) {
            throw new Error('Please provide both lower and upper bounds for interval optimization, or leave both empty for local search.');
          }

          let isClosedInterval = false;
          let a = -100, b = 100;
          if (hasLower && hasUpper) {
            a = parseFloat(lowerValStr);
            b = parseFloat(upperValStr);
            if (isNaN(a) || isNaN(b) || !isFinite(a) || !isFinite(b)) {
              throw new Error('Interval bounds must be valid real numbers.');
            }
            if (a >= b) {
              throw new Error(`Lower bound a (${a}) must be strictly less than upper bound b (${b}).`);
            }
            isClosedInterval = true;
          }

          const d1 = math.derivative(expr, v);
          let d2 = null;
          try { d2 = math.derivative(d1, v); } catch { d2 = null; }

          labelStr = `f'(${v}) = df/d${v} =`;
          resultStr = math.simplify(d1).toString();

          const evalF = (val) => {
            try {
              const res = math.evaluate(expr, { [v]: val, e: Math.E, pi: Math.PI });
              return (typeof res === 'number' && isFinite(res)) ? res : null;
            } catch {
              return null;
            }
          };

          const evalD1 = (val) => {
            try {
              const res = d1.evaluate({ [v]: val, e: Math.E, pi: Math.PI });
              return (typeof res === 'number' && isFinite(res)) ? res : null;
            } catch {
              return null;
            }
          };

          const evalD2 = (val) => {
            try {
              if (d2) {
                const res = d2.evaluate({ [v]: val, e: Math.E, pi: Math.PI });
                if (typeof res === 'number' && isFinite(res)) return res;
              }
              const h = 1e-5;
              const dPlus = evalD1(val + h);
              const dMinus = evalD1(val - h);
              if (dPlus !== null && dMinus !== null) return (dPlus - dMinus) / (2 * h);
              return null;
            } catch {
              return null;
            }
          };

          let hasDiscontinuity = false;
          if (isClosedInterval) {
            const N = 200;
            const dt = (b - a) / N;
            let prevX = a;
            let prevY = evalF(a);
            let prevD = evalD1(a);

            if (prevY === null || !isFinite(prevY) || prevD === null || !isFinite(prevD)) {
              hasDiscontinuity = true;
            } else {
              for (let i = 1; i <= N; i++) {
                const currX = a + i * dt;
                const currY = evalF(currX);
                const currD = evalD1(currX);

                if (currY === null || !isFinite(currY) || currD === null || !isFinite(currD)) {
                  hasDiscontinuity = true;
                  break;
                }

                if (prevY * currY < 0 && (Math.abs(currY) > 5 || Math.abs(prevY) > 5) && Math.abs(currY - prevY) > 10) {
                  const midX = (prevX + currX) / 2;
                  const midY = evalF(midX);
                  if (midY === null || !isFinite(midY) || Math.abs(midY) > Math.max(Math.abs(prevY), Math.abs(currY))) {
                    hasDiscontinuity = true;
                    break;
                  }
                }

                if (prevD !== null && currD !== null && prevD * currD > 0 && Math.abs(currD) > 500 && Math.abs(prevD) > 500) {
                  const midX = (prevX + currX) / 2;
                  const midY = evalF(midX);
                  if (midY === null || !isFinite(midY) || Math.abs(midY) > 1000) {
                    hasDiscontinuity = true;
                    break;
                  }
                }

                prevX = currX;
                prevY = currY;
                prevD = currD;
              }
            }
          }

          const rawRoots = findRoots(evalD1, isClosedInterval ? a : -100, isClosedInterval ? b : 100);
          const candidates = [];
          const localExtrema = [];

          if (isClosedInterval) {
            const fa = evalF(a);
            if (fa !== null) candidates.push({ x: a, y: fa, origin: 'Endpoint (Lower)' });

            for (const cr of rawRoots) {
              if (cr > a + 1e-4 && cr < b - 1e-4) {
                const fcr = evalF(cr);
                if (fcr !== null) candidates.push({ x: cr, y: fcr, origin: 'Critical Point' });
              }
            }

            const fb = evalF(b);
            if (fb !== null) candidates.push({ x: b, y: fb, origin: 'Endpoint (Upper)' });
          } else {
            for (const cr of rawRoots) {
              const fcr = evalF(cr);
              if (fcr !== null) {
                const delta = 0.01;
                const dL = evalD1(cr - delta);
                const dR = evalD1(cr + delta);
                const d2Val = evalD2(cr);

                let type = 'Stationary Point (Neither)';
                if (dL !== null && dR !== null) {
                  if (dL > 1e-6 && dR < -1e-6) type = 'Local Maximum';
                  else if (dL < -1e-6 && dR > 1e-6) type = 'Local Minimum';
                  else if (dL * dR > 0) type = 'Stationary Point (Neither)';
                  else if (d2Val !== null && Math.abs(d2Val) > 1e-5) type = d2Val > 0 ? 'Local Minimum' : 'Local Maximum';
                } else if (d2Val !== null && Math.abs(d2Val) > 1e-5) {
                  type = d2Val > 0 ? 'Local Minimum' : 'Local Maximum';
                }

                candidates.push({ x: cr, y: fcr, origin: 'Critical Point', type });
                if (type === 'Local Maximum' || type === 'Local Minimum') {
                  localExtrema.push({ x: cr, y: fcr, type });
                }
              }
            }
          }

          if (optSec && optGlobalCards && optCandList && optNote) {
            optGlobalCards.innerHTML = '';
            optCandList.innerHTML = '';
            if (optLocalList) optLocalList.innerHTML = '';

            if (isClosedInterval) {
              if (optBadge) {
                optBadge.textContent = hasDiscontinuity ? 'Discontinuous on Interval' : 'Closed Interval Method';
                optBadge.className = hasDiscontinuity
                  ? 'text-xs text-amber-800 bg-amber-50 px-2 py-0.5 rounded border border-amber-200 font-medium'
                  : 'text-xs text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 font-medium';
              }

              if (hasDiscontinuity && optDiscWarning) {
                optDiscWarning.textContent = `Warning: Discontinuity, vertical asymptote, or undefined domain detected within [${fmt(a)}, ${fmt(b)}]. The Extreme Value Theorem requires continuity across the entire closed interval; therefore, global extrema cannot be guaranteed.`;
                optDiscWarning.classList.remove('hidden');
              }

              if (!hasDiscontinuity && candidates.length > 0) {
                let maxVal = -Infinity;
                let minVal = Infinity;
                for (const c of candidates) {
                  if (c.y > maxVal) maxVal = c.y;
                  if (c.y < minVal) minVal = c.y;
                }

                const maxCands = candidates.filter(c => Math.abs(c.y - maxVal) < 1e-4);
                const minCands = candidates.filter(c => Math.abs(c.y - minVal) < 1e-4);

                const maxCard = document.createElement('div');
                maxCard.className = 'bg-white p-4 rounded-xl border border-emerald-200 shadow-sm space-y-2';
                const maxOrigins = maxCands.map(c => `<span class="ml-1 text-xs px-2 py-0.5 rounded font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200">${c.origin} (${v}=${fmt(c.x)})</span>`).join(' ');
                maxCard.innerHTML = `
                  <div class="text-xs font-bold text-emerald-800 uppercase tracking-wide">Global Maximum</div>
                  <div class="text-2xl font-bold font-mono text-emerald-900">${fmt(maxVal)}</div>
                  <div class="text-xs text-gray-600">Attained at ${maxOrigins}</div>
                `;

                const minCard = document.createElement('div');
                minCard.className = 'bg-white p-4 rounded-xl border border-indigo-200 shadow-sm space-y-2';
                const minOrigins = minCands.map(c => `<span class="ml-1 text-xs px-2 py-0.5 rounded font-semibold bg-indigo-100 text-indigo-800 border border-indigo-200">${c.origin} (${v}=${fmt(c.x)})</span>`).join(' ');
                minCard.innerHTML = `
                  <div class="text-xs font-bold text-indigo-800 uppercase tracking-wide">Global Minimum</div>
                  <div class="text-2xl font-bold font-mono text-indigo-900">${fmt(minVal)}</div>
                  <div class="text-xs text-gray-600">Attained at ${minOrigins}</div>
                `;

                optGlobalCards.appendChild(maxCard);
                optGlobalCards.appendChild(minCard);
                optGlobalCards.classList.remove('hidden');
              } else {
                optGlobalCards.classList.add('hidden');
              }

              candidates.forEach((c) => {
                const item = document.createElement('div');
                item.className = 'bg-white p-3 rounded-lg border border-gray-200 flex items-center justify-between text-sm shadow-sm';
                item.innerHTML = `
                  <div>
                    <span class="text-gray-500 font-mono text-xs">${v} =</span> <strong class="font-mono text-gray-900 text-base">${fmt(c.x)}</strong>
                    <span class="ml-2 text-xs px-2 py-0.5 rounded font-semibold bg-gray-100 text-gray-700 border border-gray-200">${c.origin}</span>
                  </div>
                  <div class="font-mono font-bold text-gray-800 bg-gray-50 px-3 py-1 rounded border border-gray-200">f(${fmt(c.x)}) = ${fmt(c.y)}</div>
                `;
                optCandList.appendChild(item);
              });

              optNote.textContent = hasDiscontinuity
                ? `Note: Evaluated candidates on [${fmt(a)}, ${fmt(b)}] are shown above, but global extrema cannot be guaranteed due to detected discontinuity.`
                : `Note: Results determined via the Closed Interval Method on [${fmt(a)}, ${fmt(b)}]. All critical points and endpoints were evaluated and compared.`;
            } else {
              if (optBadge) {
                optBadge.textContent = 'Local Search [-100, 100]';
                optBadge.className = 'text-xs text-indigo-700 bg-indigo-50 px-2 py-0.5 rounded border border-indigo-200 font-medium';
              }

              optGlobalCards.classList.add('hidden');

              if (localExtrema.length > 0 && optLocalSec && optLocalList) {
                localExtrema.forEach((le) => {
                  const item = document.createElement('div');
                  item.className = 'bg-white p-3 rounded-lg border border-gray-200 flex items-center justify-between text-sm shadow-sm';
                  const badgeClass = le.type === 'Local Maximum'
                    ? 'bg-emerald-100 text-emerald-800 border border-emerald-200'
                    : 'bg-indigo-100 text-indigo-800 border border-indigo-200';
                  item.innerHTML = `
                    <div>
                      <span class="text-gray-500 font-mono text-xs">${v} =</span> <strong class="font-mono text-gray-900 text-base">${fmt(le.x)}</strong>
                      <span class="ml-2 text-xs px-2 py-0.5 rounded font-semibold ${badgeClass}">${le.type}</span>
                    </div>
                    <div class="font-mono font-bold text-gray-800 bg-gray-50 px-3 py-1 rounded border border-gray-200">f(${fmt(le.x)}) = ${fmt(le.y)}</div>
                  `;
                  optLocalList.appendChild(item);
                });
                optLocalSec.classList.remove('hidden');
              }

              if (candidates.length === 0) {
                optCandList.innerHTML = '<div class="p-3 bg-amber-50 rounded border border-amber-200 text-amber-800 text-sm">No stationary critical points detected in the numerical search region [-100, 100].</div>';
              } else {
                candidates.forEach((c) => {
                  const item = document.createElement('div');
                  item.className = 'bg-white p-3 rounded-lg border border-gray-200 flex items-center justify-between text-sm shadow-sm';
                  item.innerHTML = `
                    <div>
                      <span class="text-gray-500 font-mono text-xs">${v} =</span> <strong class="font-mono text-gray-900 text-base">${fmt(c.x)}</strong>
                      <span class="ml-2 text-xs px-2 py-0.5 rounded font-semibold bg-gray-100 text-gray-700 border border-gray-200">${c.type || c.origin}</span>
                    </div>
                    <div class="font-mono font-bold text-gray-800 bg-gray-50 px-3 py-1 rounded border border-gray-200">f(${fmt(c.x)}) = ${fmt(c.y)}</div>
                  `;
                  optCandList.appendChild(item);
                });
              }

              optNote.textContent = 'Note: No interval was supplied. Results above are local extrema detected within the numerical search region [-100, 100]; they are not guaranteed global extrema over the full domain.';
            }

            optSec.classList.remove('hidden');
          }
        }
        else if (mode === 'related-rates') {
          if (!rrTargetSelect) throw new Error('Target rate selector missing.');
          const targetVar = rrTargetSelect.value;
          if (!targetVar) throw new Error('Please select a target rate to solve for.');

          const { diffStr, lhsStr, rhsStr, variables } = extractRRVariables(exprIn.value);
          if (!variables.includes(targetVar)) {
            throw new Error(`Target variable "${targetVar}" is not present in the relationship equation.`);
          }

          const values = {};
          const rates = {};

          for (const varName of variables) {
            const valEl = document.getElementById(`rr-val-${varName}`) as HTMLInputElement | null;
            const rateEl = document.getElementById(`rr-rate-${varName}`) as HTMLInputElement | null;

            if (valEl && valEl.value.trim() !== '') {
              const parsedVal = parseFloat(valEl.value);
              if (isNaN(parsedVal)) throw new Error(`Invalid numeric value for variable "${varName}".`);
              values[varName] = parsedVal;
            }

            if (varName !== targetVar) {
              if (!rateEl || rateEl.value.trim() === '') {
                throw new Error(`Missing known rate for variable "${varName}" (d${varName}/dt).`);
              }
              const parsedRate = parseFloat(rateEl.value);
              if (isNaN(parsedRate)) throw new Error(`Invalid numeric rate for variable "${varName}" (d${varName}/dt).`);
              rates[varName] = parsedRate;
            }
          }

          // Calculate partial derivatives and solve
          const partialDerivs = {};
          const evalPartials = {};
          let targetPartialEval = null;

          const steps = [];
          steps.push({
            title: "Step 1: Governing Relationship & Implicit Form",
            content: `Given equation: ${lhsStr} = ${rhsStr}\nStandard implicit form: F(${variables.join(', ')}) = ${diffStr} = 0`
          });

          const diffTermsLhs = [];
          const diffTermsRhs = [];
          const diffLhsNode = math.parse(cleanExpr(lhsStr));
          const diffRhsNode = math.parse(cleanExpr(rhsStr));

          for (const varName of variables) {
            const dLhs = math.derivative(diffLhsNode, varName);
            const dRhs = math.derivative(diffRhsNode, varName);
            const simpLhs = math.simplify(dLhs).toString();
            const simpRhs = math.simplify(dRhs).toString();

            if (simpLhs !== '0') {
              diffTermsLhs.push(`(${simpLhs.replace(/\s\*\s/g, '')}) · (d${varName}/dt)`);
            }
            if (simpRhs !== '0') {
              diffTermsRhs.push(`(${simpRhs.replace(/\s\*\s/g, '')}) · (d${varName}/dt)`);
            }

            const dF = math.derivative(diffStr, varName);
            partialDerivs[varName] = math.simplify(dF);

            try {
              const val = partialDerivs[varName].evaluate(values);
              if (typeof val !== 'number' || isNaN(val) || !isFinite(val)) {
                throw new Error(`Non-finite evaluation`);
              }
              evalPartials[varName] = val;
              if (varName === targetVar) {
                targetPartialEval = val;
              }
            } catch (evalErr) {
              throw new Error(`Cannot evaluate ∂F/∂${varName} = ${partialDerivs[varName].toString()}: Ensure value for "${varName}" is provided and valid.`);
            }
          }

          const lhsDiffStr = diffTermsLhs.length > 0 ? diffTermsLhs.join(' + ') : '0';
          const rhsDiffStr = diffTermsRhs.length > 0 ? diffTermsRhs.join(' + ') : '0';

          steps.push({
            title: "Step 2: Differentiate with Respect to Time (t) via Chain Rule",
            content: `d/dt [ ${lhsStr} ] = d/dt [ ${rhsStr} ]\n=> ${lhsDiffStr} = ${rhsDiffStr}`
          });

          if (targetPartialEval === null || typeof targetPartialEval !== 'number' || isNaN(targetPartialEval)) {
            throw new Error(`Coefficient of d${targetVar}/dt could not be evaluated.`);
          }

          if (Math.abs(targetPartialEval) < 1e-12) {
            throw new Error(`Cannot solve for d${targetVar}/dt: The derivative coefficient ∂F/∂${targetVar} evaluates to 0 at the given point.`);
          }

          let knownSum = 0;
          for (const varName of variables) {
            if (varName === targetVar) continue;
            const rateVal = rates[varName];
            const pVal = evalPartials[varName];
            knownSum += pVal * rateVal;
          }

          const targetRate = - knownSum / targetPartialEval;
          if (isNaN(targetRate) || !isFinite(targetRate)) {
            throw new Error(`Calculated rate d${targetVar}/dt is non-finite or undefined.`);
          }

          const fmtKnownVals = variables.map(vName => `${vName} = ${values[vName] !== undefined ? values[vName] : '?'}`).join(', ');
          const fmtKnownRates = variables.filter(vName => vName !== targetVar).map(vName => `d${vName}/dt = ${rates[vName]}`).join(', ');

          steps.push({
            title: "Step 3: Substitute Known Values & Rates",
            content: `Values: ${fmtKnownVals}\nRates: ${fmtKnownRates}\nTarget derivative coefficient: ∂F/∂${targetVar} = ${targetPartialEval.toFixed(6)}\nSum of known rate terms: ${knownSum.toFixed(6)}`
          });

          const formattedRate = Math.abs(targetRate) < 1e-12 ? "0" : (Number.isInteger(targetRate) ? targetRate.toString() : parseFloat(targetRate.toFixed(6)).toString());

          steps.push({
            title: `Step 4: Solve for d${targetVar}/dt`,
            content: `d${targetVar}/dt = -(${knownSum.toFixed(6)}) / (${targetPartialEval.toFixed(6)})\n=> d${targetVar}/dt = ${formattedRate}`
          });

          labelStr = `Related Rate: d${targetVar} / dt =`;
          resultStr = formattedRate;

          if (rrStepsList && rrInterpNote && rrSec) {
            rrStepsList.innerHTML = '';
            steps.forEach(st => {
              const stepCard = document.createElement('div');
              stepCard.className = 'bg-white p-3.5 rounded-lg border border-gray-200 text-sm shadow-sm space-y-1';
              stepCard.innerHTML = `
                <div class="font-bold text-gray-800 text-xs uppercase tracking-wide">${st.title}</div>
                <div class="text-gray-900 whitespace-pre-wrap font-mono text-xs bg-gray-50 p-2.5 rounded border border-gray-100">${st.content}</div>
              `;
              rrStepsList.appendChild(stepCard);
            });

            let interp = '';
            if (targetRate > 1e-12) {
              interp = `Variable "${targetVar}" is INCREASING at a rate of ${formattedRate} units per unit time.`;
            } else if (targetRate < -1e-12) {
              interp = `Variable "${targetVar}" is DECREASING at a rate of ${Math.abs(parseFloat(formattedRate))} units per unit time (negative rate).`;
            } else {
              interp = `Variable "${targetVar}" is instantaneous stationary (rate of change is 0).`;
            }
            rrInterpNote.textContent = `Interpretation: ${interp}`;
            rrSec.classList.remove('hidden');
          }
        }
        else {
          // first, marginal, tangent
          const d1 = math.derivative(expr, v);
          labelStr = mode === 'marginal' ? `C'(${v}) = Marginal Function` : `f'(${v}) = df/d${v} =`;
          resultStr = math.simplify(d1).toString();

          if (evalAt !== '') {
             const xVal = parseFloat(evalAt);
             const evalRes = d1.evaluate({ [v]: xVal });
             const yVal = math.evaluate(expr, { [v]: xVal });

             evalLabel.textContent = `Evaluated at ${v} = ${xVal}`;
             evalVal.textContent = mode === 'marginal'
                ? `C'(${xVal}) = ${Number.isInteger(evalRes) ? evalRes : evalRes.toFixed(4)}`
                : `f'(${xVal}) = ${Number.isInteger(evalRes) ? evalRes : evalRes.toFixed(4)}`;
             evalSec.classList.remove('hidden');

             if (mode === 'tangent' && tangSec) {
                const m = evalRes;
                const fmtM = Number.isInteger(m) ? m : parseFloat(m.toFixed(4));
                const fmtY = Number.isInteger(yVal) ? yVal : parseFloat(yVal.toFixed(4));

                // y - y1 = m(x - x1)  => y = mx - mx1 + y1
                const b = yVal - (m * xVal);
                const fmtB = Number.isInteger(b) ? b : parseFloat(b.toFixed(4));
                const signB = fmtB >= 0 ? `+ ${fmtB}` : `- ${Math.abs(fmtB)}`;
                tangEq.textContent = `y = ${fmtM}x ${signB}`;

                if (m === 0) {
                   normEq.textContent = `x = ${xVal} (Vertical line)`;
                } else {
                   const mN = -1 / m;
                   const fmtMN = Number.isInteger(mN) ? mN : parseFloat(mN.toFixed(4));
                   const bN = yVal - (mN * xVal);
                   const fmtBN = Number.isInteger(bN) ? bN : parseFloat(bN.toFixed(4));
                   const signBN = fmtBN >= 0 ? `+ ${fmtBN}` : `- ${Math.abs(fmtBN)}`;
                   normEq.textContent = `y = ${fmtMN}x ${signBN}`;
                }
                tangSec.classList.remove('hidden');
             }
          }
        }

        // Clean up output string format from mathjs (e.g. "2 * x" -> "2x")
        resultStr = resultStr.replace(/\s\*\s/g, '');

        ansLabel.textContent = labelStr;
        ansVal.textContent = resultStr;

      } catch (err) {
        ansBox.classList.add('hidden');
        errBox.textContent = `Error calculating derivative: ${err.message}. Ensure the expression is valid math syntax.`;
        errBox.classList.remove('hidden');
      }

      resSec.classList.remove('hidden');
    });

    const BUILTIN_SYMBOLS = new Set([
      'pi', 'PI', 'e', 'E', 'i', 'I',
      'sin', 'cos', 'tan', 'sec', 'csc', 'cot',
      'asin', 'acos', 'atan', 'asec', 'acsc', 'acot',
      'sinh', 'cosh', 'tanh', 'asinh', 'acosh', 'atanh',
      'log', 'ln', 'log10', 'log2', 'exp', 'sqrt', 'cbrt', 'abs', 'sign'
    ]);

    const RR_PRESETS: Record<string, { eq: string; target: string; values: Record<string, number>; rates: Record<string, number> }> = {
      circle_area: { eq: 'A = pi * r^2', target: 'A', values: { r: 5 }, rates: { r: 2 } },
      sphere_volume: { eq: 'V = (4/3) * pi * r^3', target: 'V', values: { r: 3 }, rates: { r: 2 } },
      sphere_surface: { eq: 'S = 4 * pi * r^2', target: 'S', values: { r: 5 }, rates: { r: 2 } },
      pythagorean: { eq: 'x^2 + y^2 = z^2', target: 'z', values: { x: 3, y: 4, z: 5 }, rates: { x: -2, y: 1 } },
      cone_volume: { eq: 'V = (1/3) * pi * r^2 * h', target: 'V', values: { r: 3, h: 4 }, rates: { r: 2, h: -1 } },
      cylinder_volume: { eq: 'V = pi * r^2 * h', target: 'V', values: { r: 2, h: 5 }, rates: { r: 0.5, h: 0 } },
      rectangle_area: { eq: 'A = x * y', target: 'A', values: { x: 4, y: 5 }, rates: { x: 3, y: -2 } }
    };

    const extractRRVariables = (exprStr: string) => {
      if (!exprStr || !exprStr.trim()) {
        throw new Error('Please enter a governing relationship equation.');
      }
      const parts = exprStr.split('=');
      let diffStr: string;
      if (parts.length === 2) {
        if (!parts[0].trim() || !parts[1].trim()) {
          throw new Error('Both sides of the equation must contain valid mathematical expressions.');
        }
        diffStr = `(${parts[0]}) - (${parts[1]})`;
      } else if (parts.length === 1) {
        diffStr = parts[0];
      } else {
        throw new Error('Equation must contain at most one "=" sign.');
      }

      const parsed = math.parse(cleanExpr(diffStr));
      const symbols = new Set<string>();
      parsed.traverse((node: any) => {
        if (node.isSymbolNode && !BUILTIN_SYMBOLS.has(node.name)) {
          symbols.add(node.name);
        }
      });

      const variables = Array.from(symbols);
      if (variables.length === 0) {
        throw new Error('No variables detected in equation.');
      }
      return {
        diffStr,
        lhsStr: parts.length === 2 ? parts[0].trim() : parts[0].trim(),
        rhsStr: parts.length === 2 ? parts[1].trim() : '0',
        variables
      };
    };

    const updateRRInputs = (customValues: Record<string, number | string> = {}, customRates: Record<string, number | string> = {}, customTarget: string | null = null) => {
      if (!rrVarsGrid || !rrTargetSelect || !exprIn) return;
      try {
        const { variables } = extractRRVariables(exprIn.value);

        const currentVals: Record<string, number | string> = { ...customValues };
        const currentRates: Record<string, number | string> = { ...customRates };
        variables.forEach(vName => {
          const vInput = document.getElementById(`rr-val-${vName}`) as HTMLInputElement | null;
          const rInput = document.getElementById(`rr-rate-${vName}`) as HTMLInputElement | null;
          if (currentVals[vName] === undefined && vInput && vInput.value !== '') {
            currentVals[vName] = vInput.value;
          }
          if (currentRates[vName] === undefined && rInput && rInput.value !== '') {
            currentRates[vName] = rInput.value;
          }
        });

        rrVarsGrid.innerHTML = '';
        variables.forEach(vName => {
          const card = document.createElement('div');
          card.className = 'p-3 bg-gray-50 rounded-lg border border-gray-200 space-y-2';
          card.innerHTML = `
            <div class="font-bold text-gray-700 font-mono text-sm flex items-center justify-between">
              <span>Variable: <code class="text-emerald-700">${vName}</code></span>
            </div>
            <div class="grid grid-cols-2 gap-2">
              <div>
                <label for="rr-val-${vName}" class="block text-xs text-gray-500 font-medium mb-1">Value (${vName})</label>
                <input type="number" step="any" id="rr-val-${vName}" class="w-full p-2 border border-gray-300 rounded font-mono text-sm bg-white" placeholder="e.g. 5" value="${currentVals[vName] !== undefined ? currentVals[vName] : ''}">
              </div>
              <div>
                <label for="rr-rate-${vName}" class="block text-xs text-gray-500 font-medium mb-1">Rate (d${vName}/dt)</label>
                <input type="number" step="any" id="rr-rate-${vName}" class="w-full p-2 border border-gray-300 rounded font-mono text-sm bg-white" placeholder="e.g. 2" value="${currentRates[vName] !== undefined ? currentRates[vName] : ''}">
              </div>
            </div>
          `;
          rrVarsGrid.appendChild(card);
        });

        const oldTarget = customTarget || rrTargetSelect.value;
        rrTargetSelect.innerHTML = '';
        variables.forEach(vName => {
          const opt = document.createElement('option');
          opt.value = vName;
          opt.textContent = `d${vName}/dt (Rate of change of ${vName})`;
          if (vName === oldTarget || (!variables.includes(oldTarget) && vName === variables[0])) {
            opt.selected = true;
          }
          rrTargetSelect.appendChild(opt);
        });

        const syncTargetDisabled = () => {
          const curTarget = rrTargetSelect.value;
          variables.forEach(vName => {
            const rInput = document.getElementById(`rr-rate-${vName}`) as HTMLInputElement | null;
            if (rInput) {
              if (vName === curTarget) {
                rInput.disabled = true;
                rInput.placeholder = '(To be solved)';
                rInput.classList.add('bg-emerald-50', 'text-emerald-800', 'border-emerald-200');
              } else {
                rInput.disabled = false;
                rInput.placeholder = 'e.g. 2';
                rInput.classList.remove('bg-emerald-50', 'text-emerald-800', 'border-emerald-200');
              }
            }
          });
        };

        rrTargetSelect.onchange = syncTargetDisabled;
        syncTargetDisabled();

      } catch (err) {
        // Syntax not yet completed while user is typing
      }
    };

    if (mode === 'related-rates') {
      if (rrPresetSelect) {
        rrPresetSelect.addEventListener('change', () => {
          const key = rrPresetSelect.value;
          if (key !== 'custom' && RR_PRESETS[key]) {
            const p = RR_PRESETS[key];
            if (exprIn) exprIn.value = p.eq;
            updateRRInputs(p.values, p.rates, p.target);
          }
        });
      }

      if (exprIn) {
        exprIn.addEventListener('input', () => {
          if (rrPresetSelect) rrPresetSelect.value = 'custom';
          updateRRInputs();
        });

        // Initial setup
        const initialPreset = RR_PRESETS.circle_area;
        if (!exprIn.value || exprIn.value === 'A = pi * r^2') {
          exprIn.value = initialPreset.eq;
          if (rrPresetSelect) rrPresetSelect.value = 'circle_area';
          updateRRInputs(initialPreset.values, initialPreset.rates, initialPreset.target);
        } else {
          updateRRInputs();
        }
      }
    }
  };

  initDeriv();
  document.addEventListener('astro:page-load', initDeriv);
</script>
