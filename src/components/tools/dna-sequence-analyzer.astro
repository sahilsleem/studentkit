---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="space-y-3.5">
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">5' to 3' DNA Sequence (A, T, C, G)</label>
        <textarea id="dna-input" rows="3" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent font-mono uppercase" placeholder="e.g. ATGCGATCGATCGATCGTAA"></textarea>
      </div>

      <button id="dna-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
        Analyze Sequence
      </button>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4">
        <div class="p-4 bg-page rounded-xl border border-border-line/80">
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Complementary Strand (3' → 5')</div>
          <div id="dna-comp" class="text-sm font-bold text-brand font-mono mt-1">TACGCTAGCTAGCTAGCATT</div>
        </div>

        <div class="p-4 bg-page rounded-xl border border-border-line/80">
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">mRNA Transcript (5' → 3')</div>
          <div id="dna-mrna" class="text-sm font-bold text-brand font-mono mt-1">AUGCGAUCGAUCGAUCGUAA</div>
        </div>

        <div class="p-4 bg-page rounded-xl border border-border-line/80">
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">GC Content %</div>
          <div id="dna-gc" class="text-2xl font-extrabold text-ink font-mono mt-1">45.0%</div>
        </div>

        <div class="p-4 bg-page rounded-xl border border-border-line/80">
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Estimated Melting Temp (Tm)</div>
          <div id="dna-tm" class="text-2xl font-extrabold text-ink font-mono mt-1">54.0°C</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const raw = ((document.getElementById('dna-input') as HTMLTextAreaElement)?.value || '').toUpperCase().replace(/[^ATCG]/g, '');
    if (!raw) return;

    const compMap: Record<string, string> = { 'A': 'T', 'T': 'A', 'C': 'G', 'G': 'C' };
    const comp = raw.split('').map(c => compMap[c] || c).join('');
    const mrna = raw.replace(/T/g, 'U');

    const gCount = (raw.match(/G/g) || []).length;
    const cCount = (raw.match(/C/g) || []).length;
    const aCount = (raw.match(/A/g) || []).length;
    const tCount = (raw.match(/T/g) || []).length;

    const gc = ((gCount + cCount) / raw.length) * 100;
    // Marmur & Doty formula
    const tm = raw.length < 14 ? (aCount + tCount) * 2 + (gCount + cCount) * 4 : 64.9 + 41 * (gCount + cCount - 16.4) / raw.length;

    document.getElementById('dna-comp')!.textContent = comp;
    document.getElementById('dna-mrna')!.textContent = mrna;
    document.getElementById('dna-gc')!.textContent = gc.toFixed(1) + '%';
    document.getElementById('dna-tm')!.textContent = tm.toFixed(1) + '°C';
  }


  document.getElementById('dna-calc-btn')?.addEventListener('click', calculate);
</script>