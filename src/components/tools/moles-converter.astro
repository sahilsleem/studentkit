---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Substance Molar Mass (g/mol)</label>
          <input type="number" id="mc-mw" placeholder="e.g. 18.015" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Amount in Grams (g)</label>
          <input type="number" id="mc-grams" placeholder="e.g. 36.03" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>

        <button id="mc-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Convert to Moles & Particles
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Number of Moles (n = m / MW)</div>
          <div id="mc-moles" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 space-y-1.5 text-xs text-slate-muted">
          <div class="flex flex-wrap justify-between gap-2">
            <span>Molecules (N = n · N_A):</span>
            <strong id="mc-particles" class="text-ink font-mono break-words">1.204 × 10²⁴</strong>
          </div>
          <div class="flex flex-wrap justify-between gap-2">
            <span>Gas Volume at STP (22.4 L/mol):</span>
            <strong id="mc-stp" class="text-ink font-mono break-words">44.83 L</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const mw = parseFloat((document.getElementById('mc-mw') as HTMLInputElement)?.value || '1');
    const g = parseFloat((document.getElementById('mc-grams') as HTMLInputElement)?.value || '0');
    const NA = 6.02214076e23;

    if (mw <= 0) return;
    const moles = g / mw;
    const particles = moles * NA;
    const stp = moles * 22.414;

    document.getElementById('mc-moles')!.textContent = moles.toFixed(3) + ' mol';
    document.getElementById('mc-particles')!.textContent = particles.toExponential(3);
    document.getElementById('mc-stp')!.textContent = stp.toFixed(2) + ' L';
  }


  document.getElementById('mc-calc-btn')?.addEventListener('click', calculate);
</script>