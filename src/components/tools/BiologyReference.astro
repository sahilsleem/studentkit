---
import { tools } from '../../data/registry';
import { AMINO_ACIDS } from '../../data/aminoAcids';
const { tool } = Astro.props;

const getReferenceContent = (slug) => {
  if (slug === 'amino-acid-reference' || slug === 'amino-acids') {
    return {
      title: "Standard Amino Acids",
      html: `
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse border border-gray-200">
            <thead class="bg-gray-100">
              <tr>
                <th class="p-3 border-b">Name</th>
                <th class="p-3 border-b">Codes</th>
                <th class="p-3 border-b">Mass</th>
                <th class="p-3 border-b">Properties</th>
                <th class="p-3 border-b">Essential</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              ${AMINO_ACIDS.map(aa => `
                <tr class="hover:bg-gray-50">
                  <td class="p-3 font-bold">${aa.name}</td>
                  <td class="p-3 font-mono">${aa.threeLetter} / ${aa.oneLetter}</td>
                  <td class="p-3 text-gray-600">${aa.mass.toFixed(1)}</td>
                  <td class="p-3"><span class="bg-blue-50 text-blue-800 text-xs px-2 py-1 rounded border border-blue-200">${aa.polarity}</span> <span class="bg-purple-50 text-purple-800 text-xs px-2 py-1 rounded border border-purple-200">${aa.charge}</span></td>
                  <td class="p-3">${aa.essential ? 'Yes' : 'No'}</td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        </div>
      `
    }
  }
  
  if (slug === 'central-dogma' || slug === 'transcription-reference' || slug === 'translation-reference') {
     return {
        title: "Central Dogma of Molecular Biology",
        html: `
          <div class="flex flex-col items-center justify-center p-8 bg-blue-50 rounded-xl border border-blue-100 mb-6">
            <div class="text-xl font-bold bg-white px-6 py-3 rounded-lg shadow-sm border border-gray-200">DNA</div>
            <div class="my-4 text-blue-500 font-bold flex flex-col items-center">
              <span>Transcription</span>
              <span>↓</span>
            </div>
            <div class="text-xl font-bold bg-white px-6 py-3 rounded-lg shadow-sm border border-gray-200">RNA</div>
            <div class="my-4 text-blue-500 font-bold flex flex-col items-center">
              <span>Translation</span>
              <span>↓</span>
            </div>
            <div class="text-xl font-bold bg-white px-6 py-3 rounded-lg shadow-sm border border-gray-200">Protein</div>
          </div>
          <p class="text-gray-700 leading-relaxed mb-4">The central dogma of molecular biology explains the flow of genetic information, from DNA to RNA, to make a functional product, a protein.</p>
          <ul class="list-disc pl-5 space-y-2 text-gray-700">
             <li><strong>Replication:</strong> DNA copies itself.</li>
             <li><strong>Transcription:</strong> DNA is copied into RNA (specifically mRNA).</li>
             <li><strong>Translation:</strong> mRNA is read by ribosomes to produce proteins.</li>
          </ul>
        `
     };
  }
  
  if (slug === 'mitosis-stages' || slug === 'cell-cycle') {
     return {
       title: "Stages of Mitosis",
       html: `
         <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
           <div class="p-4 border border-gray-200 rounded-lg bg-white shadow-sm">
             <h4 class="font-bold text-lg text-blue-700 border-b pb-2 mb-2">1. Prophase</h4>
             <p class="text-sm text-gray-600">Chromatin condenses into chromosomes. Nucleolus disappears. Centrosomes move to opposite poles and spindle begins to form.</p>
           </div>
           <div class="p-4 border border-gray-200 rounded-lg bg-white shadow-sm">
             <h4 class="font-bold text-lg text-blue-700 border-b pb-2 mb-2">2. Prometaphase</h4>
             <p class="text-sm text-gray-600">Nuclear envelope breaks down. Kinetochore microtubules attach to the kinetochores of the chromosomes.</p>
           </div>
           <div class="p-4 border border-gray-200 rounded-lg bg-white shadow-sm">
             <h4 class="font-bold text-lg text-blue-700 border-b pb-2 mb-2">3. Metaphase</h4>
             <p class="text-sm text-gray-600">Chromosomes align at the metaphase plate (cell equator). The spindle fibers hold them in place.</p>
           </div>
           <div class="p-4 border border-gray-200 rounded-lg bg-white shadow-sm">
             <h4 class="font-bold text-lg text-blue-700 border-b pb-2 mb-2">4. Anaphase</h4>
             <p class="text-sm text-gray-600">Sister chromatids are pulled apart toward opposite poles of the cell by the spindle fibers.</p>
           </div>
           <div class="p-4 border border-gray-200 rounded-lg bg-white shadow-sm">
             <h4 class="font-bold text-lg text-blue-700 border-b pb-2 mb-2">5. Telophase</h4>
             <p class="text-sm text-gray-600">Chromosomes decondense back into chromatin. Nuclear envelopes re-form around the two sets of DNA.</p>
           </div>
           <div class="p-4 border border-gray-200 rounded-lg bg-white shadow-sm">
             <h4 class="font-bold text-lg text-blue-700 border-b pb-2 mb-2">6. Cytokinesis</h4>
             <p class="text-sm text-gray-600">The cytoplasm divides, resulting in two genetically identical daughter cells.</p>
           </div>
         </div>
       `
     };
  }
  
  if (slug === 'cell-organelles' || slug === 'animal-cell' || slug === 'plant-cell') {
     return {
       title: "Cell Organelles Reference",
       html: `
         <ul class="space-y-4">
           <li class="bg-gray-50 p-4 border border-gray-200 rounded-lg">
             <h4 class="font-bold text-lg text-gray-800">Nucleus</h4>
             <p class="text-gray-600 text-sm mt-1">The control center of the cell, housing the genetic material (DNA).</p>
           </li>
           <li class="bg-gray-50 p-4 border border-gray-200 rounded-lg">
             <h4 class="font-bold text-lg text-gray-800">Mitochondria</h4>
             <p class="text-gray-600 text-sm mt-1">The powerhouse of the cell, generating ATP through cellular respiration.</p>
           </li>
           <li class="bg-gray-50 p-4 border border-gray-200 rounded-lg">
             <h4 class="font-bold text-lg text-gray-800">Endoplasmic Reticulum (ER)</h4>
             <p class="text-gray-600 text-sm mt-1">Rough ER synthesizes proteins (studded with ribosomes); Smooth ER synthesizes lipids and detoxifies.</p>
           </li>
           <li class="bg-gray-50 p-4 border border-gray-200 rounded-lg">
             <h4 class="font-bold text-lg text-gray-800">Golgi Apparatus</h4>
             <p class="text-gray-600 text-sm mt-1">Modifies, sorts, and packages proteins and lipids for transport.</p>
           </li>
           <li class="bg-gray-50 p-4 border border-gray-200 rounded-lg">
             <h4 class="font-bold text-lg text-gray-800">Chloroplast (Plant Cells)</h4>
             <p class="text-gray-600 text-sm mt-1">Site of photosynthesis, converting light energy into chemical energy (glucose).</p>
           </li>
           <li class="bg-gray-50 p-4 border border-gray-200 rounded-lg">
             <h4 class="font-bold text-lg text-gray-800">Lysosome (Animal Cells)</h4>
             <p class="text-gray-600 text-sm mt-1">Contains digestive enzymes to break down waste materials and cellular debris.</p>
           </li>
         </ul>
       `
     }
  }

  if (slug === 'biology-constants') {
    return {
      title: "Essential Biological Constants & Physiological Values",
      html: `
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse border border-gray-200">
            <thead class="bg-gray-100">
              <tr>
                <th class="p-3 border-b font-semibold text-gray-900">Parameter / Constant</th>
                <th class="p-3 border-b font-semibold text-gray-900">Standard Value (Adult Human / Standard)</th>
                <th class="p-3 border-b font-semibold text-gray-900">Significance / Physiological Context</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 text-sm">
              <tr class="hover:bg-gray-50">
                <td class="p-3 font-medium text-gray-900">Normal Body Temperature</td>
                <td class="p-3 font-mono text-emerald-800">36.5 – 37.5 °C (97.7 – 99.5 °F)</td>
                <td class="p-3 text-gray-600">Core thermal homeostasis regulated by the preoptic area of the hypothalamus.</td>
              </tr>
              <tr class="hover:bg-gray-50">
                <td class="p-3 font-medium text-gray-900">Arterial Blood pH</td>
                <td class="p-3 font-mono text-emerald-800">7.35 – 7.45</td>
                <td class="p-3 text-gray-600">Strict physiological buffer range maintained by bicarbonate/carbonic acid systems.</td>
              </tr>
              <tr class="hover:bg-gray-50">
                <td class="p-3 font-medium text-gray-900">Human Genome Size (Haploid)</td>
                <td class="p-3 font-mono text-emerald-800">~3.2 × 10⁹ base pairs (~3.2 Gb)</td>
                <td class="p-3 text-gray-600">Distributed across 23 chromosomes; encodes roughly 20,000 protein-coding genes.</td>
              </tr>
              <tr class="hover:bg-gray-50">
                <td class="p-3 font-medium text-gray-900">Diploid Chromosome Number (2n)</td>
                <td class="p-3 font-mono text-emerald-800">46 chromosomes (23 homologous pairs)</td>
                <td class="p-3 text-gray-600">22 pairs of autosomes and 1 pair of allosomes (sex chromosomes, XX or XY).</td>
              </tr>
              <tr class="hover:bg-gray-50">
                <td class="p-3 font-medium text-gray-900">Resting Cardiac Output</td>
                <td class="p-3 font-mono text-emerald-800">~5.0 L/min</td>
                <td class="p-3 text-gray-600">Product of Heart Rate (~70 bpm) and Stroke Volume (~70 mL).</td>
              </tr>
              <tr class="hover:bg-gray-50">
                <td class="p-3 font-medium text-gray-900">Glomerular Filtration Rate (GFR)</td>
                <td class="p-3 font-mono text-emerald-800">90 – 120 mL/min/1.73 m²</td>
                <td class="p-3 text-gray-600">Volume of fluid filtered per minute by renal glomeruli; primary renal function index.</td>
              </tr>
              <tr class="hover:bg-gray-50">
                <td class="p-3 font-medium text-gray-900">Extracellular Sodium ([Na⁺])</td>
                <td class="p-3 font-mono text-emerald-800">135 – 145 mmol/L (mEq/L)</td>
                <td class="p-3 text-gray-600">Primary extracellular cation; vital for osmolarity and neuromuscular depolarization.</td>
              </tr>
              <tr class="hover:bg-gray-50">
                <td class="p-3 font-medium text-gray-900">Intracellular Potassium ([K⁺])</td>
                <td class="p-3 font-mono text-emerald-800">140 – 150 mmol/L (mEq/L)</td>
                <td class="p-3 text-gray-600">Primary intracellular cation; sets resting membrane potential via Na⁺/K⁺-ATPase.</td>
              </tr>
              <tr class="hover:bg-gray-50">
                <td class="p-3 font-medium text-gray-900">Aerobic ATP Yield per Glucose</td>
                <td class="p-3 font-mono text-emerald-800">30 – 32 ATP molecules</td>
                <td class="p-3 text-gray-600">Theoretical maximum energetic yield from complete oxidation through cellular respiration.</td>
              </tr>
              <tr class="hover:bg-gray-50">
                <td class="p-3 font-medium text-gray-900">ATP Hydrolysis Free Energy (ΔG°′)</td>
                <td class="p-3 font-mono text-emerald-800">−30.5 kJ/mol (−7.3 kcal/mol)</td>
                <td class="p-3 text-gray-600">Standard biochemical free-energy change (ΔG°′ at pH 7.0, 25 °C, 1 mM Mg²⁺) coupling exergonic and endergonic reactions.</td>
              </tr>
            </tbody>
          </table>
        </div>
      `
    };
  }

  if (slug === 'biology-formulas') {
    return {
      title: "Essential Biology Formulas & Equations",
      html: `
        <div class="space-y-6">
          <div class="p-5 bg-gray-50 border border-gray-200 rounded-xl">
            <h4 class="font-bold text-base text-gray-900 mb-2">1. Hardy-Weinberg Equilibrium</h4>
            <div class="bg-white border border-gray-200 rounded-lg p-3 font-mono text-emerald-800 text-sm mb-2">
              p + q = 1 &nbsp;|&nbsp; p² + 2pq + q² = 1
            </div>
            <p class="text-sm text-gray-600"><strong>p:</strong> Frequency of dominant allele, <strong>q:</strong> Frequency of recessive allele, <strong>p²:</strong> Homozygous dominant genotype frequency, <strong>2pq:</strong> Heterozygous genotype frequency, <strong>q²:</strong> Homozygous recessive genotype frequency.</p>
          </div>

          <div class="p-5 bg-gray-50 border border-gray-200 rounded-xl">
            <h4 class="font-bold text-base text-gray-900 mb-2">2. Population Growth Models</h4>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="bg-white border border-gray-200 rounded-lg p-3">
                <div class="font-mono text-emerald-800 text-sm mb-1">dN / dt = rN</div>
                <p class="text-xs text-gray-500"><strong>Exponential Growth:</strong> Unrestricted reproduction with constant intrinsic growth rate (r).</p>
              </div>
              <div class="bg-white border border-gray-200 rounded-lg p-3">
                <div class="font-mono text-emerald-800 text-sm mb-1">dN / dt = rN · ((K - N) / K)</div>
                <p class="text-xs text-gray-500"><strong>Logistic Growth:</strong> Density-dependent growth limited by environmental carrying capacity (K).</p>
              </div>
            </div>
          </div>

          <div class="p-5 bg-gray-50 border border-gray-200 rounded-xl">
            <h4 class="font-bold text-base text-gray-900 mb-2">3. Cardiovascular Physiology Equations</h4>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="bg-white border border-gray-200 rounded-lg p-3">
                <div class="font-mono text-emerald-800 text-sm mb-1">CO = HR × SV</div>
                <p class="text-xs text-gray-500"><strong>Cardiac Output (CO):</strong> Heart rate (beats/min) multiplied by stroke volume (mL/beat).</p>
              </div>
              <div class="bg-white border border-gray-200 rounded-lg p-3">
                <div class="font-mono text-emerald-800 text-sm mb-1">MAP ≈ DBP + ⅓(SBP - DBP)</div>
                <p class="text-xs text-gray-500"><strong>Mean Arterial Pressure (MAP):</strong> Diastolic blood pressure plus one-third of pulse pressure.</p>
              </div>
            </div>
          </div>

          <div class="p-5 bg-gray-50 border border-gray-200 rounded-xl">
            <h4 class="font-bold text-base text-gray-900 mb-2">4. Enzyme Kinetics (Michaelis-Menten)</h4>
            <div class="bg-white border border-gray-200 rounded-lg p-3 font-mono text-emerald-800 text-sm mb-2">
              v = (V_max · [S]) / (K_m + [S])
            </div>
            <p class="text-sm text-gray-600"><strong>v:</strong> Initial reaction velocity, <strong>V_max:</strong> Maximum reaction velocity at enzyme saturation, <strong>[S]:</strong> Substrate concentration, <strong>K_m:</strong> Michaelis constant (substrate concentration at half V_max).</p>
          </div>
        </div>
      `
    };
  }

  if (slug === 'cell-structure') {
    return {
      title: "Cell Structure & Architectural Organization",
      html: `
        <div class="space-y-6">
          <p class="text-gray-700 leading-relaxed">Cells are the fundamental structural and functional units of all living organisms. While structural complexity varies across domains, all living cells share four universal core components: the plasma membrane, genetic material (DNA), ribosomes for protein synthesis, and cytosol.</p>
          
          <div class="grid gap-4 md:grid-cols-2">
            <div class="p-4 border border-gray-200 rounded-xl bg-gray-50">
              <h4 class="font-bold text-gray-900 mb-2">1. Plasma (Cell) Membrane</h4>
              <p class="text-sm text-gray-600">Amphipathic phospholipid bilayer with embedded integral and peripheral proteins, cholesterol (in animals), and carbohydrates. Regulates selective transport and maintains cellular homeostasis via the fluid mosaic model.</p>
            </div>
            <div class="p-4 border border-gray-200 rounded-xl bg-gray-50">
              <h4 class="font-bold text-gray-900 mb-2">2. Cytoplasm & Cytosol</h4>
              <p class="text-sm text-gray-600">The jelly-like fluid interior (cytosol) containing water, dissolved salts, metabolic enzymes, and suspended organelles. Hosts crucial metabolic pathways including glycolysis and protein synthesis.</p>
            </div>
            <div class="p-4 border border-gray-200 rounded-xl bg-gray-50">
              <h4 class="font-bold text-gray-900 mb-2">3. Ribosomes</h4>
              <p class="text-sm text-gray-600">Ribonucleoprotein complexes composed of ribosomal RNA (rRNA) and catalytic proteins. Translate mRNA into polypeptides. Found as 70S in prokaryotes and 80S in eukaryotic cytoplasm.</p>
            </div>
            <div class="p-4 border border-gray-200 rounded-xl bg-gray-50">
              <h4 class="font-bold text-gray-900 mb-2">4. Cytoskeletal Network</h4>
              <p class="text-sm text-gray-600">Dynamic protein scaffold providing structural integrity, spatial organization, intracellular transport, and motility. Composed of microfilaments (actin), intermediate filaments, and microtubules (tubulin).</p>
            </div>
          </div>
        </div>
      `
    };
  }

  if (slug === 'cellular-respiration') {
    return {
      title: "Cellular Respiration Pathways & Energetics",
      html: `
        <div class="space-y-6">
          <div class="p-4 bg-emerald-50 border border-emerald-200 rounded-xl text-center">
            <div class="text-xs uppercase tracking-wider font-semibold text-emerald-700 mb-1">Overall Aerobic Respiration Equation</div>
            <div class="font-mono text-emerald-900 font-bold text-base sm:text-lg">C₆H₁₂O₆ + 6 O₂ → 6 CO₂ + 6 H₂O + 30–32 ATP</div>
          </div>

          <div class="grid gap-4 md:grid-cols-2">
            <div class="p-4 border border-gray-200 rounded-xl bg-white shadow-sm">
              <span class="inline-block px-2 py-0.5 text-xs font-semibold rounded bg-blue-100 text-blue-800 mb-2">Stage 1: Cytoplasm</span>
              <h4 class="font-bold text-gray-900 mb-1">Glycolysis</h4>
              <p class="text-sm text-gray-600 mb-2">Anaerobic splitting of 1 glucose (6C) into 2 molecules of pyruvate (3C).</p>
              <ul class="text-xs text-gray-500 list-disc pl-4 space-y-1">
                <li>Net Yield: <strong>2 ATP</strong> (substrate-level phosphorylation)</li>
                <li>Redox Yield: <strong>2 NADH</strong></li>
              </ul>
            </div>

            <div class="p-4 border border-gray-200 rounded-xl bg-white shadow-sm">
              <span class="inline-block px-2 py-0.5 text-xs font-semibold rounded bg-purple-100 text-purple-800 mb-2">Stage 2: Mitochondrial Matrix</span>
              <h4 class="font-bold text-gray-900 mb-1">Pyruvate Oxidation (Link Reaction)</h4>
              <p class="text-sm text-gray-600 mb-2">Decarboxylation of pyruvate to acetyl-CoA before entering the Krebs cycle.</p>
              <ul class="text-xs text-gray-500 list-disc pl-4 space-y-1">
                <li>Byproducts: <strong>2 CO₂</strong> released</li>
                <li>Redox Yield: <strong>2 NADH</strong></li>
              </ul>
            </div>

            <div class="p-4 border border-gray-200 rounded-xl bg-white shadow-sm">
              <span class="inline-block px-2 py-0.5 text-xs font-semibold rounded bg-amber-100 text-amber-800 mb-2">Stage 3: Mitochondrial Matrix</span>
              <h4 class="font-bold text-gray-900 mb-1">Citric Acid (Krebs) Cycle</h4>
              <p class="text-sm text-gray-600 mb-2">Cyclic series of 8 enzymatic reactions oxidizing acetyl-CoA completely.</p>
              <ul class="text-xs text-gray-500 list-disc pl-4 space-y-1">
                <li>Yield per Glucose: <strong>2 ATP/GTP</strong>, <strong>6 NADH</strong>, <strong>2 FADH₂</strong></li>
                <li>Byproducts: <strong>4 CO₂</strong></li>
              </ul>
            </div>

            <div class="p-4 border border-gray-200 rounded-xl bg-white shadow-sm">
              <span class="inline-block px-2 py-0.5 text-xs font-semibold rounded bg-emerald-100 text-emerald-800 mb-2">Stage 4: Inner Mitochondrial Membrane</span>
              <h4 class="font-bold text-gray-900 mb-1">Oxidative Phosphorylation</h4>
              <p class="text-sm text-gray-600 mb-2">Electron Transport Chain (Complexes I–IV) coupled with Chemiosmosis (ATP Synthase).</p>
              <ul class="text-xs text-gray-500 list-disc pl-4 space-y-1">
                <li>Terminal Electron Acceptor: <strong>Oxygen (O₂)</strong> forming H₂O</li>
                <li>ATP Yield: <strong>~26–28 ATP</strong> via proton motive force</li>
              </ul>
            </div>
          </div>
        </div>
      `
    };
  }

  if (slug === 'circulatory-system') {
    return {
      title: "Human Circulatory System & Blood Flow Mechanics",
      html: `
        <div class="space-y-6">
          <p class="text-gray-700 leading-relaxed">The human cardiovascular system is a closed double-circulation system consisting of the muscular four-chambered heart, blood vessels (arteries, arterioles, capillaries, venules, veins), and approximately 5 liters of blood circulating continuously to transport oxygen, nutrients, hormones, and metabolic wastes.</p>

          <div class="grid gap-4 md:grid-cols-2">
            <div class="p-4 border border-blue-100 rounded-xl bg-blue-50">
              <h4 class="font-bold text-blue-900 mb-2">Pulmonary Circulation (Low Pressure)</h4>
              <p class="text-sm text-blue-800 mb-2">Transports deoxygenated blood to the alveolar capillary beds of the lungs for gas exchange:</p>
              <p class="text-xs font-mono bg-white p-2 rounded border border-blue-200 text-blue-900">Right Ventricle → Pulmonary Trunk → Pulmonary Arteries → Alveolar Capillaries (O₂ pickup / CO₂ release) → Pulmonary Veins → Left Atrium</p>
            </div>

            <div class="p-4 border border-red-100 rounded-xl bg-red-50">
              <h4 class="font-bold text-red-900 mb-2">Systemic Circulation (High Pressure)</h4>
              <p class="text-sm text-red-800 mb-2">Transports oxygen-rich blood to all organs, muscular tissues, and extremities:</p>
              <p class="text-xs font-mono bg-white p-2 rounded border border-red-200 text-red-900">Left Ventricle → Aorta → Systemic Arteries → Capillary Beds (O₂ delivery / nutrient exchange) → Vena Cavae → Right Atrium</p>
            </div>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse border border-gray-200 text-sm">
              <thead class="bg-gray-100">
                <tr>
                  <th class="p-3 border-b font-semibold text-gray-900">Vessel Type</th>
                  <th class="p-3 border-b font-semibold text-gray-900">Structural Characteristics</th>
                  <th class="p-3 border-b font-semibold text-gray-900">Primary Function</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200">
                <tr class="hover:bg-gray-50">
                  <td class="p-3 font-medium text-gray-900">Arteries</td>
                  <td class="p-3 text-gray-600">Thick muscular walls (tunica media), elastic tissue, small lumen.</td>
                  <td class="p-3 text-gray-600">Carry high-pressure blood away from the heart.</td>
                </tr>
                <tr class="hover:bg-gray-50">
                  <td class="p-3 font-medium text-gray-900">Capillaries</td>
                  <td class="p-3 text-gray-600">Single layer of endothelial cells (tunica intima), microscopic lumen (~8 µm).</td>
                  <td class="p-3 text-gray-600">Gas, nutrient, and fluid exchange via diffusion and filtration.</td>
                </tr>
                <tr class="hover:bg-gray-50">
                  <td class="p-3 font-medium text-gray-900">Veins</td>
                  <td class="p-3 text-gray-600">Thin muscular walls, wide lumen, contain one-way semilunar valves.</td>
                  <td class="p-3 text-gray-600">Return low-pressure blood to the heart; serve as capacitance reservoirs.</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      `
    };
  }

  if (slug === 'digestive-system') {
    return {
      title: "Human Digestive System & Gastrointestinal Tract",
      html: `
        <div class="space-y-6">
          <p class="text-gray-700 leading-relaxed">The human digestive system processes macronutrients through mechanical digestion (chewing, churning, peristalsis) and chemical digestion (enzymatic hydrolysis) along the continuous gastrointestinal (GI) tract aided by accessory digestive organs.</p>

          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse border border-gray-200 text-sm">
              <thead class="bg-gray-100">
                <tr>
