            <div class="p-4 border border-gray-200 rounded-xl bg-white shadow-sm">
              <span class="inline-block px-2 py-0.5 text-xs font-semibold rounded bg-amber-100 text-amber-800 mb-2">Level 4</span>
              <h4 class="font-bold text-gray-900 mb-1">Quaternary Structure (4°)</h4>
              <p class="text-sm text-gray-600 mb-2">Spatial arrangement and non-covalent association of multiple independent polypeptide subunits into a functional multi-meric protein complex.</p>
              <p class="text-xs text-gray-500"><strong>Classic Examples:</strong> Hemoglobin (heterotetramer: 2α + 2β chains with iron heme groups), Collagen (triple helix), DNA polymerase.</p>
            </div>
          </div>
        </div>
      `
    };
  }

  return { title: "Biology Reference", html: "<p>Content currently unavailable.</p>" };
};

const content = getReferenceContent(tool.slug);
