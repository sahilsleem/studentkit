---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Gender</label>
            <select id="bmr-gender" class="w-full px-3 py-2 bg-page border border-border-line rounded-xl text-sm">
              <option value="male" selected>Male</option>
              <option value="female">Female</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Age</label>
            <input type="number" id="bmr-age" placeholder="e.g. 21" min="10" max="100" class="w-full px-3 py-2 bg-page border border-border-line rounded-xl text-sm" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Weight (kg)</label>
            <input type="number" id="bmr-weight" placeholder="e.g. 70" step="0.5" class="w-full px-3 py-2 bg-page border border-border-line rounded-xl text-sm" />
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Height (cm)</label>
            <input type="number" id="bmr-height" placeholder="e.g. 175" class="w-full px-3 py-2 bg-page border border-border-line rounded-xl text-sm" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Activity Level</label>
          <select id="bmr-act" class="w-full px-3 py-2 bg-page border border-border-line rounded-xl text-sm">
            <option value="1.2">Sedentary (desk work, little exercise)</option>
            <option value="1.375" selected>Lightly Active (1-3 days/week)</option>
            <option value="1.55">Moderately Active (3-5 days/week)</option>
            <option value="1.725">Very Active (6-7 days/week)</option>
          </select>
        </div>

        <button id="bmr-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Daily Caloric Needs
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Total Daily Energy Expenditure (TDEE)</div>
          <div id="bmr-tdee" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div class="text-xs text-slate-muted mt-1">Daily maintenance calories</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 text-xs text-slate-muted">
          <span>Basal Metabolic Rate (BMR): </span>
          <strong id="bmr-base" class="text-ink font-mono break-words">1,689 kcal/day</strong>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const g = (document.getElementById('bmr-gender') as HTMLSelectElement)?.value || 'male';
    const age = parseFloat((document.getElementById('bmr-age') as HTMLInputElement)?.value || '20');
    const w = parseFloat((document.getElementById('bmr-weight') as HTMLInputElement)?.value || '70');
    const h = parseFloat((document.getElementById('bmr-height') as HTMLInputElement)?.value || '175');
    const act = parseFloat((document.getElementById('bmr-act') as HTMLSelectElement)?.value || '1.375');

    // Mifflin-St Jeor Formula
    let bmr = 10 * w + 6.25 * h - 5 * age + (g === 'male' ? 5 : -161);
    let tdee = bmr * act;

    document.getElementById('bmr-base')!.textContent = Math.round(bmr).toLocaleString() + ' kcal/day';
    document.getElementById('bmr-tdee')!.textContent = Math.round(tdee).toLocaleString() + ' kcal';
  }


  document.getElementById('bmr-calc-btn')?.addEventListener('click', calculate);
</script>