<div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden mb-12 max-w-4xl mx-auto">
  <div class="p-6 sm:p-8">
    <div class="mb-6">
      <h2 class="text-xl font-bold text-gray-900 mb-2">Z-Score & Normal Distribution Calculator</h2>
      <p class="text-sm text-gray-600">Calculate Z-scores, normal distribution tail probabilities (P-values), and percentile rankings with step-by-step solutions.</p>
    </div>

    <!-- Mode Selector Tabs -->
    <div class="flex flex-wrap gap-2 mb-6 border-b border-gray-100 pb-4">
      <button type="button" id="tab-raw2z" class="zs-tab-btn px-4 py-2 text-sm font-medium rounded-lg bg-emerald-600 text-white transition-colors" data-mode="raw2z">
        Raw Score (x) → Z-Score
      </button>
      <button type="button" id="tab-z2prob" class="zs-tab-btn px-4 py-2 text-sm font-medium rounded-lg bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors" data-mode="z2prob">
        Z-Score → P-Value / Percentile
      </button>
      <button type="button" id="tab-z2raw" class="zs-tab-btn px-4 py-2 text-sm font-medium rounded-lg bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors" data-mode="z2raw">
        Z-Score → Raw Score (x)
      </button>
    </div>

    <form id="zs-form" class="space-y-6">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <!-- Field: Raw Score X -->
        <div id="group-x">
          <label for="zs-x" class="block text-sm font-semibold text-gray-800 mb-1">
            Raw Score (x)
          </label>
          <input
            type="number"
            id="zs-x"
            step="any"
            value="85"
            required
            inputmode="decimal"
            class="block w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-base font-medium text-gray-900"
            placeholder="85"
          />
        </div>

        <!-- Field: Mean (μ) -->
        <div id="group-mean">
          <label for="zs-mean" class="block text-sm font-semibold text-gray-800 mb-1">
            Population Mean (μ)
          </label>
          <input
            type="number"
            id="zs-mean"
            step="any"
            value="75"
            required
            inputmode="decimal"
            class="block w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-base font-medium text-gray-900"
            placeholder="75"
          />
        </div>

        <!-- Field: Std Dev (σ) -->
        <div id="group-sd">
          <label for="zs-sd" class="block text-sm font-semibold text-gray-800 mb-1">
            Standard Deviation (σ)
          </label>
          <input
            type="number"
            id="zs-sd"
            min="0.000001"
            step="any"
            value="10"
            required
            inputmode="decimal"
            class="block w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-base font-medium text-gray-900"
            placeholder="10"
          />
        </div>

        <!-- Field: Direct Z-score (Shown only in z2prob mode) -->
        <div id="group-z" class="hidden sm:col-span-3">
          <label for="zs-direct-z" class="block text-sm font-semibold text-gray-800 mb-1">
            Z-Score (Z)
          </label>
          <input
            type="number"
            id="zs-direct-z"
            step="any"
            value="1.0"
            inputmode="decimal"
            class="block w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-base font-medium text-gray-900"
            placeholder="1.0"
          />
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row gap-3 pt-2">
        <button type="submit" class="flex-1 bg-emerald-600 text-white px-6 py-3 rounded-xl font-semibold hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors shadow-sm min-h-[44px]">
          Calculate Z-Score
        </button>
        <button type="button" id="reset-btn" class="px-6 py-3 border border-gray-300 rounded-xl text-gray-700 font-semibold hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors min-h-[44px]">
          Reset
        </button>
      </div>
    </form>

    <div id="error-box" class="hidden mt-6 bg-red-50 text-red-700 p-4 rounded-xl text-sm font-medium border border-red-200"></div>

    <!-- Results Section -->
    <div id="result-section" class="mt-8 pt-8 border-t border-gray-100" aria-live="polite">
      <!-- Main Highlight Result Card -->
      <div class="bg-gradient-to-br from-emerald-50 to-teal-50 border border-emerald-200/80 rounded-2xl p-6 sm:p-8 text-center relative mb-6">
        <div class="flex justify-end absolute top-4 right-4">
          <button
            type="button"
            id="copy-result-btn"
            class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg bg-white/90 hover:bg-white text-emerald-800 border border-emerald-200 shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-emerald-500 min-h-[36px]"
            title="Copy calculated result"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
            <span>Copy Result</span>
          </button>
        </div>
        <p id="zs-main-label" class="text-sm font-semibold uppercase tracking-wider text-emerald-800 mb-1">Calculated Z-Score</p>
        <div id="zs-main-value" class="text-4xl sm:text-5xl font-extrabold text-emerald-950 my-2">+1.0000</div>
        <p id="zs-main-sub" class="text-sm text-emerald-700 font-medium">84.13th Percentile (Above Mean)</p>
      </div>

      <!-- Bell Curve Visual Indicator -->
      <div class="mb-6 bg-gray-50 border border-gray-200 rounded-xl p-4 sm:p-6">
        <div class="flex justify-between text-xs font-bold text-gray-500 mb-2">
          <span>-3σ (0.1%)</span>
          <span>-2σ (2.3%)</span>
          <span>-1σ (15.9%)</span>
          <span class="text-gray-900">μ (50.0%)</span>
          <span>+1σ (84.1%)</span>
          <span>+2σ (97.7%)</span>
          <span>+3σ (99.9%)</span>
        </div>
        <!-- Position Bar Indicator -->
        <div class="relative w-full bg-gray-200 h-3 rounded-full overflow-visible my-3">
          <div class="absolute inset-y-0 left-1/2 w-0.5 bg-gray-400 z-0"></div>
          <div id="curve-pin" class="absolute top-1/2 -translate-y-1/2 -translate-x-1/2 w-5 h-5 bg-emerald-600 rounded-full border-2 border-white shadow-md z-10 transition-all duration-300" style="left: 66.66%;"></div>
        </div>
        <div class="text-center text-xs text-gray-600 mt-2 font-medium" id="curve-position-desc">
          Z = 1.00 is 1.00 standard deviations above the population mean.
        </div>
      </div>

      <!-- Probabilities & Tail Areas Table -->
      <div class="overflow-x-auto rounded-xl border border-gray-200 mb-6">
        <table class="w-full text-left text-sm text-gray-600">
          <thead class="bg-gray-50 text-xs font-semibold uppercase text-gray-700 border-b border-gray-200">
            <tr>
              <th class="px-4 py-3">Probability Area / Tail</th>
              <th class="px-4 py-3">Mathematical Notation</th>
              <th class="px-4 py-3">Decimal Value</th>
              <th class="px-4 py-3">Percentage</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 bg-white">
            <tr class="hover:bg-gray-50/80">
              <td class="px-4 py-2.5 font-medium text-gray-900">Left Tail (P &lt; Z) / Percentile</td>
              <td class="px-4 py-2.5 font-mono text-xs">P(Z &lt; z)</td>
              <td class="px-4 py-2.5 font-semibold text-emerald-700" id="prob-left">0.8413</td>
              <td class="px-4 py-2.5 font-semibold text-emerald-700" id="pct-left">84.13%</td>
            </tr>
            <tr class="hover:bg-gray-50/80">
              <td class="px-4 py-2.5 font-medium text-gray-900">Right Tail (P &gt; Z)</td>
              <td class="px-4 py-2.5 font-mono text-xs">P(Z &gt; z) = 1 - Φ(z)</td>
              <td class="px-4 py-2.5" id="prob-right">0.1587</td>
              <td class="px-4 py-2.5" id="pct-right">15.87%</td>
            </tr>
            <tr class="hover:bg-gray-50/80">
              <td class="px-4 py-2.5 font-medium text-gray-900">Two-Tailed (Extreme Area)</td>
              <td class="px-4 py-2.5 font-mono text-xs">P(|Z| &gt; |z|)</td>
              <td class="px-4 py-2.5" id="prob-twotail">0.3173</td>
              <td class="px-4 py-2.5" id="pct-twotail">31.73%</td>
            </tr>
            <tr class="hover:bg-gray-50/80">
              <td class="px-4 py-2.5 font-medium text-gray-900">Center Area (Between -z and +z)</td>
              <td class="px-4 py-2.5 font-mono text-xs">P(-|z| &lt; Z &lt; |z|)</td>
              <td class="px-4 py-2.5" id="prob-center">0.6827</td>
              <td class="px-4 py-2.5" id="pct-center">68.27%</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Step-by-Step Derivation Box -->
      <div class="bg-gray-50 rounded-xl p-5 border border-gray-200">
        <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-2">Step-by-Step Solution</h3>
        <div id="zs-steps-content" class="text-sm text-gray-700 font-mono space-y-1.5 bg-white p-4 rounded-lg border border-gray-200/80">
          <!-- Populated by JS -->
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { copyToClipboard, formatResultNumber } from '../../utils/formatters';
  import { normalCdf } from '../../utils/statistics';

  const initZScoreCalculator = () => {
    let mode = 'raw2z'; // 'raw2z', 'z2prob', 'z2raw'

    const form = document.getElementById('zs-form') as HTMLFormElement;
    const tabBtns = document.querySelectorAll('.zs-tab-btn');

    const groupX = document.getElementById('group-x');
    const groupMean = document.getElementById('group-mean');
    const groupSd = document.getElementById('group-sd');
    const groupZ = document.getElementById('group-z');

    const inputX = document.getElementById('zs-x') as HTMLInputElement;
    const inputMean = document.getElementById('zs-mean') as HTMLInputElement;
    const inputSd = document.getElementById('zs-sd') as HTMLInputElement;
    const inputZ = document.getElementById('zs-direct-z') as HTMLInputElement;

    const resetBtn = document.getElementById('reset-btn');
    const copyBtn = document.getElementById('copy-result-btn');
    const errorBox = document.getElementById('error-box');

    const mainLabelEl = document.getElementById('zs-main-label');
    const mainValueEl = document.getElementById('zs-main-value');
    const mainSubEl = document.getElementById('zs-main-sub');

    const curvePin = document.getElementById('curve-pin');
    const curveDesc = document.getElementById('curve-position-desc');

    const probLeftEl = document.getElementById('prob-left');
    const pctLeftEl = document.getElementById('pct-left');
    const probRightEl = document.getElementById('prob-right');
    const pctRightEl = document.getElementById('pct-right');
    const probTwoTailEl = document.getElementById('prob-twotail');
    const pctTwoTailEl = document.getElementById('pct-twotail');
    const probCenterEl = document.getElementById('prob-center');
    const pctCenterEl = document.getElementById('pct-center');

    const stepsContentEl = document.getElementById('zs-steps-content');

    if (!form || !inputX) return;

    const updateVisibility = () => {
      tabBtns.forEach(btn => {
        const m = btn.getAttribute('data-mode');
        if (m === mode) {
          btn.classList.remove('bg-gray-100', 'text-gray-700', 'hover:bg-gray-200');
          btn.classList.add('bg-emerald-600', 'text-white');
        } else {
          btn.classList.remove('bg-emerald-600', 'text-white');
          btn.classList.add('bg-gray-100', 'text-gray-700', 'hover:bg-gray-200');
        }
      });

      if (mode === 'raw2z') {
        groupX?.classList.remove('hidden');
        groupMean?.classList.remove('hidden');
        groupSd?.classList.remove('hidden');
        groupZ?.classList.add('hidden');
      } else if (mode === 'z2prob') {
        groupX?.classList.add('hidden');
        groupMean?.classList.add('hidden');
        groupSd?.classList.add('hidden');
        groupZ?.classList.remove('hidden');
      } else if (mode === 'z2raw') {
        groupX?.classList.add('hidden');
        groupMean?.classList.remove('hidden');
        groupSd?.classList.remove('hidden');
        groupZ?.classList.remove('hidden');
      }
    };

    const calculate = () => {
      errorBox?.classList.add('hidden');

      let z = 0;
      let x = parseFloat(inputX.value);
      let mu = parseFloat(inputMean.value);
      let sigma = parseFloat(inputSd.value);
      let directZ = parseFloat(inputZ.value);

      if (mode === 'raw2z') {
        if (isNaN(x) || isNaN(mu) || isNaN(sigma) || sigma <= 0) {
          if (errorBox) {
            errorBox.textContent = 'Please enter valid numbers. Standard deviation (σ) must be strictly greater than 0.';
            errorBox.classList.remove('hidden');
          }
          return;
        }
        z = (x - mu) / sigma;
      } else if (mode === 'z2prob') {
        if (isNaN(directZ)) {
          if (errorBox) {
            errorBox.textContent = 'Please enter a valid numeric Z-Score.';
            errorBox.classList.remove('hidden');
          }
          return;
        }
        z = directZ;
      } else if (mode === 'z2raw') {
        if (isNaN(directZ) || isNaN(mu) || isNaN(sigma) || sigma <= 0) {
          if (errorBox) {
            errorBox.textContent = 'Please enter valid numbers. Standard deviation (σ) must be strictly greater than 0.';
            errorBox.classList.remove('hidden');
          }
          return;
        }
        z = directZ;
        x = mu + z * sigma;
      }

      // Normal Distribution CDF
      const pLeft = normalCdf(z, 0, 1);
      const pRight = 1 - pLeft;
      const absZ = Math.abs(z);
      const pTail = 1 - normalCdf(absZ, 0, 1);
      const pTwoTail = Math.min(1, pTail * 2);
      const pCenter = Math.max(0, 1 - pTwoTail);

      const zSign = z >= 0 ? '+' : '';
      const zFormatted = `${zSign}${z.toFixed(4)}`;
      const pctFormatted = (pLeft * 100).toFixed(2);

      if (mode === 'raw2z') {
        if (mainLabelEl) mainLabelEl.textContent = 'Calculated Z-Score (Z)';
        if (mainValueEl) mainValueEl.textContent = zFormatted;
        if (mainSubEl) mainSubEl.textContent = `${pctFormatted}th Percentile Rank (x = ${x}, μ = ${mu}, σ = ${sigma})`;

        if (stepsContentEl) {
          stepsContentEl.innerHTML = `
            <p>1. Formula: <strong>Z = (x - μ) / σ</strong></p>
            <p>2. Substitution: <strong>Z = (${x} - ${mu}) / ${sigma}</strong></p>
            <p>3. Calculated Z-Score: <strong>Z = ${(x - mu).toFixed(4)} / ${sigma} = ${zFormatted}</strong></p>
            <p>4. Percentile Rank: <strong>P(Z &lt; ${z.toFixed(4)}) = ${pLeft.toFixed(4)} (${pctFormatted}%)</strong></p>
          `;
        }
      } else if (mode === 'z2prob') {
        if (mainLabelEl) mainLabelEl.textContent = 'P-Value / Cumulative Probability';
        if (mainValueEl) mainValueEl.textContent = `P = ${pLeft.toFixed(4)}`;
        if (mainSubEl) mainSubEl.textContent = `Percentile: ${pctFormatted}% for Z = ${zFormatted}`;

        if (stepsContentEl) {
          stepsContentEl.innerHTML = `
            <p>1. Input Z-Score: <strong>Z = ${zFormatted}</strong></p>
            <p>2. Left-Tail Area Φ(z): <strong>P(Z &lt; ${z.toFixed(4)}) = ${pLeft.toFixed(5)} (${pctFormatted}%)</strong></p>
            <p>3. Right-Tail Area: <strong>P(Z &gt; ${z.toFixed(4)}) = 1 - Φ(${z.toFixed(4)}) = ${pRight.toFixed(5)} (${(pRight * 100).toFixed(2)}%)</strong></p>
          `;
        }
      } else if (mode === 'z2raw') {
        if (mainLabelEl) mainLabelEl.textContent = 'Calculated Raw Score (x)';
        if (mainValueEl) mainValueEl.textContent = x.toFixed(4);
        if (mainSubEl) mainSubEl.textContent = `For Z = ${zFormatted}, Mean = ${mu}, Std Dev = ${sigma}`;

        if (stepsContentEl) {
          stepsContentEl.innerHTML = `
            <p>1. Formula: <strong>x = μ + (Z × σ)</strong></p>
            <p>2. Substitution: <strong>x = ${mu} + (${zFormatted} × ${sigma})</strong></p>
            <p>3. Calculated Raw Score: <strong>x = ${mu} + ${(z * sigma).toFixed(4)} = ${x.toFixed(4)}</strong></p>
          `;
        }
      }

      // Visual Bell Curve Pin Position (-3 to +3 maps to 0% to 100%)
      const clampedZ = Math.max(-3.5, Math.min(3.5, z));
      const pinPercent = ((clampedZ + 3.5) / 7.0) * 100;
      if (curvePin) curvePin.style.left = `${pinPercent}%`;

      if (curveDesc) {
        if (z === 0) {
          curveDesc.textContent = 'Z = 0.00 is exactly at the population mean (50th percentile).';
        } else if (z > 0) {
          curveDesc.textContent = `Z = ${zFormatted} is ${Math.abs(z).toFixed(2)} standard deviations ABOVE the mean.`;
        } else {
          curveDesc.textContent = `Z = ${zFormatted} is ${Math.abs(z).toFixed(2)} standard deviations BELOW the mean.`;
        }
      }

      // Populate table values
      if (probLeftEl) probLeftEl.textContent = pLeft.toFixed(4);
      if (pctLeftEl) pctLeftEl.textContent = `${(pLeft * 100).toFixed(2)}%`;

      if (probRightEl) probRightEl.textContent = pRight.toFixed(4);
      if (pctRightEl) pctRightEl.textContent = `${(pRight * 100).toFixed(2)}%`;

      if (probTwoTailEl) probTwoTailEl.textContent = pTwoTail.toFixed(4);
      if (pctTwoTailEl) pctTwoTailEl.textContent = `${(pTwoTail * 100).toFixed(2)}%`;

      if (probCenterEl) probCenterEl.textContent = pCenter.toFixed(4);
      if (pctCenterEl) pctCenterEl.textContent = `${(pCenter * 100).toFixed(2)}%`;
    };

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        mode = btn.getAttribute('data-mode') || 'raw2z';
        updateVisibility();
        calculate();
      });
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      calculate();
    });

    inputX.addEventListener('input', calculate);
    inputMean.addEventListener('input', calculate);
    inputSd.addEventListener('input', calculate);
    inputZ.addEventListener('input', calculate);

    resetBtn?.addEventListener('click', () => {
      mode = 'raw2z';
      inputX.value = '85';
      inputMean.value = '75';
      inputSd.value = '10';
      inputZ.value = '1.0';
      updateVisibility();
      calculate();
    });

    copyBtn?.addEventListener('click', async () => {
      const text = mainValueEl?.textContent || '';
      const success = await copyToClipboard(text);
      if (success) {
        const span = copyBtn.querySelector('span');
        if (span) {
          const original = span.textContent;
          span.textContent = 'Copied!';
          setTimeout(() => { span.textContent = original; }, 1500);
        }
      }
    });

    updateVisibility();
    calculate();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initZScoreCalculator);
  } else {
    initZScoreCalculator();
  }
</script>
