---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Input Number</label>
          <input type="text" id="sig-input" placeholder="e.g. 0.0045020" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent font-mono" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Round to Sig Figs</label>
          <input type="number" id="sig-target" min="1" max="10" placeholder="e.g. 3" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <button id="sig-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Count & Round Sig Figs
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Significant Figures Count</div>
          <div id="sig-count" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div id="sig-scinot" class="text-xs text-slate-muted mt-1">Scientific notation appears here</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 space-y-1.5 text-xs text-slate-muted">
          <div class="flex flex-wrap justify-between gap-2">
            <span>Rounded Result:</span>
            <strong id="sig-rounded" class="text-ink font-mono break-words">--</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function countSigFigs(str: string): number {
    str = str.trim();
    if (!str || isNaN(Number(str))) return 0;
    const s = str.replace(/^-/, '');
    if (s.includes('.')) {
      const firstNonZero = s.search(/[1-9]/);
      if (firstNonZero === -1) return 1;
      return s.slice(firstNonZero).replace('.', '').length;
    } else {
      return s.replace(/^0+/, '').replace(/0+$/, '').length || 1;
    }
  }

  function analyze() {
    const valStr = (document.getElementById('sig-input') as HTMLInputElement)?.value?.trim();
    if (!valStr) {
      document.getElementById('sig-count')!.textContent = '--';
      document.getElementById('sig-scinot')!.textContent = 'Scientific notation appears here';
      document.getElementById('sig-rounded')!.textContent = '--';
      return;
    }
    const target = parseInt((document.getElementById('sig-target') as HTMLInputElement)?.value || '3', 10);

    const count = countSigFigs(valStr);
    const num = parseFloat(valStr);

    const countEl = document.getElementById('sig-count');
    const sciEl = document.getElementById('sig-scinot');
    const roundEl = document.getElementById('sig-rounded');

    if (countEl) countEl.textContent = count + ' sig figs';
    if (!isNaN(num)) {
      if (sciEl) sciEl.textContent = 'Scientific: ' + num.toExponential();
      if (roundEl) roundEl.textContent = num.toPrecision(target);
    }
  }

  document.getElementById('sig-calc-btn')?.addEventListener('click', analyze);
</script>