---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Input Number</label>
          <input type="text" id="sig-input" placeholder="e.g. 0.0045020" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 font-mono" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Round to Sig Figs</label>
          <input type="number" id="sig-target" min="1" max="10" placeholder="e.g. 3" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <button id="sig-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Count & Round Sig Figs
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Significant Figures Count</div>
          <div id="sig-count" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
          <div id="sig-scinot" class="text-xs text-slate-400 mt-2">Scientific notation appears here</div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 space-y-2 text-xs text-slate-600">
          <div class="flex justify-between">
            <span>Rounded Result:</span>
            <strong id="sig-rounded" class="text-slate-800 font-mono">--</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function countSigFigs(str: string): number {
    str = str.trim();
    if (!str || isNaN(Number(str))) return 0;
    const s = str.replace(/^-/, '');
    if (s.includes('.')) {
      const firstNonZero = s.search(/[1-9]/);
      if (firstNonZero === -1) return 1;
      return s.slice(firstNonZero).replace('.', '').length;
    } else {
      return s.replace(/^0+/, '').replace(/0+$/, '').length || 1;
    }
  }

  function analyze() {
    const valStr = (document.getElementById('sig-input') as HTMLInputElement)?.value?.trim();
    if (!valStr) {
      document.getElementById('sig-count')!.textContent = '--';
      document.getElementById('sig-scinot')!.textContent = 'Scientific notation appears here';
      document.getElementById('sig-rounded')!.textContent = '--';
      return;
    }
    const target = parseInt((document.getElementById('sig-target') as HTMLInputElement)?.value || '3', 10);

    const count = countSigFigs(valStr);
    const num = parseFloat(valStr);

    const countEl = document.getElementById('sig-count');
    const sciEl = document.getElementById('sig-scinot');
    const roundEl = document.getElementById('sig-rounded');

    if (countEl) countEl.textContent = count + ' sig figs';
    if (!isNaN(num)) {
      if (sciEl) sciEl.textContent = 'Scientific: ' + num.toExponential();
      if (roundEl) roundEl.textContent = num.toPrecision(target);
    }
  }

  document.getElementById('sig-calc-btn')?.addEventListener('click', analyze);
</script>