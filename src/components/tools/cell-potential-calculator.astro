---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Cathode Standard Potential (E°_red in V)</label>
          <input type="number" id="cp-cat" placeholder="e.g. 0.34" step="0.01" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
          <span class="text-xs text-slate-400">e.g. Cu²⁺ + 2e⁻ → Cu (+0.34 V)</span>
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Anode Standard Potential (E°_red in V)</label>
          <input type="number" id="cp-an" placeholder="e.g. -0.76" step="0.01" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
          <span class="text-xs text-slate-400">e.g. Zn²⁺ + 2e⁻ → Zn (-0.76 V)</span>
        </div>

        <button id="cp-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Standard Cell Potential
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Standard Cell Potential (E°_cell = E°_cat - E°_an)</div>
          <div id="cp-ecell" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
          <div id="cp-spont" class="text-xs text-emerald-600 font-semibold mt-2">Spontaneous Galvanic Cell (ΔG° &lt; 0)</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const cat = parseFloat((document.getElementById('cp-cat') as HTMLInputElement)?.value || '0');
    const an = parseFloat((document.getElementById('cp-an') as HTMLInputElement)?.value || '0');

    const ecell = cat - an;

    document.getElementById('cp-ecell')!.textContent = (ecell >= 0 ? '+' : '') + ecell.toFixed(2) + ' V';
    const spEl = document.getElementById('cp-spont');
    if (spEl) {
      spEl.textContent = ecell > 0 ? 'Spontaneous Galvanic Cell (ΔG° < 0)' : 'Non-spontaneous Electrolytic Cell (ΔG° > 0)';
      spEl.className = 'text-xs font-semibold mt-2 ' + (ecell > 0 ? 'text-emerald-600' : 'text-rose-600');
    }
  }


  document.getElementById('cp-calc-btn')?.addEventListener('click', calculate);
</script>