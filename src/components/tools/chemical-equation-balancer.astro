---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="space-y-4">
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Unbalanced Chemical Equation</label>
        <div class="flex gap-2">
          <input type="text" id="ceb-input" placeholder="e.g. C6H12O6 + O2 -> CO2 + H2O" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 font-mono" />
          <button id="ceb-calc-btn" type="button" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all shrink-0">
            Balance
          </button>
        </div>
      </div>

      <div class="p-6 bg-slate-50 rounded-xl border border-slate-200/80 mt-6">
        <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Balanced Chemical Equation</div>
        <div id="ceb-output" class="text-2xl sm:text-3xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
      </div>
    </div>
  </div>
</div>

<script>
  import { balanceEquation } from '../../utils/equationBalancer';

  function calculate() {
    const input = (document.getElementById('ceb-input') as HTMLInputElement)?.value || '';
    const outEl = document.getElementById('ceb-output');

    try {
      const balanced = balanceEquation(input);
      if (outEl) outEl.textContent = balanced;
    } catch {
      if (outEl) outEl.textContent = 'Could not balance equation. Please check formula syntax.';
    }
  }


  document.getElementById('ceb-calc-btn')?.addEventListener('click', calculate);
</script>