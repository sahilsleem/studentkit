---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="space-y-3.5">
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Unbalanced Chemical Equation</label>
        <div class="flex flex-wrap gap-2">
          <input type="text" id="ceb-input" placeholder="e.g. C6H12O6 + O2 -> CO2 + H2O" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent font-mono" />
          <button id="ceb-calc-btn" type="button" class="px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all shrink-0">
            Balance
          </button>
        </div>
      </div>

      <div class="p-4 sm:p-5 bg-page rounded-xl border border-border-line/80 mt-4">
        <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Balanced Chemical Equation</div>
        <div id="ceb-output" class="text-2xl sm:text-3xl font-extrabold text-brand mt-1 font-mono">--</div>
      </div>
    </div>
  </div>
</div>

<script>
  import { balanceEquation } from '../../utils/equationBalancer';

  function calculate() {
    const input = (document.getElementById('ceb-input') as HTMLInputElement)?.value || '';
    const outEl = document.getElementById('ceb-output');

    try {
      const balanced = balanceEquation(input);
      if (outEl) outEl.textContent = balanced;
    } catch {
      if (outEl) outEl.textContent = 'Could not balance equation. Please check formula syntax.';
    }
  }


  document.getElementById('ceb-calc-btn')?.addEventListener('click', calculate);
</script>