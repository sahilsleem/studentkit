---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Initial Amount (₹)</label>
          <input type="number" id="inf-amount" step="100" min="1" placeholder="e.g. 1000" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Annual Inflation Rate (%)</label>
          <input type="number" id="inf-rate" step="0.1" min="0" max="50" placeholder="e.g. 3.5" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Time Horizon (Years)</label>
          <input type="number" id="inf-years" step="1" min="1" max="100" placeholder="e.g. 10" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <button id="inf-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Inflation Impact
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Future Equivalent Cost</div>
          <div id="inf-future-cost" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
          <div id="inf-cum-rate" class="text-xs text-slate-500 mt-2">+41.06% cumulative inflation</div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 space-y-2 text-xs text-slate-600">
          <div class="flex justify-between">
            <span>Future Purchasing Power of ₹1,000:</span>
            <strong id="inf-future-power" class="text-slate-800 font-bold">--</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const amtIn = document.getElementById('inf-amount') as HTMLInputElement;
  const rateIn = document.getElementById('inf-rate') as HTMLInputElement;
  const yrsIn = document.getElementById('inf-years') as HTMLInputElement;

  const costEl = document.getElementById('inf-future-cost');
  const cumEl = document.getElementById('inf-cum-rate');
  const powerEl = document.getElementById('inf-future-power');

  function calculate() {
    const P = parseFloat(amtIn?.value || '0');
    const r = parseFloat(rateIn?.value || '0') / 100;
    const t = parseFloat(yrsIn?.value || '1');

    const futureCost = P * Math.pow(1 + r, t);
    const purchasingPower = P / Math.pow(1 + r, t);
    const cumRate = ((futureCost - P) / P) * 100;

    const fmt = (v: number) => '₹' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    if (costEl) costEl.textContent = fmt(futureCost);
    if (cumEl) cumEl.textContent = '+' + cumRate.toFixed(2) + '% cumulative inflation';
    if (powerEl) powerEl.textContent = fmt(purchasingPower);
  }


  document.getElementById('inf-calc-btn')?.addEventListener('click', calculate);
</script>