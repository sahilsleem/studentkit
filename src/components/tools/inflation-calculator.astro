---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Initial Amount (₹)</label>
          <input type="number" id="inf-amount" step="100" min="1" placeholder="e.g. 1000" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Annual Inflation Rate (%)</label>
          <input type="number" id="inf-rate" step="0.1" min="0" max="50" placeholder="e.g. 3.5" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Time Horizon (Years)</label>
          <input type="number" id="inf-years" step="1" min="1" max="100" placeholder="e.g. 10" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <button id="inf-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Inflation Impact
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Future Equivalent Cost</div>
          <div id="inf-future-cost" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div id="inf-cum-rate" class="text-xs text-slate-muted mt-1">+41.06% cumulative inflation</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 space-y-1.5 text-xs text-slate-muted">
          <div class="flex flex-wrap justify-between gap-2">
            <span>Future Purchasing Power of ₹1,000:</span>
            <strong id="inf-future-power" class="text-ink font-bold">--</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const amtIn = document.getElementById('inf-amount') as HTMLInputElement;
  const rateIn = document.getElementById('inf-rate') as HTMLInputElement;
  const yrsIn = document.getElementById('inf-years') as HTMLInputElement;

  const costEl = document.getElementById('inf-future-cost');
  const cumEl = document.getElementById('inf-cum-rate');
  const powerEl = document.getElementById('inf-future-power');

  function calculate() {
    const P = parseFloat(amtIn?.value || '0');
    const r = parseFloat(rateIn?.value || '0') / 100;
    const t = parseFloat(yrsIn?.value || '1');

    const futureCost = P * Math.pow(1 + r, t);
    const purchasingPower = P / Math.pow(1 + r, t);
    const cumRate = ((futureCost - P) / P) * 100;

    const fmt = (v: number) => '₹' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    if (costEl) costEl.textContent = fmt(futureCost);
    if (cumEl) cumEl.textContent = '+' + cumRate.toFixed(2) + '% cumulative inflation';
    if (powerEl) powerEl.textContent = fmt(purchasingPower);
  }


  document.getElementById('inf-calc-btn')?.addEventListener('click', calculate);
</script>