---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="space-y-3.5">
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Chemical Formula</label>
        <div class="flex flex-wrap gap-2">
          <input type="text" id="pc-comp-form" placeholder="e.g. C6H12O6" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent font-mono" />
          <button id="pc-comp-btn" type="button" class="px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all shrink-0">
            Calculate %
          </button>
        </div>
      </div>

      <div class="p-4 sm:p-5 bg-page rounded-xl border border-border-line/80 mt-4">
        <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider mb-1">Mass Percent Composition</div>
        <div id="pc-comp-res" class="text-lg font-mono text-ink space-y-1">
          <div>Carbon (C): 40.00%</div>
          <div>Hydrogen (H): 6.72%</div>
          <div>Oxygen (O): 53.28%</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { parseChemicalFormula } from '../../utils/chemicalParser';
  import { ELEMENT_MASSES } from '../../utils/chemistryConstants';

  function calculate() {
    const f = (document.getElementById('pc-comp-form') as HTMLInputElement)?.value || '';
    const resEl = document.getElementById('pc-comp-res');

    try {
      const counts = parseChemicalFormula(f);
      let totalMW = 0;
      for (const [el, count] of Object.entries(counts)) {
        totalMW += (ELEMENT_MASSES[el] || 0) * count;
      }

      if (totalMW === 0) return;

      const lines = Object.entries(counts).map(([el, count]) => {
        const mass = (ELEMENT_MASSES[el] || 0) * count;
        const pct = (mass / totalMW) * 100;
        return '<div>' + el + ': <strong>' + pct.toFixed(2) + '%</strong> (' + mass.toFixed(2) + ' g/mol)</div>';
      });

      if (resEl) resEl.innerHTML = lines.join('');
    } catch {
      if (resEl) resEl.textContent = 'Invalid formula';
    }
  }


  document.getElementById('pc-comp-btn')?.addEventListener('click', calculate);
</script>