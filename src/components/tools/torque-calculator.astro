---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Applied Force (F in N)</label>
          <input type="number" id="tq-f" placeholder="e.g. 50" min="0" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Lever Arm Length (r in meters)</label>
          <input type="number" id="tq-r" placeholder="e.g. 0.4" min="0" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Angle θ (degrees)</label>
          <input type="number" id="tq-angle" placeholder="e.g. 90" min="0" max="180" step="1" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>

        <button id="tq-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Torque
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Resulting Torque (τ = r·F·sin θ)</div>
          <div id="tq-res" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 text-xs text-slate-muted">
          <span>Equivalent in Foot-Pounds: </span>
          <strong id="tq-ftlb" class="text-ink font-mono break-words">14.75 ft·lb</strong>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const f = parseFloat((document.getElementById('tq-f') as HTMLInputElement)?.value || '0');
    const r = parseFloat((document.getElementById('tq-r') as HTMLInputElement)?.value || '0');
    const deg = parseFloat((document.getElementById('tq-angle') as HTMLInputElement)?.value || '90');

    const rad = (deg * Math.PI) / 180;
    const torque = r * f * Math.sin(rad);
    const ftlb = torque * 0.737562;

    document.getElementById('tq-res')!.textContent = torque.toFixed(2) + ' N·m';
    document.getElementById('tq-ftlb')!.textContent = ftlb.toFixed(2) + ' ft·lb';
  }


  document.getElementById('tq-calc-btn')?.addEventListener('click', calculate);
</script>