---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">pKa of Weak Acid</label>
          <input type="number" id="buf-pka" placeholder="e.g. 4.76" step="0.01" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Conjugate Base Conc [A-] (M)</label>
          <input type="number" id="buf-base" placeholder="e.g. 0.1" min="0.0001" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Weak Acid Conc [HA] (M)</label>
          <input type="number" id="buf-acid" placeholder="e.g. 0.1" min="0.0001" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>

        <button id="buf-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Buffer pH (Henderson-Hasselbalch)
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Buffer pH</div>
          <div id="buf-ph" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div class="text-xs text-slate-muted mt-1">Formula: pH = pKa + log([A-]/[HA])</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const pka = parseFloat((document.getElementById('buf-pka') as HTMLInputElement)?.value || '4.76');
    const base = parseFloat((document.getElementById('buf-base') as HTMLInputElement)?.value || '0.1');
    const acid = parseFloat((document.getElementById('buf-acid') as HTMLInputElement)?.value || '0.1');

    if (acid <= 0 || base <= 0) return;
    const ph = pka + Math.log10(base / acid);

    document.getElementById('buf-ph')!.textContent = ph.toFixed(2);
  }


  document.getElementById('buf-calc-btn')?.addEventListener('click', calculate);
</script>