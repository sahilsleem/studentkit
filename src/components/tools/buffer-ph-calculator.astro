---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">pKa of Weak Acid</label>
          <input type="number" id="buf-pka" placeholder="e.g. 4.76" step="0.01" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Conjugate Base Conc [A-] (M)</label>
          <input type="number" id="buf-base" placeholder="e.g. 0.1" min="0.0001" step="any" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Weak Acid Conc [HA] (M)</label>
          <input type="number" id="buf-acid" placeholder="e.g. 0.1" min="0.0001" step="any" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>

        <button id="buf-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Buffer pH (Henderson-Hasselbalch)
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Buffer pH</div>
          <div id="buf-ph" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
          <div class="text-xs text-slate-500 mt-2">Formula: pH = pKa + log([A-]/[HA])</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const pka = parseFloat((document.getElementById('buf-pka') as HTMLInputElement)?.value || '4.76');
    const base = parseFloat((document.getElementById('buf-base') as HTMLInputElement)?.value || '0.1');
    const acid = parseFloat((document.getElementById('buf-acid') as HTMLInputElement)?.value || '0.1');

    if (acid <= 0 || base <= 0) return;
    const ph = pka + Math.log10(base / acid);

    document.getElementById('buf-ph')!.textContent = ph.toFixed(2);
  }


  document.getElementById('buf-calc-btn')?.addEventListener('click', calculate);
</script>