---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Raw Score (x)</label>
          <input type="number" id="zs-x" step="any" placeholder="e.g. 85" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Population Mean (μ)</label>
          <input type="number" id="zs-mean" step="any" placeholder="e.g. 70" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Standard Deviation (σ)</label>
          <input type="number" id="zs-sd" min="0.001" step="any" placeholder="e.g. 10" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <button id="zs-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Z-Score
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Standardized Z-Score</div>
          <div id="zs-score" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div id="zs-prob" class="text-xs text-slate-muted mt-1">P(X ≤ 85) = 93.32%</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 space-y-1.5 text-xs text-slate-muted">
          <div class="flex flex-wrap justify-between gap-2">
            <span>Percentile Rank:</span>
            <strong id="zs-pct" class="text-ink">93.3rd Percentile</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function cdf(z: number): number {
    return 0.5 * (1 + Math.sign(z) * Math.sqrt(1 - Math.exp(-2 * z * z / Math.PI)));
  }

  function calculate() {
    const x = parseFloat((document.getElementById('zs-x') as HTMLInputElement)?.value || '0');
    const mu = parseFloat((document.getElementById('zs-mean') as HTMLInputElement)?.value || '0');
    const sigma = parseFloat((document.getElementById('zs-sd') as HTMLInputElement)?.value || '1');

    if (sigma <= 0) return;

    const z = (x - mu) / sigma;
    const p = cdf(z) * 100;

    const zEl = document.getElementById('zs-score');
    const probEl = document.getElementById('zs-prob');
    const pctEl = document.getElementById('zs-pct');

    if (zEl) zEl.textContent = (z >= 0 ? '+' : '') + z.toFixed(2);
    if (probEl) probEl.textContent = 'P(X ≤ ' + x + ') = ' + p.toFixed(2) + '%';
    if (pctEl) pctEl.textContent = p.toFixed(1) + 'th Percentile';
  }


  document.getElementById('zs-calc-btn')?.addEventListener('click', calculate);
</script>