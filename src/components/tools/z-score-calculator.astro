---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Raw Score (x)</label>
          <input type="number" id="zs-x" step="any" placeholder="e.g. 85" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Population Mean (μ)</label>
          <input type="number" id="zs-mean" step="any" placeholder="e.g. 70" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Standard Deviation (σ)</label>
          <input type="number" id="zs-sd" min="0.001" step="any" placeholder="e.g. 10" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <button id="zs-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Z-Score
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Standardized Z-Score</div>
          <div id="zs-score" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
          <div id="zs-prob" class="text-xs text-slate-500 mt-2">P(X ≤ 85) = 93.32%</div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 space-y-2 text-xs text-slate-600">
          <div class="flex justify-between">
            <span>Percentile Rank:</span>
            <strong id="zs-pct" class="text-slate-800">93.3rd Percentile</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function cdf(z: number): number {
    return 0.5 * (1 + Math.sign(z) * Math.sqrt(1 - Math.exp(-2 * z * z / Math.PI)));
  }

  function calculate() {
    const x = parseFloat((document.getElementById('zs-x') as HTMLInputElement)?.value || '0');
    const mu = parseFloat((document.getElementById('zs-mean') as HTMLInputElement)?.value || '0');
    const sigma = parseFloat((document.getElementById('zs-sd') as HTMLInputElement)?.value || '1');

    if (sigma <= 0) return;

    const z = (x - mu) / sigma;
    const p = cdf(z) * 100;

    const zEl = document.getElementById('zs-score');
    const probEl = document.getElementById('zs-prob');
    const pctEl = document.getElementById('zs-pct');

    if (zEl) zEl.textContent = (z >= 0 ? '+' : '') + z.toFixed(2);
    if (probEl) probEl.textContent = 'P(X ≤ ' + x + ') = ' + p.toFixed(2) + '%';
    if (pctEl) pctEl.textContent = p.toFixed(1) + 'th Percentile';
  }


  document.getElementById('zs-calc-btn')?.addEventListener('click', calculate);
</script>