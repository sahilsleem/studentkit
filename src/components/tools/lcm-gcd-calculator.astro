---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="space-y-3.5">
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Enter integers separated by commas</label>
        <input type="text" id="lg-input" placeholder="e.g. 24, 36, 60" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent font-mono" />
      </div>

      <button id="lg-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
        Calculate LCM & GCD
      </button>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4">
        <div class="p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">GCD / HCF (Greatest Common Divisor)</div>
          <div id="lg-gcd" class="text-3xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
        </div>
        <div class="p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">LCM (Least Common Multiple)</div>
          <div id="lg-lcm" class="text-3xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function gcd(a: number, b: number): number {
    return b === 0 ? Math.abs(a) : gcd(b, a % b);
  }

  function lcm(a: number, b: number): number {
    return Math.abs(a * b) / gcd(a, b);
  }

  function calculate() {
    const raw = (document.getElementById('lg-input') as HTMLInputElement)?.value || '';
    const nums = raw.split(',').map(s => parseInt(s.trim(), 10)).filter(n => !isNaN(n) && n > 0);

    if (nums.length < 2) return;

    let currentGcd = nums[0];
    let currentLcm = nums[0];

    for (let i = 1; i < nums.length; i++) {
      currentGcd = gcd(currentGcd, nums[i]);
      currentLcm = lcm(currentLcm, nums[i]);
    }

    const gcdEl = document.getElementById('lg-gcd');
    const lcmEl = document.getElementById('lg-lcm');

    if (gcdEl) gcdEl.textContent = currentGcd.toString();
    if (lcmEl) lcmEl.textContent = currentLcm.toLocaleString();
  }


  document.getElementById('lg-calc-btn')?.addEventListener('click', calculate);
</script>