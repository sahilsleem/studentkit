---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Number of Trials (n)</label>
          <input type="number" id="bd-n" min="1" max="100" placeholder="e.g. 10" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Probability of Success (p)</label>
          <input type="number" id="bd-p" min="0" max="1" step="0.05" placeholder="e.g. 0.3" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Number of Successes (k)</label>
          <input type="number" id="bd-k" min="0" max="100" placeholder="e.g. 3" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <button id="bd-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Binomial Probability
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Exact Probability P(X = k)</div>
          <div id="bd-exact" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
          <div id="bd-exact-pct" class="text-xs text-slate-500 mt-2">26.68% chance</div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 space-y-2 text-xs text-slate-600">
          <div class="flex justify-between">
            <span>Cumulative P(X ≤ k):</span>
            <strong id="bd-cum" class="text-slate-800 font-mono">0.6496</strong>
          </div>
          <div class="flex justify-between">
            <span>Expected Value (μ = np):</span>
            <strong id="bd-mean" class="text-slate-800 font-mono">3.00</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function nCr(n: number, r: number): number {
    if (r < 0 || r > n) return 0;
    let res = 1;
    for (let i = 1; i <= r; i++) {
      res = (res * (n - i + 1)) / i;
    }
    return res;
  }

  function calculate() {
    const n = parseInt((document.getElementById('bd-n') as HTMLInputElement)?.value || '10', 10);
    const p = parseFloat((document.getElementById('bd-p') as HTMLInputElement)?.value || '0.5');
    const k = parseInt((document.getElementById('bd-k') as HTMLInputElement)?.value || '5', 10);

    if (k < 0 || k > n || p < 0 || p > 1) return;

    const exact = nCr(n, k) * Math.pow(p, k) * Math.pow(1 - p, n - k);
    let cum = 0;
    for (let i = 0; i <= k; i++) {
      cum += nCr(n, i) * Math.pow(p, i) * Math.pow(1 - p, n - i);
    }

    const mean = n * p;

    const exactEl = document.getElementById('bd-exact');
    const exactPctEl = document.getElementById('bd-exact-pct');
    const cumEl = document.getElementById('bd-cum');
    const meanEl = document.getElementById('bd-mean');

    if (exactEl) exactEl.textContent = exact.toFixed(4);
    if (exactPctEl) exactPctEl.textContent = (exact * 100).toFixed(2) + '% chance';
    if (cumEl) cumEl.textContent = cum.toFixed(4);
    if (meanEl) meanEl.textContent = mean.toFixed(2);
  }


  document.getElementById('bd-calc-btn')?.addEventListener('click', calculate);
</script>