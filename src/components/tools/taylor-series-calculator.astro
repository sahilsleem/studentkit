---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Standard Function f(x)</label>
          <select id="ts-func" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent">
            <option value="exp" selected>eˣ (Exponential)</option>
            <option value="sin">sin(x)</option>
            <option value="cos">cos(x)</option>
            <option value="ln">ln(1 + x)</option>
            <option value="geom">1 / (1 - x)</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Order / Degree (n)</label>
          <input type="number" id="ts-n" min="1" max="8" placeholder="e.g. 4" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <button id="ts-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Generate Maclaurin Series
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Series Polynomial Pₙ(x) (Center a = 0)</div>
          <div id="ts-series" class="text-2xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 text-xs text-slate-muted">
          <span>Radius of Convergence: </span>
          <strong id="ts-radius" class="text-ink font-mono break-words">--</strong>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const seriesMap: Record<string, { series: string[], radius: string }> = {
    exp: { series: ['1', 'x', 'x²/2!', 'x³/3!', 'x⁴/4!', 'x⁵/5!', 'x⁶/6!'], radius: 'R = ∞' },
    sin: { series: ['x', '- x³/3!', '+ x⁵/5!', '- x⁷/7!'], radius: 'R = ∞' },
    cos: { series: ['1', '- x²/2!', '+ x⁴/4!', '- x⁶/6!'], radius: 'R = ∞' },
    ln: { series: ['x', '- x²/2', '+ x³/3', '- x⁴/4', '+ x⁵/5'], radius: 'R = 1 (-1 < x ≤ 1)' },
    geom: { series: ['1', 'x', 'x²', 'x³', 'x⁴', 'x⁵', 'x⁶'], radius: 'R = 1 (|x| < 1)' }
  };

  function update() {
    const fn = (document.getElementById('ts-func') as HTMLSelectElement)?.value || 'exp';
    const n = parseInt((document.getElementById('ts-n') as HTMLInputElement)?.value || '4', 10);
    const data = seriesMap[fn];

    const seriesEl = document.getElementById('ts-series');
    const radEl = document.getElementById('ts-radius');

    if (seriesEl && data) seriesEl.textContent = data.series.slice(0, n + 1).join(' + ').replace(/\+ -/g, '- ');
    if (radEl && data) radEl.textContent = data.radius;
  }


  document.getElementById('ts-calc-btn')?.addEventListener('click', update);
</script>