<div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden mb-12 max-w-4xl mx-auto">
  <div class="p-6 sm:p-8">
    <div class="mb-6">
      <h2 class="text-xl font-bold text-gray-900 mb-2">Permutations & Combinations Calculator (nPr & nCr)</h2>
      <p class="text-sm text-gray-600">Calculate permutations, combinations, subsets, and arrangements with or without repetition, including step-by-step factorial expansions.</p>
    </div>

    <form id="pc-form" class="space-y-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <!-- Input n -->
        <div>
          <label for="pc-n" class="block text-sm font-semibold text-gray-800 mb-1">
            Total Number of Items (n)
          </label>
          <input
            type="number"
            id="pc-n"
            min="0"
            max="1000"
            step="1"
            value="10"
            required
            inputmode="numeric"
            class="block w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-base font-medium text-gray-900"
            placeholder="10"
          />
          <p class="text-xs text-gray-500 mt-1">Set size (n ≥ 0)</p>
        </div>

        <!-- Input r -->
        <div>
          <label for="pc-r" class="block text-sm font-semibold text-gray-800 mb-1">
            Number of Items Chosen (r)
          </label>
          <input
            type="number"
            id="pc-r"
            min="0"
            max="1000"
            step="1"
            value="3"
            required
            inputmode="numeric"
            class="block w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-base font-medium text-gray-900"
            placeholder="3"
          />
          <p class="text-xs text-gray-500 mt-1">Sample size (0 ≤ r ≤ n for non-repetition)</p>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row gap-3 pt-2">
        <button type="submit" class="flex-1 bg-emerald-600 text-white px-6 py-3 rounded-xl font-semibold hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors shadow-sm min-h-[44px]">
          Calculate Arrangements
        </button>
        <button type="button" id="reset-btn" class="px-6 py-3 border border-gray-300 rounded-xl text-gray-700 font-semibold hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors min-h-[44px]">
          Reset
        </button>
      </div>
    </form>

    <div id="error-box" class="hidden mt-6 bg-red-50 text-red-700 p-4 rounded-xl text-sm font-medium border border-red-200"></div>

    <!-- Results Section -->
    <div id="result-section" class="mt-8 pt-8 border-t border-gray-100" aria-live="polite">
      <!-- Main Highlights Grid (nPr & nCr) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
        <!-- Permutations Card -->
        <div class="bg-gradient-to-br from-emerald-50 to-teal-50 border border-emerald-200/80 rounded-2xl p-6 text-center relative">
          <div class="flex justify-end absolute top-3 right-3">
            <button
              type="button"
              id="copy-npr-btn"
              class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-lg bg-white/90 hover:bg-white text-emerald-800 border border-emerald-200 shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-emerald-500 min-h-[32px]"
              title="Copy Permutations result"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
              <span>Copy</span>
            </button>
          </div>
          <p class="text-xs font-bold uppercase tracking-wider text-emerald-800 mb-1">Permutations (nPr)</p>
          <div class="text-xs text-gray-500 mb-1">Order Matters • Without Repetition</div>
          <div id="val-npr" class="text-3xl sm:text-4xl font-extrabold text-emerald-950 my-2 break-all">720</div>
          <p id="sub-npr" class="text-xs text-emerald-700 font-mono">10! / (10 - 3)! = 720</p>
        </div>

        <!-- Combinations Card -->
        <div class="bg-gradient-to-br from-teal-50 to-cyan-50 border border-teal-200/80 rounded-2xl p-6 text-center relative">
          <div class="flex justify-end absolute top-3 right-3">
            <button
              type="button"
              id="copy-ncr-btn"
              class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-lg bg-white/90 hover:bg-white text-teal-800 border border-teal-200 shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-emerald-500 min-h-[32px]"
              title="Copy Combinations result"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
              <span>Copy</span>
            </button>
          </div>
          <p class="text-xs font-bold uppercase tracking-wider text-teal-800 mb-1">Combinations (nCr)</p>
          <div class="text-xs text-gray-500 mb-1">Order Does NOT Matter • Without Repetition</div>
          <div id="val-ncr" class="text-3xl sm:text-4xl font-extrabold text-teal-950 my-2 break-all">120</div>
          <p id="sub-ncr" class="text-xs text-teal-700 font-mono">10! / (3! × (10 - 3)!) = 120</p>
        </div>
      </div>

      <!-- Comprehensive 4-Way Comparison Table -->
      <div class="overflow-x-auto rounded-xl border border-gray-200 mb-6">
        <table class="w-full text-left text-sm text-gray-600">
          <thead class="bg-gray-50 text-xs font-semibold uppercase text-gray-700 border-b border-gray-200">
            <tr>
              <th class="px-4 py-3">Arrangement Type</th>
              <th class="px-4 py-3">Order Matters?</th>
              <th class="px-4 py-3">Repetition?</th>
              <th class="px-4 py-3">Formula</th>
              <th class="px-4 py-3">Result</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 bg-white">
            <tr class="hover:bg-gray-50/80">
              <td class="px-4 py-2.5 font-semibold text-gray-900">Permutations (nPr)</td>
              <td class="px-4 py-2.5 text-emerald-700 font-medium">Yes (Ordered)</td>
              <td class="px-4 py-2.5 text-gray-600">No</td>
              <td class="px-4 py-2.5 font-mono text-xs">n! / (n - r)!</td>
              <td class="px-4 py-2.5 font-bold text-gray-900 break-all" id="table-npr">720</td>
            </tr>
            <tr class="hover:bg-gray-50/80">
              <td class="px-4 py-2.5 font-semibold text-gray-900">Combinations (nCr)</td>
              <td class="px-4 py-2.5 text-gray-600">No (Unordered)</td>
              <td class="px-4 py-2.5 text-gray-600">No</td>
              <td class="px-4 py-2.5 font-mono text-xs">n! / (r! × (n - r)!)</td>
              <td class="px-4 py-2.5 font-bold text-gray-900 break-all" id="table-ncr">120</td>
            </tr>
            <tr class="hover:bg-gray-50/80">
              <td class="px-4 py-2.5 font-semibold text-gray-900">Permutations with Repetition</td>
              <td class="px-4 py-2.5 text-emerald-700 font-medium">Yes (Ordered)</td>
              <td class="px-4 py-2.5 text-emerald-700 font-medium">Yes</td>
              <td class="px-4 py-2.5 font-mono text-xs">n<sup>r</sup></td>
              <td class="px-4 py-2.5 font-bold text-gray-900 break-all" id="table-perm-rep">1,000</td>
            </tr>
            <tr class="hover:bg-gray-50/80">
              <td class="px-4 py-2.5 font-semibold text-gray-900">Combinations with Repetition</td>
              <td class="px-4 py-2.5 text-gray-600">No (Unordered)</td>
              <td class="px-4 py-2.5 text-emerald-700 font-medium">Yes</td>
              <td class="px-4 py-2.5 font-mono text-xs">(n + r - 1)! / (r! × (n - 1)!)</td>
              <td class="px-4 py-2.5 font-bold text-gray-900 break-all" id="table-comb-rep">220</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Step-by-Step Derivations -->
      <div class="bg-gray-50 rounded-xl p-5 border border-gray-200">
        <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-2">Detailed Factorial Solutions</h3>
        <div id="pc-steps-content" class="text-sm text-gray-700 font-mono space-y-2 bg-white p-4 rounded-lg border border-gray-200/80">
          <!-- Populated by JS -->
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { copyToClipboard } from '../../utils/formatters';

  const initPermutationsCombinations = () => {
    const form = document.getElementById('pc-form') as HTMLFormElement;
    const inputN = document.getElementById('pc-n') as HTMLInputElement;
    const inputR = document.getElementById('pc-r') as HTMLInputElement;
    const resetBtn = document.getElementById('reset-btn');
    const copyNprBtn = document.getElementById('copy-npr-btn');
    const copyNcrBtn = document.getElementById('copy-ncr-btn');
    const errorBox = document.getElementById('error-box');

    const valNprEl = document.getElementById('val-npr');
    const subNprEl = document.getElementById('sub-npr');
    const valNcrEl = document.getElementById('val-ncr');
    const subNcrEl = document.getElementById('sub-ncr');

    const tableNpr = document.getElementById('table-npr');
    const tableNcr = document.getElementById('table-ncr');
    const tablePermRep = document.getElementById('table-perm-rep');
    const tableCombRep = document.getElementById('table-comb-rep');
    const stepsContent = document.getElementById('pc-steps-content');

    if (!form || !inputN || !inputR) return;

    // BigInt factorial
    const factorialBigInt = (n: number): bigint => {
      let res = 1n;
      for (let i = 2n; i <= BigInt(n); i++) {
        res *= i;
      }
      return res;
    };

    // BigInt nPr: n * (n-1) * ... * (n - r + 1)
    const nPrBigInt = (n: number, r: number): bigint => {
      if (r < 0 || r > n) return 0n;
      let res = 1n;
      for (let i = BigInt(n); i > BigInt(n - r); i--) {
        res *= i;
      }
      return res;
    };

    // BigInt nCr: nPr / r!
    const nCrBigInt = (n: number, r: number): bigint => {
      if (r < 0 || r > n) return 0n;
      if (r === 0 || r === n) return 1n;
      const k = r > n - r ? n - r : r;
      let num = 1n;
      let den = 1n;
      for (let i = 1n; i <= BigInt(k); i++) {
        num *= BigInt(n) - i + 1n;
        den *= i;
      }
      return num / den;
    };

    // BigInt power
    const powBigInt = (base: number, exp: number): bigint => {
      if (exp < 0) return 0n;
      if (base === 0 && exp === 0) return 1n;
      let res = 1n;
      const b = BigInt(base);
      for (let i = 0; i < exp; i++) {
        res *= b;
      }
      return res;
    };

    const formatBigIntDisplay = (val: bigint): string => {
      const str = val.toString();
      if (str.length <= 15) {
        return Number(str).toLocaleString();
      }
      if (str.length > 25) {
        // Show scientific notation approximation + length
        const firstDigits = str.slice(0, 5);
        const exp = str.length - 1;
        const mantissa = (Number(firstDigits) / 10000).toFixed(4);
        return `${mantissa} × 10^${exp} (${str.length} digits)`;
      }
      return str.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    };

    const calculate = () => {
      errorBox?.classList.add('hidden');

      const n = parseInt(inputN.value, 10);
      const r = parseInt(inputR.value, 10);

      if (isNaN(n) || n < 0 || isNaN(r) || r < 0) {
        if (errorBox) {
          errorBox.textContent = 'Please enter non-negative integers for both n and r.';
          errorBox.classList.remove('hidden');
        }
        return;
      }

      if (r > n) {
        if (errorBox) {
          errorBox.textContent = 'For standard non-repetition permutations (nPr) and combinations (nCr), r cannot exceed n (r ≤ n).';
          errorBox.classList.remove('hidden');
        }
      }

      // Calculations
      const nprVal = r <= n ? nPrBigInt(n, r) : 0n;
      const ncrVal = r <= n ? nCrBigInt(n, r) : 0n;
      const permRepVal = powBigInt(n, r);
      const combRepVal = n === 0 && r === 0 ? 1n : (n > 0 ? nCrBigInt(n + r - 1, r) : 0n);

      const nprStr = r <= n ? formatBigIntDisplay(nprVal) : 'Undefined (r > n)';
      const ncrStr = r <= n ? formatBigIntDisplay(ncrVal) : 'Undefined (r > n)';
      const permRepStr = formatBigIntDisplay(permRepVal);
      const combRepStr = formatBigIntDisplay(combRepVal);

      if (valNprEl) valNprEl.textContent = nprStr;
      if (subNprEl) subNprEl.textContent = r <= n ? `${n}! / (${n} - ${r})! = ${nprStr}` : 'r must be ≤ n';

      if (valNcrEl) valNcrEl.textContent = ncrStr;
      if (subNcrEl) subNcrEl.textContent = r <= n ? `${n}! / (${r}! × (${n} - ${r})!) = ${ncrStr}` : 'r must be ≤ n';

      if (tableNpr) tableNpr.textContent = nprStr;
      if (tableNcr) tableNcr.textContent = ncrStr;
      if (tablePermRep) tablePermRep.textContent = permRepStr;
      if (tableCombRep) tableCombRep.textContent = combRepStr;

      if (stepsContent) {
        if (r <= n) {
          stepsContent.innerHTML = `
            <p>• <strong>Permutations P(${n}, ${r}):</strong></p>
            <p class="pl-4 text-xs text-gray-600">P(${n}, ${r}) = ${n}! / (${n} - ${r})! = ${n}! / ${n - r}!</p>
            <p class="pl-4 text-xs font-semibold text-emerald-800">Result = ${nprStr}</p>
            <div class="border-t border-gray-100 my-2"></div>
            <p>• <strong>Combinations C(${n}, ${r}):</strong></p>
            <p class="pl-4 text-xs text-gray-600">C(${n}, ${r}) = ${n}! / (${r}! × (${n} - ${r})!) = ${n}! / (${r}! × ${n - r}!)</p>
            <p class="pl-4 text-xs font-semibold text-teal-800">Result = ${ncrStr}</p>
            <div class="border-t border-gray-100 my-2"></div>
            <p>• <strong>With Repetition:</strong></p>
            <p class="pl-4 text-xs text-gray-600">Permutations with repetition = ${n}^${r} = ${permRepStr}</p>
            <p class="pl-4 text-xs text-gray-600">Combinations with repetition = (${n} + ${r} - 1)! / (${r}! × (${n} - 1)!) = ${combRepStr}</p>
          `;
        } else {
          stepsContent.innerHTML = `
            <p class="text-amber-700">Note: Choosing ${r} items out of ${n} items without repetition is impossible (r &gt; n).</p>
            <p>• Permutations with repetition (n^r) = ${n}^${r} = ${permRepStr}</p>
            <p>• Combinations with repetition = ${combRepStr}</p>
          `;
        }
      }
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      calculate();
    });

    inputN.addEventListener('input', calculate);
    inputR.addEventListener('input', calculate);

    resetBtn?.addEventListener('click', () => {
      inputN.value = '10';
      inputR.value = '3';
      calculate();
    });

    copyNprBtn?.addEventListener('click', async () => {
      const text = valNprEl?.textContent || '';
      const success = await copyToClipboard(text);
      if (success) {
        const span = copyNprBtn.querySelector('span');
        if (span) {
          const original = span.textContent;
          span.textContent = 'Copied!';
          setTimeout(() => { span.textContent = original; }, 1500);
        }
      }
    });

    copyNcrBtn?.addEventListener('click', async () => {
      const text = valNcrEl?.textContent || '';
      const success = await copyToClipboard(text);
      if (success) {
        const span = copyNcrBtn.querySelector('span');
        if (span) {
          const original = span.textContent;
          span.textContent = 'Copied!';
          setTimeout(() => { span.textContent = original; }, 1500);
        }
      }
    });

    calculate();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPermutationsCombinations);
  } else {
    initPermutationsCombinations();
  }
</script>
