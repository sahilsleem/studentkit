---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Total Loan Amount (₹)</label>
          <input type="number" id="sl-amount" step="500" min="500" placeholder="e.g. 35000" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Annual Interest Rate (%)</label>
          <input type="number" id="sl-rate" step="0.1" min="0" max="30" placeholder="e.g. 5.5" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Loan Term (Years)</label>
          <select id="sl-term" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="5">5 Years (60 Months)</option>
            <option value="10" selected>10 Years Standard (120 Months)</option>
            <option value="15">15 Years (180 Months)</option>
            <option value="20">20 Years (240 Months)</option>
            <option value="25">25 Years (300 Months)</option>
          </select>
        </div>

        <button id="sl-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Repayment
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Estimated Monthly Payment</div>
          <div id="sl-monthly" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
          <div id="sl-total-cost" class="text-xs text-slate-400 mt-2">Total Repayment: --</div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 space-y-2 text-xs text-slate-600">
          <div class="flex justify-between">
            <span>Principal Amount:</span>
            <strong id="sl-principal" class="text-slate-800">--</strong>
          </div>
          <div class="flex justify-between">
            <span>Total Interest Paid:</span>
            <strong id="sl-interest" class="text-slate-800 font-bold">--</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const amountIn = document.getElementById('sl-amount') as HTMLInputElement;
  const rateIn = document.getElementById('sl-rate') as HTMLInputElement;
  const termSelect = document.getElementById('sl-term') as HTMLSelectElement;
  const monthlyEl = document.getElementById('sl-monthly');
  const totalCostEl = document.getElementById('sl-total-cost');
  const principalEl = document.getElementById('sl-principal');
  const interestEl = document.getElementById('sl-interest');

  function calculate() {
    const P = parseFloat(amountIn?.value || '0');
    const annualRate = parseFloat(rateIn?.value || '0');
    const years = parseFloat(termSelect?.value || '10');

    if (P <= 0) return;

    const r = (annualRate / 100) / 12;
    const n = years * 12;

    let monthly = 0;
    if (r === 0) {
      monthly = P / n;
    } else {
      monthly = (P * (r * Math.pow(1 + r, n))) / (Math.pow(1 + r, n) - 1);
    }

    const totalRepay = monthly * n;
    const totalInterest = totalRepay - P;

    const fmt = (v: number) => '₹' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    if (monthlyEl) monthlyEl.textContent = fmt(monthly);
    if (totalCostEl) totalCostEl.textContent = 'Total Repayment: ' + fmt(totalRepay);
    if (principalEl) principalEl.textContent = fmt(P);
    if (interestEl) interestEl.textContent = fmt(totalInterest);
  }


  document.getElementById('sl-calc-btn')?.addEventListener('click', calculate);
</script>