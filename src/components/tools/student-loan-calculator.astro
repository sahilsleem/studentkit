---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Total Loan Amount (₹)</label>
          <input type="number" id="sl-amount" step="500" min="500" placeholder="e.g. 35000" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Annual Interest Rate (%)</label>
          <input type="number" id="sl-rate" step="0.1" min="0" max="30" placeholder="e.g. 5.5" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Loan Term (Years)</label>
          <select id="sl-term" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent">
            <option value="5">5 Years (60 Months)</option>
            <option value="10" selected>10 Years Standard (120 Months)</option>
            <option value="15">15 Years (180 Months)</option>
            <option value="20">20 Years (240 Months)</option>
            <option value="25">25 Years (300 Months)</option>
          </select>
        </div>

        <button id="sl-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Repayment
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Estimated Monthly Payment</div>
          <div id="sl-monthly" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div id="sl-total-cost" class="text-xs text-slate-muted mt-1">Total Repayment: --</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 space-y-1.5 text-xs text-slate-muted">
          <div class="flex flex-wrap justify-between gap-2">
            <span>Principal Amount:</span>
            <strong id="sl-principal" class="text-ink">--</strong>
          </div>
          <div class="flex flex-wrap justify-between gap-2">
            <span>Total Interest Paid:</span>
            <strong id="sl-interest" class="text-ink font-bold">--</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const amountIn = document.getElementById('sl-amount') as HTMLInputElement;
  const rateIn = document.getElementById('sl-rate') as HTMLInputElement;
  const termSelect = document.getElementById('sl-term') as HTMLSelectElement;
  const monthlyEl = document.getElementById('sl-monthly');
  const totalCostEl = document.getElementById('sl-total-cost');
  const principalEl = document.getElementById('sl-principal');
  const interestEl = document.getElementById('sl-interest');

  function calculate() {
    const P = parseFloat(amountIn?.value || '0');
    const annualRate = parseFloat(rateIn?.value || '0');
    const years = parseFloat(termSelect?.value || '10');

    if (P <= 0) return;

    const r = (annualRate / 100) / 12;
    const n = years * 12;

    let monthly = 0;
    if (r === 0) {
      monthly = P / n;
    } else {
      monthly = (P * (r * Math.pow(1 + r, n))) / (Math.pow(1 + r, n) - 1);
    }

    const totalRepay = monthly * n;
    const totalInterest = totalRepay - P;

    const fmt = (v: number) => '₹' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    if (monthlyEl) monthlyEl.textContent = fmt(monthly);
    if (totalCostEl) totalCostEl.textContent = 'Total Repayment: ' + fmt(totalRepay);
    if (principalEl) principalEl.textContent = fmt(P);
    if (interestEl) interestEl.textContent = fmt(totalInterest);
  }


  document.getElementById('sl-calc-btn')?.addEventListener('click', calculate);
</script>