<div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden mb-12 max-w-4xl mx-auto">
  <div class="p-6 sm:p-8">
    <div class="mb-6">
      <h2 class="text-xl font-bold text-gray-900 mb-2">Prime Factorization Calculator</h2>
      <p class="text-sm text-gray-600">Find the prime factors, canonical exponential form, divisor count, and step-by-step division tree for any positive integer.</p>
    </div>

    <!-- Quick Example Buttons -->
    <div class="mb-6 bg-emerald-50/60 border border-emerald-100 rounded-xl p-4">
      <label class="block text-xs font-semibold uppercase tracking-wider text-emerald-800 mb-2">Try Sample Numbers</label>
      <div class="flex flex-wrap gap-2">
        <button type="button" data-num="360" class="sample-btn text-xs font-medium py-1.5 px-3 rounded-lg bg-white border border-emerald-200 text-emerald-900 hover:bg-emerald-100 transition-colors">
          360
        </button>
        <button type="button" data-num="1024" class="sample-btn text-xs font-medium py-1.5 px-3 rounded-lg bg-white border border-emerald-200 text-emerald-900 hover:bg-emerald-100 transition-colors">
          1024 (2¹⁰)
        </button>
        <button type="button" data-num="9973" class="sample-btn text-xs font-medium py-1.5 px-3 rounded-lg bg-white border border-emerald-200 text-emerald-900 hover:bg-emerald-100 transition-colors">
          9973 (Prime)
        </button>
        <button type="button" data-num="123456" class="sample-btn text-xs font-medium py-1.5 px-3 rounded-lg bg-white border border-emerald-200 text-emerald-900 hover:bg-emerald-100 transition-colors">
          123,456
        </button>
        <button type="button" data-num="1000000" class="sample-btn text-xs font-medium py-1.5 px-3 rounded-lg bg-white border border-emerald-200 text-emerald-900 hover:bg-emerald-100 transition-colors">
          1,000,000
        </button>
      </div>
    </div>

    <form id="pf-form" class="space-y-6">
      <div>
        <label for="pf-number" class="block text-sm font-semibold text-gray-800 mb-1">
          Enter Integer to Factorize (N ≥ 1)
        </label>
        <div class="relative">
          <input
            type="number"
            id="pf-number"
            min="1"
            max="1000000000000"
            step="1"
            value="360"
            required
            inputmode="numeric"
            class="block w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-lg font-medium text-gray-900"
            placeholder="e.g. 360"
          />
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row gap-3 pt-2">
        <button type="submit" class="flex-1 bg-emerald-600 text-white px-6 py-3 rounded-xl font-semibold hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors shadow-sm min-h-[44px]">
          Find Prime Factors
        </button>
        <button type="button" id="reset-btn" class="px-6 py-3 border border-gray-300 rounded-xl text-gray-700 font-semibold hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors min-h-[44px]">
          Reset
        </button>
      </div>
    </form>

    <div id="error-box" class="hidden mt-6 bg-red-50 text-red-700 p-4 rounded-xl text-sm font-medium border border-red-200"></div>

    <!-- Results Section -->
    <div id="result-section" class="mt-8 pt-8 border-t border-gray-100" aria-live="polite">
      <!-- Main Result Card: Canonical Exponential Form -->
      <div class="bg-gradient-to-br from-emerald-50 to-teal-50 border border-emerald-200/80 rounded-2xl p-6 sm:p-8 text-center relative mb-6">
        <div class="flex justify-end absolute top-4 right-4">
          <button
            type="button"
            id="copy-result-btn"
            class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg bg-white/90 hover:bg-white text-emerald-800 border border-emerald-200 shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-emerald-500 min-h-[36px]"
            title="Copy exponential form"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
            <span>Copy Result</span>
          </button>
        </div>
        <p class="text-sm font-semibold uppercase tracking-wider text-emerald-800 mb-1">Prime Factorization (Exponential Form)</p>
        <div id="pf-exponential" class="text-3xl sm:text-5xl font-extrabold text-emerald-950 my-2 font-mono break-all">2³ × 3² × 5¹</div>
        <div class="flex items-center justify-center gap-2 mt-3">
          <span id="pf-badge-type" class="inline-flex items-center px-3 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800">
            Composite Number
          </span>
        </div>
      </div>

      <!-- Properties Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
        <div class="bg-gray-50 rounded-xl p-4 border border-gray-200/70 text-center">
          <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Distinct Factors</p>
          <div id="stat-distinct" class="text-lg font-bold text-gray-900">2, 3, 5</div>
        </div>
        <div class="bg-gray-50 rounded-xl p-4 border border-gray-200/70 text-center">
          <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Total Prime Factors</p>
          <div id="stat-total-factors" class="text-lg font-bold text-gray-900">6</div>
          <p class="text-xs text-gray-400 mt-0.5">with multiplicity</p>
        </div>
        <div class="bg-gray-50 rounded-xl p-4 border border-gray-200/70 text-center">
          <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Total Divisors d(N)</p>
          <div id="stat-divisors-count" class="text-lg font-bold text-gray-900">24</div>
        </div>
        <div class="bg-gray-50 rounded-xl p-4 border border-gray-200/70 text-center">
          <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Sum of Divisors σ(N)</p>
          <div id="stat-sum-divisors" class="text-lg font-bold text-gray-900">1,170</div>
        </div>
      </div>

      <!-- Expanded Product Representation -->
      <div class="bg-gray-50 rounded-xl p-4 border border-gray-200 mb-6">
        <p class="text-xs font-bold uppercase tracking-wider text-gray-600 mb-1">Expanded Prime Factors Product</p>
        <div id="pf-expanded" class="text-base font-mono font-semibold text-gray-900 break-all">
          360 = 2 × 2 × 2 × 3 × 3 × 5
        </div>
      </div>

      <!-- Step-by-Step Division Steps Table -->
      <div>
        <h3 class="text-base font-bold text-gray-900 mb-3">Step-by-Step Factor Division Steps</h3>
        <div class="overflow-x-auto rounded-xl border border-gray-200">
          <table class="w-full text-left text-sm text-gray-600">
            <thead class="bg-gray-50 text-xs font-semibold uppercase text-gray-700 border-b border-gray-200">
              <tr>
                <th class="px-4 py-3">Step</th>
                <th class="px-4 py-3">Current Dividend</th>
                <th class="px-4 py-3">Smallest Prime Divisor</th>
                <th class="px-4 py-3">Quotient Remaining</th>
              </tr>
            </thead>
            <tbody id="pf-steps-table" class="divide-y divide-gray-100 bg-white">
              <!-- Populated by JS -->
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { copyToClipboard } from '../../utils/formatters';

  const initPrimeFactorization = () => {
    const form = document.getElementById('pf-form') as HTMLFormElement;
    const inputNumber = document.getElementById('pf-number') as HTMLInputElement;
    const resetBtn = document.getElementById('reset-btn');
    const copyBtn = document.getElementById('copy-result-btn');
    const errorBox = document.getElementById('error-box');

    const exponentialEl = document.getElementById('pf-exponential');
    const badgeTypeEl = document.getElementById('pf-badge-type');
    const expandedEl = document.getElementById('pf-expanded');
    const statDistinctEl = document.getElementById('stat-distinct');
    const statTotalFactorsEl = document.getElementById('stat-total-factors');
    const statDivisorsCountEl = document.getElementById('stat-divisors-count');
    const statSumDivisorsEl = document.getElementById('stat-sum-divisors');
    const stepsTableBody = document.getElementById('pf-steps-table');

    if (!form || !inputNumber) return;

    const superscriptDigits = ['⁰', '¹', '²', '³', '⁴', '⁵', '⁶', '⁷', '⁸', '⁹'];
    const toSuperscript = (num: number): string => {
      return String(num).split('').map(d => superscriptDigits[parseInt(d, 10)] || d).join('');
    };

    const factorize = (n: number) => {
      const factors: { prime: number; count: number }[] = [];
      const steps: { dividend: number; divisor: number; quotient: number }[] = [];
      let temp = n;

      if (n === 1) {
        return { factors, steps };
      }

      // Check factor 2
      let count2 = 0;
      while (temp % 2 === 0) {
        count2++;
        steps.push({ dividend: temp, divisor: 2, quotient: temp / 2 });
        temp /= 2;
      }
      if (count2 > 0) factors.push({ prime: 2, count: count2 });

      // Check factor 3
      let count3 = 0;
      while (temp % 3 === 0) {
        count3++;
        steps.push({ dividend: temp, divisor: 3, quotient: temp / 3 });
        temp /= 3;
      }
      if (count3 > 0) factors.push({ prime: 3, count: count3 });

      // Check 6k +/- 1 up to sqrt(temp)
      let d = 5;
      while (d * d <= temp) {
        if (temp % d === 0) {
          let count = 0;
          while (temp % d === 0) {
            count++;
            steps.push({ dividend: temp, divisor: d, quotient: temp / d });
            temp /= d;
          }
          factors.push({ prime: d, count });
        }
        const d2 = d + 2;
        if (temp % d2 === 0) {
          let count = 0;
          while (temp % d2 === 0) {
            count++;
            steps.push({ dividend: temp, divisor: d2, quotient: temp / d2 });
            temp /= d2;
          }
          factors.push({ prime: d2, count });
        }
        d += 6;
      }

      // If remaining temp > 1, it's prime
      if (temp > 1) {
        steps.push({ dividend: temp, divisor: temp, quotient: 1 });
        factors.push({ prime: temp, count: 1 });
      }

      return { factors, steps };
    };

    const calculate = () => {
      errorBox?.classList.add('hidden');

      const n = parseInt(inputNumber.value, 10);

      if (isNaN(n) || n < 1) {
        if (errorBox) {
          errorBox.textContent = 'Please enter a positive integer (N ≥ 1).';
          errorBox.classList.remove('hidden');
        }
        return;
      }

      if (n === 1) {
        if (exponentialEl) exponentialEl.textContent = '1 (Unit)';
        if (expandedEl) expandedEl.textContent = '1 is a unit (neither prime nor composite).';
        if (badgeTypeEl) {
          badgeTypeEl.textContent = 'Unit (Neither Prime nor Composite)';
          badgeTypeEl.className = 'inline-flex items-center px-3 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800';
        }
        if (statDistinctEl) statDistinctEl.textContent = 'None';
        if (statTotalFactorsEl) statTotalFactorsEl.textContent = '0';
        if (statDivisorsCountEl) statDivisorsCountEl.textContent = '1';
        if (statSumDivisorsEl) statSumDivisorsEl.textContent = '1';
        if (stepsTableBody) {
          stepsTableBody.innerHTML = '<tr><td colspan="4" class="px-4 py-3 text-center text-gray-500 italic">1 has no prime factors (1 is the multiplicative unit).</td></tr>';
        }
        return;
      }

      const { factors, steps } = factorize(n);

      // Canonical Exponential representation: 2³ × 3² × 5¹
      const expStr = factors.map(f => `${f.prime}${toSuperscript(f.count)}`).join(' × ');

      // Expanded representation: 2 × 2 × 2 × 3 × 3 × 5
      const expandedList: number[] = [];
      factors.forEach(f => {
        for (let i = 0; i < f.count; i++) expandedList.push(f.prime);
      });
      const expFullStr = `${n.toLocaleString()} = ${expandedList.join(' × ')}`;

      // Is Prime?
      const isPrime = factors.length === 1 && factors[0].count === 1;

      // Divisor counts & sums
      let totalDivisors = 1;
      let sumOfDivisors = 1;
      let totalPrimeFactorsWithMultiplicity = 0;

      factors.forEach(f => {
        totalPrimeFactorsWithMultiplicity += f.count;
        totalDivisors *= (f.count + 1);
        let pSum = 0;
        for (let i = 0; i <= f.count; i++) {
          pSum += Math.pow(f.prime, i);
        }
        sumOfDivisors *= pSum;
      });

      if (exponentialEl) exponentialEl.textContent = expStr;
      if (expandedEl) expandedEl.textContent = expFullStr;

      if (badgeTypeEl) {
        if (isPrime) {
          badgeTypeEl.textContent = 'Prime Number';
          badgeTypeEl.className = 'inline-flex items-center px-3 py-0.5 rounded-full text-xs font-bold bg-blue-100 text-blue-800';
        } else {
          badgeTypeEl.textContent = 'Composite Number';
          badgeTypeEl.className = 'inline-flex items-center px-3 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800';
        }
      }

      if (statDistinctEl) statDistinctEl.textContent = factors.map(f => f.prime).join(', ');
      if (statTotalFactorsEl) statTotalFactorsEl.textContent = totalPrimeFactorsWithMultiplicity.toString();
      if (statDivisorsCountEl) statDivisorsCountEl.textContent = totalDivisors.toLocaleString();
      if (statSumDivisorsEl) statSumDivisorsEl.textContent = sumOfDivisors.toLocaleString();

      // Steps Table
      if (stepsTableBody) {
        stepsTableBody.innerHTML = steps.map((s, idx) => `
          <tr class="hover:bg-gray-50/80">
            <td class="px-4 py-2.5 font-semibold text-gray-900">${idx + 1}</td>
            <td class="px-4 py-2.5 font-mono">${s.dividend.toLocaleString()}</td>
            <td class="px-4 py-2.5 font-mono text-emerald-700 font-semibold">${s.divisor}</td>
            <td class="px-4 py-2.5 font-mono font-medium text-gray-900">${s.quotient.toLocaleString()}</td>
          </tr>
        `).join('');
      }
    };

    // Quick Sample Buttons
    document.querySelectorAll('.sample-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const num = btn.getAttribute('data-num');
        if (num) {
          inputNumber.value = num;
          calculate();
        }
      });
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      calculate();
    });

    inputNumber.addEventListener('input', calculate);

    resetBtn?.addEventListener('click', () => {
      inputNumber.value = '360';
      calculate();
    });

    copyBtn?.addEventListener('click', async () => {
      const text = exponentialEl?.textContent || '';
      const success = await copyToClipboard(text);
      if (success) {
        const span = copyBtn.querySelector('span');
        if (span) {
          const original = span.textContent;
          span.textContent = 'Copied!';
          setTimeout(() => { span.textContent = original; }, 1500);
        }
      }
    });

    calculate();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPrimeFactorization);
  } else {
    initPrimeFactorization();
  }
</script>
