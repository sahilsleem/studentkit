---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="space-y-3.5">
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Enter Numbers (comma or space separated)</label>
        <textarea id="sd-data" rows="3" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent font-mono" placeholder="e.g. 10, 12, 23, 23, 16, 23, 21, 16"></textarea>
      </div>

      <button id="sd-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
        Calculate Standard Deviation
      </button>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4">
        <div class="p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Sample Standard Deviation (s)</div>
          <div id="sd-sample" class="text-3xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div class="text-xs text-slate-muted mt-1">Divided by n - 1 (Bessel's correction)</div>
        </div>

        <div class="p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Population Standard Deviation (σ)</div>
          <div id="sd-pop" class="text-3xl font-extrabold text-ink mt-1 font-mono">4.8990</div>
          <div class="text-xs text-slate-muted mt-1">Divided by N (full population)</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const raw = (document.getElementById('sd-data') as HTMLTextAreaElement)?.value || '';
    const nums = raw.split(/[,\s]+/).map(s => parseFloat(s.trim())).filter(n => !isNaN(n));

    const n = nums.length;
    if (n === 0) return;

    const mean = nums.reduce((a, b) => a + b, 0) / n;
    const ss = nums.reduce((acc, x) => acc + Math.pow(x - mean, 2), 0);

    const sSample = n > 1 ? Math.sqrt(ss / (n - 1)) : 0;
    const sPop = Math.sqrt(ss / n);

    document.getElementById('sd-sample')!.textContent = sSample.toFixed(4);
    document.getElementById('sd-pop')!.textContent = sPop.toFixed(4);
  }


  document.getElementById('sd-calc-btn')?.addEventListener('click', calculate);
</script>