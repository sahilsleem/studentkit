---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Vector A (x, y, z)</label>
          <div class="grid grid-cols-3 gap-2">
            <input type="number" id="vec-a1" placeholder="e.g. 3" class="w-full px-3 py-2 bg-page border border-border-line rounded-lg text-sm text-center" />
            <input type="number" id="vec-a2" placeholder="e.g. -2" class="w-full px-3 py-2 bg-page border border-border-line rounded-lg text-sm text-center" />
            <input type="number" id="vec-a3" placeholder="e.g. 4" class="w-full px-3 py-2 bg-page border border-border-line rounded-lg text-sm text-center" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Vector B (x, y, z)</label>
          <div class="grid grid-cols-3 gap-2">
            <input type="number" id="vec-b1" placeholder="e.g. 1" class="w-full px-3 py-2 bg-page border border-border-line rounded-lg text-sm text-center" />
            <input type="number" id="vec-b2" placeholder="e.g. 5" class="w-full px-3 py-2 bg-page border border-border-line rounded-lg text-sm text-center" />
            <input type="number" id="vec-b3" placeholder="e.g. -2" class="w-full px-3 py-2 bg-page border border-border-line rounded-lg text-sm text-center" />
          </div>
        </div>

        <button id="vec-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Vector Operations
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Dot Product (A · B)</div>
          <div id="vec-dot" class="text-3xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div id="vec-angle" class="text-xs text-slate-muted mt-1">Angle Between Vectors: 122.8°</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 space-y-1.5 text-xs text-slate-muted">
          <div class="flex flex-wrap justify-between gap-2">
            <span>Cross Product (A × B):</span>
            <strong id="vec-cross" class="text-ink font-mono break-words">(-16, 10, 17)</strong>
          </div>
          <div class="flex flex-wrap justify-between gap-2">
            <span>Magnitudes:</span>
            <strong id="vec-mags" class="text-ink font-mono break-words">|A| = 5.39, |B| = 5.48</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const a1 = parseFloat((document.getElementById('vec-a1') as HTMLInputElement)?.value || '0');
    const a2 = parseFloat((document.getElementById('vec-a2') as HTMLInputElement)?.value || '0');
    const a3 = parseFloat((document.getElementById('vec-a3') as HTMLInputElement)?.value || '0');
    const b1 = parseFloat((document.getElementById('vec-b1') as HTMLInputElement)?.value || '0');
    const b2 = parseFloat((document.getElementById('vec-b2') as HTMLInputElement)?.value || '0');
    const b3 = parseFloat((document.getElementById('vec-b3') as HTMLInputElement)?.value || '0');

    const dot = a1 * b1 + a2 * b2 + a3 * b3;
    const magA = Math.sqrt(a1 * a1 + a2 * a2 + a3 * a3);
    const magB = Math.sqrt(b1 * b1 + b2 * b2 + b3 * b3);

    const cosTheta = (magA * magB > 0) ? Math.max(-1, Math.min(1, dot / (magA * magB))) : 0;
    const angleDeg = (Math.acos(cosTheta) * 180) / Math.PI;

    const cx = a2 * b3 - a3 * b2;
    const cy = a3 * b1 - a1 * b3;
    const cz = a1 * b2 - a2 * b1;

    const dotEl = document.getElementById('vec-dot');
    const angleEl = document.getElementById('vec-angle');
    const crossEl = document.getElementById('vec-cross');
    const magsEl = document.getElementById('vec-mags');

    if (dotEl) dotEl.textContent = dot.toFixed(2);
    if (angleEl) angleEl.textContent = 'Angle Between Vectors: ' + angleDeg.toFixed(1) + '°';
    if (crossEl) crossEl.textContent = '(' + cx.toFixed(2) + ', ' + cy.toFixed(2) + ', ' + cz.toFixed(2) + ')';
    if (magsEl) magsEl.textContent = '|A| = ' + magA.toFixed(2) + ', |B| = ' + magB.toFixed(2);
  }


  document.getElementById('vec-calc-btn')?.addEventListener('click', calculate);
</script>