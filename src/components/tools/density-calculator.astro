---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Mass (m in kg)</label>
          <input type="number" id="den-m" placeholder="e.g. 2.7" min="0" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Volume (V in m³)</label>
          <input type="number" id="den-v" placeholder="e.g. 0.001" min="0.000001" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>

        <button id="den-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Density
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Density (ρ = m / V)</div>
          <div id="den-rho" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div id="den-gcm3" class="text-xs text-slate-muted mt-1">2.70 g/cm³ (Aluminum)</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const m = parseFloat((document.getElementById('den-m') as HTMLInputElement)?.value || '0');
    const v = parseFloat((document.getElementById('den-v') as HTMLInputElement)?.value || '1');

    if (v <= 0) return;
    const rho = m / v;
    const gcm3 = rho / 1000;

    document.getElementById('den-rho')!.textContent = rho.toLocaleString() + ' kg/m³';
    document.getElementById('den-gcm3')!.textContent = gcm3.toFixed(3) + ' g/cm³';
  }


  document.getElementById('den-calc-btn')?.addEventListener('click', calculate);
</script>