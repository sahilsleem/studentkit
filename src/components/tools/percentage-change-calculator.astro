---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Initial Value (V₁)</label>
          <input type="number" id="pcc-v1" step="any" placeholder="e.g. 120" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Final Value (V₂)</label>
          <input type="number" id="pcc-v2" step="any" placeholder="e.g. 165" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <button id="pcc-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Change
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Percentage Change</div>
          <div id="pcc-res" class="text-4xl font-extrabold text-emerald-600 mt-1 font-mono">--</div>
          <div id="pcc-type" class="text-xs text-slate-muted mt-1">Increase of 45.00</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 space-y-1.5 text-xs text-slate-muted">
          <div class="flex flex-wrap justify-between gap-2">
            <span>Absolute Difference:</span>
            <strong id="pcc-diff" class="text-ink font-mono break-words">45.00</strong>
          </div>
          <div class="flex flex-wrap justify-between gap-2">
            <span>Multiplier:</span>
            <strong id="pcc-mult" class="text-ink font-mono break-words">1.375×</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const v1 = parseFloat((document.getElementById('pcc-v1') as HTMLInputElement)?.value || '0');
    const v2 = parseFloat((document.getElementById('pcc-v2') as HTMLInputElement)?.value || '0');

    if (v1 === 0) return;

    const diff = v2 - v1;
    const pct = (diff / Math.abs(v1)) * 100;
    const mult = v2 / v1;

    const resEl = document.getElementById('pcc-res');
    const typeEl = document.getElementById('pcc-type');
    const diffEl = document.getElementById('pcc-diff');
    const multEl = document.getElementById('pcc-mult');

    if (resEl) {
      resEl.textContent = (pct >= 0 ? '+' : '') + pct.toFixed(2) + '%';
      resEl.className = 'text-4xl font-extrabold mt-1 font-mono ' + (pct >= 0 ? 'text-emerald-600' : 'text-rose-600');
    }
    if (typeEl) typeEl.textContent = (pct >= 0 ? 'Increase of ' : 'Decrease of ') + Math.abs(diff).toFixed(2);
    if (diffEl) diffEl.textContent = Math.abs(diff).toFixed(2);
    if (multEl) multEl.textContent = mult.toFixed(3) + '×';
  }


  document.getElementById('pcc-calc-btn')?.addEventListener('click', calculate);
</script>