---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Initial Value (V₁)</label>
          <input type="number" id="pcc-v1" step="any" placeholder="e.g. 120" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Final Value (V₂)</label>
          <input type="number" id="pcc-v2" step="any" placeholder="e.g. 165" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <button id="pcc-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Change
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Percentage Change</div>
          <div id="pcc-res" class="text-4xl font-extrabold text-emerald-600 mt-2 font-mono">--</div>
          <div id="pcc-type" class="text-xs text-slate-500 mt-2">Increase of 45.00</div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 space-y-2 text-xs text-slate-600">
          <div class="flex justify-between">
            <span>Absolute Difference:</span>
            <strong id="pcc-diff" class="text-slate-800 font-mono">45.00</strong>
          </div>
          <div class="flex justify-between">
            <span>Multiplier:</span>
            <strong id="pcc-mult" class="text-slate-800 font-mono">1.375×</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const v1 = parseFloat((document.getElementById('pcc-v1') as HTMLInputElement)?.value || '0');
    const v2 = parseFloat((document.getElementById('pcc-v2') as HTMLInputElement)?.value || '0');

    if (v1 === 0) return;

    const diff = v2 - v1;
    const pct = (diff / Math.abs(v1)) * 100;
    const mult = v2 / v1;

    const resEl = document.getElementById('pcc-res');
    const typeEl = document.getElementById('pcc-type');
    const diffEl = document.getElementById('pcc-diff');
    const multEl = document.getElementById('pcc-mult');

    if (resEl) {
      resEl.textContent = (pct >= 0 ? '+' : '') + pct.toFixed(2) + '%';
      resEl.className = 'text-4xl font-extrabold mt-2 font-mono ' + (pct >= 0 ? 'text-emerald-600' : 'text-rose-600');
    }
    if (typeEl) typeEl.textContent = (pct >= 0 ? 'Increase of ' : 'Decrease of ') + Math.abs(diff).toFixed(2);
    if (diffEl) diffEl.textContent = Math.abs(diff).toFixed(2);
    if (multEl) multEl.textContent = mult.toFixed(3) + '×';
  }


  document.getElementById('pcc-calc-btn')?.addEventListener('click', calculate);
</script>