---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Mass (m in grams)</label>
          <input type="number" id="cal-m" placeholder="e.g. 250" min="0" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Specific Heat Capacity (c in J/g·°C, Water = 4.184)</label>
          <input type="number" id="cal-c" placeholder="e.g. 4.184" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Temperature Change (ΔT in °C)</label>
          <input type="number" id="cal-dt" placeholder="e.g. 35" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>

        <button id="cal-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Heat Energy (q)
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Heat Energy Transferred (q = mcΔT)</div>
          <div id="cal-q" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div class="text-xs text-slate-muted mt-1">36,610 Joules</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const m = parseFloat((document.getElementById('cal-m') as HTMLInputElement)?.value || '0');
    const c = parseFloat((document.getElementById('cal-c') as HTMLInputElement)?.value || '4.184');
    const dt = parseFloat((document.getElementById('cal-dt') as HTMLInputElement)?.value || '0');

    const qJoules = m * c * dt;
    const qKj = qJoules / 1000;

    document.getElementById('cal-q')!.textContent = qKj.toFixed(2) + ' kJ';
  }


  document.getElementById('cal-calc-btn')?.addEventListener('click', calculate);
</script>