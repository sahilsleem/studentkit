---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Mass (m in grams)</label>
          <input type="number" id="cal-m" placeholder="e.g. 250" min="0" step="any" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Specific Heat Capacity (c in J/g·°C, Water = 4.184)</label>
          <input type="number" id="cal-c" placeholder="e.g. 4.184" step="any" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Temperature Change (ΔT in °C)</label>
          <input type="number" id="cal-dt" placeholder="e.g. 35" step="any" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>

        <button id="cal-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Heat Energy (q)
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Heat Energy Transferred (q = mcΔT)</div>
          <div id="cal-q" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
          <div class="text-xs text-slate-500 mt-2">36,610 Joules</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const m = parseFloat((document.getElementById('cal-m') as HTMLInputElement)?.value || '0');
    const c = parseFloat((document.getElementById('cal-c') as HTMLInputElement)?.value || '4.184');
    const dt = parseFloat((document.getElementById('cal-dt') as HTMLInputElement)?.value || '0');

    const qJoules = m * c * dt;
    const qKj = qJoules / 1000;

    document.getElementById('cal-q')!.textContent = qKj.toFixed(2) + ' kJ';
  }


  document.getElementById('cal-calc-btn')?.addEventListener('click', calculate);
</script>