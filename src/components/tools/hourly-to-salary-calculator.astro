---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Hourly Wage (₹/hour)</label>
          <input type="number" id="hs-wage" step="0.5" min="0" placeholder="e.g. 22" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Hours Worked Per Week</label>
          <input type="number" id="hs-hours" step="1" min="1" max="80" placeholder="e.g. 40" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Weeks Worked Per Year</label>
          <input type="number" id="hs-weeks" step="1" min="1" max="52" placeholder="e.g. 52" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <button id="hs-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Salary Equivalents
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Equivalent Annual Salary</div>
          <div id="hs-annual" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div id="hs-monthly" class="text-xs text-slate-muted mt-1">Monthly estimate appears here</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 space-y-1.5 text-xs text-slate-muted">
          <div class="flex flex-wrap justify-between gap-2">
            <span>Bi-Weekly Pay (Every 2 Weeks):</span>
            <strong id="hs-biweekly" class="text-ink">--</strong>
          </div>
          <div class="flex flex-wrap justify-between gap-2">
            <span>Weekly Pay:</span>
            <strong id="hs-weekly" class="text-ink">--</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const wageIn = document.getElementById('hs-wage') as HTMLInputElement;
  const hoursIn = document.getElementById('hs-hours') as HTMLInputElement;
  const weeksIn = document.getElementById('hs-weeks') as HTMLInputElement;

  const annualEl = document.getElementById('hs-annual');
  const monthlyEl = document.getElementById('hs-monthly');
  const biweeklyEl = document.getElementById('hs-biweekly');
  const weeklyEl = document.getElementById('hs-weekly');

  function calculate() {
    const wage = parseFloat(wageIn?.value || '0');
    const hours = parseFloat(hoursIn?.value || '40');
    const weeks = parseFloat(weeksIn?.value || '52');

    const weekly = wage * hours;
    const annual = weekly * weeks;
    const monthly = annual / 12;
    const biweekly = annual / 26;

    const fmt = (v: number) => '₹' + Math.round(v).toLocaleString('en-US');
    const fmtDec = (v: number) => '₹' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    if (annualEl) annualEl.textContent = fmt(annual);
    if (monthlyEl) monthlyEl.textContent = fmtDec(monthly) + ' per month';
    if (biweeklyEl) biweeklyEl.textContent = fmtDec(biweekly);
    if (weeklyEl) weeklyEl.textContent = fmtDec(weekly);
  }


  document.getElementById('hs-calc-btn')?.addEventListener('click', calculate);
</script>