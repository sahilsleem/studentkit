---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div class="text-xs text-slate-muted mb-1 font-mono">Standard Form: ax² + bx + c = 0</div>
        <div class="grid grid-cols-3 gap-3">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">a</label>
            <input type="number" id="qf-a" step="any" placeholder="e.g. 1" class="w-full px-3 py-2 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">b</label>
            <input type="number" id="qf-b" step="any" placeholder="e.g. -5" class="w-full px-3 py-2 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">c</label>
            <input type="number" id="qf-c" step="any" placeholder="e.g. 6" class="w-full px-3 py-2 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
          </div>
        </div>

        <button id="qf-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Solve Quadratic Equation
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Roots (x₁, x₂)</div>
          <div id="qf-roots" class="text-3xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div id="qf-disc" class="text-xs text-slate-muted mt-1">Discriminant details will appear here</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 space-y-1.5 text-xs text-slate-muted">
          <div class="flex flex-wrap justify-between gap-2">
            <span>Vertex (h, k):</span>
            <strong id="qf-vertex" class="text-ink font-mono break-words">--</strong>
          </div>
          <div class="flex flex-wrap justify-between gap-2">
            <span>Root Type:</span>
            <strong id="qf-type" class="text-emerald-600 font-semibold">--</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const aIn = document.getElementById('qf-a') as HTMLInputElement;
  const bIn = document.getElementById('qf-b') as HTMLInputElement;
  const cIn = document.getElementById('qf-c') as HTMLInputElement;

  const rootsEl = document.getElementById('qf-roots');
  const discEl = document.getElementById('qf-disc');
  const vertexEl = document.getElementById('qf-vertex');
  const typeEl = document.getElementById('qf-type');

  function solve() {
    const a = parseFloat(aIn?.value || '1');
    const b = parseFloat(bIn?.value || '0');
    const c = parseFloat(cIn?.value || '0');

    if (a === 0) {
      if (rootsEl) rootsEl.textContent = 'Linear: x = ' + (-c / b).toFixed(4);
      return;
    }

    const d = b * b - 4 * a * c;
    const h = -b / (2 * a);
    const k = c - (b * b) / (4 * a);

    if (discEl) discEl.textContent = 'Discriminant (Δ = b² - 4ac) = ' + d.toFixed(4);
    if (vertexEl) vertexEl.textContent = '(' + h.toFixed(3) + ', ' + k.toFixed(3) + ')';

    if (d > 0) {
      const x1 = (-b + Math.sqrt(d)) / (2 * a);
      const x2 = (-b - Math.sqrt(d)) / (2 * a);
      if (rootsEl) rootsEl.textContent = 'x₁ = ' + x1.toFixed(4) + ',  x₂ = ' + x2.toFixed(4);
      if (typeEl) { typeEl.textContent = 'Two distinct real roots'; typeEl.className = 'text-emerald-600 font-semibold'; }
    } else if (d === 0) {
      const x = -b / (2 * a);
      if (rootsEl) rootsEl.textContent = 'x = ' + x.toFixed(4) + ' (double root)';
      if (typeEl) { typeEl.textContent = 'One repeated real root'; typeEl.className = 'text-brand font-semibold'; }
    } else {
      const real = (-b / (2 * a)).toFixed(4);
      const imag = (Math.sqrt(-d) / (2 * a)).toFixed(4);
      if (rootsEl) rootsEl.textContent = real + ' ± ' + Math.abs(parseFloat(imag)) + 'i';
      if (typeEl) { typeEl.textContent = 'Two complex conjugate roots'; typeEl.className = 'text-purple-600 font-semibold'; }
    }
  }


  document.getElementById('qf-calc-btn')?.addEventListener('click', solve);
</script>