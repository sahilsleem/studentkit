---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div class="text-xs text-slate-500 mb-2 font-mono">Standard Form: ax² + bx + c = 0</div>
        <div class="grid grid-cols-3 gap-3">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">a</label>
            <input type="number" id="qf-a" step="any" placeholder="e.g. 1" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">b</label>
            <input type="number" id="qf-b" step="any" placeholder="e.g. -5" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">c</label>
            <input type="number" id="qf-c" step="any" placeholder="e.g. 6" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
          </div>
        </div>

        <button id="qf-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Solve Quadratic Equation
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Roots (x₁, x₂)</div>
          <div id="qf-roots" class="text-3xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
          <div id="qf-disc" class="text-xs text-slate-400 mt-2">Discriminant details will appear here</div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 space-y-2 text-xs text-slate-600">
          <div class="flex justify-between">
            <span>Vertex (h, k):</span>
            <strong id="qf-vertex" class="text-slate-800 font-mono">--</strong>
          </div>
          <div class="flex justify-between">
            <span>Root Type:</span>
            <strong id="qf-type" class="text-emerald-600 font-semibold">--</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const aIn = document.getElementById('qf-a') as HTMLInputElement;
  const bIn = document.getElementById('qf-b') as HTMLInputElement;
  const cIn = document.getElementById('qf-c') as HTMLInputElement;

  const rootsEl = document.getElementById('qf-roots');
  const discEl = document.getElementById('qf-disc');
  const vertexEl = document.getElementById('qf-vertex');
  const typeEl = document.getElementById('qf-type');

  function solve() {
    const a = parseFloat(aIn?.value || '1');
    const b = parseFloat(bIn?.value || '0');
    const c = parseFloat(cIn?.value || '0');

    if (a === 0) {
      if (rootsEl) rootsEl.textContent = 'Linear: x = ' + (-c / b).toFixed(4);
      return;
    }

    const d = b * b - 4 * a * c;
    const h = -b / (2 * a);
    const k = c - (b * b) / (4 * a);

    if (discEl) discEl.textContent = 'Discriminant (Δ = b² - 4ac) = ' + d.toFixed(4);
    if (vertexEl) vertexEl.textContent = '(' + h.toFixed(3) + ', ' + k.toFixed(3) + ')';

    if (d > 0) {
      const x1 = (-b + Math.sqrt(d)) / (2 * a);
      const x2 = (-b - Math.sqrt(d)) / (2 * a);
      if (rootsEl) rootsEl.textContent = 'x₁ = ' + x1.toFixed(4) + ',  x₂ = ' + x2.toFixed(4);
      if (typeEl) { typeEl.textContent = 'Two distinct real roots'; typeEl.className = 'text-emerald-600 font-semibold'; }
    } else if (d === 0) {
      const x = -b / (2 * a);
      if (rootsEl) rootsEl.textContent = 'x = ' + x.toFixed(4) + ' (double root)';
      if (typeEl) { typeEl.textContent = 'One repeated real root'; typeEl.className = 'text-blue-600 font-semibold'; }
    } else {
      const real = (-b / (2 * a)).toFixed(4);
      const imag = (Math.sqrt(-d) / (2 * a)).toFixed(4);
      if (rootsEl) rootsEl.textContent = real + ' ± ' + Math.abs(parseFloat(imag)) + 'i';
      if (typeEl) { typeEl.textContent = 'Two complex conjugate roots'; typeEl.className = 'text-purple-600 font-semibold'; }
    }
  }


  document.getElementById('qf-calc-btn')?.addEventListener('click', solve);
</script>