---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="space-y-4">
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Function f(x) Expression</label>
        <div class="flex gap-2">
          <input type="text" id="dc-func" placeholder="e.g. 3x^3 - 5x^2 + 4x - 7" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 font-mono" />
          <button id="dc-calc-btn" type="button" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all shrink-0">
            Differentiate
          </button>
        </div>
        <p class="text-xs text-slate-400 mt-1">Supports polynomial terms like ax^n, sin(x), cos(x), e^x, ln(x).</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-6">
        <div class="p-5 bg-slate-50 rounded-xl border border-slate-200/80">
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">First Derivative f'(x)</div>
          <div id="dc-d1" class="text-2xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
        </div>
        <div class="p-5 bg-slate-50 rounded-xl border border-slate-200/80">
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Second Derivative f''(x)</div>
          <div id="dc-d2" class="text-2xl font-extrabold text-slate-800 mt-2 font-mono">18x - 10</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function differentiatePoly(str: string): string {
    str = str.replace(/\s+/g, '');
    const termRegex = /([+-]?[0-9]*\.?[0-9]*)x(?:\^([+-]?[0-9]+))?|([+-]?[0-9]+)/g;
    let match;
    const derivTerms: string[] = [];

    while ((match = termRegex.exec(str)) !== null) {
      if (!match[0]) continue;
      if (match[3]) {
        // constant term -> derivative 0
        continue;
      }
      let coeffStr = match[1];
      let coeff = coeffStr === '' || coeffStr === '+' ? 1 : coeffStr === '-' ? -1 : parseFloat(coeffStr);
      let power = match[2] !== undefined ? parseInt(match[2], 10) : 1;

      let newCoeff = coeff * power;
      let newPower = power - 1;

      if (newPower === 0) {
        derivTerms.push((newCoeff >= 0 && derivTerms.length > 0 ? '+' : '') + newCoeff);
      } else if (newPower === 1) {
        derivTerms.push((newCoeff >= 0 && derivTerms.length > 0 ? '+' : '') + (newCoeff === 1 ? '' : newCoeff === -1 ? '-' : newCoeff) + 'x');
      } else {
        derivTerms.push((newCoeff >= 0 && derivTerms.length > 0 ? '+' : '') + (newCoeff === 1 ? '' : newCoeff === -1 ? '-' : newCoeff) + 'x^' + newPower);
      }
    }

    if (str.includes('sin(x)')) return 'cos(x)';
    if (str.includes('cos(x)')) return '-sin(x)';
    if (str.includes('e^x')) return 'e^x';
    if (str.includes('ln(x)')) return '1/x';

    return derivTerms.join(' ') || '0';
  }

  function calculate() {
    const expr = (document.getElementById('dc-func') as HTMLInputElement)?.value || '';
    const d1 = differentiatePoly(expr);
    const d2 = differentiatePoly(d1);

    const d1El = document.getElementById('dc-d1');
    const d2El = document.getElementById('dc-d2');

    if (d1El) d1El.textContent = d1;
    if (d2El) d2El.textContent = d2;
  }


  document.getElementById('dc-calc-btn')?.addEventListener('click', calculate);
</script>