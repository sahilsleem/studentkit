---
import { tools } from '../../data/registry';
const { tool } = Astro.props;
const configJson = JSON.stringify(tool.physicsConfig || {});
---

<div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden mb-12 max-w-xl mx-auto unit-aware-calc-container" data-config={configJson}>
  <div class="p-6 sm:p-8">
    <form class="space-y-6 unit-calc-form">
      {tool.physicsConfig?.inputs.map((input) => (
        <div>
          <label for={input.id} class="block text-sm font-medium text-gray-700 mb-1">{input.label}</label>
          <div class="flex items-center gap-2">
            <input
              type="number"
              id={input.id}
              step="any"
              inputmode="decimal"
              required
              class="flex-1 px-4 py-3 border border-gray-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500 transition-colors unit-calc-input"
              placeholder={input.placeholder || ""}
              data-id={input.id}
            />
            {input.options && input.options.length > 0 && (
              <select class="w-28 sm:w-32 px-2 py-3 border border-gray-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500 bg-gray-50 unit-calc-select text-sm" data-for={input.id} aria-label={`${input.label.replace(/\(.*\)/, '').trim()} unit`}>
                {input.options.map((opt) => (
                  <option value={opt.factor} data-offset={opt.offset || '0'} selected={opt.default}>{opt.label}</option>
                ))}
              </select>
            )}
          </div>
        </div>
      ))}

      <div class="flex flex-col sm:flex-row gap-4 pt-4">
        <button type="submit" class="flex-1 bg-emerald-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors cursor-pointer">
          Calculate
        </button>
        <button type="reset" class="px-6 py-3 border border-gray-300 rounded-lg text-gray-700 font-medium hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors unit-calc-reset-btn cursor-pointer">
          Reset
        </button>
      </div>
    </form>

    <div class="mt-8 pt-6 border-t border-gray-100 hidden unit-calc-result-section" aria-live="polite">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-gray-900">Result</h3>
        <button
          type="button"
          class="unit-calc-copy-btn inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-emerald-700 bg-white hover:bg-emerald-50 active:bg-emerald-100 border border-emerald-200 rounded-md transition-colors shadow-xs focus:outline-none focus:ring-2 focus:ring-emerald-500 cursor-pointer"
          aria-label="Copy result to clipboard"
        >
          <svg class="w-3.5 h-3.5 copy-icon text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
          </svg>
          <span class="copy-text">Copy Result</span>
        </button>
      </div>

      <div class="unit-calc-err hidden bg-red-50 text-red-700 p-4 rounded-lg text-sm font-medium border border-red-100 mb-4"></div>

      {tool.medicalDisclaimer && (
        <div class="mb-6 bg-amber-50 border border-amber-200 rounded-lg p-4 flex items-start gap-3">
          <svg class="w-6 h-6 text-amber-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          <div>
            <h4 class="text-amber-800 font-semibold text-sm">Educational Purpose Only</h4>
            <p class="text-amber-700 text-sm mt-1">This tool provides estimates based on standard mathematical models and is not intended for clinical use, medical diagnosis, or treatment. Consult a healthcare professional for medical advice.</p>
          </div>
        </div>
      )}

      <div class="bg-emerald-50 p-6 rounded-xl border border-emerald-100 flex flex-col sm:flex-row items-center justify-between gap-4 unit-calc-ans-box">
        <div class="text-center sm:text-left">
          <p class="text-sm text-gray-500 mb-1 unit-calc-output-label">{tool.physicsConfig?.outputLabel || 'Result'}</p>
          <div class="text-3xl font-bold font-mono text-gray-900 unit-calc-result-value">--</div>
        </div>

        {tool.physicsConfig?.outputOptions && tool.physicsConfig.outputOptions.length > 0 && (
          <div class="w-full sm:w-auto">
             <label for="unit-calc-out-select" class="block text-xs font-medium text-gray-500 mb-1 sm:hidden">Output Unit</label>
             <select id="unit-calc-out-select" class="w-full sm:w-32 px-3 py-2 border border-gray-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500 bg-white unit-calc-out-select text-sm" aria-label="Output unit">
                {tool.physicsConfig.outputOptions.map((opt) => (
                  <option value={opt.factor} data-offset={opt.offset || '0'} selected={opt.default}>{opt.label}</option>
                ))}
              </select>
          </div>
        )}
      </div>
    </div>
  </div>
</div>

<div class="max-w-4xl mx-auto prose prose-emerald mt-12 px-4 sm:px-0">
  <h2 class="text-2xl font-bold text-gray-900 mb-4">About the {tool.title}</h2>
  <p class="text-gray-700 leading-relaxed mb-6">{tool.description} This offline calculator allows you to instantly compute the results with built-in dimensional unit conversions.</p>

  <h3 class="text-xl font-semibold text-gray-800 mb-3">Formula</h3>
  <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 mb-6 font-mono text-lg text-center overflow-x-auto text-emerald-900">
    {tool.physicsConfig?.outputLabel.split(' ')[0]} = {tool.physicsConfig?.expression.replace(/Math\./g, '').replace(/\*/g, ' × ').replace(/\//g, ' ÷ ')}
  </div>

  <h3 class="text-xl font-semibold text-gray-800 mb-3">Variable Definitions</h3>
  <div class="bg-white border border-gray-200 rounded-lg overflow-x-auto mb-8">
<table class="w-full text-left border-collapse">
      <thead class="bg-gray-50 text-gray-700">
        <tr>
          <th class="px-4 py-3 border-b font-semibold">Variable</th>
          <th class="px-4 py-3 border-b font-semibold">Symbol</th>
          <th class="px-4 py-3 border-b font-semibold">Supported Units</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 text-gray-600">
        {tool.physicsConfig?.inputs.map(inp => (
          <tr>
            <td class="px-4 py-3">{inp.label.replace(/\(.*\)/, '').trim()}</td>
            <td class="px-4 py-3 font-mono font-bold text-gray-800">{inp.id}</td>
            <td class="px-4 py-3 text-sm">
              {inp.options?.map(o => o.label).join(', ') || 'N/A'}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<script>
  import * as math from 'mathjs';
  import { PHYSICS_CONSTANTS } from '../../utils/physicsConstants';
  import { CHEMISTRY_CONSTANTS } from '../../utils/chemistryConstants';
  import { formatResultNumber, copyToClipboard } from '../../utils/formatters';

  const initUnitAwareCalculators = () => {
    document.querySelectorAll('.unit-aware-calc-container').forEach((container) => {
      if (container.hasAttribute('data-initialized')) return;
      container.setAttribute('data-initialized', 'true');

      const configStr = container.getAttribute('data-config');
      if (!configStr) return;

      const config = JSON.parse(configStr);
      const form = container.querySelector('.unit-calc-form') as HTMLFormElement;
      const inputs = container.querySelectorAll('.unit-calc-input') as NodeListOf<HTMLInputElement>;
      const inputSelects = container.querySelectorAll('.unit-calc-select') as NodeListOf<HTMLSelectElement>;
      const outSelect = container.querySelector('.unit-calc-out-select') as HTMLSelectElement;

      const resultSection = container.querySelector('.unit-calc-result-section');
      const resultValue = container.querySelector('.unit-calc-result-value');
      const outputLabelEl = container.querySelector('.unit-calc-output-label');
      const copyBtn = container.querySelector('.unit-calc-copy-btn');
      const errBox = container.querySelector('.unit-calc-err');
      const ansBox = container.querySelector('.unit-calc-ans-box');

      let lastRawResultSI: number | null = null;
      let lastDisplayStr = '';
      let lastUnitLabel = '';

      const updateOutput = () => {
         if (lastRawResultSI === null || !resultValue) return;
         let finalVal = lastRawResultSI;
         lastUnitLabel = '';

         if (outSelect && config.outputOptions) {
            const outOpt = outSelect.options[outSelect.selectedIndex];
            const outFactor = parseFloat(outOpt.value);
            const outOffset = parseFloat(outOpt.getAttribute('data-offset') || '0');
            // Conversion to selected unit: (SI_val / factor) - offset
            finalVal = (lastRawResultSI / outFactor) - outOffset;
            lastUnitLabel = outOpt.text.split('(')[0].trim() || outOpt.text;
         } else if (config.outputUnit) {
            lastUnitLabel = config.outputUnit;
         }

         let displayStr = formatResultNumber(finalVal);
         if (!outSelect && config.outputUnit && displayStr !== "Undefined") {
            displayStr += " " + config.outputUnit;
         }

         lastDisplayStr = displayStr;
         resultValue.textContent = displayStr;
      };

      if (outSelect) {
         outSelect.addEventListener('change', updateOutput);
      }

      // Copy result functionality
      if (copyBtn) {
        copyBtn.addEventListener('click', async () => {
          if (!resultValue || !resultValue.textContent || resultValue.textContent === '--') return;
          const label = outputLabelEl ? outputLabelEl.textContent?.trim() : 'Result';
          const val = resultValue.textContent.trim();
          const copyText = `${label}: ${val}`;

          const success = await copyToClipboard(copyText);
          if (success) {
            const copyTextEl = copyBtn.querySelector('.copy-text');
            const originalText = copyTextEl ? copyTextEl.textContent : 'Copy Result';
            if (copyTextEl) copyTextEl.textContent = 'Copied!';
            copyBtn.classList.add('bg-emerald-100', 'text-emerald-800');
            setTimeout(() => {
              if (copyTextEl) copyTextEl.textContent = originalText;
              copyBtn.classList.remove('bg-emerald-100', 'text-emerald-800');
            }, 2000);
          }
        });
      }

      // Form reset handler
      form.addEventListener('reset', () => {
        resultSection?.classList.add('hidden');
        ansBox?.classList.add('hidden');
        errBox?.classList.add('hidden');
        if (resultValue) resultValue.textContent = '--';
        lastRawResultSI = null;
        lastDisplayStr = '';
      });

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        errBox?.classList.add('hidden');
        ansBox?.classList.remove('hidden');

        let scope: Record<string, number> = {};

        // Inject physical constants into scope
        for (const [key, constant] of Object.entries(PHYSICS_CONSTANTS)) {
            scope[key] = constant.value;
        }
        for (const [key, constant] of Object.entries(CHEMISTRY_CONSTANTS)) {
            scope[key] = constant.value;
        }

        let hasError: string | boolean = false;

        // Collect normalized inputs
        config.inputs.forEach((inputConfig: any) => {
           const inputEl = Array.from(inputs).find(el => el.getAttribute('data-id') === inputConfig.id);
           if (!inputEl) return;

           let val = parseFloat(inputEl.value);

           // Apply unit factor and offset (val + offset) * factor = SI_val
           const selEl = Array.from(inputSelects).find(el => el.getAttribute('data-for') === inputConfig.id);
           if (selEl) {
              const selOpt = selEl.options[selEl.selectedIndex];
              const factor = parseFloat(selOpt.value);
              const offset = parseFloat(selOpt.getAttribute('data-offset') || '0');
              val = (val + offset) * factor;
           }

           scope[inputConfig.id] = val;
        });

        if (Object.values(scope).some(isNaN)) return;

        // Edge case physical validation (prevent mathjs from silently outputting non-real numbers)
        if (scope.m !== undefined && scope.m < 0) {
           hasError = "Mass cannot be negative.";
        } else if (scope.v !== undefined && Math.abs(scope.v) >= PHYSICS_CONSTANTS.c.value && config.expression.includes('sqrt(1 - (v*v)')) {
           hasError = "Velocity cannot equal or exceed the speed of light.";
        } else if (scope.t !== undefined && scope.t < 0 && (container.getAttribute('data-config')?.includes('time') || config.expression.includes(' / t'))) {
           hasError = "Time cannot be negative in this context.";
        } else if ((scope.tc !== undefined && scope.tc < 0) || (scope.th !== undefined && scope.th < 0) || (scope.t1 !== undefined && scope.t1 < 0) || (scope.t2 !== undefined && scope.t2 < 0) || (scope.T !== undefined && scope.T < 0)) {
           hasError = "Absolute temperature (Kelvin) cannot be negative.";
        }

        if (hasError) {
           ansBox?.classList.add('hidden');
           if (errBox) {
             errBox.textContent = typeof hasError === 'string' ? hasError : 'Invalid input parameters.';
             errBox.classList.remove('hidden');
           }
           resultSection?.classList.remove('hidden');
           return;
        }

        try {
          // Replace Math.cos with cos in expressions for mathjs, etc.
          let expr = config.expression.replace(/Math\.sin/g, 'sin');
          expr = expr.replace(/Math\.cos/g, 'cos');
          expr = expr.replace(/Math\.tan/g, 'tan');
          expr = expr.replace(/Math\.sqrt/g, 'sqrt');
          expr = expr.replace(/Math\.PI/g, 'pi');
          expr = expr.replace(/Math\.abs/g, 'abs');
          expr = expr.replace(/Math\.asin/g, 'asin');

          const resultSI = math.evaluate(expr, scope);
          lastRawResultSI = resultSI;

          if (isNaN(resultSI) || !isFinite(resultSI) || typeof resultSI === 'complex') {
             throw new Error("Mathematical error (e.g., division by zero or invalid domain).");
          }

          updateOutput();
        } catch (err: any) {
          console.error("Calculation error", err);
          ansBox?.classList.add('hidden');
          if (errBox) {
             errBox.textContent = `Error calculating: ${err.message}`;
             errBox.classList.remove('hidden');
          }
        }

        resultSection?.classList.remove('hidden');
        resultSection?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    });
  };

  initUnitAwareCalculators();
  document.addEventListener('astro:page-load', initUnitAwareCalculators);
</script>
