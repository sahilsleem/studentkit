---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Conversion Scale</label>
          <select id="cgpa-scale" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent">
            <option value="cbse">CBSE 10-Point Scale (CGPA × 9.5)</option>
            <option value="direct">Direct 10-Point Scale (CGPA × 10)</option>
            <option value="us4">US 4.0 Scale (CGPA / 4 × 100)</option>
            <option value="mumbai">Mumbai University (7.1 × CGPA + 12)</option>
            <option value="custom">Custom Multiplier</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">CGPA / GPA Score</label>
          <input type="number" id="cgpa-val" step="0.01" min="0" max="10" placeholder="Enter CGPA (e.g. 8.5)" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div id="cgpa-custom-box" class="hidden">
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Custom Multiplier</label>
          <input type="number" id="cgpa-multiplier" step="0.01" placeholder="Enter multiplier (e.g. 9.5)" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div class="flex flex-wrap gap-2.5 pt-1">
          <button id="cgpa-calc-btn" type="button" class="flex-1 px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all cursor-pointer">
            Calculate
          </button>
          <button id="cgpa-reset-btn" type="button" class="px-3.5 py-2.5 border border-border-line hover:bg-page text-ink font-medium text-sm rounded-xl transition-all cursor-pointer">
            Reset
          </button>
        </div>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Equivalent Percentage</div>
          <div id="cgpa-result" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div id="cgpa-formula-note" class="text-xs text-slate-muted mt-1"></div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4">
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Division / Honors</div>
          <div id="cgpa-division" class="text-sm font-semibold text-ink mt-1 break-words">--</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const scaleSelect = document.getElementById('cgpa-scale') as HTMLSelectElement;
  const valInput = document.getElementById('cgpa-val') as HTMLInputElement;
  const customBox = document.getElementById('cgpa-custom-box');
  const multiplierInput = document.getElementById('cgpa-multiplier') as HTMLInputElement;
  const calcBtn = document.getElementById('cgpa-calc-btn');
  const resetBtn = document.getElementById('cgpa-reset-btn');
  const resultEl = document.getElementById('cgpa-result');
  const formulaEl = document.getElementById('cgpa-formula-note');
  const divisionEl = document.getElementById('cgpa-division');

  function calculate() {
    const scale = scaleSelect?.value || 'cbse';
    const cgpa = parseFloat(valInput?.value || '');
    if (isNaN(cgpa)) {
      valInput?.focus();
      return;
    }
    let percentage = 0;
    let formula = '';

    if (scale === 'cbse') {
      percentage = cgpa * 9.5;
      formula = 'Formula: ' + cgpa + ' × 9.5';
    } else if (scale === 'direct') {
      percentage = cgpa * 10;
      formula = 'Formula: ' + cgpa + ' × 10';
    } else if (scale === 'us4') {
      percentage = (cgpa / 4) * 100;
      formula = 'Formula: (' + cgpa + ' / 4.0) × 100';
    } else if (scale === 'mumbai') {
      percentage = (7.1 * cgpa) + 12;
      formula = 'Formula: 7.1 × ' + cgpa + ' + 12';
    } else {
      const mult = parseFloat(multiplierInput?.value || '10');
      percentage = cgpa * mult;
      formula = 'Formula: ' + cgpa + ' × ' + mult;
    }

    if (resultEl) resultEl.textContent = Math.min(percentage, 100).toFixed(2) + '%';
    if (formulaEl) formulaEl.textContent = formula;

    let div = 'Pass';
    if (percentage >= 75) div = 'First Division with Distinction';
    else if (percentage >= 60) div = 'First Division';
    else if (percentage >= 50) div = 'Second Division';
    else if (percentage >= 40) div = 'Third Division / Pass';
    else div = 'Fail / Reappear';

    if (divisionEl) divisionEl.textContent = div;
  }

  function reset() {
    if (valInput) valInput.value = '';
    if (multiplierInput) multiplierInput.value = '';
    if (resultEl) resultEl.textContent = '--';
    if (formulaEl) formulaEl.textContent = '';
    if (divisionEl) divisionEl.textContent = '--';
    if (valInput) valInput.focus();
  }

  scaleSelect?.addEventListener('change', () => {
    if (scaleSelect.value === 'custom') {
      customBox?.classList.remove('hidden');
    } else {
      customBox?.classList.add('hidden');
    }
  });

  calcBtn?.addEventListener('click', calculate);
  resetBtn?.addEventListener('click', reset);
</script>