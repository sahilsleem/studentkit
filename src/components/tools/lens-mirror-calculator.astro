---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Focal Length (f in cm, + for convex/converging)</label>
          <input type="number" id="lm-f" placeholder="e.g. 15" step="any" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Object Distance (d_o in cm)</label>
          <input type="number" id="lm-do" placeholder="e.g. 30" min="0.1" step="any" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>

        <button id="lm-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Image Properties
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Image Distance (d_i)</div>
          <div id="lm-di" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
          <div id="lm-nature" class="text-xs text-slate-500 mt-2">Real & Inverted Image</div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 text-xs text-slate-600">
          <span>Magnification (M = -d_i/d_o): </span>
          <strong id="lm-mag" class="text-slate-800 font-mono">-1.00×</strong>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const f = parseFloat((document.getElementById('lm-f') as HTMLInputElement)?.value || '10');
    const do_val = parseFloat((document.getElementById('lm-do') as HTMLInputElement)?.value || '20');

    if (do_val === f) {
      document.getElementById('lm-di')!.textContent = 'At Infinity (Parallel Rays)';
      document.getElementById('lm-nature')!.textContent = 'No Image Formed';
      document.getElementById('lm-mag')!.textContent = '∞';
      return;
    }

    const di = (f * do_val) / (do_val - f);
    const m = -di / do_val;

    document.getElementById('lm-di')!.textContent = (di >= 0 ? '+' : '') + di.toFixed(2) + ' cm';
    document.getElementById('lm-nature')!.textContent = (di > 0 ? 'Real' : 'Virtual') + ' & ' + (m < 0 ? 'Inverted' : 'Upright');
    document.getElementById('lm-mag')!.textContent = m.toFixed(2) + '×';
  }


  document.getElementById('lm-calc-btn')?.addEventListener('click', calculate);
</script>