---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Focal Length (f in cm, + for convex/converging)</label>
          <input type="number" id="lm-f" placeholder="e.g. 15" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Object Distance (d_o in cm)</label>
          <input type="number" id="lm-do" placeholder="e.g. 30" min="0.1" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>

        <button id="lm-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Image Properties
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Image Distance (d_i)</div>
          <div id="lm-di" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div id="lm-nature" class="text-xs text-slate-muted mt-1">Real & Inverted Image</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 text-xs text-slate-muted">
          <span>Magnification (M = -d_i/d_o): </span>
          <strong id="lm-mag" class="text-ink font-mono break-words">-1.00×</strong>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const f = parseFloat((document.getElementById('lm-f') as HTMLInputElement)?.value || '10');
    const do_val = parseFloat((document.getElementById('lm-do') as HTMLInputElement)?.value || '20');

    if (do_val === f) {
      document.getElementById('lm-di')!.textContent = 'At Infinity (Parallel Rays)';
      document.getElementById('lm-nature')!.textContent = 'No Image Formed';
      document.getElementById('lm-mag')!.textContent = '∞';
      return;
    }

    const di = (f * do_val) / (do_val - f);
    const m = -di / do_val;

    document.getElementById('lm-di')!.textContent = (di >= 0 ? '+' : '') + di.toFixed(2) + ' cm';
    document.getElementById('lm-nature')!.textContent = (di > 0 ? 'Real' : 'Virtual') + ' & ' + (m < 0 ? 'Inverted' : 'Upright');
    document.getElementById('lm-mag')!.textContent = m.toFixed(2) + '×';
  }


  document.getElementById('lm-calc-btn')?.addEventListener('click', calculate);
</script>