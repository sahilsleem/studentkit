---
import { tools } from '../../data/registry';
const { tool } = Astro.props;
---

<div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden max-w-2xl mx-auto">
  <div class="p-6 sm:p-8">
    <form id="circuit-form" class="space-y-6">
      <!-- Selectors for Component Type & Connection Type -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="comp-type" class="block text-sm font-semibold text-gray-700 mb-2">Component Type</label>
          <select id="comp-type" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500 bg-white sm:text-base font-medium">
            <option value="resistor" selected>Resistors (Ω)</option>
            <option value="capacitor">Capacitors (F)</option>
          </select>
        </div>
        <div>
          <label for="conn-type" class="block text-sm font-semibold text-gray-700 mb-2">Connection Type</label>
          <select id="conn-type" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500 bg-white sm:text-base font-medium">
            <option value="series" selected>Series</option>
            <option value="parallel">Parallel</option>
          </select>
        </div>
      </div>

      <!-- Component Inputs List -->
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-2">Component Values</label>
        <div id="components-list" class="space-y-3">
          <!-- Dynamic component rows -->
        </div>
      </div>

      <div class="flex items-center gap-3">
        <button type="button" id="btn-add" class="flex-1 py-2.5 border-2 border-dashed border-gray-300 rounded-lg text-gray-600 font-medium hover:border-emerald-500 hover:text-emerald-700 transition-colors">
          + Add Component
        </button>
      </div>

      <div id="circuit-err" class="hidden bg-red-50 text-red-700 p-4 rounded-lg text-sm font-medium border border-red-100 flex items-start gap-3">
        <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        <span id="circuit-err-msg"></span>
      </div>

      <div class="flex flex-col sm:flex-row gap-3 pt-2">
        <button type="submit" id="btn-calc" class="flex-1 bg-emerald-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors shadow-sm">
          Calculate Equivalent Resistance
        </button>
        <button type="button" id="btn-reset" class="px-6 py-3 border border-gray-300 rounded-lg text-gray-700 font-medium hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors">
          Reset
        </button>
      </div>
    </form>

    <div id="circuit-result" class="mt-8 pt-6 border-t border-gray-100 hidden">
      <h3 id="result-title" class="text-lg font-semibold mb-3 text-center text-gray-800">Equivalent Resistance (R_eq)</h3>
      <div id="circuit-ans" class="bg-emerald-50/60 p-6 rounded-xl border border-emerald-100 text-center relative">
        <div class="flex items-center justify-center gap-3">
          <div class="text-4xl font-bold font-mono text-emerald-950" id="ans-val">--</div>
          <button type="button" class="copy-btn p-2 text-gray-400 hover:text-emerald-600 transition-colors" title="Copy result" data-target="ans-val">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
          </button>
        </div>
        <div class="text-emerald-800 mt-1 font-mono text-sm font-semibold" id="ans-unit">Ohms (Ω)</div>
      </div>
    </div>
  </div>
</div>

<script>
  const initCircuit = () => {
    const form = document.getElementById('circuit-form') as HTMLFormElement;
    const compTypeSelect = document.getElementById('comp-type') as HTMLSelectElement;
    const connTypeSelect = document.getElementById('conn-type') as HTMLSelectElement;
    const list = document.getElementById('components-list');
    const btnAdd = document.getElementById('btn-add');
    const btnCalc = document.getElementById('btn-calc');
    const btnReset = document.getElementById('btn-reset');
    const resSec = document.getElementById('circuit-result');
    const resTitle = document.getElementById('result-title');
    const ansVal = document.getElementById('ans-val');
    const ansUnit = document.getElementById('ans-unit');
    const errBox = document.getElementById('circuit-err');
    const errMsg = document.getElementById('circuit-err-msg');

    if (!form || !list || !compTypeSelect || !connTypeSelect) return;

    let count = 0;
    let compUid = 0;

    const getConfig = () => {
      const isCap = compTypeSelect.value === 'capacitor';
      const isPar = connTypeSelect.value === 'parallel';
      return {
        isCap,
        isPar,
        prefix: isCap ? 'C' : 'R',
        unit: isCap ? 'F' : 'Ω',
        unitFull: isCap ? 'Farads (F)' : 'Ohms (Ω)',
        name: isCap ? 'Capacitor' : 'Resistor',
        eqSymbol: isCap ? 'C_eq' : 'R_eq',
        typeName: isCap ? 'Capacitance' : 'Resistance'
      };
    };

    const updateUIState = () => {
      const cfg = getConfig();
      if (btnCalc) {
        btnCalc.textContent = `Calculate Equivalent ${cfg.typeName}`;
      }
      if (resTitle) {
        resTitle.textContent = `Equivalent ${cfg.typeName} (${cfg.eqSymbol})`;
      }
      if (ansUnit) {
        ansUnit.textContent = cfg.unitFull;
      }
      errBox?.classList.add('hidden');
      resSec?.classList.add('hidden');
      if (ansVal) ansVal.textContent = '--';
      renumber();
    };

    const addComponent = () => {
      count++;
      compUid++;
      const cfg = getConfig();
      const inputId = `comp-val-${compUid}`;
      const div = document.createElement('div');
      div.className = 'flex items-center gap-3 component-row';
      div.innerHTML = `
        <label for="${inputId}" class="w-8 font-mono font-bold text-gray-600">${cfg.prefix}<sub>${count}</sub></label>
        <input
          type="number"
          id="${inputId}"
          step="any"
          min="0"
          required
          aria-label="${cfg.name} ${count} value (${cfg.unit})"
          class="flex-1 p-3 border border-gray-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500 font-mono comp-val text-gray-900 bg-gray-50/50"
          placeholder="Value in ${cfg.unit}"
        >
        ${count > 2 ? `<button type="button" class="text-red-500 hover:text-red-700 p-2 font-bold btn-remove" title="Remove component">✕</button>` : `<div class="w-8"></div>`}
      `;
      list.appendChild(div);

      const removeBtn = div.querySelector('.btn-remove');
      if (removeBtn) {
        removeBtn.addEventListener('click', () => {
          div.remove();
          renumber();
        });
      }
    };

    const renumber = () => {
      count = 0;
      const cfg = getConfig();
      list.querySelectorAll('.component-row').forEach((row) => {
        count++;
        const lbl = row.querySelector('label');
        if (lbl) lbl.innerHTML = `${cfg.prefix}<sub>${count}</sub>`;
        const inp = row.querySelector('.comp-val') as HTMLInputElement;
        if (inp) {
          inp.setAttribute('aria-label', `${cfg.name} ${count} value (${cfg.unit})`);
          inp.placeholder = `Value in ${cfg.unit}`;
        }
        const btn = row.querySelector('.btn-remove');
        if (count <= 2) {
          if (btn) btn.outerHTML = '<div class="w-8"></div>';
        } else {
          if (!btn) {
            const newBtn = document.createElement('button');
            newBtn.type = 'button';
            newBtn.className = 'text-red-500 hover:text-red-700 p-2 font-bold btn-remove';
            newBtn.title = 'Remove component';
            newBtn.textContent = '✕';
            newBtn.addEventListener('click', () => {
              row.remove();
              renumber();
            });
            row.appendChild(newBtn);
            row.querySelector('.w-8:not(label)')?.remove();
          }
        }
      });
    };

    // Initialize with 2 components
    const resetList = () => {
      count = 0;
      compUid = 0;
      list.innerHTML = '';
      addComponent();
      addComponent();
      updateUIState();
    };

    resetList();

    compTypeSelect.addEventListener('change', updateUIState);
    connTypeSelect.addEventListener('change', updateUIState);
    btnAdd?.addEventListener('click', addComponent);

    btnReset?.addEventListener('click', () => {
      form.reset();
      resetList();
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      errBox?.classList.add('hidden');
      
      try {
        const inputs = list.querySelectorAll('.comp-val');
        const vals: number[] = [];
        for (const inp of Array.from(inputs)) {
          const v = parseFloat((inp as HTMLInputElement).value);
          if (isNaN(v)) {
            throw new Error('Please enter valid numeric values for all components.');
          }
          if (v < 0) {
            throw new Error('Component values cannot be negative.');
          }
          vals.push(v);
        }

        if (vals.length < 2) {
          throw new Error('Please add at least 2 components.');
        }

        const cfg = getConfig();
        let eq = 0;

        // Mathematical rules:
        // Resistors Series: Req = R1 + R2 + ...
        // Resistors Parallel: 1/Req = 1/R1 + 1/R2 + ... (if any is 0 => Req = 0)
        // Capacitors Series: 1/Ceq = 1/C1 + 1/C2 + ... (if any is 0 => Ceq = 0)
        // Capacitors Parallel: Ceq = C1 + C2 + ...
        const isInverse = (cfg.isCap && !cfg.isPar) || (!cfg.isCap && cfg.isPar);

        if (isInverse) {
          if (vals.includes(0)) {
            eq = 0;
          } else {
            let invSum = 0;
            for (const v of vals) {
              invSum += 1 / v;
            }
            eq = invSum === 0 ? 0 : 1 / invSum;
          }
        } else {
          for (const v of vals) {
            eq += v;
          }
        }

        if (ansVal && resSec) {
          ansVal.textContent = Number.isInteger(eq) ? eq.toString() : parseFloat(eq.toFixed(6)).toString();
          resSec.classList.remove('hidden');
          resSec.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      } catch (err: any) {
        if (errMsg && errBox) {
          errMsg.textContent = err.message || 'An error occurred during calculation.';
          errBox.classList.remove('hidden');
        }
      }
    });
  };

  initCircuit();

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement)?.closest('.copy-btn');
    if (!btn) return;
    const targetId = btn.getAttribute('data-target');
    if (!targetId) return;
    const text = document.getElementById(targetId)?.textContent;
    if (text && text !== '--') {
      navigator.clipboard.writeText(text).then(() => {
        const originalHtml = btn.innerHTML;
        btn.innerHTML = '<svg class="w-6 h-6 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>';
        setTimeout(() => { btn.innerHTML = originalHtml; }, 2000);
      });
    }
  });

  document.addEventListener('astro:page-load', initCircuit);
</script>
