---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Initial Velocity (u in m/s)</label>
          <input type="number" id="kin-u" placeholder="e.g. 0" step="any" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Acceleration (a in m/s²)</label>
          <input type="number" id="kin-a" placeholder="e.g. 9.8" step="any" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Time (t in seconds)</label>
          <input type="number" id="kin-t" placeholder="e.g. 4" min="0" step="any" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>

        <button id="kin-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Motion Parameters
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Final Velocity (v = u + at)</div>
          <div id="kin-v" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 space-y-2 text-xs text-slate-600">
          <div class="flex justify-between">
            <span>Displacement (s = ut + ½at²):</span>
            <strong id="kin-s" class="text-slate-800 font-mono">78.40 m</strong>
          </div>
          <div class="flex justify-between">
            <span>Average Velocity:</span>
            <strong id="kin-vavg" class="text-slate-800 font-mono">19.60 m/s</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const u = parseFloat((document.getElementById('kin-u') as HTMLInputElement)?.value || '0');
    const a = parseFloat((document.getElementById('kin-a') as HTMLInputElement)?.value || '0');
    const t = parseFloat((document.getElementById('kin-t') as HTMLInputElement)?.value || '0');

    const v = u + a * t;
    const s = u * t + 0.5 * a * t * t;
    const vAvg = (u + v) / 2;

    document.getElementById('kin-v')!.textContent = v.toFixed(2) + ' m/s';
    document.getElementById('kin-s')!.textContent = s.toFixed(2) + ' m';
    document.getElementById('kin-vavg')!.textContent = vAvg.toFixed(2) + ' m/s';
  }


  document.getElementById('kin-calc-btn')?.addEventListener('click', calculate);
</script>