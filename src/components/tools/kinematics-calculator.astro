---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Initial Velocity (u in m/s)</label>
          <input type="number" id="kin-u" placeholder="e.g. 0" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Acceleration (a in m/s²)</label>
          <input type="number" id="kin-a" placeholder="e.g. 9.8" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Time (t in seconds)</label>
          <input type="number" id="kin-t" placeholder="e.g. 4" min="0" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>

        <button id="kin-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Motion Parameters
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Final Velocity (v = u + at)</div>
          <div id="kin-v" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 space-y-1.5 text-xs text-slate-muted">
          <div class="flex flex-wrap justify-between gap-2">
            <span>Displacement (s = ut + ½at²):</span>
            <strong id="kin-s" class="text-ink font-mono break-words">78.40 m</strong>
          </div>
          <div class="flex flex-wrap justify-between gap-2">
            <span>Average Velocity:</span>
            <strong id="kin-vavg" class="text-ink font-mono break-words">19.60 m/s</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const u = parseFloat((document.getElementById('kin-u') as HTMLInputElement)?.value || '0');
    const a = parseFloat((document.getElementById('kin-a') as HTMLInputElement)?.value || '0');
    const t = parseFloat((document.getElementById('kin-t') as HTMLInputElement)?.value || '0');

    const v = u + a * t;
    const s = u * t + 0.5 * a * t * t;
    const vAvg = (u + v) / 2;

    document.getElementById('kin-v')!.textContent = v.toFixed(2) + ' m/s';
    document.getElementById('kin-s')!.textContent = s.toFixed(2) + ' m';
    document.getElementById('kin-vavg')!.textContent = vAvg.toFixed(2) + ' m/s';
  }


  document.getElementById('kin-calc-btn')?.addEventListener('click', calculate);
</script>