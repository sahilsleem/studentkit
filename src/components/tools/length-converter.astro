---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">From</label>
        <div class="flex flex-wrap gap-2">
          <input type="number" id="len-val" placeholder="e.g. 10" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
          <select id="len-from" class="px-3 py-2 bg-page border border-border-line rounded-xl text-sm">
            <option value="m" selected>Meters (m)</option>
            <option value="km">Kilometers (km)</option>
            <option value="cm">Centimeters (cm)</option>
            <option value="mi">Miles (mi)</option>
            <option value="ft">Feet (ft)</option>
            <option value="in">Inches (in)</option>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">To</label>
        <div class="flex flex-wrap gap-2">
          <div id="len-res" class="w-full px-3.5 py-2.5 bg-brand-light border border-brand-accent rounded-xl text-sm font-bold text-brand flex items-center">--</div>
          <select id="len-to" class="px-3 py-2 bg-page border border-border-line rounded-xl text-sm">
            <option value="ft" selected>Feet (ft)</option>
            <option value="m">Meters (m)</option>
            <option value="km">Kilometers (km)</option>
            <option value="cm">Centimeters (cm)</option>
            <option value="mi">Miles (mi)</option>
            <option value="in">Inches (in)</option>
          </select>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const toMeters: Record<string, number> = { m: 1, km: 1000, cm: 0.01, mi: 1609.344, ft: 0.3048, in: 0.0254 };

  function convert() {
    const raw = (document.getElementById('len-val') as HTMLInputElement)?.value;
    if (raw === '' || raw === undefined || isNaN(parseFloat(raw))) {
      document.getElementById('len-res')!.textContent = '--';
      return;
    }
    const val = parseFloat(raw);
    const from = (document.getElementById('len-from') as HTMLSelectElement)?.value || 'm';
    const to = (document.getElementById('len-to') as HTMLSelectElement)?.value || 'ft';

    const meters = val * (toMeters[from] || 1);
    const result = meters / (toMeters[to] || 1);

    document.getElementById('len-res')!.textContent = result.toFixed(4);
  }

  ['len-val', 'len-from', 'len-to'].forEach(id => document.getElementById(id)?.addEventListener('input', convert));
</script>