---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Solute Mass (g)</label>
          <input type="number" id="mol-mass" placeholder="e.g. 58.44" step="any" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Molar Mass (g/mol, e.g. NaCl = 58.44)</label>
          <input type="number" id="mol-mw" placeholder="e.g. 58.44" step="any" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Solution Volume (Liters)</label>
          <input type="number" id="mol-vol" placeholder="e.g. 0.5" step="any" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>

        <button id="mol-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Molarity
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Solution Concentration (M)</div>
          <div id="mol-result" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
          <div class="text-xs text-slate-500 mt-2">2.000 mol/L</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const mass = parseFloat((document.getElementById('mol-mass') as HTMLInputElement)?.value || '0');
    const mw = parseFloat((document.getElementById('mol-mw') as HTMLInputElement)?.value || '1');
    const vol = parseFloat((document.getElementById('mol-vol') as HTMLInputElement)?.value || '1');

    if (mw <= 0 || vol <= 0) return;
    const m = (mass / mw) / vol;

    document.getElementById('mol-result')!.textContent = m.toFixed(3) + ' M';
  }


  document.getElementById('mol-calc-btn')?.addEventListener('click', calculate);
</script>