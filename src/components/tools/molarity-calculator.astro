---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Solute Mass (g)</label>
          <input type="number" id="mol-mass" placeholder="e.g. 58.44" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Molar Mass (g/mol, e.g. NaCl = 58.44)</label>
          <input type="number" id="mol-mw" placeholder="e.g. 58.44" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Solution Volume (Liters)</label>
          <input type="number" id="mol-vol" placeholder="e.g. 0.5" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>

        <button id="mol-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Molarity
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Solution Concentration (M)</div>
          <div id="mol-result" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div class="text-xs text-slate-muted mt-1">2.000 mol/L</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const mass = parseFloat((document.getElementById('mol-mass') as HTMLInputElement)?.value || '0');
    const mw = parseFloat((document.getElementById('mol-mw') as HTMLInputElement)?.value || '1');
    const vol = parseFloat((document.getElementById('mol-vol') as HTMLInputElement)?.value || '1');

    if (mw <= 0 || vol <= 0) return;
    const m = (mass / mw) / vol;

    document.getElementById('mol-result')!.textContent = m.toFixed(3) + ' M';
  }


  document.getElementById('mol-calc-btn')?.addEventListener('click', calculate);
</script>