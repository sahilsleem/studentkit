---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Oscillator Type</label>
          <select id="shm-type" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="spring" selected>Mass-Spring (m, k)</option>
            <option value="pendulum">Simple Pendulum (Length L, g)</option>
          </select>
        </div>

        <div id="shm-v1-box">
          <label id="shm-l1" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Mass (m in kg)</label>
          <input type="number" id="shm-v1" placeholder="e.g. 0.5" min="0.01" step="any" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>

        <div id="shm-v2-box">
          <label id="shm-l2" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Spring Constant (k in N/m)</label>
          <input type="number" id="shm-v2" placeholder="e.g. 200" min="0.1" step="any" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>

        <button id="shm-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Period & Frequency
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Oscillation Period (T)</div>
          <div id="shm-period" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 space-y-2 text-xs text-slate-600">
          <div class="flex justify-between">
            <span>Frequency (f = 1/T):</span>
            <strong id="shm-freq" class="text-slate-800 font-mono">3.18 Hz</strong>
          </div>
          <div class="flex justify-between">
            <span>Angular Frequency (ω):</span>
            <strong id="shm-omega" class="text-slate-800 font-mono">20.00 rad/s</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const type = (document.getElementById('shm-type') as HTMLSelectElement)?.value;
    const v1 = parseFloat((document.getElementById('shm-v1') as HTMLInputElement)?.value || '1');
    const v2 = parseFloat((document.getElementById('shm-v2') as HTMLInputElement)?.value || '1');

    let T = 0;
    if (type === 'spring') {
      T = 2 * Math.PI * Math.sqrt(v1 / v2);
    } else {
      T = 2 * Math.PI * Math.sqrt(v1 / 9.80665);
    }

    const f = 1 / T;
    const omega = 2 * Math.PI * f;

    document.getElementById('shm-period')!.textContent = T.toFixed(3) + ' s';
    document.getElementById('shm-freq')!.textContent = f.toFixed(2) + ' Hz';
    document.getElementById('shm-omega')!.textContent = omega.toFixed(2) + ' rad/s';
  }

  document.getElementById('shm-type')?.addEventListener('change', () => {
    const type = (document.getElementById('shm-type') as HTMLSelectElement)?.value;
    const l1 = document.getElementById('shm-l1');
    const v2Box = document.getElementById('shm-v2-box');
    if (type === 'pendulum') {
      if (l1) l1.textContent = 'Pendulum Length (L in meters)';
      if (v2Box) v2Box.classList.add('hidden');
    } else {
      if (l1) l1.textContent = 'Mass (m in kg)';
      if (v2Box) v2Box.classList.remove('hidden');
    }
    calculate();
  });


  document.getElementById('shm-calc-btn')?.addEventListener('click', calculate);
</script>