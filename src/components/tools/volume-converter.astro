---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">From</label>
        <div class="flex gap-2">
          <input type="number" id="vol-val" placeholder="e.g. 5" step="any" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
          <select id="vol-from" class="px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm">
            <option value="gal" selected>Gallons (US)</option>
            <option value="l">Liters (L)</option>
            <option value="ml">Milliliters (mL)</option>
            <option value="floz">Fluid Ounces (fl oz)</option>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">To</label>
        <div class="flex gap-2">
          <div id="vol-res" class="w-full px-4 py-2 bg-blue-50 border border-blue-200 rounded-xl text-sm font-bold text-blue-600 flex items-center">--</div>
          <select id="vol-to" class="px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm">
            <option value="l" selected>Liters (L)</option>
            <option value="gal">Gallons (US)</option>
            <option value="ml">Milliliters (mL)</option>
            <option value="floz">Fluid Ounces (fl oz)</option>
          </select>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const toLiters: Record<string, number> = { l: 1, ml: 0.001, gal: 3.78541, floz: 0.0295735 };

  function convert() {
    const raw = (document.getElementById('vol-val') as HTMLInputElement)?.value;
    if (raw === '' || raw === undefined || isNaN(parseFloat(raw))) {
      document.getElementById('vol-res')!.textContent = '--';
      return;
    }
    const val = parseFloat(raw);
    const from = (document.getElementById('vol-from') as HTMLSelectElement)?.value || 'gal';
    const to = (document.getElementById('vol-to') as HTMLSelectElement)?.value || 'l';

    const l = val * (toLiters[from] || 1);
    const res = l / (toLiters[to] || 1);

    document.getElementById('vol-res')!.textContent = res.toFixed(4);
  }

  ['vol-val', 'vol-from', 'vol-to'].forEach(id => document.getElementById(id)?.addEventListener('input', convert));
</script>