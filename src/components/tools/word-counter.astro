<!-- Stats Bar -->
    <div class="grid grid-cols-2 md:grid-cols-6 gap-4 mb-6">
      <div class="bg-white rounded-xl p-4 border border-gray-200 text-center shadow-sm">
        <p class="text-xs text-gray-500 uppercase tracking-wider mb-1 font-medium">Words</p>
        <p class="text-2xl font-bold text-gray-900" id="stat-words">0</p>
      </div>
      <div class="bg-white rounded-xl p-4 border border-gray-200 text-center shadow-sm">
        <p class="text-xs text-gray-500 uppercase tracking-wider mb-1 font-medium">Chars</p>
        <p class="text-2xl font-bold text-gray-900" id="stat-chars">0</p>
      </div>
      <div class="bg-white rounded-xl p-4 border border-gray-200 text-center shadow-sm">
        <p class="text-xs text-gray-500 uppercase tracking-wider mb-1 font-medium" title="Characters without spaces">No Spaces</p>
        <p class="text-2xl font-bold text-gray-900" id="stat-chars-ns">0</p>
      </div>
      <div class="bg-white rounded-xl p-4 border border-gray-200 text-center shadow-sm">
        <p class="text-xs text-gray-500 uppercase tracking-wider mb-1 font-medium">Sentences</p>
        <p class="text-2xl font-bold text-gray-900" id="stat-sentences">0</p>
      </div>
      <div class="bg-white rounded-xl p-4 border border-gray-200 text-center shadow-sm">
        <p class="text-xs text-gray-500 uppercase tracking-wider mb-1 font-medium">Paragraphs</p>
        <p class="text-2xl font-bold text-gray-900" id="stat-paragraphs">0</p>
      </div>
      <div class="bg-white rounded-xl p-4 border border-gray-200 text-center shadow-sm">
        <p class="text-xs text-emerald-600 uppercase tracking-wider mb-1 font-medium">Read Time</p>
        <p class="text-xl font-bold text-emerald-700 mt-1" id="stat-time">0 min</p>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden mb-12 max-w-xl mx-auto">
      <textarea id="text-input" rows="12" class="w-full p-6 text-gray-700 bg-transparent border-0 focus:ring-0 resize-y text-lg" placeholder="Type or paste your text here to count words..."></textarea>
      <div class="bg-gray-50 border-t border-gray-100 px-6 py-3 flex justify-between items-center">
        <span class="text-sm text-gray-400">Autosaves locally</span>
        <button id="clear-btn" class="text-sm text-gray-500 hover:text-red-500 font-medium transition-colors">Clear text</button>
      </div>
    </div>
  <script>
  const initCounter = () => {
    const input = document.getElementById('text-input') as HTMLTextAreaElement;
    if (!input) return;

    const els = {
      words: document.getElementById('stat-words'),
      chars: document.getElementById('stat-chars'),
      charsNs: document.getElementById('stat-chars-ns'),
      sentences: document.getElementById('stat-sentences'),
      paragraphs: document.getElementById('stat-paragraphs'),
      time: document.getElementById('stat-time'),
    };

    const updateStats = () => {
      const text = input.value;
      
      const charCount = text.length;
      const charCountNs = text.replace(/\s/g, '').length;
      
      const words = text.match(/\b[-?(\w+)?]+\b/gi);
      const wordCount = words ? words.length : 0;
      
      const sentences = text.match(/[.!?]+/g);
      const sentenceCount = text.length > 0 && sentences ? sentences.length : 0;
      
      const paragraphs = text.split(/\n\s*\n/).filter(p => p.trim().length > 0);
      const paragraphCount = paragraphs.length;

      // Avg read time: 238 words per minute
      const timeMinutes = Math.ceil(wordCount / 238);
      const timeDisplay = timeMinutes < 1 && wordCount > 0 ? '< 1 min' : `${timeMinutes} min`;

      if(els.words) els.words.textContent = wordCount.toString();
      if(els.chars) els.chars.textContent = charCount.toString();
      if(els.charsNs) els.charsNs.textContent = charCountNs.toString();
      if(els.sentences) els.sentences.textContent = sentenceCount.toString();
      if(els.paragraphs) els.paragraphs.textContent = paragraphCount.toString();
      if(els.time) els.time.textContent = wordCount === 0 ? '0 min' : timeDisplay;
    };

    input.addEventListener('input', updateStats);
    
    document.getElementById('clear-btn')?.addEventListener('click', () => {
      input.value = '';
      updateStats();
    });

    // Initial calc if there's pre-filled text
    updateStats();
  };

  initCounter();
  document.addEventListener('astro:page-load', initCounter);
</script>

