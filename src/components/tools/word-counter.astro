---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="space-y-4">
      <div class="flex items-center justify-between">
        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500">Paste or type your text</label>
        <button id="wc-clear-btn" type="button" class="text-xs text-slate-400 hover:text-slate-600 font-medium">Clear Text</button>
      </div>

      <textarea id="wc-input" rows="8" placeholder="Start typing or paste your essay, assignment, or notes here..." class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all"></textarea>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3 mt-6">
      <div class="p-4 bg-slate-50 rounded-xl border border-slate-200/80 text-center">
        <div class="text-xs text-slate-500 font-medium">Words</div>
        <div id="wc-words" class="text-2xl font-bold text-blue-600 font-mono mt-1">--</div>
      </div>
      <div class="p-4 bg-slate-50 rounded-xl border border-slate-200/80 text-center">
        <div class="text-xs text-slate-500 font-medium">Characters</div>
        <div id="wc-chars" class="text-2xl font-bold text-slate-800 font-mono mt-1">0</div>
      </div>
      <div class="p-4 bg-slate-50 rounded-xl border border-slate-200/80 text-center">
        <div class="text-xs text-slate-500 font-medium">No Spaces</div>
        <div id="wc-chars-no-space" class="text-2xl font-bold text-slate-800 font-mono mt-1">0</div>
      </div>
      <div class="p-4 bg-slate-50 rounded-xl border border-slate-200/80 text-center">
        <div class="text-xs text-slate-500 font-medium">Sentences</div>
        <div id="wc-sentences" class="text-2xl font-bold text-slate-800 font-mono mt-1">0</div>
      </div>
      <div class="p-4 bg-slate-50 rounded-xl border border-slate-200/80 text-center">
        <div class="text-xs text-slate-500 font-medium">Paragraphs</div>
        <div id="wc-paragraphs" class="text-2xl font-bold text-slate-800 font-mono mt-1">--</div>
      </div>
      <div class="p-4 bg-slate-50 rounded-xl border border-slate-200/80 text-center">
        <div class="text-xs text-slate-500 font-medium">Reading Time</div>
        <div id="wc-read-time" class="text-lg font-bold text-slate-800 font-mono mt-1">0m</div>
      </div>
    </div>
  </div>
</div>

<script>
  const textInput = document.getElementById('wc-input') as HTMLTextAreaElement;
  const wordsEl = document.getElementById('wc-words');
  const charsEl = document.getElementById('wc-chars');
  const charsNoSpaceEl = document.getElementById('wc-chars-no-space');
  const sentencesEl = document.getElementById('wc-sentences');
  const paragraphsEl = document.getElementById('wc-paragraphs');
  const readTimeEl = document.getElementById('wc-read-time');
  const clearBtn = document.getElementById('wc-clear-btn');

  function analyze() {
    const text = textInput?.value || '';
    const words = text.trim() ? text.trim().split(/\s+/).length : 0;
    const chars = text.length;
    const charsNoSpace = text.replace(/\s/g, '').length;
    const sentences = text.trim() ? (text.match(/[^.!?]+[.!?]+/g) || []).length || (text.trim().length > 0 ? 1 : 0) : 0;
    const paragraphs = text.trim() ? text.split(/\n\s*\n/).filter(p => p.trim().length > 0).length || (text.trim().length > 0 ? 1 : 0) : 0;
    const readingTimeMin = Math.ceil(words / 200);

    if (wordsEl) wordsEl.textContent = words.toLocaleString();
    if (charsEl) charsEl.textContent = chars.toLocaleString();
    if (charsNoSpaceEl) charsNoSpaceEl.textContent = charsNoSpace.toLocaleString();
    if (sentencesEl) sentencesEl.textContent = sentences.toLocaleString();
    if (paragraphsEl) paragraphsEl.textContent = paragraphs.toLocaleString();
    if (readTimeEl) readTimeEl.textContent = readingTimeMin + 'm';
  }

  textInput?.addEventListener('input', analyze);
  clearBtn?.addEventListener('click', () => {
    if (textInput) textInput.value = '';
    analyze();
  });
</script>