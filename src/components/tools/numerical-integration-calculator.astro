---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Function f(x)</label>
          <input type="text" id="ni-func" placeholder="e.g. sin(x)" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent font-mono" />
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Lower (a)</label>
            <input type="number" id="ni-a" placeholder="e.g. 0" step="any" class="w-full px-3 py-2 bg-page border border-border-line rounded-xl text-sm" />
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Upper (b)</label>
            <input type="number" id="ni-b" placeholder="e.g. 3.14159" step="any" class="w-full px-3 py-2 bg-page border border-border-line rounded-xl text-sm" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Even Subintervals (n)</label>
          <input type="number" id="ni-n" min="2" max="1000" step="2" placeholder="e.g. 6" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <button id="ni-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Compute Simpson's & Trapezoidal
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Simpson's 1/3 Rule Approximation</div>
          <div id="ni-simp" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 space-y-1.5 text-xs text-slate-muted">
          <div class="flex flex-wrap justify-between gap-2">
            <span>Trapezoidal Rule:</span>
            <strong id="ni-trap" class="text-ink font-mono break-words">1.95409</strong>
          </div>
          <div class="flex flex-wrap justify-between gap-2">
            <span>Step Size (Δx = (b-a)/n):</span>
            <strong id="ni-dx" class="text-ink font-mono break-words">0.5236</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function evalF(expr: string, x: number): number {
    if (expr === 'sin(x)') return Math.sin(x);
    if (expr === 'cos(x)') return Math.cos(x);
    if (expr === 'e^x') return Math.exp(x);
    return Math.pow(x, 2);
  }

  function calculate() {
    const expr = (document.getElementById('ni-func') as HTMLInputElement)?.value || 'sin(x)';
    const a = parseFloat((document.getElementById('ni-a') as HTMLInputElement)?.value || '0');
    const b = parseFloat((document.getElementById('ni-b') as HTMLInputElement)?.value || '3.14159');
    let n = parseInt((document.getElementById('ni-n') as HTMLInputElement)?.value || '6', 10);
    if (n % 2 !== 0) n += 1;

    const h = (b - a) / n;

    // Trapezoidal
    let trapSum = 0.5 * (evalF(expr, a) + evalF(expr, b));
    for (let i = 1; i < n; i++) trapSum += evalF(expr, a + i * h);
    const trap = trapSum * h;

    // Simpson 1/3
    let simpSum = evalF(expr, a) + evalF(expr, b);
    for (let i = 1; i < n; i++) {
      simpSum += (i % 2 === 1 ? 4 : 2) * evalF(expr, a + i * h);
    }
    const simp = (simpSum * h) / 3;

    const simpEl = document.getElementById('ni-simp');
    const trapEl = document.getElementById('ni-trap');
    const dxEl = document.getElementById('ni-dx');

    if (simpEl) simpEl.textContent = simp.toFixed(5);
    if (trapEl) trapEl.textContent = trap.toFixed(5);
    if (dxEl) dxEl.textContent = h.toFixed(4);
  }


  document.getElementById('ni-calc-btn')?.addEventListener('click', calculate);
</script>