---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Set A (comma separated elements)</label>
          <input type="text" id="set-a" placeholder="e.g. 1, 2, 3, 4, 5" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 font-mono" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Set B (comma separated elements)</label>
          <input type="text" id="set-b" placeholder="e.g. 4, 5, 6, 7, 8" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 font-mono" />
        </div>
      </div>

      <button id="set-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
        Calculate Set Operations
      </button>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-6">
        <div class="p-4 bg-slate-50 rounded-xl border border-slate-200/80">
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Union (A ∪ B)</div>
          <div id="set-union" class="text-lg font-bold text-blue-600 mt-1 font-mono">{1, 2, 3, 4, 5, 6, 7, 8}</div>
        </div>

        <div class="p-4 bg-slate-50 rounded-xl border border-slate-200/80">
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Intersection (A ∩ B)</div>
          <div id="set-inter" class="text-lg font-bold text-blue-600 mt-1 font-mono">--</div>
        </div>

        <div class="p-4 bg-slate-50 rounded-xl border border-slate-200/80">
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Difference (A  B)</div>
          <div id="set-diff" class="text-lg font-bold text-slate-800 mt-1 font-mono">{1, 2, 3}</div>
        </div>

        <div class="p-4 bg-slate-50 rounded-xl border border-slate-200/80">
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Symmetric Difference (A Δ B)</div>
          <div id="set-symdiff" class="text-lg font-bold text-slate-800 mt-1 font-mono">{1, 2, 3, 6, 7, 8}</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function parseSet(str: string): Set<string> {
    return new Set(str.split(',').map(s => s.trim()).filter(s => s.length > 0));
  }

  function fmtSet(s: Set<string>): string {
    const arr = Array.from(s).sort();
    return arr.length > 0 ? '{' + arr.join(', ') + '}' : '∅ (Empty Set)';
  }

  function calculate() {
    const rawA = (document.getElementById('set-a') as HTMLInputElement)?.value || '';
    const rawB = (document.getElementById('set-b') as HTMLInputElement)?.value || '';

    const setA = parseSet(rawA);
    const setB = parseSet(rawB);

    const union = new Set([...setA, ...setB]);
    const inter = new Set([...setA].filter(x => setB.has(x)));
    const diff = new Set([...setA].filter(x => !setB.has(x)));
    const symdiff = new Set([...[...setA].filter(x => !setB.has(x)), ...[...setB].filter(x => !setA.has(x))]);

    const uEl = document.getElementById('set-union');
    const iEl = document.getElementById('set-inter');
    const dEl = document.getElementById('set-diff');
    const sEl = document.getElementById('set-symdiff');

    if (uEl) uEl.textContent = fmtSet(union);
    if (iEl) iEl.textContent = fmtSet(inter);
    if (dEl) dEl.textContent = fmtSet(diff);
    if (sEl) sEl.textContent = fmtSet(symdiff);
  }


  document.getElementById('set-calc-btn')?.addEventListener('click', calculate);
</script>