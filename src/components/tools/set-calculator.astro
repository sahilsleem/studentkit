---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="space-y-3.5">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Set A (comma separated elements)</label>
          <input type="text" id="set-a" placeholder="e.g. 1, 2, 3, 4, 5" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent font-mono" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Set B (comma separated elements)</label>
          <input type="text" id="set-b" placeholder="e.g. 4, 5, 6, 7, 8" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent font-mono" />
        </div>
      </div>

      <button id="set-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
        Calculate Set Operations
      </button>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4">
        <div class="p-4 bg-page rounded-xl border border-border-line/80">
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Union (A ∪ B)</div>
          <div id="set-union" class="text-lg font-bold text-brand mt-1 font-mono">{1, 2, 3, 4, 5, 6, 7, 8}</div>
        </div>

        <div class="p-4 bg-page rounded-xl border border-border-line/80">
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Intersection (A ∩ B)</div>
          <div id="set-inter" class="text-lg font-bold text-brand mt-1 font-mono">--</div>
        </div>

        <div class="p-4 bg-page rounded-xl border border-border-line/80">
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Difference (A  B)</div>
          <div id="set-diff" class="text-lg font-bold text-ink mt-1 font-mono">{1, 2, 3}</div>
        </div>

        <div class="p-4 bg-page rounded-xl border border-border-line/80">
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Symmetric Difference (A Δ B)</div>
          <div id="set-symdiff" class="text-lg font-bold text-ink mt-1 font-mono">{1, 2, 3, 6, 7, 8}</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function parseSet(str: string): Set<string> {
    return new Set(str.split(',').map(s => s.trim()).filter(s => s.length > 0));
  }

  function fmtSet(s: Set<string>): string {
    const arr = Array.from(s).sort();
    return arr.length > 0 ? '{' + arr.join(', ') + '}' : '∅ (Empty Set)';
  }

  function calculate() {
    const rawA = (document.getElementById('set-a') as HTMLInputElement)?.value || '';
    const rawB = (document.getElementById('set-b') as HTMLInputElement)?.value || '';

    const setA = parseSet(rawA);
    const setB = parseSet(rawB);

    const union = new Set([...setA, ...setB]);
    const inter = new Set([...setA].filter(x => setB.has(x)));
    const diff = new Set([...setA].filter(x => !setB.has(x)));
    const symdiff = new Set([...[...setA].filter(x => !setB.has(x)), ...[...setB].filter(x => !setA.has(x))]);

    const uEl = document.getElementById('set-union');
    const iEl = document.getElementById('set-inter');
    const dEl = document.getElementById('set-diff');
    const sEl = document.getElementById('set-symdiff');

    if (uEl) uEl.textContent = fmtSet(union);
    if (iEl) iEl.textContent = fmtSet(inter);
    if (dEl) dEl.textContent = fmtSet(diff);
    if (sEl) sEl.textContent = fmtSet(symdiff);
  }


  document.getElementById('set-calc-btn')?.addEventListener('click', calculate);
</script>