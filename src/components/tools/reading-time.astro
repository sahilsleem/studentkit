<!-- Stats Bar -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
      <div class="bg-emerald-50 rounded-xl p-6 border border-emerald-100 text-center shadow-sm flex flex-col justify-center">
        <p class="text-xs text-emerald-600 uppercase tracking-wider mb-1 font-medium">Estimated Reading Time</p>
        <p class="text-4xl font-bold text-emerald-700 mt-2" id="stat-time">0 min</p>
      </div>
      <div class="md:col-span-2 bg-white rounded-xl p-6 border border-gray-200 shadow-sm flex flex-col justify-center">
        <div class="flex items-center justify-between mb-4">
          <label class="block text-sm font-medium text-gray-700">Reading Speed (words per minute)</label>
          <span class="text-sm font-bold text-emerald-600" id="speed-display">238 wpm</span>
        </div>
        <input type="range" id="speed-slider" min="100" max="500" value="238" class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-emerald-600">
        <div class="flex justify-between text-xs text-gray-400 mt-2">
          <span>Slow (100)</span>
          <span>Average (238)</span>
          <span>Fast (500)</span>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden mb-12 max-w-xl mx-auto">
      <textarea id="text-input" rows="12" class="w-full p-6 text-gray-700 bg-transparent border-0 focus:ring-0 resize-y text-lg" placeholder="Paste your essay, article, or chapter here..."></textarea>
      <div class="bg-gray-50 border-t border-gray-100 px-6 py-3 flex justify-between items-center">
        <span class="text-sm text-gray-500 font-medium"><span id="word-count">0</span> words</span>
        <button id="clear-btn" class="text-sm text-gray-500 hover:text-red-500 font-medium transition-colors">Clear text</button>
      </div>
    </div>
  <script>
  const initCounter = () => {
    const input = document.getElementById('text-input') as HTMLTextAreaElement;
    const slider = document.getElementById('speed-slider') as HTMLInputElement;
    if (!input || !slider) return;

    const timeEl = document.getElementById('stat-time');
    const wordCountEl = document.getElementById('word-count');
    const speedDisplay = document.getElementById('speed-display');

    const updateStats = () => {
      const text = input.value;
      const speed = parseInt(slider.value, 10);
      
      if(speedDisplay) speedDisplay.textContent = `${speed} wpm`;
      
      const words = text.match(/\b[-?(\w+)?]+\b/gi);
      const wordCount = words ? words.length : 0;
      
      if(wordCountEl) wordCountEl.textContent = wordCount.toString();

      const timeMinutes = wordCount / speed;
      
      if (timeEl) {
        if (wordCount === 0) {
          timeEl.textContent = '0 min';
        } else if (timeMinutes < 1) {
          const seconds = Math.ceil(timeMinutes * 60);
          timeEl.textContent = `${seconds} sec`;
        } else {
          timeEl.textContent = `${Math.ceil(timeMinutes)} min`;
        }
      }
    };

    input.addEventListener('input', updateStats);
    slider.addEventListener('input', updateStats);
    
    document.getElementById('clear-btn')?.addEventListener('click', () => {
      input.value = '';
      updateStats();
    });

    updateStats();
  };

  initCounter();
  document.addEventListener('astro:page-load', initCounter);
</script>

