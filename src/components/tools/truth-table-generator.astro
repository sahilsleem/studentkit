---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="space-y-3.5">
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Boolean Logic Gate</label>
        <select id="tt-gate" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm">
          <option value="and" selected>AND Gate (A ∧ B)</option>
          <option value="or">OR Gate (A ∨ B)</option>
          <option value="xor">XOR Gate (A ⊕ B)</option>
          <option value="nand">NAND Gate (¬(A ∧ B))</option>
          <option value="nor">NOR Gate (¬(A ∨ B))</option>
        </select>
      </div>
      <button id="tt-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">Generate Truth Table</button>

      <div class="overflow-x-auto mt-4">
        <div class="overflow-x-auto w-full"><table class="w-full text-center text-sm font-mono border border-border-line rounded-xl overflow-hidden">
          <thead class="bg-page text-xs font-bold uppercase text-slate-muted border-b border-border-line">
            <tr>
              <th class="py-2.5 px-4">A</th>
              <th class="py-2.5 px-4">B</th>
              <th class="py-2.5 px-4 text-brand">Output (Q)</th>
            </tr>
          </thead>
          <tbody id="tt-body" class="divide-y divide-border-line">
            <tr><td>0</td><td>0</td><td class="font-bold text-brand">0</td></tr>
            <tr><td>0</td><td>1</td><td class="font-bold text-brand">0</td></tr>
            <tr><td>1</td><td>0</td><td class="font-bold text-brand">0</td></tr>
            <tr><td>1</td><td>1</td><td class="font-bold text-brand">1</td></tr>
          </tbody>
        </table></div>
      </div>
    </div>
  </div>
</div>

<script>
  const tables: Record<string, number[]> = {
    and: [0, 0, 0, 1],
    or: [0, 1, 1, 1],
    xor: [0, 1, 1, 0],
    nand: [1, 1, 1, 0],
    nor: [1, 0, 0, 0]
  };

  function update() {
    const gate = (document.getElementById('tt-gate') as HTMLSelectElement)?.value || 'and';
    const outputs = tables[gate] || [0, 0, 0, 1];

    const tbody = document.getElementById('tt-body');
    if (tbody) {
      tbody.innerHTML =
        '<tr><td>0</td><td>0</td><td class="font-bold text-brand">' + outputs[0] + '</td></tr>' +
        '<tr><td>0</td><td>1</td><td class="font-bold text-brand">' + outputs[1] + '</td></tr>' +
        '<tr><td>1</td><td>0</td><td class="font-bold text-brand">' + outputs[2] + '</td></tr>' +
        '<tr><td>1</td><td>1</td><td class="font-bold text-brand">' + outputs[3] + '</td></tr>';
    }
  }


document.getElementById('tt-calc-btn')?.addEventListener('click', update);
</script>