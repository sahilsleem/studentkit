---
import { tools } from '../../data/registry';
const { tool } = Astro.props;
---

<div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden max-w-lg mx-auto">
  <div class="p-6 sm:p-8">
    <form id="trig-form" class="space-y-6">
      <!-- Function Selector -->
      <div>
        <label for="trig-func" class="block text-sm font-medium text-gray-700 mb-1">
          Trigonometric Function
        </label>
        <select id="trig-func" class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500 sm:text-base font-medium transition-colors bg-white">
          <optgroup label="Standard Trigonometric Functions">
            <option value="sin" data-math="sin" data-inverse="false" selected>Sine — sin(θ)</option>
            <option value="cos" data-math="cos" data-inverse="false">Cosine — cos(θ)</option>
            <option value="tan" data-math="tan" data-inverse="false">Tangent — tan(θ)</option>
            <option value="csc" data-math="csc" data-inverse="false">Cosecant — csc(θ)</option>
            <option value="sec" data-math="sec" data-inverse="false">Secant — sec(θ)</option>
            <option value="cot" data-math="cot" data-inverse="false">Cotangent — cot(θ)</option>
          </optgroup>
          <optgroup label="Inverse Trigonometric Functions">
            <option value="arcsin" data-math="asin" data-inverse="true">Arcsine — arcsin(x)</option>
            <option value="arccos" data-math="acos" data-inverse="true">Arccosine — arccos(x)</option>
            <option value="arctan" data-math="atan" data-inverse="true">Arctangent — arctan(x)</option>
            <option value="arccsc" data-math="acsc" data-inverse="true">Arccosecant — arccsc(x)</option>
            <option value="arcsec" data-math="asec" data-inverse="true">Arcsecant — arcsec(x)</option>
            <option value="arccot" data-math="acot" data-inverse="true">Arccotangent — arccot(x)</option>
          </optgroup>
        </select>
      </div>

      <!-- Unit Selector (Degrees / Radians) -->
      <div class="flex flex-col items-center gap-1.5">
        <span class="text-xs font-medium text-gray-500" id="unit-context-label">Angle Unit (Input)</span>
        <div class="inline-flex bg-gray-100 p-1 rounded-lg">
          <label class="cursor-pointer">
            <input type="radio" name="angleUnit" value="deg" class="peer sr-only" checked>
            <div class="px-4 py-2 text-sm font-medium rounded-md peer-checked:bg-white peer-checked:shadow-sm peer-checked:text-gray-900 text-gray-500 hover:text-gray-900 transition-colors">Degrees (DEG)</div>
          </label>
          <label class="cursor-pointer">
            <input type="radio" name="angleUnit" value="rad" class="peer sr-only">
            <div class="px-4 py-2 text-sm font-medium rounded-md peer-checked:bg-white peer-checked:shadow-sm peer-checked:text-gray-900 text-gray-500 hover:text-gray-900 transition-colors">Radians (RAD)</div>
          </label>
        </div>
      </div>

      <!-- Input Value Field -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="trig-input" id="input-label" class="block text-sm font-medium text-gray-700">
            Input Angle (θ)
          </label>
          <span id="domain-hint" class="text-xs text-gray-400 font-mono hidden"></span>
        </div>
        <div class="relative">
          <input type="number" step="any" id="trig-input" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500 sm:text-base font-mono transition-colors" placeholder="e.g. 30">
          <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-gray-400 font-mono" id="unit-label">
            °
          </div>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 pt-2">
        <button type="submit" class="flex-1 bg-emerald-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors shadow-sm">Calculate</button>
      </div>
    </form>

    <div id="trig-result" class="mt-8 pt-6 border-t border-gray-100 hidden">
      <h3 class="text-lg font-semibold mb-3 text-center">Result</h3>
      <div class="bg-gray-50 p-6 rounded-xl border border-gray-200 text-center">
        <p class="text-sm text-gray-500 mb-2 font-mono" id="res-expr"></p>
        <p class="text-3xl font-bold text-gray-900 font-mono" id="res-val">--</p>
      </div>
    </div>
  </div>
</div>

<script>
  import * as math from 'mathjs';

  const fnMap: Record<string, string> = {
    'sin': 'sin', 'cos': 'cos', 'tan': 'tan',
    'csc': 'csc', 'sec': 'sec', 'cot': 'cot',
    'arcsin': 'asin', 'arccos': 'acos', 'arctan': 'atan',
    'arccsc': 'acsc', 'arcsec': 'asec', 'arccot': 'acot'
  };

  const domainHints: Record<string, string> = {
    'arcsin': 'Domain: [-1, 1]',
    'arccos': 'Domain: [-1, 1]',
    'arctan': 'Domain: (-∞, ∞)',
    'arccsc': 'Domain: |x| ≥ 1',
    'arcsec': 'Domain: |x| ≥ 1',
    'arccot': 'Domain: (-∞, ∞)'
  };

  const initTrig = () => {
    const form = document.getElementById('trig-form') as HTMLFormElement;
    const funcSelect = document.getElementById('trig-func') as HTMLSelectElement;
    const input = document.getElementById('trig-input') as HTMLInputElement;
    const inputLabel = document.getElementById('input-label');
    const unitLabel = document.getElementById('unit-label');
    const unitContextLabel = document.getElementById('unit-context-label');
    const domainHint = document.getElementById('domain-hint');
    const radios = document.getElementsByName('angleUnit');
    const resSec = document.getElementById('trig-result');
    const resExpr = document.getElementById('res-expr');
    const resVal = document.getElementById('res-val');

    if (!form || !funcSelect || !input) return;

    const getUnit = () => Array.from(radios).find(r => (r as HTMLInputElement).checked)?.value || 'deg';

    const updateModeUI = () => {
      const selectedOption = funcSelect.options[funcSelect.selectedIndex];
      const isInverse = selectedOption.getAttribute('data-inverse') === 'true';
      const funcName = funcSelect.value;
      const unit = getUnit();

      if (isInverse) {
        if (inputLabel) inputLabel.textContent = 'Input Value / Ratio (x)';
        if (unitContextLabel) unitContextLabel.textContent = 'Angle Unit (Output)';
        if (unitLabel) unitLabel.textContent = '';
        input.placeholder = funcName === 'arccsc' || funcName === 'arcsec' ? 'e.g. 2' : 'e.g. 0.5';
        if (domainHint) {
          domainHint.textContent = domainHints[funcName] || '';
          domainHint.classList.remove('hidden');
        }
      } else {
        if (inputLabel) inputLabel.textContent = 'Input Angle (θ)';
        if (unitContextLabel) unitContextLabel.textContent = 'Angle Unit (Input)';
        if (unitLabel) unitLabel.textContent = unit === 'deg' ? '°' : 'rad';
        input.placeholder = unit === 'deg' ? 'e.g. 30' : 'e.g. 0.5236';
        if (domainHint) {
          domainHint.classList.add('hidden');
        }
      }

      // Clear previous results on mode switch
      if (resSec) resSec.classList.add('hidden');
    };

    funcSelect.addEventListener('change', updateModeUI);

    radios.forEach(r => r.addEventListener('change', () => {
      const selectedOption = funcSelect.options[funcSelect.selectedIndex];
      const isInverse = selectedOption.getAttribute('data-inverse') === 'true';
      const unit = getUnit();
      if (!isInverse && unitLabel) {
        unitLabel.textContent = unit === 'deg' ? '°' : 'rad';
        input.placeholder = unit === 'deg' ? 'e.g. 30' : 'e.g. 0.5236';
      }
    }));

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const val = parseFloat(input.value);
      if (isNaN(val)) return;

      const funcName = funcSelect.value;
      const selectedOption = funcSelect.options[funcSelect.selectedIndex];
      const isInverse = selectedOption.getAttribute('data-inverse') === 'true';
      const mathFn = fnMap[funcName] || funcName;
      const unit = getUnit();

      let result: number | null = null;
      let error: string | null = null;

      try {
        if (isInverse) {
          // Domain checks
          if ((mathFn === 'asin' || mathFn === 'acos') && (val < -1 || val > 1)) {
            error = 'Undefined (out of domain [-1, 1])';
          } else if ((mathFn === 'asec' || mathFn === 'acsc') && (val > -1 && val < 1)) {
            error = 'Undefined (out of domain |x| >= 1)';
          } else {
            result = math.evaluate(`${mathFn}(${val})`);
            // mathjs returns radians for inverse trig; convert to degrees if unit is 'deg'
            if (unit === 'deg' && typeof result === 'number') {
              result = result * (180 / Math.PI);
            }
          }
        } else {
          // Standard trig evaluation
          let evalStr = unit === 'deg' ? `${mathFn}(${val} deg)` : `${mathFn}(${val} rad)`;
          let angDeg = unit === 'deg' ? val : val * (180 / Math.PI);

          // Normalized positive angle modulo 180
          let norm180 = ((angDeg % 180) + 180) % 180;

          // Singularity detection:
          // tan and sec are undefined at 90° + 180°k (e.g. 90, 270, -90)
          if ((mathFn === 'tan' || mathFn === 'sec') && Math.abs(norm180 - 90) < 1e-9) {
            error = 'Undefined';
          }
          // cot and csc are undefined at 0° + 180°k (e.g. 0, 180, 360, -180)
          else if ((mathFn === 'cot' || mathFn === 'csc') && (Math.abs(norm180) < 1e-9 || Math.abs(norm180 - 180) < 1e-9)) {
            error = 'Undefined';
          } else {
            result = math.evaluate(evalStr);
          }
        }

        if (error) {
          if (resExpr) resExpr.textContent = `${funcName}(${val}${isInverse ? '' : (unit === 'deg' ? '°' : ' rad')})`;
          if (resVal) {
            resVal.innerHTML = `<span class="text-red-500 text-xl">${error}</span>`;
          }
        } else if (typeof result === 'number') {
          // Floating point zero-snapping
          if (Math.abs(result) < 1e-10) result = 0;

          const formatted = Number.isInteger(result) ? result : parseFloat(result.toFixed(6));

          let exprStr = '';
          if (isInverse) {
            exprStr = `${funcName}(${val}) = ${formatted}${unit === 'deg' ? '°' : ' rad'}`;
          } else {
            exprStr = `${funcName}(${val}${unit === 'deg' ? '°' : ' rad'}) =`;
          }

          if (resExpr) resExpr.textContent = exprStr;
          if (resVal) resVal.textContent = isInverse ? `${formatted}${unit === 'deg' ? '°' : ''}` : String(formatted);
        }

        if (resSec) resSec.classList.remove('hidden');
      } catch (err) {
        if (resVal) resVal.textContent = 'Error';
        if (resSec) resSec.classList.remove('hidden');
      }
    });

    // Initial UI setup
    updateModeUI();
  };

  initTrig();
  document.addEventListener('astro:page-load', initTrig);
</script>
