---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Voltage (V in Volts)</label>
          <input type="number" id="ohm-v" placeholder="e.g. 12" step="any" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Current (I in Amperes)</label>
          <input type="number" id="ohm-i" placeholder="e.g. 2.5" step="any" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>

        <button id="ohm-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Resistance & Power
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Resistance (R = V / I)</div>
          <div id="ohm-r" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 space-y-2 text-xs text-slate-600">
          <div class="flex justify-between">
            <span>Electric Power (P = V · I):</span>
            <strong id="ohm-p" class="text-slate-800 font-mono">30.00 W</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const v = parseFloat((document.getElementById('ohm-v') as HTMLInputElement)?.value || '0');
    const i = parseFloat((document.getElementById('ohm-i') as HTMLInputElement)?.value || '0');

    if (i === 0) return;
    const r = v / i;
    const p = v * i;

    document.getElementById('ohm-r')!.textContent = r.toFixed(2) + ' Ω';
    document.getElementById('ohm-p')!.textContent = p.toFixed(2) + ' W';
  }


  document.getElementById('ohm-calc-btn')?.addEventListener('click', calculate);
</script>