---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="flex items-center justify-between pb-4 mb-6 border-b border-border-line">
      <div>
        <h2 class="text-lg font-bold text-ink">Weighted Grade Calculator</h2>
        <p class="text-sm text-slate-muted">Calculate composite grade with weighted assignments, quizzes, and exams.</p>
      </div>
      <button id="wg-add-row" type="button" class="px-3 py-1.5 bg-brand-light text-brand hover:bg-brand-light font-medium text-xs rounded-lg transition-colors">
        + Add Category
      </button>
    </div>

    <div class="overflow-x-auto w-full"><table class="w-full text-left text-sm text-slate-muted">
        <thead class="text-xs uppercase bg-page text-slate-muted font-semibold border-b border-border-line">
          <tr>
            <th class="py-3 px-3">Assessment Category</th>
            <th class="py-3 px-3">Score (%)</th>
            <th class="py-3 px-3">Weight (%)</th>
            <th class="py-3 px-2 w-10"></th>
          </tr>
        </thead>
        <tbody id="wg-body" class="divide-y divide-border-line"></tbody>
      </table></div>


    <div class="mt-4 flex flex-wrap items-center justify-between gap-4 pt-3 border-t border-border-line">
      <div class="flex flex-wrap items-center gap-2">
        <button id="wg-calc-btn" type="button" class="px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Grade
        </button>
        <button id="wg-reset-btn" type="button" class="px-3.5 py-2.5 bg-search hover:bg-border-line text-ink font-medium text-sm rounded-xl transition-all">
          Reset
        </button>
      </div>
      <div class="text-sm">
        <span class="text-slate-muted">Total Weight: </span>
        <strong id="wg-total-weight" class="text-ink">0%</strong>
      </div>
    </div>

    <div class="mt-4 p-4 sm:p-5 bg-page rounded-xl border border-border-line/80 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Overall Weighted Score</div>
        <div id="wg-result" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
      </div>
      <div class="text-right">
        <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Letter Grade</div>
        <div id="wg-letter" class="text-sm font-semibold text-ink mt-1 break-words">--</div>
      </div>
    </div>
  </div>
</div>

<script>
  const tbody = document.getElementById('wg-body');
  const addBtn = document.getElementById('wg-add-row');
  const calcBtn = document.getElementById('wg-calc-btn');
  const resetBtn = document.getElementById('wg-reset-btn');
  const resultEl = document.getElementById('wg-result');
  const letterEl = document.getElementById('wg-letter');
  const totalWeightEl = document.getElementById('wg-total-weight');

  let count = 0;

  function addRow(name = '', score = 90, weight = 25) {
    count++;
    const tr = document.createElement('tr');
    tr.className = 'hover:bg-page/50 transition-colors';
    tr.innerHTML =
      '<td class="py-2.5 px-3">' +
        '<input type="text" placeholder="e.g. Homework" class="wg-name w-full px-3 py-1.5 bg-page border border-border-line rounded-lg text-sm text-ink focus:outline-none focus:ring-1 focus:ring-brand-accent" />' +
      '</td>' +
      '<td class="py-2.5 px-3">' +
        '<input type="number" min="0" max="150" step="0.5" placeholder="90" class="wg-score w-24 min-w-[4rem] flex-1 sm:flex-none px-3 py-1.5 bg-page border border-border-line rounded-lg text-sm text-ink focus:outline-none focus:ring-1 focus:ring-brand-accent" />' +
      '</td>' +
      '<td class="py-2.5 px-3">' +
        '<input type="number" min="0" max="100" step="1" placeholder="25" class="wg-weight w-24 min-w-[4rem] flex-1 sm:flex-none px-3 py-1.5 bg-page border border-border-line rounded-lg text-sm text-ink focus:outline-none focus:ring-1 focus:ring-brand-accent" />' +
      '</td>' +
      '<td class="py-2.5 px-2 text-right">' +
        '<button type="button" class="wg-del text-slate-muted hover:text-red-500 font-bold p-1">&times;</button>' +
      '</td>';

    tbody?.appendChild(tr);

    tr.querySelector('.wg-del')?.addEventListener('click', () => {
      if (tbody && tbody.children.length > 1) {
        tr.remove();
      }
    });
  }

  function calculate() {
    if (!tbody) return;
    const rows = tbody.querySelectorAll('tr');
    let totalScoreWeight = 0;
    let totalWeight = 0;

    rows.forEach(row => {
      const scoreIn = row.querySelector('.wg-score') as HTMLInputElement;
      const weightIn = row.querySelector('.wg-weight') as HTMLInputElement;
      const score = parseFloat(scoreIn?.value || '0');
      const weight = parseFloat(weightIn?.value || '0');

      if (!isNaN(score) && !isNaN(weight) && weight > 0) {
        totalScoreWeight += score * weight;
        totalWeight += weight;
      }
    });

    if (totalWeightEl) {
      totalWeightEl.textContent = totalWeight + '%';
      totalWeightEl.className = totalWeight === 100 ? 'text-emerald-600 font-bold' : 'text-amber-600 font-bold';
    }

    if (totalWeight > 0 && resultEl && letterEl) {
      const finalScore = totalScoreWeight / totalWeight;
      resultEl.textContent = finalScore.toFixed(2) + '%';

      let grade = 'F';
      if (finalScore >= 93) grade = 'A';
      else if (finalScore >= 90) grade = 'A-';
      else if (finalScore >= 87) grade = 'B+';
      else if (finalScore >= 83) grade = 'B';
      else if (finalScore >= 80) grade = 'B-';
      else if (finalScore >= 77) grade = 'C+';
      else if (finalScore >= 73) grade = 'C';
      else if (finalScore >= 70) grade = 'C-';
      else if (finalScore >= 60) grade = 'D';

      letterEl.textContent = grade;
    }
  }

  function init() {
    if (!tbody) return;
    tbody.innerHTML = '';
    addRow('Homework / Assignments', 95, 20);
    addRow('Midterm Exam', 84, 25);
    addRow('Project / Lab', 92, 20);
    addRow('Final Exam', 88, 35);
    calculate();
  }

  addBtn?.addEventListener('click', () => addRow('', 90, 10));
  calcBtn?.addEventListener('click', calculate);
  resetBtn?.addEventListener('click', init);

  init();
</script>