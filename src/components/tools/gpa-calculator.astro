---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="flex items-center justify-between pb-4 mb-6 border-b border-border-line">
      <div>
        <h2 class="text-lg font-bold text-ink">Semester GPA Calculator</h2>
        <p class="text-sm text-slate-muted">Calculate weighted grade point average from credit hours and letter grades.</p>
      </div>
      <button id="gpa-add-row" type="button" class="px-3 py-1.5 bg-brand-light text-brand hover:bg-brand-light font-medium text-xs rounded-lg transition-colors">
        + Add Course
      </button>
    </div>

    <div class="overflow-x-auto w-full"><table class="w-full text-left text-sm text-slate-muted">
        <thead class="text-xs uppercase bg-page text-slate-muted font-semibold border-b border-border-line">
          <tr>
            <th class="py-3 px-3">Course</th>
            <th class="py-3 px-3">Credits</th>
            <th class="py-3 px-3">Grade</th>
            <th class="py-3 px-2 w-10"></th>
          </tr>
        </thead>
        <tbody id="gpa-courses-body" class="divide-y divide-border-line"></tbody>
      </table></div>


    <div class="mt-4 flex flex-wrap items-center justify-between gap-4 pt-3 border-t border-border-line">
      <div class="flex flex-wrap items-center gap-2">
        <button id="gpa-calc-btn" type="button" class="px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate GPA
        </button>
        <button id="gpa-reset-btn" type="button" class="px-3.5 py-2.5 bg-search hover:bg-border-line text-ink font-medium text-sm rounded-xl transition-all">
          Reset
        </button>
      </div>
      <div class="text-sm text-slate-muted">
        Total Credits: <strong id="gpa-total-credits" class="text-ink">0</strong>
      </div>
    </div>

    <div class="mt-4 p-4 sm:p-5 bg-page rounded-xl border border-border-line/80 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Calculated GPA (4.0 Scale)</div>
        <div id="gpa-result-val" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
      </div>
      <div class="text-right">
        <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Academic Standing</div>
        <div id="gpa-result-class" class="text-sm font-semibold text-ink mt-1 break-words">Enter courses above</div>
      </div>
    </div>
  </div>
</div>

<script>
  const gradePoints: Record<string, number> = {
    'A+': 4.0, 'A': 4.0, 'A-': 3.7,
    'B+': 3.3, 'B': 3.0, 'B-': 2.7,
    'C+': 2.3, 'C': 2.0, 'C-': 1.7,
    'D+': 1.3, 'D': 1.0, 'F': 0.0
  };

  const tbody = document.getElementById('gpa-courses-body');
  const addBtn = document.getElementById('gpa-add-row');
  const calcBtn = document.getElementById('gpa-calc-btn');
  const resetBtn = document.getElementById('gpa-reset-btn');
  const resultVal = document.getElementById('gpa-result-val');
  const resultClass = document.getElementById('gpa-result-class');
  const totalCreds = document.getElementById('gpa-total-credits');

  let courseCount = 0;

  function createRow(name = '', credits = 3, grade = 'A') {
    courseCount++;
    const tr = document.createElement('tr');
    tr.id = 'gpa-row-' + courseCount;
    tr.className = 'hover:bg-page/50 transition-colors';

    let optionsHtml = '';
    for (const [k, v] of Object.entries(gradePoints)) {
      optionsHtml += '<option value="' + k + '" ' + (k === grade ? 'selected' : '') + '>' + k + ' (' + v + ')</option>';
    }

    tr.innerHTML =
      '<td class="py-2.5 px-3">' +
        '<input type="text" placeholder="e.g. Course Name" class="gpa-course-name w-full px-3 py-1.5 bg-page border border-border-line rounded-lg text-sm text-ink focus:outline-none focus:ring-1 focus:ring-brand-accent" />' +
      '</td>' +
      '<td class="py-2.5 px-3">' +
        '<input type="number" min="0.5" max="12" step="0.5" placeholder="3" class="gpa-course-credits w-20 min-w-[4rem] flex-1 sm:flex-none px-3 py-1.5 bg-page border border-border-line rounded-lg text-sm text-ink focus:outline-none focus:ring-1 focus:ring-brand-accent" />' +
      '</td>' +
      '<td class="py-2.5 px-3">' +
        '<select class="gpa-course-grade w-28 px-3 py-1.5 bg-page border border-border-line rounded-lg text-sm text-ink focus:outline-none focus:ring-1 focus:ring-brand-accent">' +
          optionsHtml +
        '</select>' +
      '</td>' +
      '<td class="py-2.5 px-2 text-right">' +
        '<button type="button" class="gpa-del-btn text-slate-muted hover:text-red-500 font-bold p-1" aria-label="Remove course">&times;</button>' +
      '</td>';

    tbody?.appendChild(tr);

    tr.querySelector('.gpa-del-btn')?.addEventListener('click', () => {
      if (tbody && tbody.children.length > 1) {
        tr.remove();
      }
    });
  }

  function calculateGPA() {
    if (!tbody) return;
    const rows = tbody.querySelectorAll('tr');
    let totalPoints = 0;
    let creditsSum = 0;

    rows.forEach(row => {
      const creditsInput = row.querySelector('.gpa-course-credits') as HTMLInputElement;
      const gradeSelect = row.querySelector('.gpa-course-grade') as HTMLSelectElement;
      const creds = parseFloat(creditsInput?.value || '0');
      const grade = gradeSelect?.value || 'A';
      const pts = gradePoints[grade] ?? 0;

      if (!isNaN(creds) && creds > 0) {
        creditsSum += creds;
        totalPoints += pts * creds;
      }
    });

    if (totalCreds) totalCreds.textContent = creditsSum.toString();

    if (creditsSum > 0 && resultVal && resultClass) {
      const gpa = totalPoints / creditsSum;
      resultVal.textContent = gpa.toFixed(2);
      if (gpa >= 3.8) resultClass.textContent = 'Summa Cum Laude / High Distinction';
      else if (gpa >= 3.5) resultClass.textContent = 'Magna Cum Laude / Distinction';
      else if (gpa >= 3.0) resultClass.textContent = "Dean's List / Good Standing";
      else if (gpa >= 2.0) resultClass.textContent = 'Satisfactory';
      else resultClass.textContent = 'Academic Warning / Probation';
    } else if (resultVal && resultClass) {
      resultVal.textContent = '--';
      resultClass.textContent = 'Enter course details above';
    }
  }

  function init() {
    if (!tbody) return;
    tbody.innerHTML = '';
    createRow('', 3, 'A'); createRow('', 3, 'A'); createRow('', 3, 'A');

  }

  addBtn?.addEventListener('click', () => createRow('', 3, 'A'));
  calcBtn?.addEventListener('click', calculateGPA);
  resetBtn?.addEventListener('click', init);

  init();
</script>