---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="space-y-3.5">
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Chemical Formula</label>
        <div class="flex flex-wrap gap-2">
          <input type="text" id="mm-formula" placeholder="e.g. H2SO4" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent font-mono" />
          <button id="mm-calc-btn" type="button" class="px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all shrink-0">
            Compute
          </button>
        </div>
        <p class="text-xs text-slate-muted mt-1">Examples: C6H12O6, Ca(OH)2, CuSO4*5H2O, Fe2(SO4)3</p>
      </div>

      <div class="p-4 sm:p-5 bg-page rounded-xl border border-border-line/80 flex flex-col sm:flex-row items-center justify-between gap-4 mt-4">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Molar Mass</div>
          <div id="mm-result" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { calculateMolarMass } from '../../utils/chemicalParser';

  function calculate() {
    const f = (document.getElementById('mm-formula') as HTMLInputElement)?.value || '';
    const resEl = document.getElementById('mm-result');
    try {
      const mw = calculateMolarMass(f);
      if (resEl) resEl.textContent = mw.toFixed(3) + ' g/mol';
    } catch {
      if (resEl) resEl.textContent = 'Invalid formula';
    }
  }


  document.getElementById('mm-calc-btn')?.addEventListener('click', calculate);
</script>