---
---

<div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden max-w-3xl mx-auto">
  <div class="p-6 sm:p-8">
    <div class="mb-6">
      <h2 class="text-xl font-bold text-gray-900 mb-2">Significant Figures Calculator</h2>
      <p class="text-sm text-gray-600">Analyze and count significant digits in measurements, round numbers to desired sig figs, and execute precision-compliant arithmetic operations.</p>
    </div>

    <!-- Mode Selector Tabs -->
    <div class="flex flex-wrap gap-2 mb-6 border-b border-gray-100 pb-4">
      <button type="button" id="tab-counter" class="sig-tab-btn px-4 py-2 text-sm font-medium rounded-lg bg-emerald-600 text-white transition-colors cursor-pointer" data-mode="counter">
        Sig Fig Counter & Rounder
      </button>
      <button type="button" id="tab-arithmetic" class="sig-tab-btn px-4 py-2 text-sm font-medium rounded-lg bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors cursor-pointer" data-mode="arithmetic">
        Sig Fig Arithmetic (+, −, ×, ÷)
      </button>
    </div>

    <form id="sig-form" class="space-y-6">
      <!-- MODE 1: COUNTER & ROUNDER -->
      <div id="mode-counter-inputs" class="space-y-4">
        <div>
          <label for="sig-input-num" class="block text-sm font-semibold text-gray-800 mb-1">
            Enter Measurement Number or Scientific Form
          </label>
          <input
            type="text"
            id="sig-input-num"
            value="0.00450"
            required
            class="block w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-lg font-mono text-gray-900"
            placeholder="e.g. 0.00450 or 1002 or 6.02e23"
          />
          <p class="text-xs text-gray-500 mt-1">Supports standard decimals, integers, and scientific notation (e.g. 1.23e4, 6.02 × 10^23)</p>
        </div>

        <div>
          <label for="sig-round-target" class="block text-xs font-semibold uppercase tracking-wider text-gray-600 mb-1">
            Round to Desired Significant Figures (Optional)
          </label>
          <input
            type="number"
            min="1"
            max="15"
            step="1"
            id="sig-round-target"
            value="2"
            class="block w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 font-mono text-base text-gray-900"
            placeholder="e.g. 2"
          />
        </div>
      </div>

      <!-- MODE 2: ARITHMETIC -->
      <div id="mode-arithmetic-inputs" class="hidden space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="arith-val-a" class="block text-sm font-semibold text-gray-800 mb-1">First Value (A)</label>
            <input
              type="text"
              id="arith-val-a"
              value="12.34"
              class="block w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 font-mono text-base text-gray-900"
              placeholder="e.g. 12.34"
            />
          </div>
          <div>
            <label for="arith-val-b" class="block text-sm font-semibold text-gray-800 mb-1">Second Value (B)</label>
            <input
              type="text"
              id="arith-val-b"
              value="5.6"
              class="block w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 font-mono text-base text-gray-900"
              placeholder="e.g. 5.6"
            />
          </div>
        </div>

        <div>
          <label for="arith-op" class="block text-xs font-semibold uppercase tracking-wider text-gray-600 mb-1">Operation</label>
          <select id="arith-op" class="block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-xl text-base text-gray-800 focus:ring-emerald-500 focus:border-emerald-500">
            <option value="multiply" selected>Multiplication (A × B) — Rule: Least Sig Figs</option>
            <option value="divide">Division (A ÷ B) — Rule: Least Sig Figs</option>
            <option value="add">Addition (A + B) — Rule: Least Decimal Places</option>
            <option value="subtract">Subtraction (A − B) — Rule: Least Decimal Places</option>
          </select>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row gap-3 pt-2">
        <button type="submit" class="flex-1 bg-emerald-600 text-white px-6 py-3 rounded-xl font-semibold hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors shadow-sm min-h-[44px]">
          Calculate Precision
        </button>
        <button type="button" id="reset-btn" class="px-6 py-3 border border-gray-300 rounded-xl text-gray-700 font-semibold hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors min-h-[44px]">
          Reset
        </button>
      </div>
    </form>

    <div id="error-box" class="hidden mt-6 bg-red-50 text-red-700 p-4 rounded-xl text-sm font-medium border border-red-200"></div>

    <!-- Results Section -->
    <div id="result-section" class="mt-8 pt-8 border-t border-gray-100" aria-live="polite">
      <!-- Main Highlight Result Card -->
      <div class="bg-gradient-to-br from-emerald-50 to-teal-50 border border-emerald-200/80 rounded-2xl p-6 sm:p-8 text-center relative mb-6">
        <div class="flex justify-end absolute top-4 right-4">
          <button
            type="button"
            id="copy-result-btn"
            class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg bg-white/90 hover:bg-white text-emerald-800 border border-emerald-200 shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-emerald-500 min-h-[36px]"
            title="Copy significant figures result"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
            <span>Copy Result</span>
          </button>
        </div>
        <p id="main-result-label" class="text-sm font-semibold uppercase tracking-wider text-emerald-800 mb-1">Significant Figures Count</p>
        <div id="main-result-val" class="text-4xl sm:text-6xl font-extrabold text-emerald-950 my-2 font-mono break-all">3</div>
        <div class="flex items-center justify-center gap-2 mt-3">
          <span id="main-result-badge" class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800">
            Scientific Notation: 4.50 × 10⁻³
          </span>
        </div>
      </div>

      <!-- Properties Grid -->
      <div id="sig-props-grid" class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-6">
        <div class="bg-gray-50 rounded-xl p-4 border border-gray-200/70 text-center">
          <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Decimal Places</p>
          <div id="prop-decimals" class="text-xl font-bold font-mono text-gray-900">5</div>
          <p class="text-xs text-gray-400 mt-0.5">Digits after decimal</p>
        </div>
        <div class="bg-gray-50 rounded-xl p-4 border border-gray-200/70 text-center">
          <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Rounded Value</p>
          <div id="prop-rounded" class="text-xl font-bold font-mono text-emerald-700">0.0045</div>
          <p id="prop-rounded-label" class="text-xs text-gray-400 mt-0.5">Rounded to 2 sig figs</p>
        </div>
        <div class="bg-gray-50 rounded-xl p-4 border border-gray-200/70 text-center">
          <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Exact Scientific</p>
          <div id="prop-scientific" class="text-xl font-bold font-mono text-gray-900">4.50 × 10⁻³</div>
          <p class="text-xs text-gray-400 mt-0.5">Canonical mantissa</p>
        </div>
      </div>

      <!-- Step-by-Step Explanation -->
      <div class="bg-gray-50 rounded-xl p-5 border border-gray-200">
        <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-2">Step-by-Step Rule Analysis</h3>
        <div id="steps-content" class="text-sm text-gray-700 font-mono space-y-1.5 bg-white p-4 rounded-lg border border-gray-200/80">
          <!-- Populated by JS -->
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { copyToClipboard, formatResultNumber } from '../../utils/formatters';

  const initSigFig = () => {
    let mode = 'counter'; // 'counter' or 'arithmetic'

    const form = document.getElementById('sig-form') as HTMLFormElement;
    const tabBtns = document.querySelectorAll('.sig-tab-btn');

    const counterInputs = document.getElementById('mode-counter-inputs');
    const arithmeticInputs = document.getElementById('mode-arithmetic-inputs');

    const inputNum = document.getElementById('sig-input-num') as HTMLInputElement;
    const inputRound = document.getElementById('sig-round-target') as HTMLInputElement;

    const arithA = document.getElementById('arith-val-a') as HTMLInputElement;
    const arithB = document.getElementById('arith-val-b') as HTMLInputElement;
    const arithOp = document.getElementById('arith-op') as HTMLSelectElement;

    const resetBtn = document.getElementById('reset-btn');
    const copyBtn = document.getElementById('copy-result-btn');
    const errorBox = document.getElementById('error-box');

    const mainLabel = document.getElementById('main-result-label');
    const mainVal = document.getElementById('main-result-val');
    const mainBadge = document.getElementById('main-result-badge');

    const propDecimals = document.getElementById('prop-decimals');
    const propRounded = document.getElementById('prop-rounded');
    const propRoundedLabel = document.getElementById('prop-rounded-label');
    const propScientific = document.getElementById('prop-scientific');
    const stepsContent = document.getElementById('steps-content');

    if (!form || !inputNum) return;

    // Tab switcher
    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetMode = btn.getAttribute('data-mode') || 'counter';
        mode = targetMode;
        tabBtns.forEach((b) => {
          b.className = 'sig-tab-btn px-4 py-2 text-sm font-medium rounded-lg bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors cursor-pointer';
        });
        btn.className = 'sig-tab-btn px-4 py-2 text-sm font-medium rounded-lg bg-emerald-600 text-white transition-colors cursor-pointer';

        if (mode === 'counter') {
          counterInputs?.classList.remove('hidden');
          arithmeticInputs?.classList.add('hidden');
        } else {
          counterInputs?.classList.add('hidden');
          arithmeticInputs?.classList.remove('hidden');
        }
        calculate();
      });
    });

    const superscriptDigits = ['⁰', '¹', '²', '³', '⁴', '⁵', '⁶', '⁷', '⁸', '⁹'];
    const formatExponent = (exp: number): string => {
      const isNeg = exp < 0;
      const digits = Math.abs(exp).toString().split('').map(d => superscriptDigits[parseInt(d, 10)] || d).join('');
      return isNeg ? '⁻' + digits : digits;
    };

    // Sig fig analyzer for a single string
    const analyzeSigFigs = (rawStr: string) => {
      let clean = rawStr.trim();
      let exp = 0;

      // Handle scientific notation: e.g. 6.02e23, 6.02 x 10^23
      const sciMatch = clean.match(/^([+-]?d*.?d+)s*(?:[eE]|xs*10^?|×s*10^?|*s*10^?)s*([+-]?d+)$/i);
      if (sciMatch) {
        clean = sciMatch[1];
        exp = parseInt(sciMatch[2], 10);
      }

      // Remove leading sign
      clean = clean.replace(/^[+-]/, '');

      if (!/^d*.?d+$/.test(clean)) {
        return null;
      }

      const hasDecimal = clean.includes('.');
      let decimalPlaces = 0;
      if (hasDecimal) {
        decimalPlaces = clean.split('.')[1].length;
      }

      // Breakdown digits
      let leadingZeros = 0;
      let captiveZeros = 0;
      let trailingZeros = 0;
      let nonZeroDigits = 0;
      let sigFigs = 0;
      let sigDigits = '';

      if (hasDecimal) {
        const withoutDot = clean.replace('.', '');
        // Find first non-zero
        const firstNonZero = withoutDot.search(/[1-9]/);
        if (firstNonZero === -1) {
          // e.g. "0.00" -> all trailing after dot are significant by convention, but value is 0
          sigFigs = clean.split('.')[1].length;
          sigDigits = clean.split('.')[1];
        } else {
          const sigPart = withoutDot.substring(firstNonZero);
          sigFigs = sigPart.length;
          sigDigits = sigPart;
          leadingZeros = firstNonZero;
          for (let i = 0; i < sigPart.length; i++) {
            if (sigPart[i] === '0') {
              if (i === sigPart.length - 1 || sigPart.substring(i).replace(/0/g, '') === '') {
                trailingZeros++;
              } else {
                captiveZeros++;
              }
            } else {
              nonZeroDigits++;
            }
          }
        }
      } else {
        // Integer without decimal point
        const firstNonZero = clean.search(/[1-9]/);
        if (firstNonZero === -1) {
          sigFigs = 1; // 0 has 1 sig fig
          sigDigits = '0';
        } else {
          // Trailing zeros in integers without decimal are ambiguous/non-significant by standard rules
          const strippedTrailing = clean.replace(/0+$/, '');
          const sigPart = clean.substring(firstNonZero, strippedTrailing.length);
          sigFigs = sigPart.length;
          sigDigits = sigPart;
          trailingZeros = clean.length - strippedTrailing.length;
          for (const char of sigPart) {
            if (char === '0') captiveZeros++;
            else nonZeroDigits++;
          }
        }
      }

      // Construct canonical scientific form
      const numVal = parseFloat(rawStr.replace(/xs*10^?/i, 'e').replace(/×s*10^?/i, 'e'));
      let sciStr = '';
      if (!isNaN(numVal) && numVal !== 0) {
        const sciExp = Math.floor(Math.log10(Math.abs(numVal)));
        const mantissa = numVal / Math.pow(10, sciExp);
        // Format mantissa to have exact sigFigs
        const mantissaStr = mantissa.toFixed(Math.max(0, sigFigs - 1));
        sciStr = `${mantissaStr} × 10${formatExponent(sciExp)}`;
      } else {
        sciStr = '0';
      }

      return {
        raw: rawStr,
        clean,
        hasDecimal,
        decimalPlaces,
        sigFigs,
        sigDigits,
        leadingZeros,
        captiveZeros,
        trailingZeros,
        nonZeroDigits,
        scientific: sciStr,
        numValue: numVal
      };
    };

    // Round number to N significant figures
    const roundToSigFigs = (num: number, targetSigFigs: number): string => {
      if (isNaN(num) || num === 0) return '0';
      const d = Math.ceil(Math.log10(Math.abs(num)));
      const power = targetSigFigs - d;
      const magnitude = Math.pow(10, power);
      const shifted = Math.round(num * magnitude);
      const rounded = shifted / magnitude;

      if (power >= 0 && power <= 6) {
        return rounded.toFixed(power);
      }
      return rounded.toPrecision(targetSigFigs);
    };

    const calculate = () => {
      errorBox?.classList.add('hidden');

      if (mode === 'counter') {
        const raw = inputNum.value.trim();
        const analysis = analyzeSigFigs(raw);

        if (!analysis) {
          if (errorBox) {
            errorBox.textContent = 'Please enter a valid numeric value (e.g. 0.00450, 1002, 1.23e4).';
            errorBox.classList.remove('hidden');
          }
          return;
        }

        const targetN = parseInt(inputRound.value, 10);
        let roundedStr = 'N/A';
        if (!isNaN(targetN) && targetN > 0 && !isNaN(analysis.numValue)) {
          roundedStr = roundToSigFigs(analysis.numValue, targetN);
        }

        if (mainLabel) mainLabel.textContent = 'Significant Figures Count';
        if (mainVal) mainVal.textContent = analysis.sigFigs.toString();
        if (mainBadge) mainBadge.textContent = `Scientific Form: ${analysis.scientific}`;

        if (propDecimals) propDecimals.textContent = analysis.decimalPlaces.toString();
        if (propRounded) propRounded.textContent = roundedStr;
        if (propRoundedLabel) propRoundedLabel.textContent = `Rounded to ${targetN || 2} sig figs`;
        if (propScientific) propScientific.textContent = analysis.scientific;

        if (stepsContent) {
          stepsContent.innerHTML = `
            <p class="font-semibold text-gray-900">Significance Rules Applied for "${raw}":</p>
            <p>1. Non-Zero Digits: All non-zero digits are significant (${analysis.nonZeroDigits} found).</p>
            ${analysis.leadingZeros > 0 ? `<p>2. Leading Zeros: Zeros to the left of the first non-zero digit are place-holders and NOT significant (${analysis.leadingZeros} leading zeros ignored).</p>` : ''}
            ${analysis.captiveZeros > 0 ? `<p>3. Captive Zeros: Zeros between non-zero digits are ALWAYS significant (${analysis.captiveZeros} captive zeros counted).</p>` : ''}
            ${analysis.hasDecimal && analysis.trailingZeros > 0 ? `<p>4. Trailing Zeros: Trailing zeros after a decimal point indicate precision and ARE significant (${analysis.trailingZeros} trailing zeros counted).</p>` : ''}
            ${!analysis.hasDecimal && analysis.trailingZeros > 0 ? `<p>4. Trailing Zeros in Integer: Trailing zeros without a decimal point are considered place-holders and NOT significant (${analysis.trailingZeros} trailing zeros ignored).</p>` : ''}
            <p class="font-semibold text-emerald-800 mt-2">Total Significant Figures = ${analysis.sigFigs} (Significant digits: ${analysis.sigDigits})</p>
            ${!isNaN(targetN) && targetN > 0 ? `<p class="mt-2 text-gray-800">Rounding to ${targetN} Sig Figs: ${raw} → ${roundedStr}</p>` : ''}
          `;
        }
      } else {
        // ARITHMETIC MODE
        const strA = arithA.value.trim();
        const strB = arithB.value.trim();
        const op = arithOp.value;

        const aAnalysis = analyzeSigFigs(strA);
        const bAnalysis = analyzeSigFigs(strB);

        if (!aAnalysis || !bAnalysis) {
          if (errorBox) {
            errorBox.textContent = 'Please enter valid numbers for both Value A and Value B.';
            errorBox.classList.remove('hidden');
          }
          return;
        }

        const valA = aAnalysis.numValue;
        const valB = bAnalysis.numValue;
        let rawResult = 0;
        let finalRounded = '';
        let ruleExplanation = '';

        if (op === 'multiply') {
          rawResult = valA * valB;
          const limitingSigFigs = Math.min(aAnalysis.sigFigs, bAnalysis.sigFigs);
          finalRounded = roundToSigFigs(rawResult, limitingSigFigs);
          ruleExplanation = `Multiplication Rule: Round to the least number of significant figures (min(${aAnalysis.sigFigs}, ${bAnalysis.sigFigs}) = ${limitingSigFigs} sig figs).`;
        } else if (op === 'divide') {
          if (valB === 0) {
            if (errorBox) {
              errorBox.textContent = 'Division by zero is undefined.';
              errorBox.classList.remove('hidden');
            }
            return;
          }
          rawResult = valA / valB;
          const limitingSigFigs = Math.min(aAnalysis.sigFigs, bAnalysis.sigFigs);
          finalRounded = roundToSigFigs(rawResult, limitingSigFigs);
          ruleExplanation = `Division Rule: Round to the least number of significant figures (min(${aAnalysis.sigFigs}, ${bAnalysis.sigFigs}) = ${limitingSigFigs} sig figs).`;
        } else if (op === 'add') {
          rawResult = valA + valB;
          const limitingDecimals = Math.min(aAnalysis.decimalPlaces, bAnalysis.decimalPlaces);
          finalRounded = rawResult.toFixed(limitingDecimals);
          ruleExplanation = `Addition Rule: Round to the least number of decimal places (min(${aAnalysis.decimalPlaces}, ${bAnalysis.decimalPlaces}) = ${limitingDecimals} decimal places).`;
        } else if (op === 'subtract') {
          rawResult = valA - valB;
          const limitingDecimals = Math.min(aAnalysis.decimalPlaces, bAnalysis.decimalPlaces);
          finalRounded = rawResult.toFixed(limitingDecimals);
          ruleExplanation = `Subtraction Rule: Round to the least number of decimal places (min(${aAnalysis.decimalPlaces}, ${bAnalysis.decimalPlaces}) = ${limitingDecimals} decimal places).`;
        }

        if (mainLabel) mainLabel.textContent = 'Precision-Rounded Result';
        if (mainVal) mainVal.textContent = finalRounded;
        if (mainBadge) mainBadge.textContent = `Raw Calculation: ${formatResultNumber(rawResult)}`;

        if (propDecimals) propDecimals.textContent = Math.min(aAnalysis.decimalPlaces, bAnalysis.decimalPlaces).toString();
        if (propRounded) propRounded.textContent = finalRounded;
        if (propRoundedLabel) propRoundedLabel.textContent = 'Compliant Final Value';
        if (propScientific) propScientific.textContent = formatResultNumber(rawResult);

        if (stepsContent) {
          stepsContent.innerHTML = `
            <p class="font-semibold text-gray-900">Arithmetic Precision Breakdown:</p>
            <p>• Value A (${strA}): ${aAnalysis.sigFigs} sig figs, ${aAnalysis.decimalPlaces} decimal places</p>
            <p>• Value B (${strB}): ${bAnalysis.sigFigs} sig figs, ${bAnalysis.decimalPlaces} decimal places</p>
            <p>• Raw Mathematical Output = ${formatResultNumber(rawResult)}</p>
            <p class="text-emerald-800 font-semibold mt-2">• ${ruleExplanation}</p>
            <p class="font-bold text-gray-900 mt-1">Final Significant Figures Answer = ${finalRounded}</p>
          `;
        }
      }
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      calculate();
    });

    // Copy Result
    copyBtn?.addEventListener('click', async () => {
      const resVal = mainVal?.textContent?.trim() || '';
      const textToCopy = `Significant Figures Result: ${resVal}`;
      const success = await copyToClipboard(textToCopy);
      if (success) {
        const span = copyBtn.querySelector('span');
        const orig = span ? span.textContent : 'Copy Result';
        if (span) span.textContent = 'Copied!';
        copyBtn.classList.add('bg-emerald-100', 'text-emerald-900');
        setTimeout(() => {
          if (span) span.textContent = orig;
          copyBtn.classList.remove('bg-emerald-100', 'text-emerald-900');
        }, 2000);
      }
    });

    // Reset button
    resetBtn?.addEventListener('click', () => {
      inputNum.value = '0.00450';
      inputRound.value = '2';
      arithA.value = '12.34';
      arithB.value = '5.6';
      arithOp.value = 'multiply';
      calculate();
    });

    // Initial calculation on load
    calculate();
  };

  initSigFig();
  document.addEventListener('astro:page-load', initSigFig);
</script>
