---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Signed Decimal Integer</label>
          <input type="number" id="tc-dec" placeholder="e.g. -42" step="1" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm font-mono" />
        </div>

        <button id="tc-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Two's Complement
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">8-Bit Representation</div>
          <div id="tc-8bit" class="text-3xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 space-y-1 text-xs text-slate-600">
          <div class="flex justify-between">
            <span>16-Bit:</span>
            <strong id="tc-16bit" class="text-slate-800 font-mono">11111111 11010110</strong>
          </div>
          <div class="flex justify-between">
            <span>Hex:</span>
            <strong id="tc-hex" class="text-slate-800 font-mono">0xD6</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const dec = parseInt((document.getElementById('tc-dec') as HTMLInputElement)?.value || '0', 10);
    const u8 = (dec >>> 0) & 0xFF;
    const u16 = (dec >>> 0) & 0xFFFF;

    const b8 = u8.toString(2).padStart(8, '0');
    const b16 = u16.toString(2).padStart(16, '0');

    document.getElementById('tc-8bit')!.textContent = b8;
    document.getElementById('tc-16bit')!.textContent = b16.slice(0, 8) + ' ' + b16.slice(8);
    document.getElementById('tc-hex')!.textContent = '0x' + u8.toString(16).toUpperCase();
  }


  document.getElementById('tc-calc-btn')?.addEventListener('click', calculate);
</script>