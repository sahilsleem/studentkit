---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Signed Decimal Integer</label>
          <input type="number" id="tc-dec" placeholder="e.g. -42" step="1" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm font-mono" />
        </div>

        <button id="tc-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Two's Complement
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">8-Bit Representation</div>
          <div id="tc-8bit" class="text-3xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 space-y-1 text-xs text-slate-muted">
          <div class="flex flex-wrap justify-between gap-2">
            <span>16-Bit:</span>
            <strong id="tc-16bit" class="text-ink font-mono break-words">11111111 11010110</strong>
          </div>
          <div class="flex flex-wrap justify-between gap-2">
            <span>Hex:</span>
            <strong id="tc-hex" class="text-ink font-mono break-words">0xD6</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const dec = parseInt((document.getElementById('tc-dec') as HTMLInputElement)?.value || '0', 10);
    const u8 = (dec >>> 0) & 0xFF;
    const u16 = (dec >>> 0) & 0xFFFF;

    const b8 = u8.toString(2).padStart(8, '0');
    const b16 = u16.toString(2).padStart(16, '0');

    document.getElementById('tc-8bit')!.textContent = b8;
    document.getElementById('tc-16bit')!.textContent = b16.slice(0, 8) + ' ' + b16.slice(8);
    document.getElementById('tc-hex')!.textContent = '0x' + u8.toString(16).toUpperCase();
  }


  document.getElementById('tc-calc-btn')?.addEventListener('click', calculate);
</script>