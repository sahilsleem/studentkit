---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Fluid Density (ρ in kg/m³)</label>
          <input type="number" id="pb-rho" placeholder="e.g. 1000" min="1" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Depth / Submerged Height (h in m)</label>
          <input type="number" id="pb-h" placeholder="e.g. 10" min="0" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Displaced Volume (V in m³)</label>
          <input type="number" id="pb-v" placeholder="e.g. 0.05" min="0" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>

        <button id="pb-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Pressure & Buoyant Force
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Hydrostatic Pressure (P = ρgh)</div>
          <div id="pb-press" class="text-3xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 text-xs text-slate-muted">
          <span>Buoyant Force (F_b = ρ V g): </span>
          <strong id="pb-buoy" class="text-ink font-mono break-words">490.33 N</strong>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const rho = parseFloat((document.getElementById('pb-rho') as HTMLInputElement)?.value || '1000');
    const h = parseFloat((document.getElementById('pb-h') as HTMLInputElement)?.value || '0');
    const v = parseFloat((document.getElementById('pb-v') as HTMLInputElement)?.value || '0');
    const g = 9.80665;

    const p = (rho * g * h) / 1000;
    const fb = rho * v * g;

    document.getElementById('pb-press')!.textContent = p.toFixed(2) + ' kPa';
    document.getElementById('pb-buoy')!.textContent = fb.toFixed(2) + ' N';
  }


  document.getElementById('pb-calc-btn')?.addEventListener('click', calculate);
</script>