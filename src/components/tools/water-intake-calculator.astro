---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Body Weight (kg)</label>
          <input type="number" id="wi-weight" placeholder="e.g. 68" min="20" step="1" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Daily Exercise (minutes)</label>
          <input type="number" id="wi-exercise" placeholder="e.g. 45" min="0" step="15" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>

        <button id="wi-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Daily Water Goal
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Recommended Daily Hydration</div>
          <div id="wi-liters" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div id="wi-cups" class="text-xs text-slate-muted mt-1">~11 standard 250ml glasses</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 text-xs text-slate-muted">
          <span>In Fluid Ounces: </span>
          <strong id="wi-floz" class="text-ink font-mono break-words">95 fl oz</strong>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const w = parseFloat((document.getElementById('wi-weight') as HTMLInputElement)?.value || '65');
    const ex = parseFloat((document.getElementById('wi-exercise') as HTMLInputElement)?.value || '0');

    // Base: 35ml per kg + 350ml per 30 min workout
    const totalMl = w * 35 + (ex / 30) * 350;
    const liters = totalMl / 1000;
    const cups = Math.round(totalMl / 250);
    const floz = Math.round(totalMl * 0.033814);

    document.getElementById('wi-liters')!.textContent = liters.toFixed(1) + ' Liters';
    document.getElementById('wi-cups')!.textContent = '~' + cups + ' standard 250ml glasses';
    document.getElementById('wi-floz')!.textContent = floz + ' fl oz';
  }


  document.getElementById('wi-calc-btn')?.addEventListener('click', calculate);
</script>