---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Base (b)</label>
          <input type="number" id="exp-base" step="any" placeholder="e.g. 2" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Exponent (x)</label>
          <input type="number" id="exp-power" step="any" placeholder="e.g. 8" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <button id="exp-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Power
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Result (bˣ)</div>
          <div id="exp-result" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 space-y-2 text-xs text-slate-600">
          <div class="flex justify-between">
            <span>Inverse (b⁻ˣ):</span>
            <strong id="exp-inv" class="text-slate-800 font-mono">0.003906</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const b = parseFloat((document.getElementById('exp-base') as HTMLInputElement)?.value || '0');
    const x = parseFloat((document.getElementById('exp-power') as HTMLInputElement)?.value || '0');

    const res = Math.pow(b, x);
    const inv = Math.pow(b, -x);

    const resEl = document.getElementById('exp-result');
    const invEl = document.getElementById('exp-inv');

    if (resEl) resEl.textContent = res > 1e12 || res < 1e-6 ? res.toExponential(6) : res.toString();
    if (invEl) invEl.textContent = inv > 1e12 || inv < 1e-6 ? inv.toExponential(6) : inv.toFixed(6);
  }


  document.getElementById('exp-calc-btn')?.addEventListener('click', calculate);
</script>