---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Base (b)</label>
          <input type="number" id="exp-base" step="any" placeholder="e.g. 2" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Exponent (x)</label>
          <input type="number" id="exp-power" step="any" placeholder="e.g. 8" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <button id="exp-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Power
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Result (bˣ)</div>
          <div id="exp-result" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 space-y-1.5 text-xs text-slate-muted">
          <div class="flex flex-wrap justify-between gap-2">
            <span>Inverse (b⁻ˣ):</span>
            <strong id="exp-inv" class="text-ink font-mono break-words">0.003906</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const b = parseFloat((document.getElementById('exp-base') as HTMLInputElement)?.value || '0');
    const x = parseFloat((document.getElementById('exp-power') as HTMLInputElement)?.value || '0');

    const res = Math.pow(b, x);
    const inv = Math.pow(b, -x);

    const resEl = document.getElementById('exp-result');
    const invEl = document.getElementById('exp-inv');

    if (resEl) resEl.textContent = res > 1e12 || res < 1e-6 ? res.toExponential(6) : res.toString();
    if (invEl) invEl.textContent = inv > 1e12 || inv < 1e-6 ? inv.toExponential(6) : inv.toFixed(6);
  }


  document.getElementById('exp-calc-btn')?.addEventListener('click', calculate);
</script>