---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Mass (m in kg)</label>
          <input type="number" id="fc-mass" placeholder="e.g. 12" min="0" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Acceleration (a in m/s²)</label>
          <input type="number" id="fc-acc" placeholder="e.g. 3.5" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>

        <button id="fc-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Net Force
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Net Force (F = m · a)</div>
          <div id="fc-force" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div class="text-xs text-slate-muted mt-1">Newtons (kg·m/s²)</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 space-y-1.5 text-xs text-slate-muted">
          <div class="flex flex-wrap justify-between gap-2">
            <span>Force in Pounds-Force (lbf):</span>
            <strong id="fc-lbf" class="text-ink font-mono break-words">9.44 lbf</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const m = parseFloat((document.getElementById('fc-mass') as HTMLInputElement)?.value || '0');
    const a = parseFloat((document.getElementById('fc-acc') as HTMLInputElement)?.value || '0');

    const f = m * a;
    const lbf = f * 0.224809;

    document.getElementById('fc-force')!.textContent = f.toFixed(2) + ' N';
    document.getElementById('fc-lbf')!.textContent = lbf.toFixed(2) + ' lbf';
  }


  document.getElementById('fc-calc-btn')?.addEventListener('click', calculate);
</script>