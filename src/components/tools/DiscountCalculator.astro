---
---

<div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden max-w-3xl mx-auto">
  <div class="p-6 sm:p-8">
    <div class="mb-6">
      <h2 class="text-xl font-bold text-gray-900 mb-2">Discount & Sale Price Calculator</h2>
      <p class="text-sm text-gray-600">Calculate discounted sale prices, total money saved, multi-tier stackable discounts, and final checkout prices including sales tax.</p>
    </div>

    <!-- Quick Preset Buttons -->
    <div class="mb-6 bg-emerald-50/60 border border-emerald-100 rounded-xl p-4">
      <label class="block text-xs font-semibold uppercase tracking-wider text-emerald-800 mb-2">Quick Discount Presets</label>
      <div class="flex flex-wrap gap-2">
        <button type="button" data-pct="10" class="disc-preset-btn text-xs font-medium py-1.5 px-3 rounded-lg bg-white border border-emerald-200 text-emerald-900 hover:bg-emerald-100 transition-colors">
          10% Off
        </button>
        <button type="button" data-pct="15" class="disc-preset-btn text-xs font-medium py-1.5 px-3 rounded-lg bg-white border border-emerald-200 text-emerald-900 hover:bg-emerald-100 transition-colors">
          15% Off
        </button>
        <button type="button" data-pct="20" class="disc-preset-btn text-xs font-medium py-1.5 px-3 rounded-lg bg-white border border-emerald-200 text-emerald-900 hover:bg-emerald-100 transition-colors">
          20% Off
        </button>
        <button type="button" data-pct="25" class="disc-preset-btn text-xs font-medium py-1.5 px-3 rounded-lg bg-white border border-emerald-200 text-emerald-900 hover:bg-emerald-100 transition-colors">
          25% Off
        </button>
        <button type="button" data-pct="30" class="disc-preset-btn text-xs font-medium py-1.5 px-3 rounded-lg bg-white border border-emerald-200 text-emerald-900 hover:bg-emerald-100 transition-colors">
          30% Off
        </button>
        <button type="button" data-pct="50" class="disc-preset-btn text-xs font-medium py-1.5 px-3 rounded-lg bg-white border border-emerald-200 text-emerald-900 hover:bg-emerald-100 transition-colors">
          50% Off (Half Price)
        </button>
      </div>
    </div>

    <form id="discount-form" class="space-y-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Original Price -->
        <div>
          <label for="orig-price" class="block text-sm font-semibold text-gray-800 mb-1">
            Original / Marked Price
          </label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-gray-500 font-medium">$</span>
            <input
              type="number"
              step="any"
              min="0"
              id="orig-price"
              value="100"
              required
              class="block w-full pl-8 pr-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-lg font-mono text-gray-900"
              placeholder="100.00"
            />
          </div>
        </div>

        <!-- Primary Discount Mode -->
        <div>
          <label for="disc-val" class="block text-sm font-semibold text-gray-800 mb-1">
            Discount (% Off or Amount Off)
          </label>
          <div class="flex gap-2">
            <div class="relative flex-1">
              <input
                type="number"
                step="any"
                min="0"
                id="disc-val"
                value="20"
                required
                class="block w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-lg font-mono text-gray-900"
                placeholder="20"
              />
            </div>
            <select
              id="disc-type"
              class="px-3 py-3 bg-white border border-gray-300 rounded-xl text-sm font-semibold text-gray-800 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500"
              aria-label="Discount unit type"
            >
              <option value="percent" selected>% Off</option>
              <option value="amount">$ Off</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Advanced / Optional Fields -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 border-t border-gray-100">
        <!-- Additional Stackable Discount -->
        <div>
          <label for="extra-disc" class="block text-xs font-semibold uppercase tracking-wider text-gray-600 mb-1">
            Additional Discount (% Off, Optional)
          </label>
          <div class="relative">
            <input
              type="number"
              step="any"
              min="0"
              max="100"
              id="extra-disc"
              value="0"
              class="block w-full pr-8 pl-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-base font-mono text-gray-900"
              placeholder="0"
            />
            <span class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-gray-500 font-medium text-sm">%</span>
          </div>
          <p class="text-xs text-gray-400 mt-1">e.g. 10% student coupon applied on subtotal</p>
        </div>

        <!-- Sales Tax Rate -->
        <div>
          <label for="tax-rate" class="block text-xs font-semibold uppercase tracking-wider text-gray-600 mb-1">
            Sales Tax Rate (% Rate, Optional)
          </label>
          <div class="relative">
            <input
              type="number"
              step="any"
              min="0"
              id="tax-rate"
              value="0"
              class="block w-full pr-8 pl-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-base font-mono text-gray-900"
              placeholder="0"
            />
            <span class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-gray-500 font-medium text-sm">%</span>
          </div>
          <p class="text-xs text-gray-400 mt-1">e.g. 5%, 8.25%, 18% GST</p>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row gap-3 pt-2">
        <button type="submit" class="flex-1 bg-emerald-600 text-white px-6 py-3 rounded-xl font-semibold hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors shadow-sm min-h-[44px]">
          Calculate Savings
        </button>
        <button type="button" id="reset-btn" class="px-6 py-3 border border-gray-300 rounded-xl text-gray-700 font-semibold hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors min-h-[44px]">
          Reset
        </button>
      </div>
    </form>

    <div id="error-box" class="hidden mt-6 bg-red-50 text-red-700 p-4 rounded-xl text-sm font-medium border border-red-200"></div>

    <!-- Results Section -->
    <div id="result-section" class="mt-8 pt-8 border-t border-gray-100" aria-live="polite">
      <!-- Main Highlight Result Card -->
      <div class="bg-gradient-to-br from-emerald-50 to-teal-50 border border-emerald-200/80 rounded-2xl p-6 sm:p-8 text-center relative mb-6">
        <div class="flex justify-end absolute top-4 right-4">
          <button
            type="button"
            id="copy-result-btn"
            class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg bg-white/90 hover:bg-white text-emerald-800 border border-emerald-200 shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-emerald-500 min-h-[36px]"
            title="Copy final price and savings"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
            <span>Copy Result</span>
          </button>
        </div>
        <p class="text-sm font-semibold uppercase tracking-wider text-emerald-800 mb-1">Final Price to Pay</p>
        <div id="final-price-display" class="text-4xl sm:text-6xl font-extrabold text-emerald-950 my-2 font-mono break-all">$80.00</div>
        <div class="flex items-center justify-center gap-2 mt-3">
          <span id="savings-badge" class="inline-flex items-center px-3 py-1 rounded-full text-sm font-bold bg-emerald-100 text-emerald-800">
            You Save $20.00 (20% Total Off)
          </span>
        </div>
      </div>

      <!-- Financial Breakdown Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
        <div class="bg-gray-50 rounded-xl p-4 border border-gray-200/70 text-center">
          <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Original Price</p>
          <div id="breakdown-orig" class="text-lg font-bold font-mono text-gray-900">$100.00</div>
        </div>
        <div class="bg-gray-50 rounded-xl p-4 border border-gray-200/70 text-center">
          <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Discount Amount</p>
          <div id="breakdown-discount" class="text-lg font-bold font-mono text-emerald-700">−$20.00</div>
        </div>
        <div class="bg-gray-50 rounded-xl p-4 border border-gray-200/70 text-center">
          <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Price Before Tax</p>
          <div id="breakdown-subtotal" class="text-lg font-bold font-mono text-gray-900">$80.00</div>
        </div>
        <div class="bg-gray-50 rounded-xl p-4 border border-gray-200/70 text-center">
          <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Sales Tax</p>
          <div id="breakdown-tax" class="text-lg font-bold font-mono text-gray-900">$0.00</div>
        </div>
      </div>

      <!-- Step-by-Step Derivation -->
      <div class="bg-gray-50 rounded-xl p-5 border border-gray-200">
        <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-2">Calculation Breakdown</h3>
        <div id="steps-content" class="text-sm text-gray-700 font-mono space-y-1.5 bg-white p-4 rounded-lg border border-gray-200/80">
          <!-- Populated by JS -->
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { copyToClipboard } from '../../utils/formatters';

  const initDiscount = () => {
    const form = document.getElementById('discount-form') as HTMLFormElement;
    const inputOrig = document.getElementById('orig-price') as HTMLInputElement;
    const inputDisc = document.getElementById('disc-val') as HTMLInputElement;
    const selectType = document.getElementById('disc-type') as HTMLSelectElement;
    const inputExtra = document.getElementById('extra-disc') as HTMLInputElement;
    const inputTax = document.getElementById('tax-rate') as HTMLInputElement;
    const resetBtn = document.getElementById('reset-btn');
    const copyBtn = document.getElementById('copy-result-btn');
    const errorBox = document.getElementById('error-box');

    const finalDisplay = document.getElementById('final-price-display');
    const savingsBadge = document.getElementById('savings-badge');
    const bdOrig = document.getElementById('breakdown-orig');
    const bdDisc = document.getElementById('breakdown-discount');
    const bdSub = document.getElementById('breakdown-subtotal');
    const bdTax = document.getElementById('breakdown-tax');
    const stepsContent = document.getElementById('steps-content');

    if (!form || !inputOrig || !inputDisc || !selectType) return;

    const formatCurrency = (num: number): string => {
      return '$' + num.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    };

    const calculate = () => {
      errorBox?.classList.add('hidden');
      const orig = parseFloat(inputOrig.value);
      const discVal = parseFloat(inputDisc.value);
      const discType = selectType.value; // 'percent' or 'amount'
      const extraPct = parseFloat(inputExtra.value) || 0;
      const taxRate = parseFloat(inputTax.value) || 0;

      if (isNaN(orig) || isNaN(discVal) || orig < 0 || discVal < 0) {
        if (errorBox) {
          errorBox.textContent = 'Please enter valid non-negative values for price and discount.';
          errorBox.classList.remove('hidden');
        }
        return;
      }

      // Step 1: Primary discount
      let primaryDiscountAmount = 0;
      let primaryDiscountPct = 0;

      if (discType === 'percent') {
        primaryDiscountPct = discVal;
        primaryDiscountAmount = orig * (discVal / 100);
      } else {
        primaryDiscountAmount = Math.min(discVal, orig);
        primaryDiscountPct = orig > 0 ? (primaryDiscountAmount / orig) * 100 : 0;
      }

      let priceAfterPrimary = Math.max(0, orig - primaryDiscountAmount);

      // Step 2: Extra stackable discount
      let extraDiscountAmount = 0;
      if (extraPct > 0) {
        extraDiscountAmount = priceAfterPrimary * (extraPct / 100);
      }
      let subtotal = Math.max(0, priceAfterPrimary - extraDiscountAmount);

      const totalSavings = primaryDiscountAmount + extraDiscountAmount;
      const totalEffectivePct = orig > 0 ? (totalSavings / orig) * 100 : 0;

      // Step 3: Sales tax
      let taxAmount = 0;
      if (taxRate > 0) {
        taxAmount = subtotal * (taxRate / 100);
      }

      const finalPrice = subtotal + taxAmount;

      // Update UI
      if (finalDisplay) finalDisplay.textContent = formatCurrency(finalPrice);
      if (savingsBadge) {
        savingsBadge.textContent = `You Save ${formatCurrency(totalSavings)} (${totalEffectivePct.toFixed(1)}% Total Off)`;
      }

      if (bdOrig) bdOrig.textContent = formatCurrency(orig);
      if (bdDisc) bdDisc.textContent = '−' + formatCurrency(totalSavings);
      if (bdSub) bdSub.textContent = formatCurrency(subtotal);
      if (bdTax) bdTax.textContent = formatCurrency(taxAmount);

      if (stepsContent) {
        let stepsHtml = `
          <p>1. Original Price = ${formatCurrency(orig)}</p>
          <p>2. Primary Discount (${discType === 'percent' ? discVal + '%' : formatCurrency(discVal)}): Savings = ${formatCurrency(primaryDiscountAmount)} → Price = ${formatCurrency(priceAfterPrimary)}</p>
        `;

        if (extraPct > 0) {
          stepsHtml += `
            <p>3. Additional ${extraPct}% Coupon: Savings = ${formatCurrency(extraDiscountAmount)} → Subtotal = ${formatCurrency(subtotal)}</p>
          `;
        }

        if (taxRate > 0) {
          stepsHtml += `
            <p>${extraPct > 0 ? '4' : '3'}. Sales Tax (${taxRate}% on ${formatCurrency(subtotal)}): Tax = ${formatCurrency(taxAmount)}</p>
            <p>${extraPct > 0 ? '5' : '4'}. Final Total = ${formatCurrency(subtotal)} + ${formatCurrency(taxAmount)} = ${formatCurrency(finalPrice)}</p>
          `;
        } else {
          stepsHtml += `
            <p>${extraPct > 0 ? '4' : '3'}. Final Price to Pay = ${formatCurrency(finalPrice)}</p>
          `;
        }

        stepsContent.innerHTML = stepsHtml;
      }
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      calculate();
    });

    // Preset buttons
    document.querySelectorAll('.disc-preset-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const pct = btn.getAttribute('data-pct') || '20';
        inputDisc.value = pct;
        selectType.value = 'percent';
        calculate();
      });
    });

    // Copy Result
    copyBtn?.addEventListener('click', async () => {
      const finalVal = finalDisplay?.textContent?.trim() || '';
      const savingsVal = savingsBadge?.textContent?.trim() || '';
      const origVal = bdOrig?.textContent?.trim() || '';
      const textToCopy = `Original: ${origVal} | Final Price: ${finalVal} | ${savingsVal}`;

      const success = await copyToClipboard(textToCopy);
      if (success) {
        const span = copyBtn.querySelector('span');
        const orig = span ? span.textContent : 'Copy Result';
        if (span) span.textContent = 'Copied!';
        copyBtn.classList.add('bg-emerald-100', 'text-emerald-900');
        setTimeout(() => {
          if (span) span.textContent = orig;
          copyBtn.classList.remove('bg-emerald-100', 'text-emerald-900');
        }, 2000);
      }
    });

    // Reset button
    resetBtn?.addEventListener('click', () => {
      inputOrig.value = '100';
      inputDisc.value = '20';
      selectType.value = 'percent';
      inputExtra.value = '0';
      inputTax.value = '0';
      calculate();
    });

    // Initial calculation on load
    calculate();
  };

  initDiscount();
  document.addEventListener('astro:page-load', initDiscount);
</script>
