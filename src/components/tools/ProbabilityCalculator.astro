---
---
<div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden max-w-2xl mx-auto">
  <div class="p-6 sm:p-8">
    <div class="space-y-6">
      <div class="bg-gray-50 p-4 rounded-xl border border-gray-200">
        <h3 class="font-bold text-gray-700 mb-3">Event A</h3>
        <div class="flex gap-4 items-center">
          <div class="flex-1">
            <label class="block text-xs text-gray-500 uppercase">Favorable Outcomes</label>
            <input type="number" min="0" step="any" id="favA" class="w-full mt-1 p-2 border border-gray-300 rounded focus:ring-emerald-500" value="1">
          </div>
          <div class="flex-1">
            <label class="block text-xs text-gray-500 uppercase">Total Outcomes</label>
            <input type="number" min="1" step="any" id="totA" class="w-full mt-1 p-2 border border-gray-300 rounded focus:ring-emerald-500" value="6">
          </div>
        </div>
      </div>

      <div class="bg-gray-50 p-4 rounded-xl border border-gray-200">
        <h3 class="font-bold text-gray-700 mb-3">Event B (Optional)</h3>
        <div class="flex gap-4 items-center">
          <div class="flex-1">
            <label class="block text-xs text-gray-500 uppercase">Favorable Outcomes</label>
            <input type="number" min="0" step="any" id="favB" class="w-full mt-1 p-2 border border-gray-300 rounded focus:ring-emerald-500">
          </div>
          <div class="flex-1">
            <label class="block text-xs text-gray-500 uppercase">Total Outcomes</label>
            <input type="number" min="1" step="any" id="totB" class="w-full mt-1 p-2 border border-gray-300 rounded focus:ring-emerald-500">
          </div>
        </div>
      </div>
    </div>

    <div class="mt-6">
      <button id="calc-prob-btn" class="w-full bg-emerald-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-emerald-700 transition-colors">Calculate Probability</button>
    </div>

    <div id="prob-result" class="mt-8 pt-6 border-t border-gray-100 hidden">
      <h3 class="text-lg font-semibold mb-4">Results</h3>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
          <p class="text-xs text-gray-500 uppercase mb-1">P(A) [Probability of A]</p>
          <p class="text-xl font-bold" id="res-pa">--</p>
        </div>
        <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
          <p class="text-xs text-gray-500 uppercase mb-1">P(A') [Not A]</p>
          <p class="text-xl font-bold" id="res-nota">--</p>
        </div>
        <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
          <p class="text-xs text-gray-500 uppercase mb-1">P(B) [Probability of B]</p>
          <p class="text-xl font-bold" id="res-pb">--</p>
        </div>
        <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
          <p class="text-xs text-gray-500 uppercase mb-1">P(A and B) [Independent]</p>
          <p class="text-xl font-bold" id="res-aandb">--</p>
        </div>
        <div class="bg-gray-50 p-4 rounded-lg border border-gray-200 sm:col-span-2 text-center">
          <p class="text-xs text-gray-500 uppercase mb-1">P(A or B) [Mutually Exclusive]</p>
          <p class="text-xl font-bold" id="res-aorb">--</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const initProb = () => {
    const btn = document.getElementById('calc-prob-btn');
    const resSec = document.getElementById('prob-result');

    if (!btn) return;

    btn.addEventListener('click', () => {
      const fA = parseFloat((document.getElementById('favA') as HTMLInputElement).value) || 0;
      const tA = parseFloat((document.getElementById('totA') as HTMLInputElement).value) || 1;
      
      const fB = parseFloat((document.getElementById('favB') as HTMLInputElement).value) || 0;
      const tBRaw = (document.getElementById('totB') as HTMLInputElement).value;
      const tB = tBRaw ? (parseFloat(tBRaw) || 1) : null;

      const pA = fA / tA;
      const pB = tB ? (fB / tB) : 0;

      const fmt = (n) => `${Number.isInteger(n) ? n : parseFloat(n.toFixed(4))} (${(n*100).toFixed(2)}%)`;

      (document.getElementById('res-pa') as HTMLElement).textContent = fmt(pA);
      (document.getElementById('res-nota') as HTMLElement).textContent = fmt(1 - pA);
      
      if (tB) {
        (document.getElementById('res-pb') as HTMLElement).textContent = fmt(pB);
        (document.getElementById('res-aandb') as HTMLElement).textContent = fmt(pA * pB);
        (document.getElementById('res-aorb') as HTMLElement).textContent = fmt(pA + pB);
      } else {
        (document.getElementById('res-pb') as HTMLElement).textContent = 'N/A';
        (document.getElementById('res-aandb') as HTMLElement).textContent = 'N/A';
        (document.getElementById('res-aorb') as HTMLElement).textContent = 'N/A';
      }

      resSec.classList.remove('hidden');
    });
  };

  initProb();
  document.addEventListener('astro:page-load', initProb);
</script>
