---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Pre-Tax Amount (₹)</label>
          <input type="number" id="st-amount" step="0.01" min="0" placeholder="e.g. 85" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Sales Tax Rate (%)</label>
          <input type="number" id="st-rate" step="0.05" min="0" max="50" placeholder="e.g. 8.25" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Quantity</label>
          <input type="number" id="st-qty" step="1" min="1" placeholder="e.g. 1" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <button id="st-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Sales Tax
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Total Gross Price (Tax Included)</div>
          <div id="st-total" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div id="st-tax-val" class="text-xs text-slate-muted font-semibold mt-1">Tax amount appears here</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 space-y-1.5 text-xs text-slate-muted">
          <div class="flex flex-wrap justify-between gap-2">
            <span>Net Subtotal:</span>
            <strong id="st-subtotal" class="text-ink">--</strong>
          </div>
          <div class="flex flex-wrap justify-between gap-2">
            <span>Effective Rate:</span>
            <strong id="st-eff-rate" class="text-ink">8.25%</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const amtIn = document.getElementById('st-amount') as HTMLInputElement;
  const rateIn = document.getElementById('st-rate') as HTMLInputElement;
  const qtyIn = document.getElementById('st-qty') as HTMLInputElement;

  const totalEl = document.getElementById('st-total');
  const taxValEl = document.getElementById('st-tax-val');
  const subtotalEl = document.getElementById('st-subtotal');
  const effRateEl = document.getElementById('st-eff-rate');

  function calculate() {
    const amt = parseFloat(amtIn?.value || '0');
    const rate = parseFloat(rateIn?.value || '0') / 100;
    const qty = parseInt(qtyIn?.value || '1', 10);

    const subtotal = amt * qty;
    const tax = subtotal * rate;
    const total = subtotal + tax;

    const fmt = (v: number) => '₹' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    if (totalEl) totalEl.textContent = fmt(total);
    if (taxValEl) taxValEl.textContent = '+' + fmt(tax) + ' in Sales Tax';
    if (subtotalEl) subtotalEl.textContent = fmt(subtotal);
    if (effRateEl) effRateEl.textContent = (rate * 100).toFixed(2) + '%';
  }


  document.getElementById('st-calc-btn')?.addEventListener('click', calculate);
</script>