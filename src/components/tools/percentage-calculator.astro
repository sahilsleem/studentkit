---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">What is X% of Y?</label>
          <div class="flex flex-wrap items-center gap-2">
            <input type="number" id="pct-p" placeholder="e.g. 15" class="w-24 min-w-[4rem] flex-1 sm:flex-none min-w-[4rem] flex-1 sm:flex-none px-3 py-2 bg-page border border-border-line rounded-xl text-sm" />
            <span class="text-sm font-semibold text-slate-muted">% of</span>
            <input type="number" id="pct-y" placeholder="e.g. 250" class="w-32 min-w-[5rem] flex-1 sm:flex-none min-w-[5rem] flex-1 sm:flex-none px-3 py-2 bg-page border border-border-line rounded-xl text-sm" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">X is what percent of Y?</label>
          <div class="flex flex-wrap items-center gap-2">
            <input type="number" id="pct-x2" placeholder="e.g. 45" class="w-24 min-w-[4rem] flex-1 sm:flex-none min-w-[4rem] flex-1 sm:flex-none px-3 py-2 bg-page border border-border-line rounded-xl text-sm" />
            <span class="text-sm font-semibold text-slate-muted">out of</span>
            <input type="number" id="pct-y2" placeholder="e.g. 180" class="w-32 min-w-[5rem] flex-1 sm:flex-none min-w-[5rem] flex-1 sm:flex-none px-3 py-2 bg-page border border-border-line rounded-xl text-sm" />
          </div>
        </div>

        <button id="pct-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Percentages
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Result 1 (X% of Y)</div>
          <div id="pct-res1" class="text-3xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4">
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Result 2 (Percentage)</div>
          <div id="pct-res2" class="text-3xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const p = parseFloat((document.getElementById('pct-p') as HTMLInputElement)?.value || '0');
    const y = parseFloat((document.getElementById('pct-y') as HTMLInputElement)?.value || '0');
    const x2 = parseFloat((document.getElementById('pct-x2') as HTMLInputElement)?.value || '0');
    const y2 = parseFloat((document.getElementById('pct-y2') as HTMLInputElement)?.value || '1');

    const res1 = (p / 100) * y;
    const res2 = (x2 / y2) * 100;

    const res1El = document.getElementById('pct-res1');
    const res2El = document.getElementById('pct-res2');

    if (res1El) res1El.textContent = res1.toFixed(2);
    if (res2El) res2El.textContent = res2.toFixed(2) + '%';
  }


  document.getElementById('pct-calc-btn')?.addEventListener('click', calculate);
</script>