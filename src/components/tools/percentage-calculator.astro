<div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden mb-12">
      <div class="p-6 sm:p-8">
        <form id="calculator-form" class="space-y-6">
          <div id="subjects-container" class="space-y-4">
            <!-- Row 1 -->
            <div class="flex items-center gap-4">
              <input type="text" placeholder="Subject (Optional)" class="block w-1/3 px-3 py-2 border border-gray-300 rounded-md focus:ring-emerald-500 focus:border-emerald-500 sm:text-sm">
              <input type="number" min="0" step="0.5" required placeholder="Marks Obtained" class="obtained-input block w-1/3 px-3 py-2 border border-gray-300 rounded-md focus:ring-emerald-500 focus:border-emerald-500 sm:text-sm">
              <span class="text-gray-400">/</span>
              <input type="number" min="1" step="0.5" required placeholder="Total Marks" class="total-input block w-1/3 px-3 py-2 border border-gray-300 rounded-md focus:ring-emerald-500 focus:border-emerald-500 sm:text-sm" value="100">
            </div>
            <!-- Row 2 -->
            <div class="flex items-center gap-4">
              <input type="text" placeholder="Subject (Optional)" class="block w-1/3 px-3 py-2 border border-gray-300 rounded-md focus:ring-emerald-500 focus:border-emerald-500 sm:text-sm">
              <input type="number" min="0" step="0.5" placeholder="Marks Obtained" class="obtained-input block w-1/3 px-3 py-2 border border-gray-300 rounded-md focus:ring-emerald-500 focus:border-emerald-500 sm:text-sm">
              <span class="text-gray-400">/</span>
              <input type="number" min="1" step="0.5" placeholder="Total Marks" class="total-input block w-1/3 px-3 py-2 border border-gray-300 rounded-md focus:ring-emerald-500 focus:border-emerald-500 sm:text-sm" value="100">
            </div>
            <!-- Row 3 -->
            <div class="flex items-center gap-4">
              <input type="text" placeholder="Subject (Optional)" class="block w-1/3 px-3 py-2 border border-gray-300 rounded-md focus:ring-emerald-500 focus:border-emerald-500 sm:text-sm">
              <input type="number" min="0" step="0.5" placeholder="Marks Obtained" class="obtained-input block w-1/3 px-3 py-2 border border-gray-300 rounded-md focus:ring-emerald-500 focus:border-emerald-500 sm:text-sm">
              <span class="text-gray-400">/</span>
              <input type="number" min="1" step="0.5" placeholder="Total Marks" class="total-input block w-1/3 px-3 py-2 border border-gray-300 rounded-md focus:ring-emerald-500 focus:border-emerald-500 sm:text-sm" value="100">
            </div>
          </div>

          <div class="flex justify-between items-center border-t border-gray-100 pt-4">
            <button type="button" id="add-row-btn" class="text-emerald-600 hover:text-emerald-700 font-medium text-sm flex items-center gap-1 transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
              Add Subject
            </button>
          </div>

          <div class="flex flex-col sm:flex-row gap-4 pt-4">
            <button type="submit" class="flex-1 bg-emerald-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors">
              Calculate Percentage
            </button>
            <button type="button" id="reset-btn" class="px-6 py-3 border border-gray-300 rounded-lg text-gray-700 font-medium hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors">
              Clear All
            </button>
          </div>
        </form>

        <div id="result-section" class="mt-8 pt-8 border-t border-gray-100 hidden">
          <div class="text-center mb-8">
            <p class="text-sm text-gray-500 mb-1">Total Percentage</p>
            <div class="text-5xl font-bold text-emerald-600 mb-2" id="total-percentage">--%</div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="bg-gray-50 rounded-lg p-5 border border-gray-100 text-center">
              <p class="text-sm text-gray-600 mb-2">Total Obtained</p>
              <div class="text-2xl font-bold text-gray-900" id="total-obtained">--</div>
            </div>
            <div class="bg-gray-50 rounded-lg p-5 border border-gray-100 text-center">
              <p class="text-sm text-gray-600 mb-2">Total Possible</p>
              <div class="text-2xl font-bold text-gray-900" id="total-possible">--</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  <script>
  const initCalculator = () => {
    const form = document.getElementById('calculator-form') as HTMLFormElement;
    const container = document.getElementById('subjects-container');
    const addBtn = document.getElementById('add-row-btn');
    const resetBtn = document.getElementById('reset-btn');
    const resultSection = document.getElementById('result-section');
    const totalPercentageEl = document.getElementById('total-percentage');
    const totalObtainedEl = document.getElementById('total-obtained');
    const totalPossibleEl = document.getElementById('total-possible');

    if (!form || !container) return;

    addBtn?.addEventListener('click', () => {
      const row = document.createElement('div');
      row.className = 'flex items-center gap-4';
      row.innerHTML = `
        <input type="text" placeholder="Subject (Optional)" class="block w-1/3 px-3 py-2 border border-gray-300 rounded-md focus:ring-emerald-500 focus:border-emerald-500 sm:text-sm">
        <input type="number" min="0" step="0.5" placeholder="Marks Obtained" class="obtained-input block w-1/3 px-3 py-2 border border-gray-300 rounded-md focus:ring-emerald-500 focus:border-emerald-500 sm:text-sm">
        <span class="text-gray-400">/</span>
        <input type="number" min="1" step="0.5" placeholder="Total Marks" class="total-input block w-1/3 px-3 py-2 border border-gray-300 rounded-md focus:ring-emerald-500 focus:border-emerald-500 sm:text-sm" value="100">
      `;
      container.appendChild(row);
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      let obtainedSum = 0;
      let possibleSum = 0;
      let hasValidInput = false;

      const obtainedInputs = document.querySelectorAll('.obtained-input') as NodeListOf<HTMLInputElement>;
      const totalInputs = document.querySelectorAll('.total-input') as NodeListOf<HTMLInputElement>;

      obtainedInputs.forEach((input, index) => {
        const obtained = parseFloat(input.value);
        const total = parseFloat(totalInputs[index].value);
        
        if (!isNaN(obtained) && !isNaN(total) && total > 0) {
          if (obtained > total) {
            alert(`Marks obtained cannot be greater than total marks (Row ${index + 1})`);
            return;
          }
          obtainedSum += obtained;
          possibleSum += total;
          hasValidInput = true;
        }
      });

      if (!hasValidInput || possibleSum === 0) return;

      const percentage = (obtainedSum / possibleSum) * 100;

      if (totalPercentageEl) totalPercentageEl.textContent = `${percentage.toFixed(2)}%`;
      if (totalObtainedEl) totalObtainedEl.textContent = obtainedSum.toString();
      if (totalPossibleEl) totalPossibleEl.textContent = possibleSum.toString();

      if (resultSection) {
        resultSection.classList.remove('hidden');
        resultSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });

    resetBtn?.addEventListener('click', () => {
      form.reset();
      resultSection?.classList.add('hidden');
    });
  };

  initCalculator();
  document.addEventListener('astro:page-load', initCalculator);
</script>
