---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">File Size</label>
          <div class="flex flex-wrap gap-2">
            <input type="number" id="bw-size" placeholder="e.g. 15" min="0.1" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
            <select id="bw-size-unit" class="px-3 py-2 bg-page border border-border-line rounded-xl text-sm">
              <option value="1">GB</option>
              <option value="0.001">MB</option>
              <option value="1000">TB</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Internet Download Speed (Mbps)</label>
          <input type="number" id="bw-speed" placeholder="e.g. 100" min="1" step="10" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>

        <button id="bw-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Download Duration
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Estimated Download Time</div>
          <div id="bw-time" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 text-xs text-slate-muted">
          <span>Actual Transfer Rate: </span>
          <strong id="bw-mbps" class="text-ink font-mono break-words">12.50 MB/s</strong>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const size = parseFloat((document.getElementById('bw-size') as HTMLInputElement)?.value || '1');
    const unit = parseFloat((document.getElementById('bw-size-unit') as HTMLSelectElement)?.value || '1');
    const mbps = parseFloat((document.getElementById('bw-speed') as HTMLInputElement)?.value || '100');

    const sizeGB = size * unit;
    const sizeMB = sizeGB * 1024;
    const speedMBps = mbps / 8;

    const totalSeconds = sizeMB / speedMBps;
    const hrs = Math.floor(totalSeconds / 3600);
    const mins = Math.floor((totalSeconds % 3600) / 60);
    const secs = Math.round(totalSeconds % 60);

    let timeStr = '';
    if (hrs > 0) timeStr += hrs + ' hr ';
    timeStr += mins + ' min ' + secs + ' sec';

    document.getElementById('bw-time')!.textContent = timeStr;
    document.getElementById('bw-mbps')!.textContent = speedMBps.toFixed(2) + ' MB/s';
  }


  document.getElementById('bw-calc-btn')?.addEventListener('click', calculate);
</script>