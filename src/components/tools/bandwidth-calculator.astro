---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">File Size</label>
          <div class="flex gap-2">
            <input type="number" id="bw-size" placeholder="e.g. 15" min="0.1" step="any" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
            <select id="bw-size-unit" class="px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm">
              <option value="1">GB</option>
              <option value="0.001">MB</option>
              <option value="1000">TB</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Internet Download Speed (Mbps)</label>
          <input type="number" id="bw-speed" placeholder="e.g. 100" min="1" step="10" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>

        <button id="bw-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Download Duration
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Estimated Download Time</div>
          <div id="bw-time" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 text-xs text-slate-600">
          <span>Actual Transfer Rate: </span>
          <strong id="bw-mbps" class="text-slate-800 font-mono">12.50 MB/s</strong>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const size = parseFloat((document.getElementById('bw-size') as HTMLInputElement)?.value || '1');
    const unit = parseFloat((document.getElementById('bw-size-unit') as HTMLSelectElement)?.value || '1');
    const mbps = parseFloat((document.getElementById('bw-speed') as HTMLInputElement)?.value || '100');

    const sizeGB = size * unit;
    const sizeMB = sizeGB * 1024;
    const speedMBps = mbps / 8;

    const totalSeconds = sizeMB / speedMBps;
    const hrs = Math.floor(totalSeconds / 3600);
    const mins = Math.floor((totalSeconds % 3600) / 60);
    const secs = Math.round(totalSeconds % 60);

    let timeStr = '';
    if (hrs > 0) timeStr += hrs + ' hr ';
    timeStr += mins + ' min ' + secs + ' sec';

    document.getElementById('bw-time')!.textContent = timeStr;
    document.getElementById('bw-mbps')!.textContent = speedMBps.toFixed(2) + ' MB/s';
  }


  document.getElementById('bw-calc-btn')?.addEventListener('click', calculate);
</script>