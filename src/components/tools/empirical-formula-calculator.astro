---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Carbon % (C)</label>
          <input type="number" id="ef-c" placeholder="e.g. 40.0" step="0.1" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Hydrogen % (H)</label>
          <input type="number" id="ef-h" placeholder="e.g. 6.7" step="0.1" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Oxygen % (O)</label>
          <input type="number" id="ef-o" placeholder="e.g. 53.3" step="0.1" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>

        <button id="ef-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Determine Empirical Formula
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Empirical Formula</div>
          <div id="ef-res" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div class="text-xs text-slate-muted mt-1">Molar ratio C : H : O = 1 : 2 : 1</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const c = parseFloat((document.getElementById('ef-c') as HTMLInputElement)?.value || '0');
    const h = parseFloat((document.getElementById('ef-h') as HTMLInputElement)?.value || '0');
    const o = parseFloat((document.getElementById('ef-o') as HTMLInputElement)?.value || '0');

    const molC = c / 12.011;
    const molH = h / 1.008;
    const molO = o / 15.999;

    const minMol = Math.min(molC || 1, molH || 1, molO || 1);

    const rC = Math.round(molC / minMol);
    const rH = Math.round(molH / minMol);
    const rO = Math.round(molO / minMol);

    const fC = rC > 1 ? 'C' + rC : rC === 1 ? 'C' : '';
    const fH = rH > 1 ? 'H' + rH : rH === 1 ? 'H' : '';
    const fO = rO > 1 ? 'O' + rO : rO === 1 ? 'O' : '';

    document.getElementById('ef-res')!.textContent = fC + fH + fO;
  }


  document.getElementById('ef-calc-btn')?.addEventListener('click', calculate);
</script>