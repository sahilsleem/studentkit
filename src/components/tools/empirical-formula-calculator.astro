---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Carbon % (C)</label>
          <input type="number" id="ef-c" placeholder="e.g. 40.0" step="0.1" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Hydrogen % (H)</label>
          <input type="number" id="ef-h" placeholder="e.g. 6.7" step="0.1" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Oxygen % (O)</label>
          <input type="number" id="ef-o" placeholder="e.g. 53.3" step="0.1" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>

        <button id="ef-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Determine Empirical Formula
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Empirical Formula</div>
          <div id="ef-res" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
          <div class="text-xs text-slate-500 mt-2">Molar ratio C : H : O = 1 : 2 : 1</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const c = parseFloat((document.getElementById('ef-c') as HTMLInputElement)?.value || '0');
    const h = parseFloat((document.getElementById('ef-h') as HTMLInputElement)?.value || '0');
    const o = parseFloat((document.getElementById('ef-o') as HTMLInputElement)?.value || '0');

    const molC = c / 12.011;
    const molH = h / 1.008;
    const molO = o / 15.999;

    const minMol = Math.min(molC || 1, molH || 1, molO || 1);

    const rC = Math.round(molC / minMol);
    const rH = Math.round(molH / minMol);
    const rO = Math.round(molO / minMol);

    const fC = rC > 1 ? 'C' + rC : rC === 1 ? 'C' : '';
    const fH = rH > 1 ? 'H' + rH : rH === 1 ? 'H' : '';
    const fO = rO > 1 ? 'O' + rO : rO === 1 ? 'O' : '';

    document.getElementById('ef-res')!.textContent = fC + fH + fO;
  }


  document.getElementById('ef-calc-btn')?.addEventListener('click', calculate);
</script>