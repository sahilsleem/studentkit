<div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden mb-12 max-w-4xl mx-auto">
  <div class="p-6 sm:p-8">
    <div class="mb-6">
      <h2 class="text-xl font-bold text-gray-900 mb-2">Scientific Notation Calculator & Converter</h2>
      <p class="text-sm text-gray-600">Convert numbers between standard decimal, scientific notation (a × 10ᵇ), engineering notation, and perform scientific arithmetic.</p>
    </div>

    <!-- Mode Selector Tabs -->
    <div class="flex flex-wrap gap-2 mb-6 border-b border-gray-100 pb-4">
      <button type="button" id="tab-convert" class="sn-tab-btn px-4 py-2 text-sm font-medium rounded-lg bg-emerald-600 text-white transition-colors" data-mode="convert">
        Convert Notation
      </button>
      <button type="button" id="tab-arithmetic" class="sn-tab-btn px-4 py-2 text-sm font-medium rounded-lg bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors" data-mode="arithmetic">
        Scientific Arithmetic (+, −, ×, ÷)
      </button>
    </div>

    <form id="sn-form" class="space-y-6">
      <!-- CONVERSION MODE INPUTS -->
      <div id="sn-convert-inputs">
        <label for="sn-conv-input" class="block text-sm font-semibold text-gray-800 mb-1">
          Enter Decimal or Scientific Number
        </label>
        <input
          type="text"
          id="sn-conv-input"
          value="0.0000036"
          required
          class="block w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-lg font-mono text-gray-900"
          placeholder="e.g. 0.0000036 or 1.2e4 or 5.6 x 10^7"
        />
        <p class="text-xs text-gray-500 mt-1">Accepts decimals (12000, 0.005), scientific notation (3.6e-6), or standard form (3.6 × 10^-6)</p>
      </div>

      <!-- ARITHMETIC MODE INPUTS -->
      <div id="sn-arithmetic-inputs" class="hidden space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="sn-num1" class="block text-sm font-semibold text-gray-800 mb-1">First Value (A)</label>
            <input
              type="text"
              id="sn-num1"
              value="1.2e4"
              class="block w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 font-mono text-base text-gray-900"
              placeholder="e.g. 1.2e4"
            />
          </div>
          <div>
            <label for="sn-num2" class="block text-sm font-semibold text-gray-800 mb-1">Second Value (B)</label>
            <input
              type="text"
              id="sn-num2"
              value="3e2"
              class="block w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 font-mono text-base text-gray-900"
              placeholder="e.g. 3e2"
            />
          </div>
        </div>

        <div>
          <label for="sn-op-select" class="block text-xs font-semibold uppercase tracking-wider text-gray-600 mb-1">Operation</label>
          <select id="sn-op-select" class="block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-xl text-base text-gray-800 focus:ring-emerald-500 focus:border-emerald-500">
            <option value="multiply" selected>Multiplication (A × B)</option>
            <option value="divide">Division (A ÷ B)</option>
            <option value="add">Addition (A + B)</option>
            <option value="subtract">Subtraction (A − B)</option>
          </select>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row gap-3 pt-2">
        <button type="submit" class="flex-1 bg-emerald-600 text-white px-6 py-3 rounded-xl font-semibold hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors shadow-sm min-h-[44px]">
          Calculate
        </button>
        <button type="button" id="reset-btn" class="px-6 py-3 border border-gray-300 rounded-xl text-gray-700 font-semibold hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors min-h-[44px]">
          Reset
        </button>
      </div>
    </form>

    <div id="error-box" class="hidden mt-6 bg-red-50 text-red-700 p-4 rounded-xl text-sm font-medium border border-red-200"></div>

    <!-- Results Section -->
    <div id="result-section" class="mt-8 pt-8 border-t border-gray-100" aria-live="polite">
      <!-- Main Highlight Result Card -->
      <div class="bg-gradient-to-br from-emerald-50 to-teal-50 border border-emerald-200/80 rounded-2xl p-6 sm:p-8 text-center relative mb-6">
        <div class="flex justify-end absolute top-4 right-4">
          <button
            type="button"
            id="copy-result-btn"
            class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg bg-white/90 hover:bg-white text-emerald-800 border border-emerald-200 shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-emerald-500 min-h-[36px]"
            title="Copy scientific notation"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
            <span>Copy Result</span>
          </button>
        </div>
        <p id="sn-main-label" class="text-sm font-semibold uppercase tracking-wider text-emerald-800 mb-1">Scientific Notation</p>
        <div id="sn-main-value" class="text-3xl sm:text-5xl font-extrabold text-emerald-950 my-2 font-mono break-all">3.6 × 10⁻⁶</div>
        <p id="sn-main-sub" class="text-sm text-emerald-700 font-mono font-medium">3.6e-6</p>
      </div>

      <!-- Multiple Representation Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-6">
        <div class="bg-gray-50 rounded-xl p-4 border border-gray-200/70 text-center">
          <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Standard Decimal</p>
          <div id="sn-res-decimal" class="text-lg font-bold font-mono text-gray-900 break-all">0.0000036</div>
        </div>
        <div class="bg-gray-50 rounded-xl p-4 border border-gray-200/70 text-center">
          <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Engineering Notation</p>
          <div id="sn-res-engineering" class="text-lg font-bold font-mono text-gray-900 break-all">3.6 × 10⁻⁶</div>
          <p class="text-xs text-gray-400 mt-0.5">Powers of 10³</p>
        </div>
        <div class="bg-gray-50 rounded-xl p-4 border border-gray-200/70 text-center">
          <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">E-Notation</p>
          <div id="sn-res-enotation" class="text-lg font-bold font-mono text-gray-900 break-all">3.6e-6</div>
        </div>
      </div>

      <!-- Step-by-step Solution -->
      <div class="bg-gray-50 rounded-xl p-5 border border-gray-200">
        <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-2">Step-by-Step Derivation</h3>
        <div id="sn-steps-content" class="text-sm text-gray-700 font-mono space-y-1.5 bg-white p-4 rounded-lg border border-gray-200/80">
          <!-- Populated by JS -->
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { copyToClipboard } from '../../utils/formatters';

  const initScientificNotation = () => {
    let mode = 'convert'; // 'convert' or 'arithmetic'

    const form = document.getElementById('sn-form') as HTMLFormElement;
    const tabBtns = document.querySelectorAll('.sn-tab-btn');

    const convertInputs = document.getElementById('sn-convert-inputs');
    const arithmeticInputs = document.getElementById('sn-arithmetic-inputs');

    const inputConv = document.getElementById('sn-conv-input') as HTMLInputElement;
    const inputNum1 = document.getElementById('sn-num1') as HTMLInputElement;
    const inputNum2 = document.getElementById('sn-num2') as HTMLInputElement;
    const opSelect = document.getElementById('sn-op-select') as HTMLSelectElement;

    const resetBtn = document.getElementById('reset-btn');
    const copyBtn = document.getElementById('copy-result-btn');
    const errorBox = document.getElementById('error-box');

    const mainLabel = document.getElementById('sn-main-label');
    const mainValue = document.getElementById('sn-main-value');
    const mainSub = document.getElementById('sn-main-sub');

    const resDecimal = document.getElementById('sn-res-decimal');
    const resEngineering = document.getElementById('sn-res-engineering');
    const resENotation = document.getElementById('sn-res-enotation');
    const stepsContent = document.getElementById('sn-steps-content');

    if (!form || !inputConv) return;

    const superscriptDigits = ['⁰', '¹', '²', '³', '⁴', '⁵', '⁶', '⁷', '⁸', '⁹'];
    const formatExponent = (exp: number): string => {
      const isNeg = exp < 0;
      const digits = Math.abs(exp).toString().split('').map(d => superscriptDigits[parseInt(d, 10)] || d).join('');
      return isNeg ? '⁻' + digits : digits;
    };

    // Parse string to { mantissa, exp }
    const parseSci = (str: string): { mantissa: number; exp: number } | null => {
      let clean = str.trim().replace(/\s*\*\s*10\^?\s*/i, 'e').replace(/\s*x\s*10\^?\s*/i, 'e').replace(/\s*×\s*10\^?\s*/i, 'e');
      if (/^0+(\.0+)?$/.test(clean) || clean === '0') {
        return { mantissa: 0, exp: 0 };
      }

      if (clean.includes('e') || clean.includes('E')) {
        const parts = clean.split(/[eE]/);
        if (parts.length !== 2) return null;
        const m = parseFloat(parts[0]);
        const exp = parseInt(parts[1], 10);
        if (isNaN(m) || isNaN(exp)) return null;
        if (m === 0) return { mantissa: 0, exp: 0 };
        // Normalize
        let normM = m;
        let normExp = exp;
        while (Math.abs(normM) >= 10) {
          normM /= 10;
          normExp++;
        }
        while (Math.abs(normM) < 1 && normM !== 0) {
          normM *= 10;
          normExp--;
        }
        return { mantissa: normM, exp: normExp };
      }

      const val = parseFloat(clean);
      if (isNaN(val)) return null;
      if (val === 0) return { mantissa: 0, exp: 0 };

      let exp = Math.floor(Math.log10(Math.abs(val)));
      let mantissa = val / Math.pow(10, exp);
      // Clean precision artifacts
      mantissa = Number(mantissa.toPrecision(10));
      if (Math.abs(mantissa) >= 10) {
        mantissa /= 10;
        exp++;
      } else if (Math.abs(mantissa) < 1 && mantissa !== 0) {
        mantissa *= 10;
        exp--;
      }
      return { mantissa, exp };
    };

    const formatSciObj = (obj: { mantissa: number; exp: number }) => {
      const { mantissa, exp } = obj;
      if (mantissa === 0) {
        return {
          sci: '0 × 10⁰',
          eng: '0 × 10⁰',
          eNot: '0e0',
          dec: '0'
        };
      }

      const mClean = Number(mantissa.toPrecision(8)).toString();
      const sci = `${mClean} × 10${formatExponent(exp)}`;
      const eNot = `${mClean}e${exp >= 0 ? '+' : ''}${exp}`;

      // Engineering notation: exponent multiple of 3
      let engExp = Math.floor(exp / 3) * 3;
      let engShift = exp - engExp;
      let engM = Number((mantissa * Math.pow(10, engShift)).toPrecision(8));
      const eng = `${engM} × 10${formatExponent(engExp)}`;

      // Decimal representation
      let dec = '';
      if (Math.abs(exp) <= 15) {
        dec = (mantissa * Math.pow(10, exp)).toLocaleString('en-US', { maximumFractionDigits: 12 });
      } else {
        dec = eNot;
      }

      return { sci, eng, eNot, dec };
    };

    const calculate = () => {
      errorBox?.classList.add('hidden');

      if (mode === 'convert') {
        const parsed = parseSci(inputConv.value);
        if (!parsed) {
          if (errorBox) {
            errorBox.textContent = 'Please enter a valid numeric value or scientific notation (e.g. 0.0000036 or 3.6e-6).';
            errorBox.classList.remove('hidden');
          }
          return;
        }

        const formatted = formatSciObj(parsed);

        if (mainLabel) mainLabel.textContent = 'Normalized Scientific Notation';
        if (mainValue) mainValue.textContent = formatted.sci;
        if (mainSub) mainSub.textContent = formatted.eNot;

        if (resDecimal) resDecimal.textContent = formatted.dec;
        if (resEngineering) resEngineering.textContent = formatted.eng;
        if (resENotation) resENotation.textContent = formatted.eNot;

        if (stepsContent) {
          stepsContent.innerHTML = `
            <p>1. Input Value: <strong>${inputConv.value}</strong></p>
            <p>2. Normalized Mantissa: <strong>${Number(parsed.mantissa.toPrecision(8))}</strong> (satisfies 1 ≤ |a| &lt; 10)</p>
            <p>3. Exponent of 10: <strong>10^${parsed.exp}</strong></p>
            <p>4. Scientific Notation: <strong>${formatted.sci}</strong></p>
            <p>5. Engineering Form (Power of 3): <strong>${formatted.eng}</strong></p>
          `;
        }
      } else {
        const p1 = parseSci(inputNum1.value);
        const p2 = parseSci(inputNum2.value);
        const op = opSelect.value;

        if (!p1 || !p2) {
          if (errorBox) {
            errorBox.textContent = 'Please provide valid scientific notation values for both operands.';
            errorBox.classList.remove('hidden');
          }
          return;
        }

        let resM = 0;
        let resExp = 0;
        let stepMath = '';

        if (op === 'multiply') {
          resM = p1.mantissa * p2.mantissa;
          resExp = p1.exp + p2.exp;
          stepMath = `
            <p>• Multiply Mantissas: ${p1.mantissa} × ${p2.mantissa} = ${resM}</p>
            <p>• Add Exponents: 10^(${p1.exp} + ${p2.exp}) = 10^${resExp}</p>
          `;
        } else if (op === 'divide') {
          if (p2.mantissa === 0) {
            if (errorBox) {
              errorBox.textContent = 'Division by zero is undefined.';
              errorBox.classList.remove('hidden');
            }
            return;
          }
          resM = p1.mantissa / p2.mantissa;
          resExp = p1.exp - p2.exp;
          stepMath = `
            <p>• Divide Mantissas: ${p1.mantissa} ÷ ${p2.mantissa} = ${Number(resM.toPrecision(8))}</p>
            <p>• Subtract Exponents: 10^(${p1.exp} - ${p2.exp}) = 10^${resExp}</p>
          `;
        } else if (op === 'add' || op === 'subtract') {
          const maxExp = Math.max(p1.exp, p2.exp);
          const adjM1 = p1.mantissa * Math.pow(10, p1.exp - maxExp);
          const adjM2 = p2.mantissa * Math.pow(10, p2.exp - maxExp);
          resM = op === 'add' ? adjM1 + adjM2 : adjM1 - adjM2;
          resExp = maxExp;
          stepMath = `
            <p>• Align Exponents to 10^${maxExp}:</p>
            <p class="pl-4 text-xs">A = ${adjM1} × 10^${maxExp}</p>
            <p class="pl-4 text-xs">B = ${adjM2} × 10^${maxExp}</p>
            <p>• ${op === 'add' ? 'Add' : 'Subtract'} Mantissas: ${adjM1} ${op === 'add' ? '+' : '−'} ${adjM2} = ${resM}</p>
          `;
        }

        // Normalize result
        if (resM !== 0) {
          while (Math.abs(resM) >= 10) {
            resM /= 10;
            resExp++;
          }
          while (Math.abs(resM) < 1 && resM !== 0) {
            resM *= 10;
            resExp--;
          }
        }

        const formatted = formatSciObj({ mantissa: resM, exp: resExp });

        if (mainLabel) mainLabel.textContent = 'Calculated Result';
        if (mainValue) mainValue.textContent = formatted.sci;
        if (mainSub) mainSub.textContent = formatted.eNot;

        if (resDecimal) resDecimal.textContent = formatted.dec;
        if (resEngineering) resEngineering.textContent = formatted.eng;
        if (resENotation) resENotation.textContent = formatted.eNot;

        if (stepsContent) {
          stepsContent.innerHTML = `
            ${stepMath}
            <div class="border-t border-gray-100 my-1.5"></div>
            <p>• Normalized Result: <strong>${formatted.sci}</strong></p>
          `;
        }
      }
    };

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        mode = btn.getAttribute('data-mode') || 'convert';
        tabBtns.forEach(b => {
          b.className = 'sn-tab-btn px-4 py-2 text-sm font-medium rounded-lg bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors';
        });
        btn.className = 'sn-tab-btn px-4 py-2 text-sm font-medium rounded-lg bg-emerald-600 text-white transition-colors';

        if (mode === 'convert') {
          convertInputs?.classList.remove('hidden');
          arithmeticInputs?.classList.add('hidden');
        } else {
          convertInputs?.classList.add('hidden');
          arithmeticInputs?.classList.remove('hidden');
        }
        calculate();
      });
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      calculate();
    });

    inputConv.addEventListener('input', calculate);
    inputNum1.addEventListener('input', calculate);
    inputNum2.addEventListener('input', calculate);
    opSelect.addEventListener('change', calculate);

    resetBtn?.addEventListener('click', () => {
      mode = 'convert';
      inputConv.value = '0.0000036';
      inputNum1.value = '1.2e4';
      inputNum2.value = '3e2';
      opSelect.value = 'multiply';
      convertInputs?.classList.remove('hidden');
      arithmeticInputs?.classList.add('hidden');
      tabBtns.forEach((b, i) => {
        b.className = i === 0 ? 'sn-tab-btn px-4 py-2 text-sm font-medium rounded-lg bg-emerald-600 text-white transition-colors' : 'sn-tab-btn px-4 py-2 text-sm font-medium rounded-lg bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors';
      });
      calculate();
    });

    copyBtn?.addEventListener('click', async () => {
      const text = mainValue?.textContent || '';
      const success = await copyToClipboard(text);
      if (success) {
        const span = copyBtn.querySelector('span');
        if (span) {
          const original = span.textContent;
          span.textContent = 'Copied!';
          setTimeout(() => { span.textContent = original; }, 1500);
        }
      }
    });

    calculate();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScientificNotation);
  } else {
    initScientificNotation();
  }
</script>
