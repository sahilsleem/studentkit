---
import { tools } from '../../data/registry';
const { tool } = Astro.props;
---

<div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden max-w-4xl mx-auto base-container" data-tool={tool.slug}>
  <div class="p-6 sm:p-8">
    <form class="space-y-6 base-form">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Number</label>
          <input 
            type="text" 
            class="in-num w-full p-4 text-lg font-mono border border-gray-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500 bg-gray-50" 
            required 
          />
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">From Base</label>
          <select class="in-base w-full p-4 text-lg border border-gray-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500 bg-gray-50">
            <option value="10">Decimal (Base 10)</option>
            <option value="2">Binary (Base 2)</option>
            <option value="8">Octal (Base 8)</option>
            <option value="16">Hexadecimal (Base 16)</option>
          </select>
        </div>
      </div>

      <button type="submit" class="w-full bg-emerald-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors shadow-sm">
        Convert Base
      </button>
    </form>

    <div class="err-box hidden mt-6 bg-red-50 text-red-700 p-4 rounded-lg text-sm font-medium border border-red-100 flex items-start gap-3">
      <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
      <span class="err-msg"></span>
    </div>

    <div class="result-section hidden mt-8 pt-8 border-t border-gray-100">
      <div class="grid grid-cols-2 gap-4">
        <div class="bg-emerald-50 p-4 rounded-lg border border-emerald-100">
          <h4 class="text-emerald-800 font-semibold mb-1 text-sm">Binary (2)</h4>
          <p class="text-xl font-bold text-emerald-900 font-mono res-bin break-all">--</p>
        </div>
        <div class="bg-purple-50 p-4 rounded-lg border border-purple-100">
          <h4 class="text-purple-800 font-semibold mb-1 text-sm">Octal (8)</h4>
          <p class="text-xl font-bold text-purple-900 font-mono res-oct break-all">--</p>
        </div>
        <div class="bg-emerald-50 p-4 rounded-lg border border-emerald-100">
          <h4 class="text-emerald-800 font-semibold mb-1 text-sm">Decimal (10)</h4>
          <p class="text-xl font-bold text-emerald-900 font-mono res-dec break-all">--</p>
        </div>
        <div class="bg-amber-50 p-4 rounded-lg border border-amber-100">
          <h4 class="text-amber-800 font-semibold mb-1 text-sm">Hexadecimal (16)</h4>
          <p class="text-xl font-bold text-amber-900 font-mono res-hex break-all uppercase">--</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const initBase = () => {
    document.querySelectorAll('.base-container').forEach(container => {
      if (container.hasAttribute('data-init')) return;
      container.setAttribute('data-init', 'true');
      
      const form = container.querySelector('.base-form');
      const errBox = container.querySelector('.err-box');
      const errMsg = container.querySelector('.err-msg');
      const resultSec = container.querySelector('.result-section');
      
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        errBox.classList.add('hidden');
        resultSec.classList.add('hidden');
        
        try {
          const numStr = (container.querySelector('.in-num') as HTMLInputElement).value.trim();
          const base = parseInt((container.querySelector('.in-base') as HTMLSelectElement).value);
          
          if (!numStr) throw new Error("Please enter a number.");
          
          let decStr = numStr;
          // Parse to decimal safely (handling large integers)
          let decimalVal = 0;
          try {
             // For safety in student context, parseInt handles up to 53 bits.
             // If we need bigInt, we can use BigInt.
             const parsed = parseInt(numStr, base);
             if (isNaN(parsed)) throw new Error("Invalid number for the selected base.");
             
             // Check valid chars
             const validChars = {
               2: /^[01]+$/,
               8: /^[0-7]+$/,
               10: /^[0-9]+$/,
               16: /^[0-9a-fA-F]+$/
             };
             
             if (validChars[base] && !validChars[base].test(numStr)) {
               throw new Error(`Number contains invalid characters for base ${base}.`);
             }
             
             let big = BigInt("0");
             // manual parse for arbitrary size
             const chars = numStr.toLowerCase().split('');
             for (let i = 0; i < chars.length; i++) {
                const c = chars[i];
                let val = 0;
                if (c >= '0' && c <= '9') val = parseInt(c);
                else val = c.charCodeAt(0) - 87; // a is 97
                big = big * BigInt(base) + BigInt(val);
             }
             
             container.querySelector('.res-bin').textContent = big.toString(2);
             container.querySelector('.res-oct').textContent = big.toString(8);
             container.querySelector('.res-dec').textContent = big.toString(10);
             container.querySelector('.res-hex').textContent = big.toString(16);
             
          } catch(e) {
             throw new Error("Invalid number format for selected base.");
          }
          
          resultSec.classList.remove('hidden');
          
        } catch (err) {
          errMsg.textContent = err.message;
          errBox.classList.remove('hidden');
        }
      });
    });
  };

  initBase();
  document.addEventListener('astro:page-load', initBase);
</script>
