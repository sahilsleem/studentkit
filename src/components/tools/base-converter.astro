---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Input Value</label>
          <input type="text" id="bc-input" placeholder="e.g. 255" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm font-mono" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">From Base</label>
          <select id="bc-from" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm">
            <option value="10" selected>Decimal (Base 10)</option>
            <option value="2">Binary (Base 2)</option>
            <option value="16">Hexadecimal (Base 16)</option>
            <option value="8">Octal (Base 8)</option>
          </select>
        </div>
      </div>

      <button id="bc-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
        Convert Bases
      </button>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-6">
        <div class="p-4 bg-slate-50 rounded-xl border border-slate-200/80">
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Binary (Base 2)</div>
          <div id="bc-bin" class="text-lg font-bold text-blue-600 font-mono mt-1 break-all">--</div>
        </div>
        <div class="p-4 bg-slate-50 rounded-xl border border-slate-200/80">
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Hexadecimal (Base 16)</div>
          <div id="bc-hex" class="text-lg font-bold text-blue-600 font-mono mt-1 uppercase">--</div>
        </div>
        <div class="p-4 bg-slate-50 rounded-xl border border-slate-200/80">
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Decimal (Base 10)</div>
          <div id="bc-dec" class="text-lg font-bold text-slate-800 font-mono mt-1">--</div>
        </div>
        <div class="p-4 bg-slate-50 rounded-xl border border-slate-200/80">
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Octal (Base 8)</div>
          <div id="bc-oct" class="text-lg font-bold text-slate-800 font-mono mt-1">--</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const raw = (document.getElementById('bc-input') as HTMLInputElement)?.value.trim() || '';
    if (!raw) {
      document.getElementById('bc-bin')!.textContent = '--';
      document.getElementById('bc-hex')!.textContent = '--';
      document.getElementById('bc-dec')!.textContent = '--';
      document.getElementById('bc-oct')!.textContent = '--';
      return;
    }
    const fromBase = parseInt((document.getElementById('bc-from') as HTMLSelectElement)?.value || '10', 10);

    const num = parseInt(raw, fromBase);
    if (isNaN(num)) {
      document.getElementById('bc-bin')!.textContent = 'Invalid input';
      document.getElementById('bc-hex')!.textContent = 'Invalid input';
      document.getElementById('bc-dec')!.textContent = 'Invalid input';
      document.getElementById('bc-oct')!.textContent = 'Invalid input';
      return;
    }

    document.getElementById('bc-bin')!.textContent = num.toString(2);
    document.getElementById('bc-hex')!.textContent = num.toString(16).toUpperCase();
    document.getElementById('bc-dec')!.textContent = num.toString(10);
    document.getElementById('bc-oct')!.textContent = num.toString(8);
  }

  document.getElementById('bc-calc-btn')?.addEventListener('click', calculate);
</script>