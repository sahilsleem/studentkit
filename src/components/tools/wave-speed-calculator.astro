---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Frequency (f in Hz)</label>
          <input type="number" id="ws-f" placeholder="e.g. 440" min="0.1" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Wavelength (λ in meters)</label>
          <input type="number" id="ws-lambda" placeholder="e.g. 0.78" min="0.001" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>

        <button id="ws-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Wave Speed
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Wave Speed (v = f · λ)</div>
          <div id="ws-speed" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div class="text-xs text-slate-muted mt-1">~Speed of Sound in Air at 20°C</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 text-xs text-slate-muted">
          <span>Wave Period (T = 1/f): </span>
          <strong id="ws-period" class="text-ink font-mono break-words">2.27 ms</strong>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const f = parseFloat((document.getElementById('ws-f') as HTMLInputElement)?.value || '1');
    const lambda = parseFloat((document.getElementById('ws-lambda') as HTMLInputElement)?.value || '1');

    const v = f * lambda;
    const t = (1 / f) * 1000;

    document.getElementById('ws-speed')!.textContent = v.toFixed(2) + ' m/s';
    document.getElementById('ws-period')!.textContent = t.toFixed(2) + ' ms';
  }


  document.getElementById('ws-calc-btn')?.addEventListener('click', calculate);
</script>