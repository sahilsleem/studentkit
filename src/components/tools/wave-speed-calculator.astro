---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Frequency (f in Hz)</label>
          <input type="number" id="ws-f" placeholder="e.g. 440" min="0.1" step="any" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Wavelength (λ in meters)</label>
          <input type="number" id="ws-lambda" placeholder="e.g. 0.78" min="0.001" step="any" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>

        <button id="ws-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Wave Speed
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Wave Speed (v = f · λ)</div>
          <div id="ws-speed" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
          <div class="text-xs text-slate-500 mt-2">~Speed of Sound in Air at 20°C</div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 text-xs text-slate-600">
          <span>Wave Period (T = 1/f): </span>
          <strong id="ws-period" class="text-slate-800 font-mono">2.27 ms</strong>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const f = parseFloat((document.getElementById('ws-f') as HTMLInputElement)?.value || '1');
    const lambda = parseFloat((document.getElementById('ws-lambda') as HTMLInputElement)?.value || '1');

    const v = f * lambda;
    const t = (1 / f) * 1000;

    document.getElementById('ws-speed')!.textContent = v.toFixed(2) + ' m/s';
    document.getElementById('ws-period')!.textContent = t.toFixed(2) + ' ms';
  }


  document.getElementById('ws-calc-btn')?.addEventListener('click', calculate);
</script>