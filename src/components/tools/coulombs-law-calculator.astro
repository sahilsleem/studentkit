---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Charge 1 (q₁ in Coulombs)</label>
          <input type="text" id="cl-q1" placeholder="e.g. 2e-6" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm font-mono" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Charge 2 (q₂ in Coulombs)</label>
          <input type="text" id="cl-q2" placeholder="e.g. -5e-6" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm font-mono" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Separation Distance (r in meters)</label>
          <input type="number" id="cl-r" placeholder="e.g. 0.1" min="0.001" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>

        <button id="cl-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Electrostatic Force
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Electrostatic Force (F = k·|q₁q₂|/r²)</div>
          <div id="cl-force" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div id="cl-type" class="text-xs text-rose-600 font-semibold mt-1">Attractive Force (Opposite Charges)</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const q1 = parseFloat((document.getElementById('cl-q1') as HTMLInputElement)?.value || '0');
    const q2 = parseFloat((document.getElementById('cl-q2') as HTMLInputElement)?.value || '0');
    const r = parseFloat((document.getElementById('cl-r') as HTMLInputElement)?.value || '1');
    const k = 8.98755e9;

    if (r <= 0) return;
    const f = (k * Math.abs(q1 * q2)) / (r * r);

    document.getElementById('cl-force')!.textContent = f.toFixed(2) + ' N';
    document.getElementById('cl-type')!.textContent = (q1 * q2 < 0) ? 'Attractive Force (Opposite Charges)' : 'Repulsive Force (Like Charges)';
  }


  document.getElementById('cl-calc-btn')?.addEventListener('click', calculate);
</script>