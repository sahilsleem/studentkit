---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Angle (θ)</label>
          <input type="number" id="trig-val" step="any" placeholder="e.g. 45" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Angle Unit</label>
          <select id="trig-unit" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="deg" selected>Degrees (°)</option>
            <option value="rad">Radians (rad)</option>
          </select>
        </div>

        <button id="trig-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Trig Values
        </button>
      </div>

      <div class="p-6 bg-slate-50 rounded-xl border border-slate-200/80 grid grid-cols-2 gap-4">
        <div class="bg-white p-3 rounded-lg border border-slate-200">
          <div class="text-xs text-slate-500 font-semibold">sin(θ)</div>
          <div id="trig-sin" class="text-lg font-bold text-blue-600 font-mono mt-0.5">0.7071</div>
        </div>
        <div class="bg-white p-3 rounded-lg border border-slate-200">
          <div class="text-xs text-slate-500 font-semibold">cos(θ)</div>
          <div id="trig-cos" class="text-lg font-bold text-blue-600 font-mono mt-0.5">0.7071</div>
        </div>
        <div class="bg-white p-3 rounded-lg border border-slate-200">
          <div class="text-xs text-slate-500 font-semibold">tan(θ)</div>
          <div id="trig-tan" class="text-lg font-bold text-blue-600 font-mono mt-0.5">1.0000</div>
        </div>
        <div class="bg-white p-3 rounded-lg border border-slate-200">
          <div class="text-xs text-slate-500 font-semibold">csc(θ) / sec(θ)</div>
          <div id="trig-sec" class="text-sm font-bold text-slate-700 font-mono mt-0.5">1.4142</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const val = parseFloat((document.getElementById('trig-val') as HTMLInputElement)?.value || '0');
    const unit = (document.getElementById('trig-unit') as HTMLSelectElement)?.value;

    const rad = unit === 'deg' ? (val * Math.PI) / 180 : val;

    const s = Math.sin(rad);
    const c = Math.cos(rad);
    const t = Math.abs(c) < 1e-9 ? 'Undefined' : Math.tan(rad).toFixed(4);
    const sec = Math.abs(c) < 1e-9 ? 'Undefined' : (1 / c).toFixed(4);

    const sinEl = document.getElementById('trig-sin');
    const cosEl = document.getElementById('trig-cos');
    const tanEl = document.getElementById('trig-tan');
    const secEl = document.getElementById('trig-sec');

    if (sinEl) sinEl.textContent = s.toFixed(4);
    if (cosEl) cosEl.textContent = c.toFixed(4);
    if (tanEl) tanEl.textContent = t;
    if (secEl) secEl.textContent = sec;
  }


  document.getElementById('trig-calc-btn')?.addEventListener('click', calculate);
</script>