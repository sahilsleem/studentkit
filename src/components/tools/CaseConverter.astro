<div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden mb-12 max-w-4xl mx-auto">
  <div class="p-6 sm:p-8">
    <div class="mb-6">
      <h2 class="text-xl font-bold text-gray-900 mb-2">Text Case Converter</h2>
      <p class="text-sm text-gray-600">Instantly convert text between UPPERCASE, lowercase, Title Case, Sentence case, camelCase, PascalCase, snake_case, kebab-case, and CONSTANT_CASE.</p>
    </div>

    <!-- Live Statistics Bar -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-6 bg-gray-50 border border-gray-200/80 rounded-xl p-3 text-center">
      <div>
        <span class="text-xs text-gray-500 uppercase font-semibold">Characters</span>
        <div id="stat-chars" class="text-base font-bold text-gray-900">0</div>
      </div>
      <div>
        <span class="text-xs text-gray-500 uppercase font-semibold">Words</span>
        <div id="stat-words" class="text-base font-bold text-gray-900">0</div>
      </div>
      <div>
        <span class="text-xs text-gray-500 uppercase font-semibold">Sentences</span>
        <div id="stat-sentences" class="text-base font-bold text-gray-900">0</div>
      </div>
      <div>
        <span class="text-xs text-gray-500 uppercase font-semibold">Lines</span>
        <div id="stat-lines" class="text-base font-bold text-gray-900">0</div>
      </div>
    </div>

    <!-- Text Input Area -->
    <div class="mb-6">
      <label for="case-input" class="block text-sm font-semibold text-gray-800 mb-1">
        Type or Paste Your Text Below:
      </label>
      <textarea
        id="case-input"
        rows="5"
        class="block w-full p-4 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-base text-gray-900 leading-relaxed font-sans"
        placeholder="Enter your text here to convert across multiple case styles..."
      >The quick brown fox jumps over the lazy dog</textarea>
    </div>

    <!-- Action Helper Buttons -->
    <div class="flex flex-wrap gap-2 mb-8">
      <button type="button" id="btn-sample" class="px-3.5 py-1.5 text-xs font-semibold rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-800 hover:bg-emerald-100 transition-colors">
        Sample Text
      </button>
      <button type="button" id="btn-clear" class="px-3.5 py-1.5 text-xs font-semibold rounded-lg bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors">
        Clear All
      </button>
    </div>

    <!-- Generated Case Formats Grid -->
    <div class="space-y-4" aria-live="polite">
      <!-- Title Case -->
      <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 transition-all hover:border-emerald-300">
        <div class="flex justify-between items-center mb-1.5">
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-800">Title Case (Headline Style)</span>
          <button type="button" data-target="out-title" class="copy-card-btn text-xs font-semibold px-2.5 py-1 rounded bg-white border border-gray-300 hover:bg-emerald-50 text-gray-700 hover:text-emerald-800 transition-colors shadow-sm">
            Copy
          </button>
        </div>
        <div id="out-title" class="text-sm font-medium text-gray-900 break-words whitespace-pre-wrap">The Quick Brown Fox Jumps Over the Lazy Dog</div>
      </div>

      <!-- Sentence case -->
      <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 transition-all hover:border-emerald-300">
        <div class="flex justify-between items-center mb-1.5">
          <span class="text-xs font-bold uppercase tracking-wider text-gray-700">Sentence case</span>
          <button type="button" data-target="out-sentence" class="copy-card-btn text-xs font-semibold px-2.5 py-1 rounded bg-white border border-gray-300 hover:bg-emerald-50 text-gray-700 hover:text-emerald-800 transition-colors shadow-sm">
            Copy
          </button>
        </div>
        <div id="out-sentence" class="text-sm font-medium text-gray-900 break-words whitespace-pre-wrap">The quick brown fox jumps over the lazy dog</div>
      </div>

      <!-- UPPERCASE & lowercase Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 transition-all hover:border-emerald-300">
          <div class="flex justify-between items-center mb-1.5">
            <span class="text-xs font-bold uppercase tracking-wider text-gray-700">UPPERCASE</span>
            <button type="button" data-target="out-upper" class="copy-card-btn text-xs font-semibold px-2.5 py-1 rounded bg-white border border-gray-300 hover:bg-emerald-50 text-gray-700 hover:text-emerald-800 transition-colors shadow-sm">
              Copy
            </button>
          </div>
          <div id="out-upper" class="text-sm font-medium text-gray-900 break-words whitespace-pre-wrap">THE QUICK BROWN FOX JUMPS OVER THE LAZY DOG</div>
        </div>

        <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 transition-all hover:border-emerald-300">
          <div class="flex justify-between items-center mb-1.5">
            <span class="text-xs font-bold uppercase tracking-wider text-gray-700">lowercase</span>
            <button type="button" data-target="out-lower" class="copy-card-btn text-xs font-semibold px-2.5 py-1 rounded bg-white border border-gray-300 hover:bg-emerald-50 text-gray-700 hover:text-emerald-800 transition-colors shadow-sm">
              Copy
            </button>
          </div>
          <div id="out-lower" class="text-sm font-medium text-gray-900 break-words whitespace-pre-wrap">the quick brown fox jumps over the lazy dog</div>
        </div>
      </div>

      <!-- Developer / Coding Formats Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 transition-all hover:border-emerald-300">
          <div class="flex justify-between items-center mb-1.5">
            <span class="text-xs font-bold uppercase tracking-wider text-teal-800 font-mono">camelCase</span>
            <button type="button" data-target="out-camel" class="copy-card-btn text-xs font-semibold px-2.5 py-1 rounded bg-white border border-gray-300 hover:bg-emerald-50 text-gray-700 hover:text-emerald-800 transition-colors shadow-sm">
              Copy
            </button>
          </div>
          <div id="out-camel" class="text-sm font-mono font-medium text-gray-900 break-all">theQuickBrownFoxJumpsOverTheLazyDog</div>
        </div>

        <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 transition-all hover:border-emerald-300">
          <div class="flex justify-between items-center mb-1.5">
            <span class="text-xs font-bold uppercase tracking-wider text-teal-800 font-mono">PascalCase</span>
            <button type="button" data-target="out-pascal" class="copy-card-btn text-xs font-semibold px-2.5 py-1 rounded bg-white border border-gray-300 hover:bg-emerald-50 text-gray-700 hover:text-emerald-800 transition-colors shadow-sm">
              Copy
            </button>
          </div>
          <div id="out-pascal" class="text-sm font-mono font-medium text-gray-900 break-all">TheQuickBrownFoxJumpsOverTheLazyDog</div>
        </div>

        <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 transition-all hover:border-emerald-300">
          <div class="flex justify-between items-center mb-1.5">
            <span class="text-xs font-bold uppercase tracking-wider text-teal-800 font-mono">snake_case</span>
            <button type="button" data-target="out-snake" class="copy-card-btn text-xs font-semibold px-2.5 py-1 rounded bg-white border border-gray-300 hover:bg-emerald-50 text-gray-700 hover:text-emerald-800 transition-colors shadow-sm">
              Copy
            </button>
          </div>
          <div id="out-snake" class="text-sm font-mono font-medium text-gray-900 break-all">the_quick_brown_fox_jumps_over_the_lazy_dog</div>
        </div>

        <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 transition-all hover:border-emerald-300">
          <div class="flex justify-between items-center mb-1.5">
            <span class="text-xs font-bold uppercase tracking-wider text-teal-800 font-mono">kebab-case</span>
            <button type="button" data-target="out-kebab" class="copy-card-btn text-xs font-semibold px-2.5 py-1 rounded bg-white border border-gray-300 hover:bg-emerald-50 text-gray-700 hover:text-emerald-800 transition-colors shadow-sm">
              Copy
            </button>
          </div>
          <div id="out-kebab" class="text-sm font-mono font-medium text-gray-900 break-all">the-quick-brown-fox-jumps-over-the-lazy-dog</div>
        </div>

        <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 transition-all hover:border-emerald-300">
          <div class="flex justify-between items-center mb-1.5">
            <span class="text-xs font-bold uppercase tracking-wider text-teal-800 font-mono">CONSTANT_CASE</span>
            <button type="button" data-target="out-constant" class="copy-card-btn text-xs font-semibold px-2.5 py-1 rounded bg-white border border-gray-300 hover:bg-emerald-50 text-gray-700 hover:text-emerald-800 transition-colors shadow-sm">
              Copy
            </button>
          </div>
          <div id="out-constant" class="text-sm font-mono font-medium text-gray-900 break-all">THE_QUICK_BROWN_FOX_JUMPS_OVER_THE_LAZY_DOG</div>
        </div>

        <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 transition-all hover:border-emerald-300">
          <div class="flex justify-between items-center mb-1.5">
            <span class="text-xs font-bold uppercase tracking-wider text-gray-700">Invert / Swap Case</span>
            <button type="button" data-target="out-invert" class="copy-card-btn text-xs font-semibold px-2.5 py-1 rounded bg-white border border-gray-300 hover:bg-emerald-50 text-gray-700 hover:text-emerald-800 transition-colors shadow-sm">
              Copy
            </button>
          </div>
          <div id="out-invert" class="text-sm font-medium text-gray-900 break-words whitespace-pre-wrap">tHE QUICK BROWN FOX JUMPS OVER THE LAZY DOG</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { copyToClipboard } from '../../utils/formatters';

  const initCaseConverter = () => {
    const inputEl = document.getElementById('case-input') as HTMLTextAreaElement;
    const btnSample = document.getElementById('btn-sample');
    const btnClear = document.getElementById('btn-clear');

    const statChars = document.getElementById('stat-chars');
    const statWords = document.getElementById('stat-words');
    const statSentences = document.getElementById('stat-sentences');
    const statLines = document.getElementById('stat-lines');

    const outTitle = document.getElementById('out-title');
    const outSentence = document.getElementById('out-sentence');
    const outUpper = document.getElementById('out-upper');
    const outLower = document.getElementById('out-lower');
    const outCamel = document.getElementById('out-camel');
    const outPascal = document.getElementById('out-pascal');
    const outSnake = document.getElementById('out-snake');
    const outKebab = document.getElementById('out-kebab');
    const outConstant = document.getElementById('out-constant');
    const outInvert = document.getElementById('out-invert');

    if (!inputEl) return;

    const stopWords = new Set([
      'a', 'an', 'the', 'and', 'but', 'or', 'for', 'nor', 'on', 'at', 'to', 'from', 'by', 'in', 'of', 'with'
    ]);

    // Title Case (APA / Chicago style rules)
    const toTitleCase = (text: string): string => {
      return text.replace(/\b[\w']+\b/g, (word, index, fullStr) => {
        const lower = word.toLowerCase();
        const isFirstOrLast = index === 0 || index + word.length >= fullStr.length;
        if (!isFirstOrLast && stopWords.has(lower)) {
          return lower;
        }
        return lower.charAt(0).toUpperCase() + lower.slice(1);
      });
    };

    // Sentence case
    const toSentenceCase = (text: string): string => {
      const lower = text.toLowerCase();
      return lower.replace(/(^\s*|[.!?]\s*\n*\s*)([a-z])/g, (_, boundary, char) => {
        return boundary + char.toUpperCase();
      });
    };

    // Extract word tokens for identifier cases
    const getWords = (text: string): string[] => {
      return text
        .replace(/([a-z])([A-Z])/g, '$1 $2')
        .replace(/[^a-zA-Z0-9]+/g, ' ')
        .trim()
        .split(/\s+/)
        .filter(w => w.length > 0);
    };

    const toCamelCase = (text: string): string => {
      const words = getWords(text);
      if (words.length === 0) return '';
      return words[0].toLowerCase() + words.slice(1).map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase()).join('');
    };

    const toPascalCase = (text: string): string => {
      const words = getWords(text);
      return words.map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase()).join('');
    };

    const toSnakeCase = (text: string): string => {
      const words = getWords(text);
      return words.map(w => w.toLowerCase()).join('_');
    };

    const toKebabCase = (text: string): string => {
      const words = getWords(text);
      return words.map(w => w.toLowerCase()).join('-');
    };

    const toConstantCase = (text: string): string => {
      const words = getWords(text);
      return words.map(w => w.toUpperCase()).join('_');
    };

    const toInvertCase = (text: string): string => {
      return text.split('').map(c => {
        if (c === c.toUpperCase()) return c.toLowerCase();
        return c.toUpperCase();
      }).join('');
    };

    const update = () => {
      const text = inputEl.value;

      // Stats
      const charCount = text.length;
      const wordsArray = text.trim() ? text.trim().split(/\s+/) : [];
      const wordCount = wordsArray.length;
      const sentenceCount = text.trim() ? (text.match(/[.!?]+(\s|$)/g) || ['']).length : 0;
      const lineCount = text.trim() ? text.split(/\n/).length : 0;

      if (statChars) statChars.textContent = charCount.toLocaleString();
      if (statWords) statWords.textContent = wordCount.toLocaleString();
      if (statSentences) statSentences.textContent = sentenceCount.toString();
      if (statLines) statLines.textContent = lineCount.toString();

      if (!text.trim()) {
        if (outTitle) outTitle.textContent = '(empty)';
        if (outSentence) outSentence.textContent = '(empty)';
        if (outUpper) outUpper.textContent = '(empty)';
        if (outLower) outLower.textContent = '(empty)';
        if (outCamel) outCamel.textContent = '(empty)';
        if (outPascal) outPascal.textContent = '(empty)';
        if (outSnake) outSnake.textContent = '(empty)';
        if (outKebab) outKebab.textContent = '(empty)';
        if (outConstant) outConstant.textContent = '(empty)';
        if (outInvert) outInvert.textContent = '(empty)';
        return;
      }

      if (outTitle) outTitle.textContent = toTitleCase(text);
      if (outSentence) outSentence.textContent = toSentenceCase(text);
      if (outUpper) outUpper.textContent = text.toUpperCase();
      if (outLower) outLower.textContent = text.toLowerCase();
      if (outCamel) outCamel.textContent = toCamelCase(text);
      if (outPascal) outPascal.textContent = toPascalCase(text);
      if (outSnake) outSnake.textContent = toSnakeCase(text);
      if (outKebab) outKebab.textContent = toKebabCase(text);
      if (outConstant) outConstant.textContent = toConstantCase(text);
      if (outInvert) outInvert.textContent = toInvertCase(text);
    };

    inputEl.addEventListener('input', update);

    btnSample?.addEventListener('click', () => {
      inputEl.value = 'The quick brown fox jumps over the lazy dog';
      update();
    });

    btnClear?.addEventListener('click', () => {
      inputEl.value = '';
      update();
    });

    // 1-Click Copy Buttons for each card
    document.querySelectorAll('.copy-card-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const targetId = btn.getAttribute('data-target');
        if (!targetId) return;
        const targetEl = document.getElementById(targetId);
        const text = targetEl?.textContent || '';
        if (text === '(empty)') return;
        const success = await copyToClipboard(text);
        if (success) {
          const original = btn.textContent;
          btn.textContent = 'Copied!';
          setTimeout(() => { btn.textContent = original; }, 1500);
        }
      });
    });

    update();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCaseConverter);
  } else {
    initCaseConverter();
  }
</script>
