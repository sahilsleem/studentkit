---
---
<div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden max-w-2xl mx-auto">
  <div class="p-6 sm:p-8">
    <div class="space-y-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Polynomial Expression P(x)</label>
        <input type="text" id="poly-expr" placeholder="e.g. 2x^2 - 3x + 5" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-emerald-500 font-mono text-lg">
        <p class="text-xs text-gray-500 mt-2">Use 'x' as the variable. Example: <code>3x^3 - 2x + 1</code></p>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Evaluate at x = </label>
        <input type="number" step="any" id="poly-x" placeholder="Value of x" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-emerald-500 font-mono">
      </div>
    </div>

    <div class="mt-6">
      <button id="eval-poly-btn" class="w-full bg-emerald-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors">Evaluate Polynomial</button>
    </div>

    <div id="poly-result" class="mt-8 pt-6 border-t border-gray-100 hidden">
      <h3 class="text-lg font-semibold mb-2">Result</h3>
      <div id="poly-ans" class="bg-gray-50 p-6 rounded-xl border border-gray-200 text-2xl font-bold font-mono text-center"></div>
    </div>
  </div>
</div>

<script>
  import { evaluate } from 'mathjs';

  const initPoly = () => {
    const btn = document.getElementById('eval-poly-btn');
    const resSec = document.getElementById('poly-result');
    const ans = document.getElementById('poly-ans');

    if (!btn) return;

    btn.addEventListener('click', () => {
      let expr = (document.getElementById('poly-expr') as HTMLInputElement).value;
      const xVal = parseFloat((document.getElementById('poly-x') as HTMLInputElement).value);

      if (!expr || isNaN(xVal)) return;

      // Fix implicit multiplication like 2x -> 2*x
      expr = expr.replace(/(\d)x/g, '$1*x');

      try {
        let result = evaluate(expr, { x: xVal });
        if (typeof result === 'number') {
           result = parseFloat(result.toFixed(6));
        }
        ans.textContent = `P(${xVal}) = ${result}`;
        resSec.classList.remove('hidden');
      } catch (err) {
        ans.innerHTML = `<span class="text-red-500 text-lg">Error parsing polynomial</span>`;
        resSec.classList.remove('hidden');
      }
    });
  };

  initPoly();
  document.addEventListener('astro:page-load', initPoly);
</script>
