---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Operand A (Decimal)</label>
          <input type="number" id="bw-a" placeholder="e.g. 12" step="1" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm font-mono" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Operand B (Decimal)</label>
          <input type="number" id="bw-b" placeholder="e.g. 5" step="1" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm font-mono" />
        </div>

        <button id="bw-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Bitwise Logic
        </button>
      </div>

      <div class="p-4 sm:p-5 bg-page rounded-xl border border-border-line/80 grid grid-cols-2 gap-3">
        <div class="bg-card p-3 rounded-lg border border-border-line">
          <div class="text-xs text-slate-muted">AND (A & B)</div>
          <div id="bw-and" class="text-lg font-bold text-brand font-mono mt-0.5">4 (0100)</div>
        </div>
        <div class="bg-card p-3 rounded-lg border border-border-line">
          <div class="text-xs text-slate-muted">OR (A | B)</div>
          <div id="bw-or" class="text-lg font-bold text-brand font-mono mt-0.5">13 (1101)</div>
        </div>
        <div class="bg-card p-3 rounded-lg border border-border-line">
          <div class="text-xs text-slate-muted">XOR (A ^ B)</div>
          <div id="bw-xor" class="text-lg font-bold text-brand font-mono mt-0.5">9 (1001)</div>
        </div>
        <div class="bg-card p-3 rounded-lg border border-border-line">
          <div class="text-xs text-slate-muted">NOT (~A)</div>
          <div id="bw-not" class="text-lg font-bold text-ink font-mono mt-0.5">-13</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const a = parseInt((document.getElementById('bw-a') as HTMLInputElement)?.value || '0', 10);
    const b = parseInt((document.getElementById('bw-b') as HTMLInputElement)?.value || '0', 10);

    const and = a & b;
    const or = a | b;
    const xor = a ^ b;
    const notA = ~a;

    document.getElementById('bw-and')!.textContent = and + ' (' + (and >>> 0).toString(2) + ')';
    document.getElementById('bw-or')!.textContent = or + ' (' + (or >>> 0).toString(2) + ')';
    document.getElementById('bw-xor')!.textContent = xor + ' (' + (xor >>> 0).toString(2) + ')';
    document.getElementById('bw-not')!.textContent = notA.toString();
  }


  document.getElementById('bw-calc-btn')?.addEventListener('click', calculate);
</script>