---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Recessive Genotype Frequency (q²)</label>
          <input type="number" id="hw-q2" placeholder="e.g. 0.09" min="0" max="1" step="0.01" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
          <span class="text-xs text-slate-400">e.g. 9% affected individuals</span>
        </div>

        <button id="hw-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Allele & Genotype Frequencies
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Allele Frequencies</div>
          <div id="hw-alleles" class="text-2xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 space-y-1 text-xs text-slate-600">
          <div class="flex justify-between">
            <span>Homozygous Dominant (p²):</span>
            <strong id="hw-p2" class="text-slate-800 font-mono">0.49 (49.0%)</strong>
          </div>
          <div class="flex justify-between">
            <span>Heterozygous Carriers (2pq):</span>
            <strong id="hw-2pq" class="text-slate-800 font-mono">0.42 (42.0%)</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const q2 = parseFloat((document.getElementById('hw-q2') as HTMLInputElement)?.value || '0.09');
    if (q2 < 0 || q2 > 1) return;

    const q = Math.sqrt(q2);
    const p = 1 - q;
    const p2 = p * p;
    const twoPq = 2 * p * q;

    document.getElementById('hw-alleles')!.textContent = 'p = ' + p.toFixed(2) + '  |  q = ' + q.toFixed(2);
    document.getElementById('hw-p2')!.textContent = p2.toFixed(4) + ' (' + (p2 * 100).toFixed(1) + '%)';
    document.getElementById('hw-2pq')!.textContent = twoPq.toFixed(4) + ' (' + (twoPq * 100).toFixed(1) + '%)';
  }


  document.getElementById('hw-calc-btn')?.addEventListener('click', calculate);
</script>