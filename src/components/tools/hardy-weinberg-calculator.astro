---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Recessive Genotype Frequency (q²)</label>
          <input type="number" id="hw-q2" placeholder="e.g. 0.09" min="0" max="1" step="0.01" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
          <span class="text-xs text-slate-muted">e.g. 9% affected individuals</span>
        </div>

        <button id="hw-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Allele & Genotype Frequencies
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Allele Frequencies</div>
          <div id="hw-alleles" class="text-2xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 space-y-1 text-xs text-slate-muted">
          <div class="flex flex-wrap justify-between gap-2">
            <span>Homozygous Dominant (p²):</span>
            <strong id="hw-p2" class="text-ink font-mono break-words">0.49 (49.0%)</strong>
          </div>
          <div class="flex flex-wrap justify-between gap-2">
            <span>Heterozygous Carriers (2pq):</span>
            <strong id="hw-2pq" class="text-ink font-mono break-words">0.42 (42.0%)</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const q2 = parseFloat((document.getElementById('hw-q2') as HTMLInputElement)?.value || '0.09');
    if (q2 < 0 || q2 > 1) return;

    const q = Math.sqrt(q2);
    const p = 1 - q;
    const p2 = p * p;
    const twoPq = 2 * p * q;

    document.getElementById('hw-alleles')!.textContent = 'p = ' + p.toFixed(2) + '  |  q = ' + q.toFixed(2);
    document.getElementById('hw-p2')!.textContent = p2.toFixed(4) + ' (' + (p2 * 100).toFixed(1) + '%)';
    document.getElementById('hw-2pq')!.textContent = twoPq.toFixed(4) + ' (' + (twoPq * 100).toFixed(1) + '%)';
  }


  document.getElementById('hw-calc-btn')?.addEventListener('click', calculate);
</script>