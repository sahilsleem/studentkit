---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Total Items (n)</label>
          <input type="number" id="pc-n" min="0" max="50" placeholder="e.g. 8" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Selected Items (r)</label>
          <input type="number" id="pc-r" min="0" max="50" placeholder="e.g. 3" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <button id="pc-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate nPr & nCr
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Combinations nCr (Order does NOT matter)</div>
          <div id="pc-ncr" class="text-3xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div class="text-xs text-slate-muted mt-1">Formula: n! / (r!(n-r)!)</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4">
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Permutations nPr (Order DOES matter)</div>
          <div id="pc-npr" class="text-3xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div class="text-xs text-slate-muted mt-1">Formula: n! / (n-r)!</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function fact(n: number): number {
    let res = 1;
    for (let i = 2; i <= n; i++) res *= i;
    return res;
  }

  function calculate() {
    const n = parseInt((document.getElementById('pc-n') as HTMLInputElement)?.value || '0', 10);
    const r = parseInt((document.getElementById('pc-r') as HTMLInputElement)?.value || '0', 10);

    if (n < 0 || r < 0 || r > n) return;

    const npr = fact(n) / fact(n - r);
    const ncr = fact(n) / (fact(r) * fact(n - r));

    const nprEl = document.getElementById('pc-npr');
    const ncrEl = document.getElementById('pc-ncr');

    if (nprEl) nprEl.textContent = npr.toLocaleString();
    if (ncrEl) ncrEl.textContent = ncr.toLocaleString();
  }


  document.getElementById('pc-calc-btn')?.addEventListener('click', calculate);
</script>