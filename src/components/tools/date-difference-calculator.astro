---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Start Date</label>
          <input type="date" id="dd-start" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">End Date</label>
          <input type="date" id="dd-end" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div class="flex items-center gap-2 pt-2">
          <input type="checkbox" id="dd-include-end" checked class="rounded border-slate-300 text-blue-600 focus:ring-blue-500" />
          <label for="dd-include-end" class="text-xs text-slate-600">Include end date in total count (+1 day)</label>
        </div>

        <button id="dd-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Date Difference
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Total Duration</div>
          <div id="dd-days" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">-- days</div>
          <div id="dd-breakdown" class="text-xs text-slate-500 mt-2">--</div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 space-y-2 text-xs text-slate-600">
          <div class="flex justify-between">
            <span>Workdays (Mon-Fri):</span>
            <strong id="dd-workdays" class="text-slate-800">--</strong>
          </div>
          <div class="flex justify-between">
            <span>Weekend Days:</span>
            <strong id="dd-weekends" class="text-slate-800">--</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const startIn = document.getElementById('dd-start') as HTMLInputElement;
  const endIn = document.getElementById('dd-end') as HTMLInputElement;
  const includeEnd = document.getElementById('dd-include-end') as HTMLInputElement;
  const daysEl = document.getElementById('dd-days');
  const breakdownEl = document.getElementById('dd-breakdown');
  const workdaysEl = document.getElementById('dd-workdays');
  const weekendsEl = document.getElementById('dd-weekends');

  // Default dates: today and 30 days later
  const today = new Date();
  const future = new Date();
  future.setDate(today.getDate() + 30);
  if (startIn) startIn.value = today.toISOString().split('T')[0];
  if (endIn) endIn.value = future.toISOString().split('T')[0];

  function calculate() {
    if (!startIn.value || !endIn.value) return;
    const d1 = new Date(startIn.value);
    const d2 = new Date(endIn.value);

    let diffTime = d2.getTime() - d1.getTime();
    let diffDays = Math.round(diffTime / (1000 * 3600 * 24));
    if (includeEnd?.checked && diffDays >= 0) diffDays += 1;

    let workdays = 0;
    let weekends = 0;
    const curr = new Date(d1);
    const end = new Date(d2);
    if (includeEnd?.checked) end.setDate(end.getDate() + 1);

    while (curr < end) {
      const day = curr.getDay();
      if (day === 0 || day === 6) weekends++;
      else workdays++;
      curr.setDate(curr.getDate() + 1);
    }

    const weeks = Math.floor(diffDays / 7);
    const remDays = diffDays % 7;

    if (daysEl) daysEl.textContent = diffDays + ' days';
    if (breakdownEl) breakdownEl.textContent = weeks + ' weeks' + (remDays > 0 ? ' and ' + remDays + ' days' : '');
    if (workdaysEl) workdaysEl.textContent = workdays + ' days';
    if (weekendsEl) weekendsEl.textContent = weekends + ' days';
  }


  document.getElementById('dd-calc-btn')?.addEventListener('click', calculate);
</script>