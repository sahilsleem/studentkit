---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Enter Integer (n &gt; 1)</label>
          <input type="number" id="pf-num" min="2" max="100000000" placeholder="e.g. 360" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <button id="pf-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Factorize Integer
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Prime Factorization</div>
          <div id="pf-exp" class="text-3xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div id="pf-list" class="text-xs text-slate-muted mt-1">Factors: 2, 2, 2, 3, 3, 5</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 space-y-1.5 text-xs text-slate-muted">
          <div class="flex flex-wrap justify-between gap-2">
            <span>Total Divisors:</span>
            <strong id="pf-div-count" class="text-ink">24 divisors</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function factorize() {
    let n = parseInt((document.getElementById('pf-num') as HTMLInputElement)?.value || '2', 10);
    if (n < 2) return;

    const factors: Record<number, number> = {};
    const flatList: number[] = [];
    let d = 2;

    while (d * d <= n) {
      while (n % d === 0) {
        factors[d] = (factors[d] || 0) + 1;
        flatList.push(d);
        n /= d;
      }
      d++;
    }
    if (n > 1) {
      factors[n] = (factors[n] || 0) + 1;
      flatList.push(n);
    }

    const expStr = Object.entries(factors).map(([p, e]) => e === 1 ? p : p + '^' + e).join(' × ');

    let divisorCount = 1;
    for (const e of Object.values(factors)) {
      divisorCount *= (e + 1);
    }

    const expEl = document.getElementById('pf-exp');
    const listEl = document.getElementById('pf-list');
    const divCountEl = document.getElementById('pf-div-count');

    if (expEl) expEl.textContent = expStr;
    if (listEl) listEl.textContent = 'Factors: ' + flatList.join(', ');
    if (divCountEl) divCountEl.textContent = divisorCount + ' divisors';
  }

  document.getElementById('pf-num')?.addEventListener('input', factorize);
  document.getElementById('pf-calc-btn')?.addEventListener('click', factorize);
  factorize();
</script>