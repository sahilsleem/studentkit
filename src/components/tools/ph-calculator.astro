---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Hydrogen Ion [H+] (mol/L)</label>
          <input type="text" id="ph-h" placeholder="e.g. 1e-7" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm font-mono" />
        </div>

        <button id="ph-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate pH & pOH
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Calculated pH (-log [H+])</div>
          <div id="ph-val" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
          <div id="ph-nature" class="text-xs text-emerald-600 font-semibold mt-2">Neutral Solution</div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 space-y-2 text-xs text-slate-600">
          <div class="flex justify-between">
            <span>pOH (14 - pH):</span>
            <strong id="ph-poh" class="text-slate-800 font-mono">7.00</strong>
          </div>
          <div class="flex justify-between">
            <span>Hydroxide [OH-]:</span>
            <strong id="ph-oh" class="text-slate-800 font-mono">1.00 × 10⁻⁷ M</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const h = parseFloat((document.getElementById('ph-h') as HTMLInputElement)?.value || '1e-7');
    if (h <= 0) return;

    const ph = -Math.log10(h);
    const poh = 14 - ph;
    const oh = Math.pow(10, -poh);

    document.getElementById('ph-val')!.textContent = ph.toFixed(2);
    document.getElementById('ph-poh')!.textContent = poh.toFixed(2);
    document.getElementById('ph-oh')!.textContent = oh.toExponential(2) + ' M';

    const natEl = document.getElementById('ph-nature');
    if (natEl) {
      if (ph < 6.8) { natEl.textContent = 'Acidic Solution'; natEl.className = 'text-xs text-rose-600 font-semibold mt-2'; }
      else if (ph > 7.2) { natEl.textContent = 'Basic / Alkaline Solution'; natEl.className = 'text-xs text-blue-600 font-semibold mt-2'; }
      else { natEl.textContent = 'Neutral Solution'; natEl.className = 'text-xs text-emerald-600 font-semibold mt-2'; }
    }
  }


  document.getElementById('ph-calc-btn')?.addEventListener('click', calculate);
</script>