---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Hydrogen Ion [H+] (mol/L)</label>
          <input type="text" id="ph-h" placeholder="e.g. 1e-7" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm font-mono" />
        </div>

        <button id="ph-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate pH & pOH
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Calculated pH (-log [H+])</div>
          <div id="ph-val" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div id="ph-nature" class="text-xs text-emerald-600 font-semibold mt-1">Neutral Solution</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 space-y-1.5 text-xs text-slate-muted">
          <div class="flex flex-wrap justify-between gap-2">
            <span>pOH (14 - pH):</span>
            <strong id="ph-poh" class="text-ink font-mono break-words">7.00</strong>
          </div>
          <div class="flex flex-wrap justify-between gap-2">
            <span>Hydroxide [OH-]:</span>
            <strong id="ph-oh" class="text-ink font-mono break-words">1.00 × 10⁻⁷ M</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const h = parseFloat((document.getElementById('ph-h') as HTMLInputElement)?.value || '1e-7');
    if (h <= 0) return;

    const ph = -Math.log10(h);
    const poh = 14 - ph;
    const oh = Math.pow(10, -poh);

    document.getElementById('ph-val')!.textContent = ph.toFixed(2);
    document.getElementById('ph-poh')!.textContent = poh.toFixed(2);
    document.getElementById('ph-oh')!.textContent = oh.toExponential(2) + ' M';

    const natEl = document.getElementById('ph-nature');
    if (natEl) {
      if (ph < 6.8) { natEl.textContent = 'Acidic Solution'; natEl.className = 'text-xs text-rose-600 font-semibold mt-1'; }
      else if (ph > 7.2) { natEl.textContent = 'Basic / Alkaline Solution'; natEl.className = 'text-xs text-brand font-semibold mt-1'; }
      else { natEl.textContent = 'Neutral Solution'; natEl.className = 'text-xs text-emerald-600 font-semibold mt-1'; }
    }
  }


  document.getElementById('ph-calc-btn')?.addEventListener('click', calculate);
</script>