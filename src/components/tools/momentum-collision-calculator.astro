---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="p-4 bg-slate-50 rounded-xl border border-slate-200/80 space-y-2">
          <span class="text-xs font-bold text-slate-500">Object 1</span>
          <div>
            <label class="block text-xs text-slate-500 mb-1">Mass (m₁ in kg)</label>
            <input type="number" id="mc-m1" placeholder="e.g. 2" class="w-full px-3 py-1.5 bg-white border border-slate-200 rounded-lg text-sm" />
          </div>
          <div>
            <label class="block text-xs text-slate-500 mb-1">Initial Velocity (u₁ in m/s)</label>
            <input type="number" id="mc-u1" placeholder="e.g. 5" class="w-full px-3 py-1.5 bg-white border border-slate-200 rounded-lg text-sm" />
          </div>
        </div>

        <div class="p-4 bg-slate-50 rounded-xl border border-slate-200/80 space-y-2">
          <span class="text-xs font-bold text-slate-500">Object 2</span>
          <div>
            <label class="block text-xs text-slate-500 mb-1">Mass (m₂ in kg)</label>
            <input type="number" id="mc-m2" placeholder="e.g. 3" class="w-full px-3 py-1.5 bg-white border border-slate-200 rounded-lg text-sm" />
          </div>
          <div>
            <label class="block text-xs text-slate-500 mb-1">Initial Velocity (u₂ in m/s)</label>
            <input type="number" id="mc-u2" placeholder="e.g. -2" class="w-full px-3 py-1.5 bg-white border border-slate-200 rounded-lg text-sm" />
          </div>
        </div>
      </div>

      <button id="mc-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
        Calculate Elastic & Inelastic Collisions
      </button>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-6">
        <div class="p-5 bg-slate-50 rounded-xl border border-slate-200/80">
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Elastic Post-Collision Velocities</div>
          <div id="mc-elastic" class="text-2xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
        </div>

        <div class="p-5 bg-slate-50 rounded-xl border border-slate-200/80">
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Perfect Inelastic (Stick Together)</div>
          <div id="mc-inelastic" class="text-2xl font-extrabold text-slate-800 mt-2 font-mono">v = +0.80 m/s</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const m1 = parseFloat((document.getElementById('mc-m1') as HTMLInputElement)?.value || '1');
    const u1 = parseFloat((document.getElementById('mc-u1') as HTMLInputElement)?.value || '0');
    const m2 = parseFloat((document.getElementById('mc-m2') as HTMLInputElement)?.value || '1');
    const u2 = parseFloat((document.getElementById('mc-u2') as HTMLInputElement)?.value || '0');

    // Elastic 1D
    const v1 = ((m1 - m2) / (m1 + m2)) * u1 + ((2 * m2) / (m1 + m2)) * u2;
    const v2 = ((2 * m1) / (m1 + m2)) * u1 + ((m2 - m1) / (m1 + m2)) * u2;

    // Perfectly inelastic
    const vInelastic = (m1 * u1 + m2 * u2) / (m1 + m2);

    document.getElementById('mc-elastic')!.textContent = 'v₁ = ' + v1.toFixed(2) + ' m/s  |  v₂ = ' + v2.toFixed(2) + ' m/s';
    document.getElementById('mc-inelastic')!.textContent = 'v = ' + vInelastic.toFixed(2) + ' m/s';
  }


  document.getElementById('mc-calc-btn')?.addEventListener('click', calculate);
</script>