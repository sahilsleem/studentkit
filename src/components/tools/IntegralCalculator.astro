---
import { tools } from '../../data/registry';
const { tool } = Astro.props;

let mode = 'definite';
if (tool.slug.includes('indefinite')) mode = 'indefinite';
---

<div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden max-w-3xl mx-auto">
  <div class="p-6 sm:p-8">
    <div class="mb-6 border-b border-gray-100 pb-4">
      {mode !== 'indefinite' && (
        <div class="mt-3 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-50 text-emerald-700 text-xs font-medium border border-emerald-100">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          Uses composite Simpson's 1/3 rule for numerical precision.
        </div>
      )}
    </div>

    {mode === 'indefinite' ? (
      <div class="bg-amber-50 border border-amber-200 text-amber-800 p-6 rounded-lg text-center mb-6">
        <svg class="w-12 h-12 mx-auto mb-3 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
        </svg>
        <h2 class="text-xl font-semibold mb-2">Symbolic Integration Not Supported</h2>
        <p class="text-sm mb-4">Calculators that evaluate indefinite integrals symbolically require massive Computer Algebra Systems (CAS) which are too heavy to run offline in the browser.</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
           <a href="/tools/definite-integral-calculator" class="bg-white px-4 py-2 rounded border border-amber-300 font-medium hover:bg-amber-100 transition-colors">Use Definite Integral Calculator</a>
           <a href="/tools/integration-rules" class="bg-white px-4 py-2 rounded border border-amber-300 font-medium hover:bg-amber-100 transition-colors">View Integration Rules</a>
        </div>
      </div>
    ) : (
      <form id="integral-form" class="space-y-6">
        <div class="flex items-center gap-4">
          <div class="flex flex-col items-center gap-1 w-20">
            <input type="number" step="any" id="int-b" required class="w-16 p-2 border border-gray-300 rounded text-center text-sm focus:ring-emerald-500" placeholder="b">
            <div class="text-4xl font-light text-gray-400">∫</div>
            <input type="number" step="any" id="int-a" required class="w-16 p-2 border border-gray-300 rounded text-center text-sm focus:ring-emerald-500" placeholder="a">
          </div>
          
          <div class="flex-1">
            <label class="block text-sm font-medium text-gray-700 mb-2">Function f(x)</label>
            <div class="flex items-center gap-2">
              <input type="text" id="fn-expr" required class="w-full p-3 border border-gray-300 rounded-lg focus:ring-emerald-500 font-mono text-lg" placeholder="x^2 + 2x">
              <span class="font-mono text-gray-500 font-bold text-lg mt-1">dx</span>
            </div>
          </div>
        </div>

        <div class="pt-4">
          <button type="submit" class="w-full bg-emerald-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors">
            Evaluate Integral
          </button>
        </div>
      </form>
    )}

    <div id="integral-result" class="mt-8 pt-6 border-t border-gray-100 hidden">
      <h3 class="text-lg font-semibold mb-3">Result</h3>
      
      <div id="integral-err" class="hidden bg-red-50 text-red-700 p-4 rounded-lg text-sm font-medium border border-red-100 mb-4"></div>
      
      <div id="integral-ans" class="bg-gray-50 p-6 rounded-xl border border-gray-200 overflow-x-auto text-center">
        <div class="text-gray-500 font-mono text-sm mb-2" id="ans-label"></div>
        <div class="text-3xl font-bold font-mono text-gray-900" id="ans-val"></div>
      </div>
    </div>
  </div>
</div>

<script>
  import * as math from 'mathjs';

  const initIntegral = () => {
    const form = document.getElementById('integral-form');
    const exprIn = document.getElementById('fn-expr');
    const aIn = document.getElementById('int-a');
    const bIn = document.getElementById('int-b');
    
    const resSec = document.getElementById('integral-result');
    const errBox = document.getElementById('integral-err');
    const ansBox = document.getElementById('integral-ans');
    const ansLabel = document.getElementById('ans-label');
    const ansVal = document.getElementById('ans-val');

    if (!form) return;

    const cleanExpr = (str) => str.replace(/(\d)([a-zA-Z])/g, '$1*$2');

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      errBox.classList.add('hidden');
      ansBox.classList.remove('hidden');

      let expr = cleanExpr((exprIn as HTMLInputElement).value);
      let a = parseFloat((aIn as HTMLInputElement).value);
      let b = parseFloat((bIn as HTMLInputElement).value);

      if (a === b) {
        ansLabel.textContent = `∫ [ ${expr} ] dx from ${a} to ${b} =`;
        ansVal.textContent = '0';
        resSec.classList.remove('hidden');
        return;
      }

      try {
        const code = math.compile(expr);
        const f = (x) => code.evaluate({ x });
        
        // Simpson's 1/3 Rule
        const n = 10000; // Even number of intervals
        const h = (b - a) / n;
        
        let sum = f(a) + f(b);
        
        for (let i = 1; i < n; i++) {
           let x = a + i * h;
           sum += f(x) * (i % 2 === 0 ? 2 : 4);
        }
        
        const area = (h / 3) * sum;
        
        if (isNaN(area) || !isFinite(area)) {
           throw new Error("Integral diverges or hits an undefined asymptote (e.g. division by zero in domain).");
        }

        const fmt = (num) => Number.isInteger(num) ? num : parseFloat(num.toFixed(6));

        ansLabel.textContent = `∫ [ ${expr} ] dx from ${a} to ${b} =`;
        ansVal.textContent = String(fmt(area));

      } catch (err) {
        ansBox.classList.add('hidden');
        errBox.textContent = `Error evaluating integral: ${err.message}`;
        errBox.classList.remove('hidden');
      }

      resSec.classList.remove('hidden');
    });
  };

  initIntegral();
  document.addEventListener('astro:page-load', initIntegral);
</script>
