<div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden mb-12 max-w-4xl mx-auto">
  <div class="p-6 sm:p-8">
    <div class="mb-6">
      <h2 class="text-xl font-bold text-gray-900 mb-2">Compound Interest Calculator</h2>
      <p class="text-sm text-gray-600">Calculate investment growth with compound interest, regular monthly/annual contributions, and compounding frequencies.</p>
    </div>

    <form id="ci-form" class="space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <!-- Initial Principal -->
        <div>
          <label for="ci-principal" class="block text-sm font-semibold text-gray-800 mb-1">
            Initial Principal ($ / ₹ / €)
          </label>
          <div class="relative">
            <input
              type="number"
              id="ci-principal"
              min="0"
              step="any"
              value="10000"
              required
              inputmode="decimal"
              class="block w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-base font-medium text-gray-900"
              placeholder="10000"
            />
          </div>
        </div>

        <!-- Annual Interest Rate -->
        <div>
          <label for="ci-rate" class="block text-sm font-semibold text-gray-800 mb-1">
            Annual Interest Rate (%)
          </label>
          <div class="relative">
            <input
              type="number"
              id="ci-rate"
              min="0"
              max="1000"
              step="any"
              value="7"
              required
              inputmode="decimal"
              class="block w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-base font-medium text-gray-900"
              placeholder="7.5"
            />
          </div>
        </div>

        <!-- Regular Contribution -->
        <div>
          <label for="ci-pmt" class="block text-sm font-semibold text-gray-800 mb-1">
            Regular Contribution Amount
          </label>
          <div class="relative">
            <input
              type="number"
              id="ci-pmt"
              min="0"
              step="any"
              value="200"
              inputmode="decimal"
              class="block w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-base font-medium text-gray-900"
              placeholder="200"
            />
          </div>
        </div>

        <!-- Contribution Frequency & Timing -->
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label for="ci-pmt-freq" class="block text-sm font-semibold text-gray-800 mb-1">
              Deposit Frequency
            </label>
            <select id="ci-pmt-freq" class="block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-xl text-sm text-gray-800 focus:ring-emerald-500 focus:border-emerald-500">
              <option value="12" selected>Monthly</option>
              <option value="1">Annually</option>
              <option value="0">None (0)</option>
            </select>
          </div>
          <div>
            <label for="ci-pmt-timing" class="block text-sm font-semibold text-gray-800 mb-1">
              Deposit Timing
            </label>
            <select id="ci-pmt-timing" class="block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-xl text-sm text-gray-800 focus:ring-emerald-500 focus:border-emerald-500">
              <option value="end" selected>End of Period</option>
              <option value="beginning">Start of Period</option>
            </select>
          </div>
        </div>

        <!-- Time Horizon -->
        <div>
          <label for="ci-time" class="block text-sm font-semibold text-gray-800 mb-1">
            Investment Duration (Years)
          </label>
          <div class="relative">
            <input
              type="number"
              id="ci-time"
              min="0.01"
              max="100"
              step="any"
              value="10"
              required
              inputmode="decimal"
              class="block w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-base font-medium text-gray-900"
              placeholder="10"
            />
          </div>
        </div>

        <!-- Compounding Frequency -->
        <div>
          <label for="ci-compound-freq" class="block text-sm font-semibold text-gray-800 mb-1">
            Compounding Frequency
          </label>
          <select id="ci-compound-freq" class="block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-xl text-base text-gray-800 focus:ring-emerald-500 focus:border-emerald-500">
            <option value="12" selected>Monthly (12/yr)</option>
            <option value="1">Annually (1/yr)</option>
            <option value="2">Semi-Annually (2/yr)</option>
            <option value="4">Quarterly (4/yr)</option>
            <option value="365">Daily (365/yr)</option>
            <option value="continuous">Continuously</option>
          </select>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row gap-3 pt-2">
        <button type="submit" class="flex-1 bg-emerald-600 text-white px-6 py-3 rounded-xl font-semibold hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors shadow-sm min-h-[44px]">
          Calculate Growth
        </button>
        <button type="button" id="reset-btn" class="px-6 py-3 border border-gray-300 rounded-xl text-gray-700 font-semibold hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors min-h-[44px]">
          Reset
        </button>
      </div>
    </form>

    <div id="error-box" class="hidden mt-6 bg-red-50 text-red-700 p-4 rounded-xl text-sm font-medium border border-red-200"></div>

    <!-- Results Section -->
    <div id="result-section" class="mt-8 pt-8 border-t border-gray-100" aria-live="polite">
      <!-- Main Highlight Balance Card -->
      <div class="bg-gradient-to-br from-emerald-50 to-teal-50 border border-emerald-200/80 rounded-2xl p-6 sm:p-8 text-center relative mb-6">
        <div class="flex justify-end absolute top-4 right-4">
          <button
            type="button"
            id="copy-result-btn"
            class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg bg-white/90 hover:bg-white text-emerald-800 border border-emerald-200 shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-emerald-500 min-h-[36px]"
            title="Copy final balance"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
            <span>Copy Result</span>
          </button>
        </div>
        <p class="text-sm font-semibold uppercase tracking-wider text-emerald-800 mb-1">Estimated Future Value</p>
        <div id="ci-total-balance" class="text-4xl sm:text-5xl font-extrabold text-emerald-950 my-2">$52,389.14</div>
        <p id="ci-summary-sub" class="text-sm text-emerald-700 font-medium">After 10 years with regular contributions</p>
      </div>

      <!-- Financial Breakdown Summary -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
        <div class="bg-gray-50 rounded-xl p-5 border border-gray-200/70 text-center">
          <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Starting Principal</p>
          <div id="ci-stat-principal" class="text-xl font-bold text-gray-900">$10,000.00</div>
        </div>
        <div class="bg-gray-50 rounded-xl p-5 border border-gray-200/70 text-center">
          <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Total Additional Deposits</p>
          <div id="ci-stat-deposits" class="text-xl font-bold text-gray-900">$24,000.00</div>
        </div>
        <div class="bg-gray-50 rounded-xl p-5 border border-gray-200/70 text-center">
          <p class="text-xs font-semibold uppercase tracking-wider text-emerald-700 mb-1">Total Interest Earned</p>
          <div id="ci-stat-interest" class="text-xl font-bold text-emerald-600">$18,389.14</div>
        </div>
      </div>

      <!-- Visual Distribution Bar -->
      <div class="mb-8">
        <div class="flex justify-between text-xs font-medium text-gray-600 mb-1.5">
          <span id="label-principal-pct">Principal Contributed (64.9%)</span>
          <span id="label-interest-pct" class="text-emerald-700 font-semibold">Interest Earned (35.1%)</span>
        </div>
        <div class="w-full bg-gray-200 h-3.5 rounded-full overflow-hidden flex">
          <div id="bar-principal" class="bg-blue-600 h-full transition-all duration-300" style="width: 64.9%"></div>
          <div id="bar-interest" class="bg-emerald-500 h-full transition-all duration-300" style="width: 35.1%"></div>
        </div>
      </div>

      <!-- Annual Growth Schedule Table -->
      <div>
        <h3 class="text-base font-bold text-gray-900 mb-3">Annual Growth Schedule</h3>
        <div class="overflow-x-auto rounded-xl border border-gray-200 max-h-96">
          <table class="w-full text-left text-sm text-gray-600">
            <thead class="bg-gray-50 text-xs font-semibold uppercase text-gray-700 sticky top-0 border-b border-gray-200">
              <tr>
                <th class="px-4 py-3">Year</th>
                <th class="px-4 py-3">Starting Balance</th>
                <th class="px-4 py-3">Annual Deposits</th>
                <th class="px-4 py-3">Interest Earned</th>
                <th class="px-4 py-3">End Balance</th>
              </tr>
            </thead>
            <tbody id="ci-table-body" class="divide-y divide-gray-100 bg-white">
              <!-- Dynamically populated rows -->
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { copyToClipboard } from '../../utils/formatters';

  const initCompoundInterest = () => {
    const form = document.getElementById('ci-form') as HTMLFormElement;
    const principalInput = document.getElementById('ci-principal') as HTMLInputElement;
    const rateInput = document.getElementById('ci-rate') as HTMLInputElement;
    const pmtInput = document.getElementById('ci-pmt') as HTMLInputElement;
    const pmtFreqSelect = document.getElementById('ci-pmt-freq') as HTMLSelectElement;
    const pmtTimingSelect = document.getElementById('ci-pmt-timing') as HTMLSelectElement;
    const timeInput = document.getElementById('ci-time') as HTMLInputElement;
    const compoundFreqSelect = document.getElementById('ci-compound-freq') as HTMLSelectElement;
    const resetBtn = document.getElementById('reset-btn');
    const copyBtn = document.getElementById('copy-result-btn');
    const errorBox = document.getElementById('error-box');

    const totalBalanceEl = document.getElementById('ci-total-balance');
    const summarySubEl = document.getElementById('ci-summary-sub');
    const statPrincipalEl = document.getElementById('ci-stat-principal');
    const statDepositsEl = document.getElementById('ci-stat-deposits');
    const statInterestEl = document.getElementById('ci-stat-interest');
    const labelPrincipalPct = document.getElementById('label-principal-pct');
    const labelInterestPct = document.getElementById('label-interest-pct');
    const barPrincipal = document.getElementById('bar-principal');
    const barInterest = document.getElementById('bar-interest');
    const tableBody = document.getElementById('ci-table-body');

    if (!form || !principalInput) return;

    const formatCurrency = (val: number): string => {
      if (isNaN(val) || !isFinite(val)) return '0.00';
      return val.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    };

    const calculate = () => {
      errorBox?.classList.add('hidden');

      const P = parseFloat(principalInput.value);
      const annualRatePct = parseFloat(rateInput.value);
      let PMT = parseFloat(pmtInput.value) || 0;
      const pmtFreq = parseInt(pmtFreqSelect.value, 10);
      const pmtTiming = pmtTimingSelect.value || 'end';
      const tYears = parseFloat(timeInput.value);
      const compoundFreqStr = compoundFreqSelect.value;

      if (isNaN(P) || P < 0 || isNaN(annualRatePct) || annualRatePct < 0 || isNaN(tYears) || tYears <= 0) {
        if (errorBox) {
          errorBox.textContent = 'Please provide valid positive values for Principal, Rate, and Time.';
          errorBox.classList.remove('hidden');
        }
        return;
      }

      if (pmtFreq === 0) PMT = 0;

      const r = annualRatePct / 100;

      // Effective monthly growth factor based on compounding frequency
      let monthlyGrowthFactor = 1;
      if (compoundFreqStr === 'continuous') {
        monthlyGrowthFactor = Math.exp(r / 12);
      } else {
        const n = parseFloat(compoundFreqStr);
        monthlyGrowthFactor = Math.pow(1 + r / n, n / 12);
      }

      const totalMonths = Math.max(1, Math.round(tYears * 12));
      let currentBalance = P;
      let totalDeposited = 0;
      let tableRowsHtml = '';

      let yearStartBalance = P;
      let yearDeposits = 0;
      let yearInterest = 0;
      let simulatedBalance = P;

      for (let m = 1; m <= totalMonths; m++) {
        let depositThisMonth = 0;
        if (pmtFreq === 12) {
          depositThisMonth = PMT;
        } else if (pmtFreq === 1 && m % 12 === 1) {
          depositThisMonth = PMT;
        }

        if (pmtTiming === 'beginning') {
          simulatedBalance += depositThisMonth;
          totalDeposited += depositThisMonth;
          yearDeposits += depositThisMonth;

          const interestThisMonth = simulatedBalance * (monthlyGrowthFactor - 1);
          simulatedBalance += interestThisMonth;
          yearInterest += interestThisMonth;
        } else {
          // Standard end of period
          const interestThisMonth = simulatedBalance * (monthlyGrowthFactor - 1);
          simulatedBalance += interestThisMonth;
          yearInterest += interestThisMonth;

          simulatedBalance += depositThisMonth;
          totalDeposited += depositThisMonth;
          yearDeposits += depositThisMonth;
        }

        if (m % 12 === 0 || m === totalMonths) {
          const yearNum = Math.ceil(m / 12);
          tableRowsHtml += `
            <tr class="hover:bg-gray-50/80">
              <td class="px-4 py-2.5 font-semibold text-gray-900">${yearNum}</td>
              <td class="px-4 py-2.5">$${formatCurrency(yearStartBalance)}</td>
              <td class="px-4 py-2.5">$${formatCurrency(yearDeposits)}</td>
              <td class="px-4 py-2.5 text-emerald-700 font-medium">+$${formatCurrency(yearInterest)}</td>
              <td class="px-4 py-2.5 font-bold text-gray-900">$${formatCurrency(simulatedBalance)}</td>
            </tr>
          `;
          yearStartBalance = simulatedBalance;
          yearDeposits = 0;
          yearInterest = 0;
        }
      }

      const finalBalance = simulatedBalance;
      const totalPrincipalInvested = P + totalDeposited;
      const totalInterestEarned = Math.max(0, finalBalance - totalPrincipalInvested);

      const principalPct = finalBalance > 0 ? (totalPrincipalInvested / finalBalance) * 100 : 100;
      const interestPct = finalBalance > 0 ? (totalInterestEarned / finalBalance) * 100 : 0;

      if (totalBalanceEl) totalBalanceEl.textContent = `$${formatCurrency(finalBalance)}`;
      if (summarySubEl) summarySubEl.textContent = `After ${tYears} ${tYears === 1 ? 'year' : 'years'} at ${annualRatePct}% annual rate (${pmtTiming === 'beginning' ? 'Beginning of Period' : 'End of Period'} deposits)`;
      if (statPrincipalEl) statPrincipalEl.textContent = `$${formatCurrency(P)}`;
      if (statDepositsEl) statDepositsEl.textContent = `$${formatCurrency(totalDeposited)}`;
      if (statInterestEl) statInterestEl.textContent = `$${formatCurrency(totalInterestEarned)}`;

      if (labelPrincipalPct) labelPrincipalPct.textContent = `Principal (${principalPct.toFixed(1)}%)`;
      if (labelInterestPct) labelInterestPct.textContent = `Interest Earned (${interestPct.toFixed(1)}%)`;
      if (barPrincipal) barPrincipal.style.width = `${Math.min(100, Math.max(0, principalPct))}%`;
      if (barInterest) barInterest.style.width = `${Math.min(100, Math.max(0, interestPct))}%`;

      if (tableBody) tableBody.innerHTML = tableRowsHtml;
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      calculate();
    });

    principalInput.addEventListener('input', calculate);
    rateInput.addEventListener('input', calculate);
    pmtInput.addEventListener('input', calculate);
    pmtFreqSelect.addEventListener('change', calculate);
    pmtTimingSelect.addEventListener('change', calculate);
    timeInput.addEventListener('input', calculate);
    compoundFreqSelect.addEventListener('change', calculate);

    resetBtn?.addEventListener('click', () => {
      principalInput.value = '10000';
      rateInput.value = '7';
      pmtInput.value = '200';
      pmtFreqSelect.value = '12';
      pmtTimingSelect.value = 'end';
      timeInput.value = '10';
      compoundFreqSelect.value = '12';
      calculate();
    });

    copyBtn?.addEventListener('click', async () => {
      const text = totalBalanceEl?.textContent || '';
      const success = await copyToClipboard(text);
      if (success) {
        const span = copyBtn.querySelector('span');
        if (span) {
          const original = span.textContent;
          span.textContent = 'Copied!';
          setTimeout(() => { span.textContent = original; }, 1500);
        }
      }
    });

    calculate();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCompoundInterest);
  } else {
    initCompoundInterest();
  }
</script>
