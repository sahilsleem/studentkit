---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Marks Obtained</label>
          <input type="number" id="mp-obtained" step="0.5" min="0" placeholder="e.g. 435" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Total Maximum Marks</label>
          <input type="number" id="mp-total" step="1" min="1" placeholder="e.g. 500" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <button id="mp-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Percentage
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Calculated Percentage</div>
          <div id="mp-result" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
          <div id="mp-fraction" class="text-xs text-slate-500 mt-2">Fraction: 435 / 500 = 0.87</div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 space-y-2 text-xs text-slate-600">
          <div class="flex justify-between">
            <span>Performance Division:</span>
            <strong id="mp-division" class="text-emerald-600 font-semibold">First Division / Distinction</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const obtIn = document.getElementById('mp-obtained') as HTMLInputElement;
  const totIn = document.getElementById('mp-total') as HTMLInputElement;
  const resEl = document.getElementById('mp-result');
  const fracEl = document.getElementById('mp-fraction');
  const divEl = document.getElementById('mp-division');

  function calculate() {
    const obt = parseFloat(obtIn?.value || '0');
    const tot = parseFloat(totIn?.value || '1');

    if (tot <= 0) return;
    const pct = (obt / tot) * 100;

    if (resEl) resEl.textContent = pct.toFixed(2) + '%';
    if (fracEl) fracEl.textContent = 'Fraction: ' + obt + ' / ' + tot + ' = ' + (obt / tot).toFixed(4);

    let classification = 'Pass';
    if (pct >= 75) classification = 'First Division with Distinction';
    else if (pct >= 60) classification = 'First Division';
    else if (pct >= 50) classification = 'Second Division';
    else if (pct >= 35) classification = 'Third Division / Pass';
    else classification = 'Fail';

    if (divEl) divEl.textContent = classification;
  }


  document.getElementById('mp-calc-btn')?.addEventListener('click', calculate);
</script>