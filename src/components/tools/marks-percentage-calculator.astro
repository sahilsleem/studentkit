---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Marks Obtained</label>
          <input type="number" id="mp-obtained" step="0.5" min="0" placeholder="e.g. 435" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Total Maximum Marks</label>
          <input type="number" id="mp-total" step="1" min="1" placeholder="e.g. 500" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <button id="mp-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Percentage
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Calculated Percentage</div>
          <div id="mp-result" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div id="mp-fraction" class="text-xs text-slate-muted mt-1">Fraction: 435 / 500 = 0.87</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 space-y-1.5 text-xs text-slate-muted">
          <div class="flex flex-wrap justify-between gap-2">
            <span>Performance Division:</span>
            <strong id="mp-division" class="text-emerald-600 font-semibold">First Division / Distinction</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const obtIn = document.getElementById('mp-obtained') as HTMLInputElement;
  const totIn = document.getElementById('mp-total') as HTMLInputElement;
  const resEl = document.getElementById('mp-result');
  const fracEl = document.getElementById('mp-fraction');
  const divEl = document.getElementById('mp-division');

  function calculate() {
    const obt = parseFloat(obtIn?.value || '0');
    const tot = parseFloat(totIn?.value || '1');

    if (tot <= 0) return;
    const pct = (obt / tot) * 100;

    if (resEl) resEl.textContent = pct.toFixed(2) + '%';
    if (fracEl) fracEl.textContent = 'Fraction: ' + obt + ' / ' + tot + ' = ' + (obt / tot).toFixed(4);

    let classification = 'Pass';
    if (pct >= 75) classification = 'First Division with Distinction';
    else if (pct >= 60) classification = 'First Division';
    else if (pct >= 50) classification = 'Second Division';
    else if (pct >= 35) classification = 'Third Division / Pass';
    else classification = 'Fail';

    if (divEl) divEl.textContent = classification;
  }


  document.getElementById('mp-calc-btn')?.addEventListener('click', calculate);
</script>