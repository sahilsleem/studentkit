---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-muted mb-3">Monthly Income & Allowances</h3>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs text-slate-muted mb-1">Scholarship / Aid (₹)</label>
              <input type="number" id="sb-aid" placeholder="e.g. 800" class="w-full px-3 py-2 bg-page border border-border-line rounded-lg text-sm text-ink" />
            </div>
            <div>
              <label class="block text-xs text-slate-muted mb-1">Part-Time Job (₹)</label>
              <input type="number" id="sb-job" placeholder="e.g. 650" class="w-full px-3 py-2 bg-page border border-border-line rounded-lg text-sm text-ink" />
            </div>
          </div>
        </div>

        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-muted mb-3">Monthly Expenses</h3>
          <div class="space-y-2">
            <div class="flex justify-between items-center gap-2">
              <label class="text-xs text-slate-muted">Rent & Housing</label>
              <input type="number" id="sb-rent" placeholder="e.g. 650" class="w-28 px-3 py-1.5 bg-page border border-border-line rounded-lg text-sm text-ink" />
            </div>
            <div class="flex justify-between items-center gap-2">
              <label class="text-xs text-slate-muted">Food & Groceries</label>
              <input type="number" id="sb-food" placeholder="e.g. 300" class="w-28 px-3 py-1.5 bg-page border border-border-line rounded-lg text-sm text-ink" />
            </div>
            <div class="flex justify-between items-center gap-2">
              <label class="text-xs text-slate-muted">Books & Courseware</label>
              <input type="number" id="sb-books" placeholder="e.g. 80" class="w-28 px-3 py-1.5 bg-page border border-border-line rounded-lg text-sm text-ink" />
            </div>
            <div class="flex justify-between items-center gap-2">
              <label class="text-xs text-slate-muted">Transportation</label>
              <input type="number" id="sb-transit" placeholder="e.g. 60" class="w-28 px-3 py-1.5 bg-page border border-border-line rounded-lg text-sm text-ink" />
            </div>
            <div class="flex justify-between items-center gap-2">
              <label class="text-xs text-slate-muted">Personal & Leisure</label>
              <input type="number" id="sb-leisure" placeholder="e.g. 120" class="w-28 px-3 py-1.5 bg-page border border-border-line rounded-lg text-sm text-ink" />
            </div>
          </div>
        </div>

        <button id="sb-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Monthly Budget
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Net Monthly Cashflow</div>
          <div id="sb-net" class="text-4xl font-extrabold text-emerald-600 mt-1 font-mono">--</div>
          <div id="sb-savings-rate" class="text-xs text-slate-muted mt-1">Savings rate appears here</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 space-y-1.5 text-xs text-slate-muted">
          <div class="flex flex-wrap justify-between gap-2">
            <span>Total Monthly Income:</span>
            <strong id="sb-tot-income" class="text-ink">--</strong>
          </div>
          <div class="flex flex-wrap justify-between gap-2">
            <span>Total Monthly Expenses:</span>
            <strong id="sb-tot-expense" class="text-ink">--</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const inputs = ['sb-aid', 'sb-job', 'sb-rent', 'sb-food', 'sb-books', 'sb-transit', 'sb-leisure'];
  const netEl = document.getElementById('sb-net');
  const savingsRateEl = document.getElementById('sb-savings-rate');
  const totIncomeEl = document.getElementById('sb-tot-income');
  const totExpenseEl = document.getElementById('sb-tot-expense');

  function calculate() {
    const aid = parseFloat((document.getElementById('sb-aid') as HTMLInputElement)?.value || '0');
    const job = parseFloat((document.getElementById('sb-job') as HTMLInputElement)?.value || '0');
    const rent = parseFloat((document.getElementById('sb-rent') as HTMLInputElement)?.value || '0');
    const food = parseFloat((document.getElementById('sb-food') as HTMLInputElement)?.value || '0');
    const books = parseFloat((document.getElementById('sb-books') as HTMLInputElement)?.value || '0');
    const transit = parseFloat((document.getElementById('sb-transit') as HTMLInputElement)?.value || '0');
    const leisure = parseFloat((document.getElementById('sb-leisure') as HTMLInputElement)?.value || '0');

    const totalIncome = aid + job;
    const totalExpense = rent + food + books + transit + leisure;
    const net = totalIncome - totalExpense;
    const savingsRate = totalIncome > 0 ? (net / totalIncome) * 100 : 0;

    const fmt = (v: number) => (v >= 0 ? '+₹' : '-₹') + Math.abs(v).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    if (netEl) {
      netEl.textContent = fmt(net);
      netEl.className = 'text-4xl font-extrabold mt-1 font-mono ' + (net >= 0 ? 'text-emerald-600' : 'text-rose-600');
    }
    if (savingsRateEl) savingsRateEl.textContent = savingsRate.toFixed(1) + '% monthly savings rate';
    if (totIncomeEl) totIncomeEl.textContent = '₹' + totalIncome.toFixed(2);
    if (totExpenseEl) totExpenseEl.textContent = '₹' + totalExpense.toFixed(2);
  }

  document.getElementById('sb-calc-btn')?.addEventListener('click', calculate);
</script>