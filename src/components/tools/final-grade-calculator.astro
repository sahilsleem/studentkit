---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Current Grade (%)</label>
          <input type="number" id="fg-current" step="0.1" min="0" max="100" placeholder="e.g. 82" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Desired Target Grade (%)</label>
          <input type="number" id="fg-target" step="0.1" min="0" max="100" placeholder="e.g. 85" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Final Exam Weight (%)</label>
          <input type="number" id="fg-weight" step="1" min="1" max="100" placeholder="e.g. 30" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <button id="fg-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Required Score
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Required Final Exam Score</div>
          <div id="fg-result" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
          <p id="fg-feasibility" class="text-xs text-emerald-600 font-medium mt-2">Achievable with dedicated preparation.</p>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 space-y-2 text-xs text-slate-600">
          <div class="flex justify-between">
            <span>Current Contribution:</span>
            <strong id="fg-curr-contrib">57.4%</strong>
          </div>
          <div class="flex justify-between">
            <span>Points Needed from Final:</span>
            <strong id="fg-needed-pts">27.6%</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const currentIn = document.getElementById('fg-current') as HTMLInputElement;
  const targetIn = document.getElementById('fg-target') as HTMLInputElement;
  const weightIn = document.getElementById('fg-weight') as HTMLInputElement;
  const resultEl = document.getElementById('fg-result');
  const feasEl = document.getElementById('fg-feasibility');
  const currContEl = document.getElementById('fg-curr-contrib');
  const neededPtsEl = document.getElementById('fg-needed-pts');

  function calculate() {
    const current = parseFloat(currentIn?.value || '0');
    const target = parseFloat(targetIn?.value || '0');
    const weight = parseFloat(weightIn?.value || '0');

    if (weight <= 0 || weight > 100) return;

    const currentWeight = (100 - weight) / 100;
    const finalWeight = weight / 100;
    const currentCont = current * currentWeight;
    const needed = (target - currentCont) / finalWeight;

    if (resultEl) resultEl.textContent = needed.toFixed(1) + '%';
    if (currContEl) currContEl.textContent = currentCont.toFixed(1) + '%';
    if (neededPtsEl) neededPtsEl.textContent = (target - currentCont).toFixed(1) + '%';

    if (feasEl) {
      if (needed <= 0) {
        feasEl.textContent = 'Target already achieved even with 0% on the final exam.';
        feasEl.className = 'text-xs text-emerald-600 font-medium mt-2';
      } else if (needed <= 80) {
        feasEl.textContent = 'Easily achievable with standard study.';
        feasEl.className = 'text-xs text-emerald-600 font-medium mt-2';
      } else if (needed <= 100) {
        feasEl.textContent = 'Achievable with dedicated preparation.';
        feasEl.className = 'text-xs text-amber-600 font-medium mt-2';
      } else {
        feasEl.textContent = 'Requires extra credit or over 100% to hit this target.';
        feasEl.className = 'text-xs text-rose-600 font-medium mt-2';
      }
    }
  }


  document.getElementById('fg-calc-btn')?.addEventListener('click', calculate);
</script>