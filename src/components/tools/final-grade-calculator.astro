---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Current Grade (%)</label>
          <input type="number" id="fg-current" step="0.1" min="0" max="100" placeholder="e.g. 82" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Desired Target Grade (%)</label>
          <input type="number" id="fg-target" step="0.1" min="0" max="100" placeholder="e.g. 85" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Final Exam Weight (%)</label>
          <input type="number" id="fg-weight" step="1" min="1" max="100" placeholder="e.g. 30" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <button id="fg-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Required Score
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Required Final Exam Score</div>
          <div id="fg-result" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <p id="fg-feasibility" class="text-xs text-emerald-600 font-medium mt-1">Achievable with dedicated preparation.</p>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 space-y-1.5 text-xs text-slate-muted">
          <div class="flex flex-wrap justify-between gap-2">
            <span>Current Contribution:</span>
            <strong id="fg-curr-contrib">57.4%</strong>
          </div>
          <div class="flex flex-wrap justify-between gap-2">
            <span>Points Needed from Final:</span>
            <strong id="fg-needed-pts">27.6%</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const currentIn = document.getElementById('fg-current') as HTMLInputElement;
  const targetIn = document.getElementById('fg-target') as HTMLInputElement;
  const weightIn = document.getElementById('fg-weight') as HTMLInputElement;
  const resultEl = document.getElementById('fg-result');
  const feasEl = document.getElementById('fg-feasibility');
  const currContEl = document.getElementById('fg-curr-contrib');
  const neededPtsEl = document.getElementById('fg-needed-pts');

  function calculate() {
    const current = parseFloat(currentIn?.value || '0');
    const target = parseFloat(targetIn?.value || '0');
    const weight = parseFloat(weightIn?.value || '0');

    if (weight <= 0 || weight > 100) return;

    const currentWeight = (100 - weight) / 100;
    const finalWeight = weight / 100;
    const currentCont = current * currentWeight;
    const needed = (target - currentCont) / finalWeight;

    if (resultEl) resultEl.textContent = needed.toFixed(1) + '%';
    if (currContEl) currContEl.textContent = currentCont.toFixed(1) + '%';
    if (neededPtsEl) neededPtsEl.textContent = (target - currentCont).toFixed(1) + '%';

    if (feasEl) {
      if (needed <= 0) {
        feasEl.textContent = 'Target already achieved even with 0% on the final exam.';
        feasEl.className = 'text-xs text-emerald-600 font-medium mt-1';
      } else if (needed <= 80) {
        feasEl.textContent = 'Easily achievable with standard study.';
        feasEl.className = 'text-xs text-emerald-600 font-medium mt-1';
      } else if (needed <= 100) {
        feasEl.textContent = 'Achievable with dedicated preparation.';
        feasEl.className = 'text-xs text-amber-600 font-medium mt-1';
      } else {
        feasEl.textContent = 'Requires extra credit or over 100% to hit this target.';
        feasEl.className = 'text-xs text-rose-600 font-medium mt-1';
      }
    }
  }


  document.getElementById('fg-calc-btn')?.addEventListener('click', calculate);
</script>