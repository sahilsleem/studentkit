<div class="bg-white rounded-3xl shadow-sm border border-gray-200 overflow-hidden mb-12">
      
      <!-- Setup Phase -->
      <div id="setup-phase" class="p-6 sm:p-8">
        <form id="countdown-form" class="space-y-6 max-w-lg mx-auto">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Exam Name</label>
            <input type="text" id="exam-name" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500" placeholder="e.g. Final Mathematics Exam">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Exam Date</label>
            <input type="date" id="exam-date" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Exam Time</label>
            <input type="time" id="exam-time" required value="09:00" class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500">
          </div>
          <button type="submit" class="w-full bg-emerald-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors shadow-sm">
            Start Countdown
          </button>
        </form>
      </div>

      <!-- Countdown Phase -->
      <div id="countdown-phase" class="hidden p-8 sm:p-12 text-center relative bg-emerald-900 text-white">
        <button id="edit-btn" class="absolute top-4 right-4 text-emerald-200 hover:text-white text-sm font-medium flex items-center gap-1 transition-colors bg-emerald-800/50 px-3 py-1.5 rounded-full">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
          Edit
        </button>
        
        <h2 id="display-name" class="text-2xl sm:text-3xl font-bold mb-2 text-emerald-50">Exam Name</h2>
        <p id="display-date" class="text-emerald-200 mb-10 font-medium">Date</p>
        
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-2xl mx-auto mb-8">
          <div class="bg-emerald-800/50 rounded-2xl p-4 backdrop-blur-sm border border-emerald-700/50">
            <div id="cd-days" class="text-4xl sm:text-6xl font-black tabular-nums tracking-tighter">00</div>
            <div class="text-emerald-200 text-sm font-medium uppercase tracking-wider mt-1">Days</div>
          </div>
          <div class="bg-emerald-800/50 rounded-2xl p-4 backdrop-blur-sm border border-emerald-700/50">
            <div id="cd-hours" class="text-4xl sm:text-6xl font-black tabular-nums tracking-tighter">00</div>
            <div class="text-emerald-200 text-sm font-medium uppercase tracking-wider mt-1">Hours</div>
          </div>
          <div class="bg-emerald-800/50 rounded-2xl p-4 backdrop-blur-sm border border-emerald-700/50">
            <div id="cd-minutes" class="text-4xl sm:text-6xl font-black tabular-nums tracking-tighter">00</div>
            <div class="text-emerald-200 text-sm font-medium uppercase tracking-wider mt-1">Minutes</div>
          </div>
          <div class="bg-emerald-800/50 rounded-2xl p-4 backdrop-blur-sm border border-emerald-700/50">
            <div id="cd-seconds" class="text-4xl sm:text-6xl font-black tabular-nums tracking-tighter">00</div>
            <div class="text-emerald-200 text-sm font-medium uppercase tracking-wider mt-1">Seconds</div>
          </div>
        </div>

        <div id="passed-message" class="hidden mt-8 py-4 px-6 bg-red-500/20 border border-red-500/50 rounded-xl text-red-100 font-medium max-w-md mx-auto">
          This exam date has already passed.
        </div>
      </div>
    </div>
  <script>
  const initCountdown = () => {
    const form = document.getElementById('countdown-form') as HTMLFormElement;
    const setupPhase = document.getElementById('setup-phase');
    const countdownPhase = document.getElementById('countdown-phase');
    const editBtn = document.getElementById('edit-btn');
    
    let timerId: number | null = null;

    if (!form) return;

    // Load from local storage if exists
    const saved = localStorage.getItem('studentkit_exam_countdown');
    if (saved) {
      const data = JSON.parse(saved);
      (document.getElementById('exam-name') as HTMLInputElement).value = data.name;
      (document.getElementById('exam-date') as HTMLInputElement).value = data.date;
      (document.getElementById('exam-time') as HTMLInputElement).value = data.time;
      startTimer(data.name, data.date, data.time);
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const name = (document.getElementById('exam-name') as HTMLInputElement).value;
      const date = (document.getElementById('exam-date') as HTMLInputElement).value;
      const time = (document.getElementById('exam-time') as HTMLInputElement).value;

      localStorage.setItem('studentkit_exam_countdown', JSON.stringify({ name, date, time }));
      startTimer(name, date, time);
    });

    editBtn?.addEventListener('click', () => {
      if (timerId) clearInterval(timerId);
      countdownPhase?.classList.add('hidden');
      setupPhase?.classList.remove('hidden');
    });

    function startTimer(name: string, dateStr: string, timeStr: string) {
      setupPhase?.classList.add('hidden');
      countdownPhase?.classList.remove('hidden');
      
      document.getElementById('display-name')!.textContent = name;
      
      const targetDate = new Date(`${dateStr}T${timeStr}`);
      
      document.getElementById('display-date')!.textContent = targetDate.toLocaleString(undefined, { 
        weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit'
      });

      const update = () => {
        const now = new Date().getTime();
        const distance = targetDate.getTime() - now;

        const passedMessage = document.getElementById('passed-message');

        if (distance < 0) {
          if (timerId) clearInterval(timerId);
          document.getElementById('cd-days')!.textContent = "00";
          document.getElementById('cd-hours')!.textContent = "00";
          document.getElementById('cd-minutes')!.textContent = "00";
          document.getElementById('cd-seconds')!.textContent = "00";
          passedMessage?.classList.remove('hidden');
          return;
        }

        passedMessage?.classList.add('hidden');

        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

        document.getElementById('cd-days')!.textContent = days.toString().padStart(2, '0');
        document.getElementById('cd-hours')!.textContent = hours.toString().padStart(2, '0');
        document.getElementById('cd-minutes')!.textContent = minutes.toString().padStart(2, '0');
        document.getElementById('cd-seconds')!.textContent = seconds.toString().padStart(2, '0');
      };

      update();
      if (timerId) clearInterval(timerId);
      timerId = window.setInterval(update, 1000);
    }
  };

  initCountdown();
  document.addEventListener('astro:page-load', initCountdown);
</script>
