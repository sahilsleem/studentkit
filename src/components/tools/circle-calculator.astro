---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Radius (r)</label>
          <input type="number" id="circ-r" step="any" min="0" placeholder="e.g. 5" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Sector Angle θ (Degrees)</label>
          <input type="number" id="circ-angle" step="any" min="0" max="360" placeholder="e.g. 60" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <button id="circ-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Circle Metrics
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Total Circle Area (πr²)</div>
          <div id="circ-area" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div id="circ-circum" class="text-xs text-slate-muted mt-1">Circumference (2πr) = 31.42</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 space-y-1.5 text-xs text-slate-muted">
          <div class="flex flex-wrap justify-between gap-2">
            <span>Arc Length (60°):</span>
            <strong id="circ-arc" class="text-ink font-mono break-words">5.24</strong>
          </div>
          <div class="flex flex-wrap justify-between gap-2">
            <span>Sector Area:</span>
            <strong id="circ-sector" class="text-ink font-mono break-words">13.09</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const r = parseFloat((document.getElementById('circ-r') as HTMLInputElement)?.value || '0');
    const angle = parseFloat((document.getElementById('circ-angle') as HTMLInputElement)?.value || '0');

    const area = Math.PI * r * r;
    const circum = 2 * Math.PI * r;
    const arc = (angle / 360) * circum;
    const sector = (angle / 360) * area;

    const areaEl = document.getElementById('circ-area');
    const circumEl = document.getElementById('circ-circum');
    const arcEl = document.getElementById('circ-arc');
    const sectorEl = document.getElementById('circ-sector');

    if (areaEl) areaEl.textContent = area.toFixed(2);
    if (circumEl) circumEl.textContent = 'Circumference (2πr) = ' + circum.toFixed(2);
    if (arcEl) arcEl.textContent = arc.toFixed(2);
    if (sectorEl) sectorEl.textContent = sector.toFixed(2);
  }


  document.getElementById('circ-calc-btn')?.addEventListener('click', calculate);
</script>