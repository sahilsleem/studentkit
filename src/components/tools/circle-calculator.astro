---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Radius (r)</label>
          <input type="number" id="circ-r" step="any" min="0" placeholder="e.g. 5" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Sector Angle θ (Degrees)</label>
          <input type="number" id="circ-angle" step="any" min="0" max="360" placeholder="e.g. 60" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <button id="circ-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Circle Metrics
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Total Circle Area (πr²)</div>
          <div id="circ-area" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
          <div id="circ-circum" class="text-xs text-slate-500 mt-2">Circumference (2πr) = 31.42</div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 space-y-2 text-xs text-slate-600">
          <div class="flex justify-between">
            <span>Arc Length (60°):</span>
            <strong id="circ-arc" class="text-slate-800 font-mono">5.24</strong>
          </div>
          <div class="flex justify-between">
            <span>Sector Area:</span>
            <strong id="circ-sector" class="text-slate-800 font-mono">13.09</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const r = parseFloat((document.getElementById('circ-r') as HTMLInputElement)?.value || '0');
    const angle = parseFloat((document.getElementById('circ-angle') as HTMLInputElement)?.value || '0');

    const area = Math.PI * r * r;
    const circum = 2 * Math.PI * r;
    const arc = (angle / 360) * circum;
    const sector = (angle / 360) * area;

    const areaEl = document.getElementById('circ-area');
    const circumEl = document.getElementById('circ-circum');
    const arcEl = document.getElementById('circ-arc');
    const sectorEl = document.getElementById('circ-sector');

    if (areaEl) areaEl.textContent = area.toFixed(2);
    if (circumEl) circumEl.textContent = 'Circumference (2πr) = ' + circum.toFixed(2);
    if (arcEl) arcEl.textContent = arc.toFixed(2);
    if (sectorEl) sectorEl.textContent = sector.toFixed(2);
  }


  document.getElementById('circ-calc-btn')?.addEventListener('click', calculate);
</script>