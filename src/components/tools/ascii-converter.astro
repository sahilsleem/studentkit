---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="space-y-4">
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Text String</label>
        <input type="text" id="asc-text" placeholder="e.g. Hello StudentKit" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
      </div>

      <button id="asc-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
        Convert to ASCII & Hex
      </button>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-6">
        <div class="p-4 bg-slate-50 rounded-xl border border-slate-200/80">
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">ASCII Decimal</div>
          <div id="asc-dec" class="text-sm font-bold text-blue-600 font-mono mt-1 break-all">--</div>
        </div>
        <div class="p-4 bg-slate-50 rounded-xl border border-slate-200/80">
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Hexadecimal</div>
          <div id="asc-hex" class="text-sm font-bold text-slate-800 font-mono mt-1 break-all uppercase">--</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const text = (document.getElementById('asc-text') as HTMLInputElement)?.value || '';
    if (!text) {
      document.getElementById('asc-dec')!.textContent = '--';
      document.getElementById('asc-hex')!.textContent = '--';
      return;
    }
    const decs = text.split('').map(c => c.charCodeAt(0));
    const hexs = decs.map(d => d.toString(16).toUpperCase());

    document.getElementById('asc-dec')!.textContent = decs.join(' ');
    document.getElementById('asc-hex')!.textContent = hexs.join(' ');
  }

  document.getElementById('asc-calc-btn')?.addEventListener('click', calculate);
</script>