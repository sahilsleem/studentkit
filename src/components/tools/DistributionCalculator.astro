---
import { tools } from '../../data/registry';
const { tool } = Astro.props;
---

<div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden max-w-4xl mx-auto dist-container" data-tool={tool.slug}>
  <div class="p-6 sm:p-8">
    <form class="space-y-6 dist-form">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Normal -->
        <div class="dist-normal hidden space-y-4">
          <div>
            <label for="in-mean" class="block text-sm font-semibold text-gray-700 mb-2">Mean (μ)</label>
            <input type="number" step="any" inputmode="decimal" id="in-mean" class="in-mean w-full p-3 border border-gray-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500 bg-gray-50" />
          </div>
          <div>
            <label for="in-sd" class="block text-sm font-semibold text-gray-700 mb-2">Standard Deviation (σ)</label>
            <input type="number" step="any" min="0.0000001" inputmode="decimal" id="in-sd" class="in-sd w-full p-3 border border-gray-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500 bg-gray-50" />
          </div>
          <div>
            <label for="in-x-norm" class="block text-sm font-semibold text-gray-700 mb-2">Target value (x)</label>
            <input type="number" step="any" inputmode="decimal" id="in-x-norm" class="in-x-norm w-full p-3 border border-gray-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500 bg-gray-50" />
          </div>
        </div>

        <!-- Binomial -->
        <div class="dist-binom hidden space-y-4">
          <div>
            <label for="in-n" class="block text-sm font-semibold text-gray-700 mb-2">Number of Trials (n)</label>
            <input type="number" min="1" step="1" inputmode="numeric" id="in-n" class="in-n w-full p-3 border border-gray-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500 bg-gray-50" />
          </div>
          <div>
            <label for="in-p" class="block text-sm font-semibold text-gray-700 mb-2">Probability of Success (p)</label>
            <input type="number" step="any" min="0" max="1" inputmode="decimal" id="in-p" class="in-p w-full p-3 border border-gray-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500 bg-gray-50" />
          </div>
          <div>
            <label for="in-x-bin" class="block text-sm font-semibold text-gray-700 mb-2">Number of Successes (x)</label>
            <input type="number" min="0" step="1" inputmode="numeric" id="in-x-bin" class="in-x-bin w-full p-3 border border-gray-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500 bg-gray-50" />
          </div>
        </div>

        <!-- Poisson -->
        <div class="dist-poisson hidden space-y-4">
          <div>
            <label for="in-lambda" class="block text-sm font-semibold text-gray-700 mb-2">Average Rate (λ)</label>
            <input type="number" step="any" min="0" inputmode="decimal" id="in-lambda" class="in-lambda w-full p-3 border border-gray-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500 bg-gray-50" />
          </div>
          <div>
            <label for="in-x-pois" class="block text-sm font-semibold text-gray-700 mb-2">Number of Events (x)</label>
            <input type="number" min="0" step="1" inputmode="numeric" id="in-x-pois" class="in-x-pois w-full p-3 border border-gray-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500 bg-gray-50" />
          </div>
        </div>
      </div>

      <button type="submit" class="w-full bg-emerald-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors shadow-sm mt-4 cursor-pointer">
        Calculate Probability
      </button>
    </form>

    <div class="err-box hidden mt-6 bg-red-50 text-red-700 p-4 rounded-lg text-sm font-medium border border-red-100 flex items-start gap-3">
      <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
      <span class="err-msg"></span>
    </div>

    <div class="result-section hidden mt-8 pt-8 border-t border-gray-100" aria-live="polite">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-sm font-semibold uppercase text-gray-500 tracking-wider">Probability Results</h3>
        <button
          type="button"
          id="dist-copy-btn"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-emerald-700 bg-white hover:bg-emerald-50 active:bg-emerald-100 border border-emerald-200 rounded-md transition-colors shadow-xs focus:outline-none focus:ring-2 focus:ring-emerald-500 cursor-pointer"
          aria-label="Copy probability results to clipboard"
        >
          <svg class="w-3.5 h-3.5 copy-icon text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
          </svg>
          <span class="copy-text">Copy Results</span>
        </button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-emerald-50 p-6 rounded-xl border border-emerald-100 text-center">
          <h4 class="text-emerald-800 font-semibold mb-2 text-sm">P(X = x)</h4>
          <p class="text-2xl font-bold text-emerald-900 font-mono res-eq">--</p>
          <p class="text-xs text-blue-600 mt-1">Exact Probability</p>
        </div>
        <div class="bg-emerald-50 p-6 rounded-xl border border-emerald-100 text-center">
          <h4 class="text-emerald-800 font-semibold mb-2 text-sm">P(X ≤ x)</h4>
          <p class="text-2xl font-bold text-emerald-900 font-mono res-lte">--</p>
          <p class="text-xs text-emerald-600 mt-1">Cumulative Prob.</p>
        </div>
        <div class="bg-purple-50 p-6 rounded-xl border border-purple-100 text-center">
          <h4 class="text-purple-800 font-semibold mb-2 text-sm">P(X &gt; x)</h4>
          <p class="text-2xl font-bold text-purple-900 font-mono res-gt">--</p>
          <p class="text-xs text-purple-600 mt-1">1 - P(X ≤ x)</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { normalPdf, normalCdf } from '../../utils/statistics';
  import { formatResultNumber, copyToClipboard } from '../../utils/formatters';

  // Helper factorials and combinations
  function factorial(n: number): number {
    if (n === 0 || n === 1) return 1;
    let res = 1;
    for (let i = 2; i <= n; i++) res *= i;
    return res;
  }

  function combinations(n: number, k: number): number {
    if (k < 0 || k > n) return 0;
    return factorial(n) / (factorial(k) * factorial(n - k));
  }

  function binomialPdf(n: number, p: number, x: number): number {
    return combinations(n, x) * Math.pow(p, x) * Math.pow(1 - p, n - x);
  }

  function binomialCdf(n: number, p: number, x: number): number {
    let sum = 0;
    for (let i = 0; i <= x; i++) {
      sum += binomialPdf(n, p, i);
    }
    return sum;
  }

  function poissonPdf(lambda: number, x: number): number {
    return (Math.pow(lambda, x) * Math.exp(-lambda)) / factorial(x);
  }

  function poissonCdf(lambda: number, x: number): number {
    let sum = 0;
    for (let i = 0; i <= x; i++) {
      sum += poissonPdf(lambda, i);
    }
    return sum;
  }

  const initDist = () => {
    document.querySelectorAll('.dist-container').forEach(container => {
      if (container.hasAttribute('data-init')) return;
      container.setAttribute('data-init', 'true');

      const slug = container.getAttribute('data-tool') || '';
      let type = 'normal';
      if (slug.includes('binomial')) type = 'binomial';
      if (slug.includes('poisson')) type = 'poisson';

      const distNormal = container.querySelector('.dist-normal');
      const distBinom = container.querySelector('.dist-binom');
      const distPoisson = container.querySelector('.dist-poisson');

      if (type === 'normal' && distNormal) {
         distNormal.classList.remove('hidden');
         distNormal.querySelectorAll('input').forEach(i => i.required = true);
      } else if (type === 'binomial' && distBinom) {
         distBinom.classList.remove('hidden');
         distBinom.querySelectorAll('input').forEach(i => i.required = true);
      } else if (type === 'poisson' && distPoisson) {
         distPoisson.classList.remove('hidden');
         distPoisson.querySelectorAll('input').forEach(i => i.required = true);
      }

      const form = container.querySelector('.dist-form') as HTMLFormElement;
      const errBox = container.querySelector('.err-box');
      const errMsg = container.querySelector('.err-msg');
      const resultSec = container.querySelector('.result-section');
      const copyBtn = container.querySelector('#dist-copy-btn');

      if (copyBtn) {
        copyBtn.addEventListener('click', async () => {
          const eqVal = container.querySelector('.res-eq')?.textContent || '';
          const lteVal = container.querySelector('.res-lte')?.textContent || '';
          const gtVal = container.querySelector('.res-gt')?.textContent || '';
          if (!eqVal || eqVal === '--') return;

          const copyText = `P(X = x): ${eqVal}, P(X ≤ x): ${lteVal}, P(X > x): ${gtVal}`;
          const success = await copyToClipboard(copyText);
          if (success) {
            const copyTextEl = copyBtn.querySelector('.copy-text');
            const originalText = copyTextEl ? copyTextEl.textContent : 'Copy Results';
            if (copyTextEl) copyTextEl.textContent = 'Copied!';
            copyBtn.classList.add('bg-emerald-100', 'text-emerald-800');
            setTimeout(() => {
              if (copyTextEl) copyTextEl.textContent = originalText;
              copyBtn.classList.remove('bg-emerald-100', 'text-emerald-800');
            }, 2000);
          }
        });
      }

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        errBox?.classList.add('hidden');
        resultSec?.classList.add('hidden');

        try {
          let eq = 0;
          let lte = 0;

          if (type === 'normal') {
             const m = parseFloat((container.querySelector('.in-mean') as HTMLInputElement).value);
             const sd = parseFloat((container.querySelector('.in-sd') as HTMLInputElement).value);
             const x = parseFloat((container.querySelector('.in-x-norm') as HTMLInputElement).value);
             if (sd <= 0) throw new Error("Standard Deviation must be > 0.");

             eq = normalPdf(x, m, sd);
             lte = normalCdf(x, m, sd);
          } else if (type === 'binomial') {
             const n = parseInt((container.querySelector('.in-n') as HTMLInputElement).value);
             const p = parseFloat((container.querySelector('.in-p') as HTMLInputElement).value);
             const x = parseInt((container.querySelector('.in-x-bin') as HTMLInputElement).value);
             if (p < 0 || p > 1) throw new Error("Probability p must be between 0 and 1.");
             if (x < 0 || x > n) throw new Error("Successes x must be between 0 and n.");

             eq = binomialPdf(n, p, x);
             lte = binomialCdf(n, p, x);
          } else if (type === 'poisson') {
             const lambda = parseFloat((container.querySelector('.in-lambda') as HTMLInputElement).value);
             const x = parseInt((container.querySelector('.in-x-pois') as HTMLInputElement).value);
             if (lambda < 0) throw new Error("Average rate λ must be non-negative.");

             eq = poissonPdf(lambda, x);
             lte = poissonCdf(lambda, x);
          }

          const gt = 1 - lte;

          const resEq = container.querySelector('.res-eq');
          const resLte = container.querySelector('.res-lte');
          const resGt = container.querySelector('.res-gt');

          if (resEq) resEq.textContent = formatResultNumber(eq);
          if (resLte) resLte.textContent = formatResultNumber(lte);
          if (resGt) resGt.textContent = formatResultNumber(Math.max(0, gt));

          resultSec?.classList.remove('hidden');
          resultSec?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

        } catch (err: any) {
          if (errMsg) errMsg.textContent = err.message;
          errBox?.classList.remove('hidden');
        }
      });
    });
  };

  initDist();
  document.addEventListener('astro:page-load', initDist);
</script>
