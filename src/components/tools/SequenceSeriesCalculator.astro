---
import { tools } from '../../data/registry';
const { tool } = Astro.props;

const isArithmetic = tool.slug.includes('arithmetic');
const isGeometric = tool.slug.includes('geometric');
const isInfinite = tool.slug.includes('infinite');
const isSigma = tool.slug.includes('sigma');
---

<div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden max-w-3xl mx-auto">
  <div class="p-6 sm:p-8">
    {isSigma ? (
      <form id="sigma-form" class="space-y-6">
        <div class="flex items-center gap-4 justify-center">
          <div class="text-6xl font-light text-gray-300">∑</div>
          <div class="flex flex-col gap-2">
            <div class="flex items-center gap-2">
              <span class="text-sm font-medium text-gray-700">Index n =</span>
              <input type="number" inputmode="numeric" id="sig-start" aria-label="Start index n" required class="w-16 p-2 border border-gray-300 rounded focus:ring-emerald-500 text-center" placeholder="1">
              <span class="text-gray-400">to</span>
              <input type="number" inputmode="numeric" id="sig-end" aria-label="End index n" required class="w-16 p-2 border border-gray-300 rounded focus:ring-emerald-500 text-center" placeholder="10">
            </div>
            <div class="flex items-center gap-2">
              <label for="sig-expr" class="font-mono text-gray-500 text-sm">f(n) =</label>
              <input type="text" id="sig-expr" required class="w-48 p-2 border border-gray-300 rounded focus:ring-emerald-500 font-mono" placeholder="n^2 + 1">
            </div>
          </div>
        </div>
        <button type="submit" class="w-full bg-emerald-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors shadow-sm cursor-pointer">Calculate Sum</button>
      </form>
    ) : (
      <form id="seq-form" class="space-y-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label for="seq-a" class="block text-sm font-medium text-gray-700 mb-2">First Term (a₁)</label>
            <input type="number" step="any" inputmode="decimal" id="seq-a" required class="w-full p-3 border border-gray-300 rounded-lg focus:ring-emerald-500 font-mono">
          </div>

          <div>
            <label for="seq-r" class="block text-sm font-medium text-gray-700 mb-2">
              {isGeometric ? 'Common Ratio (r)' : 'Common Difference (d)'}
            </label>
            <input type="number" step="any" inputmode="decimal" id="seq-r" required class="w-full p-3 border border-gray-300 rounded-lg focus:ring-emerald-500 font-mono">
          </div>

          {!isInfinite && (
            <div class="sm:col-span-2">
              <label for="seq-n" class="block text-sm font-medium text-gray-700 mb-2">Number of Terms (n)</label>
              <input type="number" min="1" inputmode="numeric" id="seq-n" required class="w-full p-3 border border-gray-300 rounded-lg focus:ring-emerald-500 font-mono">
            </div>
          )}
        </div>
        <button type="submit" class="w-full bg-emerald-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors shadow-sm cursor-pointer">Calculate</button>
      </form>
    )}

    <div id="seq-result" class="mt-8 pt-6 border-t border-gray-100 hidden" aria-live="polite">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-lg font-semibold text-gray-900">Result</h3>
        <button
          type="button"
          id="seq-copy-btn"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-emerald-700 bg-white hover:bg-emerald-50 active:bg-emerald-100 border border-emerald-200 rounded-md transition-colors shadow-xs focus:outline-none focus:ring-2 focus:ring-emerald-500 cursor-pointer"
          aria-label="Copy sequence result to clipboard"
        >
          <svg class="w-3.5 h-3.5 copy-icon text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
          </svg>
          <span class="copy-text">Copy Result</span>
        </button>
      </div>
      <div id="seq-err" class="hidden bg-red-50 text-red-700 p-4 rounded-lg text-sm font-medium mb-4"></div>

      <div id="seq-ans" class="bg-gray-50 p-6 rounded-xl border border-gray-200 text-center">
         <div class="text-gray-500 font-mono text-sm mb-2" id="ans-label">Sum =</div>
         <div class="text-3xl font-bold font-mono text-gray-900" id="ans-val"></div>
         <div id="ans-nth" class="mt-3 text-sm text-gray-600 font-mono"></div>
      </div>
    </div>
  </div>
</div>

<div id="seq-config" data-is-arithmetic={isArithmetic.toString()} data-is-geometric={isGeometric.toString()} data-is-infinite={isInfinite.toString()} data-is-sigma={isSigma.toString()} class="hidden"></div>
<script>
  const conf = document.getElementById('seq-config')?.dataset;
  const isArithmetic = conf?.isArithmetic === 'true';
  const isGeometric = conf?.isGeometric === 'true';
  const isInfinite = conf?.isInfinite === 'true';
  const isSigma = conf?.isSigma === 'true';
  import * as math from 'mathjs';
  import { formatResultNumber, copyToClipboard } from '../../utils/formatters';

  const initSeq = () => {
    const sigmaForm = document.getElementById('sigma-form');
    const seqForm = document.getElementById('seq-form');
    const resSec = document.getElementById('seq-result');
    const errBox = document.getElementById('seq-err');
    const ansBox = document.getElementById('seq-ans');
    const ansLabel = document.getElementById('ans-label');
    const ansVal = document.getElementById('ans-val');
    const ansNth = document.getElementById('ans-nth');
    const copyBtn = document.getElementById('seq-copy-btn');

    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        const valText = ansVal?.textContent?.trim() || '';
        if (!valText) return;
        const lblText = ansLabel?.textContent?.trim() || 'Result:';
        let copyText = `${lblText} ${valText}`;
        if (ansNth?.textContent?.trim()) {
          copyText += `\n${ansNth.textContent.trim()}`;
        }

        const success = await copyToClipboard(copyText);
        if (success) {
          const copyTextEl = copyBtn.querySelector('.copy-text');
          const originalText = copyTextEl ? copyTextEl.textContent : 'Copy Result';
          if (copyTextEl) copyTextEl.textContent = 'Copied!';
          copyBtn.classList.add('bg-emerald-100', 'text-emerald-800');
          setTimeout(() => {
            if (copyTextEl) copyTextEl.textContent = originalText;
            copyBtn.classList.remove('bg-emerald-100', 'text-emerald-800');
          }, 2000);
        }
      });
    }

    if (sigmaForm) {
      sigmaForm.addEventListener('submit', (e) => {
        e.preventDefault();
        errBox?.classList.add('hidden');
        ansBox?.classList.remove('hidden');
        if (ansNth) ansNth.textContent = '';

        try {
          const start = parseInt((document.getElementById('sig-start') as HTMLInputElement).value);
          const end = parseInt((document.getElementById('sig-end') as HTMLInputElement).value);
          let expr = (document.getElementById('sig-expr') as HTMLInputElement).value;
          expr = expr.replace(/(\d)([a-zA-Z])/g, '$1*$2');

          if (end < start) throw new Error("End must be >= Start");
          if (end - start > 100000) throw new Error("Too many terms to compute safely in browser.");

          const code = math.compile(expr);
          let sum = 0;
          for (let n = start; n <= end; n++) {
            sum += code.evaluate({ n });
          }

          if (ansLabel) ansLabel.textContent = `Sum from n=${start} to ${end} =`;
          if (ansVal) ansVal.textContent = formatResultNumber(sum);

        } catch (err: any) {
          ansBox?.classList.add('hidden');
          if (errBox) {
            errBox.textContent = err.message;
            errBox.classList.remove('hidden');
          }
        }
        resSec?.classList.remove('hidden');
        resSec?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    }

    if (seqForm) {
      seqForm.addEventListener('submit', (e) => {
        e.preventDefault();
        errBox?.classList.add('hidden');
        ansBox?.classList.remove('hidden');
        if (ansNth) ansNth.textContent = '';

        try {
          const a = parseFloat((document.getElementById('seq-a') as HTMLInputElement).value);
          const r = parseFloat((document.getElementById('seq-r') as HTMLInputElement).value);

          let n = 1;
          if (!isInfinite) {
            n = parseInt((document.getElementById('seq-n') as HTMLInputElement).value);
          }

          let sum = 0;
          let nth = 0;

          if (isGeometric) {
             if (isInfinite) {
                if (Math.abs(r) >= 1) {
                   throw new Error(`Geometric series diverges for |r| >= 1. (r = ${r})`);
                }
                sum = a / (1 - r);
                if (ansLabel) ansLabel.textContent = `Infinite Sum (S_∞) =`;
             } else {
                if (r === 1) sum = a * n;
                else sum = a * (1 - Math.pow(r, n)) / (1 - r);
                nth = a * Math.pow(r, n - 1);
                if (ansLabel) ansLabel.textContent = `Sum (S_${n}) =`;
                if (ansNth) ansNth.textContent = `n-th term (a_${n}) = ${formatResultNumber(nth)}`;
             }
          } else {
             // Arithmetic
             sum = (n / 2) * (2 * a + (n - 1) * r);
             nth = a + (n - 1) * r;
             if (ansLabel) ansLabel.textContent = `Sum (S_${n}) =`;
             if (ansNth) ansNth.textContent = `n-th term (a_${n}) = ${formatResultNumber(nth)}`;
          }

          if (ansVal) ansVal.textContent = formatResultNumber(sum);

        } catch (err: any) {
          ansBox?.classList.add('hidden');
          if (errBox) {
            errBox.textContent = err.message;
            errBox.classList.remove('hidden');
          }
        }
        resSec?.classList.remove('hidden');
        resSec?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    }
  };

  initSeq();
  document.addEventListener('astro:page-load', initSeq);
</script>
