---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="space-y-4">
      <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">2×3 Augmented Matrix</label>
      <div class="grid grid-cols-3 gap-2">
        <input type="number" id="rr-11" placeholder="e.g. 1" class="px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-center font-bold" />
        <input type="number" id="rr-12" placeholder="e.g. 2" class="px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-center font-bold" />
        <input type="number" id="rr-13" placeholder="e.g. 5" class="px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-center font-bold" />
        <input type="number" id="rr-21" placeholder="e.g. 3" class="px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-center font-bold" />
        <input type="number" id="rr-22" placeholder="e.g. 4" class="px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-center font-bold" />
        <input type="number" id="rr-23" placeholder="e.g. 11" class="px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-center font-bold" />
      </div>

      <button id="rr-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
        Compute RREF (Gauss-Jordan)
      </button>

      <div class="p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Reduced Row Echelon Form</div>
        <div id="rr-res" class="text-2xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    let mat = [
      [
        parseFloat((document.getElementById('rr-11') as HTMLInputElement)?.value || '0'),
        parseFloat((document.getElementById('rr-12') as HTMLInputElement)?.value || '0'),
        parseFloat((document.getElementById('rr-13') as HTMLInputElement)?.value || '0')
      ],
      [
        parseFloat((document.getElementById('rr-21') as HTMLInputElement)?.value || '0'),
        parseFloat((document.getElementById('rr-22') as HTMLInputElement)?.value || '0'),
        parseFloat((document.getElementById('rr-23') as HTMLInputElement)?.value || '0')
      ]
    ];

    // Gauss Jordan
    let lead = 0;
    const rowCount = 2;
    const colCount = 3;

    for (let r = 0; r < rowCount; r++) {
      if (colCount <= lead) break;
      let i = r;
      while (mat[i][lead] === 0) {
        i++;
        if (rowCount === i) {
          i = r;
          lead++;
          if (colCount === lead) break;
        }
      }
      if (colCount === lead) break;

      let temp = mat[i];
      mat[i] = mat[r];
      mat[r] = temp;

      let val = mat[r][lead];
      if (val !== 0) {
        for (let j = 0; j < colCount; j++) mat[r][j] /= val;
      }

      for (let k = 0; k < rowCount; k++) {
        if (k !== r) {
          let factor = mat[k][lead];
          for (let j = 0; j < colCount; j++) mat[k][j] -= factor * mat[r][j];
        }
      }
      lead++;
    }

    const fmtRow = (row: number[]) => '[' + row.map(n => Math.abs(n) < 1e-9 ? '0' : n.toFixed(2)).join(', ') + ']';
    const resEl = document.getElementById('rr-res');
    if (resEl) resEl.textContent = fmtRow(mat[0]) + '  |  ' + fmtRow(mat[1]);
  }


  document.getElementById('rr-calc-btn')?.addEventListener('click', calculate);
</script>