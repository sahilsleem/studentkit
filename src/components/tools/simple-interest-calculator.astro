---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Principal Amount (₹)</label>
          <input type="number" id="si-principal" step="100" min="0" placeholder="e.g. 5000" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Annual Interest Rate (%)</label>
          <input type="number" id="si-rate" step="0.1" min="0" placeholder="e.g. 6" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Time Period (Years)</label>
          <input type="number" id="si-time" step="0.5" min="0.1" placeholder="e.g. 3" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <button id="si-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Interest
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Total Simple Interest (I)</div>
          <div id="si-interest" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div class="text-xs text-slate-muted mt-1">Formula: I = P × r × t</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 space-y-1.5 text-xs text-slate-muted">
          <div class="flex flex-wrap justify-between gap-2">
            <span>Total Maturity Amount (A = P + I):</span>
            <strong id="si-total" class="text-ink font-bold">--</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const pIn = document.getElementById('si-principal') as HTMLInputElement;
  const rIn = document.getElementById('si-rate') as HTMLInputElement;
  const tIn = document.getElementById('si-time') as HTMLInputElement;
  const iEl = document.getElementById('si-interest');
  const aEl = document.getElementById('si-total');

  function calculate() {
    const P = parseFloat(pIn?.value || '0');
    const r = parseFloat(rIn?.value || '0') / 100;
    const t = parseFloat(tIn?.value || '0');

    const I = P * r * t;
    const A = P + I;

    const fmt = (v: number) => '₹' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (iEl) iEl.textContent = fmt(I);
    if (aEl) aEl.textContent = fmt(A);
  }


  document.getElementById('si-calc-btn')?.addEventListener('click', calculate);
</script>