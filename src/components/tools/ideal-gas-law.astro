---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Pressure (P in atm)</label>
          <input type="number" id="igl-p" placeholder="e.g. 1.0" step="any" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Volume (V in Liters)</label>
          <input type="number" id="igl-v" placeholder="e.g. 22.414" step="any" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Temperature (T in Kelvin)</label>
          <input type="number" id="igl-t" placeholder="e.g. 273.15" step="any" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>

        <button id="igl-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Moles of Gas
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Amount of Gas (n = PV / RT)</div>
          <div id="igl-n" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
          <div class="text-xs text-slate-500 mt-2">R = 0.082057 L·atm/(mol·K)</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const p = parseFloat((document.getElementById('igl-p') as HTMLInputElement)?.value || '1');
    const v = parseFloat((document.getElementById('igl-v') as HTMLInputElement)?.value || '1');
    const t = parseFloat((document.getElementById('igl-t') as HTMLInputElement)?.value || '273.15');
    const R = 0.082057;

    if (t <= 0) return;
    const n = (p * v) / (R * t);

    document.getElementById('igl-n')!.textContent = n.toFixed(3) + ' mol';
  }


  document.getElementById('igl-calc-btn')?.addEventListener('click', calculate);
</script>