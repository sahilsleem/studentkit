---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Pressure (P in atm)</label>
          <input type="number" id="igl-p" placeholder="e.g. 1.0" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Volume (V in Liters)</label>
          <input type="number" id="igl-v" placeholder="e.g. 22.414" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Temperature (T in Kelvin)</label>
          <input type="number" id="igl-t" placeholder="e.g. 273.15" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>

        <button id="igl-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Moles of Gas
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Amount of Gas (n = PV / RT)</div>
          <div id="igl-n" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div class="text-xs text-slate-muted mt-1">R = 0.082057 L·atm/(mol·K)</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const p = parseFloat((document.getElementById('igl-p') as HTMLInputElement)?.value || '1');
    const v = parseFloat((document.getElementById('igl-v') as HTMLInputElement)?.value || '1');
    const t = parseFloat((document.getElementById('igl-t') as HTMLInputElement)?.value || '273.15');
    const R = 0.082057;

    if (t <= 0) return;
    const n = (p * v) / (R * t);

    document.getElementById('igl-n')!.textContent = n.toFixed(3) + ' mol';
  }


  document.getElementById('igl-calc-btn')?.addEventListener('click', calculate);
</script>