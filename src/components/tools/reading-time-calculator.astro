---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Word Count</label>
          <input type="number" id="rt-words" min="1" placeholder="e.g. 1500" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div>
          <div class="flex justify-between items-center mb-1">
            <label class="text-xs font-semibold uppercase tracking-wider text-slate-muted">Reading Speed (WPM)</label>
            <span id="rt-wpm-display" class="text-xs font-mono font-bold text-brand">225 WPM (Average)</span>
          </div>
          <input type="range" id="rt-wpm" min="100" max="450" step="25" placeholder="e.g. 225" class="w-full accent-brand" />
        </div>

        <button id="rt-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Reading Time
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Estimated Silent Reading Time</div>
          <div id="rt-silent-time" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div class="text-xs text-slate-muted mt-1">Based on normal collegiate comprehension speed.</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 space-y-1.5 text-xs text-slate-muted">
          <div class="flex flex-wrap justify-between gap-2">
            <span>Speaking / Presentation Time (130 WPM):</span>
            <strong id="rt-speech-time" class="text-ink font-bold">11 min 32 sec</strong>
          </div>
          <div class="flex flex-wrap justify-between gap-2">
            <span>Slow / Deep Study Time (150 WPM):</span>
            <strong id="rt-slow-time" class="text-ink font-bold">10 min 0 sec</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const wordsIn = document.getElementById('rt-words') as HTMLInputElement;
  const wpmIn = document.getElementById('rt-wpm') as HTMLInputElement;
  const wpmDisplay = document.getElementById('rt-wpm-display');
  const silentEl = document.getElementById('rt-silent-time');
  const speechEl = document.getElementById('rt-speech-time');
  const slowEl = document.getElementById('rt-slow-time');

  function formatTime(totalSec: number) {
    const min = Math.floor(totalSec / 60);
    const sec = Math.round(totalSec % 60);
    if (min === 0) return sec + ' sec';
    return min + ' min ' + (sec > 0 ? sec + ' sec' : '');
  }

  function calculate() {
    const words = parseFloat(wordsIn?.value || '0');
    const wpm = parseFloat(wpmIn?.value || '225');

    if (wpmDisplay) {
      let speedDesc = 'Average';
      if (wpm < 180) speedDesc = 'Slow / Deliberate';
      else if (wpm > 300) speedDesc = 'Fast / Skimming';
      wpmDisplay.textContent = wpm + ' WPM (' + speedDesc + ')';
    }

    if (words <= 0) return;

    const silentSec = (words / wpm) * 60;
    const speechSec = (words / 130) * 60;
    const slowSec = (words / 150) * 60;

    if (silentEl) silentEl.textContent = formatTime(silentSec);
    if (speechEl) speechEl.textContent = formatTime(speechSec);
    if (slowEl) slowEl.textContent = formatTime(slowSec);
  }


  document.getElementById('rt-calc-btn')?.addEventListener('click', calculate);
</script>