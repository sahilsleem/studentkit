---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Word Count</label>
          <input type="number" id="rt-words" min="1" placeholder="e.g. 1500" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div>
          <div class="flex justify-between items-center mb-1.5">
            <label class="text-xs font-semibold uppercase tracking-wider text-slate-500">Reading Speed (WPM)</label>
            <span id="rt-wpm-display" class="text-xs font-mono font-bold text-blue-600">225 WPM (Average)</span>
          </div>
          <input type="range" id="rt-wpm" min="100" max="450" step="25" placeholder="e.g. 225" class="w-full accent-blue-600" />
        </div>

        <button id="rt-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Reading Time
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Estimated Silent Reading Time</div>
          <div id="rt-silent-time" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
          <div class="text-xs text-slate-500 mt-2">Based on normal collegiate comprehension speed.</div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 space-y-2 text-xs text-slate-600">
          <div class="flex justify-between">
            <span>Speaking / Presentation Time (130 WPM):</span>
            <strong id="rt-speech-time" class="text-slate-800 font-bold">11 min 32 sec</strong>
          </div>
          <div class="flex justify-between">
            <span>Slow / Deep Study Time (150 WPM):</span>
            <strong id="rt-slow-time" class="text-slate-800 font-bold">10 min 0 sec</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const wordsIn = document.getElementById('rt-words') as HTMLInputElement;
  const wpmIn = document.getElementById('rt-wpm') as HTMLInputElement;
  const wpmDisplay = document.getElementById('rt-wpm-display');
  const silentEl = document.getElementById('rt-silent-time');
  const speechEl = document.getElementById('rt-speech-time');
  const slowEl = document.getElementById('rt-slow-time');

  function formatTime(totalSec: number) {
    const min = Math.floor(totalSec / 60);
    const sec = Math.round(totalSec % 60);
    if (min === 0) return sec + ' sec';
    return min + ' min ' + (sec > 0 ? sec + ' sec' : '');
  }

  function calculate() {
    const words = parseFloat(wordsIn?.value || '0');
    const wpm = parseFloat(wpmIn?.value || '225');

    if (wpmDisplay) {
      let speedDesc = 'Average';
      if (wpm < 180) speedDesc = 'Slow / Deliberate';
      else if (wpm > 300) speedDesc = 'Fast / Skimming';
      wpmDisplay.textContent = wpm + ' WPM (' + speedDesc + ')';
    }

    if (words <= 0) return;

    const silentSec = (words / wpm) * 60;
    const speechSec = (words / 130) * 60;
    const slowSec = (words / 150) * 60;

    if (silentEl) silentEl.textContent = formatTime(silentSec);
    if (speechEl) speechEl.textContent = formatTime(speechSec);
    if (slowEl) slowEl.textContent = formatTime(slowSec);
  }


  document.getElementById('rt-calc-btn')?.addEventListener('click', calculate);
</script>