---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Initial Quantity (N₀)</label>
          <input type="number" id="hl-n0" placeholder="e.g. 100" min="0" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Half-Life (t₁/₂ in years)</label>
          <input type="number" id="hl-thalf" placeholder="e.g. 5730" min="0.001" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Elapsed Time (t in years)</label>
          <input type="number" id="hl-t" placeholder="e.g. 11460" min="0" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>

        <button id="hl-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Remaining Quantity
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Remaining Amount (N(t))</div>
          <div id="hl-rem" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div id="hl-pct" class="text-xs text-slate-muted mt-1">25.00% of initial mass (2.0 half-lives elapsed)</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const n0 = parseFloat((document.getElementById('hl-n0') as HTMLInputElement)?.value || '0');
    const thalf = parseFloat((document.getElementById('hl-thalf') as HTMLInputElement)?.value || '1');
    const t = parseFloat((document.getElementById('hl-t') as HTMLInputElement)?.value || '0');

    if (thalf <= 0) return;
    const halfLives = t / thalf;
    const rem = n0 * Math.pow(0.5, halfLives);
    const pct = n0 > 0 ? (rem / n0) * 100 : 0;

    document.getElementById('hl-rem')!.textContent = rem.toFixed(2);
    document.getElementById('hl-pct')!.textContent = pct.toFixed(2) + '% of initial (' + halfLives.toFixed(2) + ' half-lives)';
  }


  document.getElementById('hl-calc-btn')?.addEventListener('click', calculate);
</script>