---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Bill Total (₹)</label>
          <input type="number" id="tip-bill" step="0.5" min="0" placeholder="e.g. 64.50" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Tip Percentage (%)</label>
          <div class="grid grid-cols-4 gap-2 mb-1">
            <button type="button" data-tip="10" class="tip-preset px-3 py-1.5 bg-search hover:bg-border-line rounded-lg text-xs font-semibold text-ink">10%</button>
            <button type="button" data-tip="15" class="tip-preset px-3 py-1.5 bg-search hover:bg-border-line rounded-lg text-xs font-semibold text-ink">15%</button>
            <button type="button" data-tip="18" class="tip-preset px-3 py-1.5 bg-brand-light border border-brand-accent rounded-lg text-xs font-semibold text-brand">18%</button>
            <button type="button" data-tip="20" class="tip-preset px-3 py-1.5 bg-search hover:bg-border-line rounded-lg text-xs font-semibold text-ink">20%</button>
          </div>
          <input type="number" id="tip-custom" step="1" min="0" max="100" placeholder="e.g. 18" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Number of People</label>
          <input type="number" id="tip-people" step="1" min="1" max="50" placeholder="e.g. 3" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <button id="tip-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Split
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Per Person Share</div>
          <div id="tip-per-person" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div id="tip-per-person-tip" class="text-xs text-slate-muted mt-1">Per person breakdown appears here</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 space-y-1.5 text-xs text-slate-muted">
          <div class="flex flex-wrap justify-between gap-2">
            <span>Total Tip Amount:</span>
            <strong id="tip-total-tip" class="text-ink font-bold">--</strong>
          </div>
          <div class="flex flex-wrap justify-between gap-2">
            <span>Total Bill With Tip:</span>
            <strong id="tip-total-bill" class="text-ink font-bold">--</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const billIn = document.getElementById('tip-bill') as HTMLInputElement;
  const tipIn = document.getElementById('tip-custom') as HTMLInputElement;
  const peopleIn = document.getElementById('tip-people') as HTMLInputElement;
  const presets = document.querySelectorAll('.tip-preset');

  const perPersonEl = document.getElementById('tip-per-person');
  const perPersonTipEl = document.getElementById('tip-per-person-tip');
  const totalTipEl = document.getElementById('tip-total-tip');
  const totalBillEl = document.getElementById('tip-total-bill');

  function calculate() {
    const bill = parseFloat(billIn?.value || '0');
    const tipPct = parseFloat(tipIn?.value || '0') / 100;
    const people = parseInt(peopleIn?.value || '1', 10);

    if (people <= 0) return;

    const totalTip = bill * tipPct;
    const totalBill = bill + totalTip;
    const perPerson = totalBill / people;
    const perPersonTip = totalTip / people;

    const fmt = (v: number) => '₹' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    if (perPersonEl) perPersonEl.textContent = fmt(perPerson);
    if (perPersonTipEl) perPersonTipEl.textContent = 'includes ' + fmt(perPersonTip) + ' tip per person';
    if (totalTipEl) totalTipEl.textContent = fmt(totalTip);
    if (totalBillEl) totalBillEl.textContent = fmt(totalBill);
  }

  presets.forEach(btn => {
    btn.addEventListener('click', () => {
      const tipVal = btn.getAttribute('data-tip');
      if (tipVal && tipIn) {
        tipIn.value = tipVal;
        presets.forEach(b => b.className = 'tip-preset px-3 py-1.5 bg-search hover:bg-border-line rounded-lg text-xs font-semibold text-ink');
        btn.className = 'tip-preset px-3 py-1.5 bg-brand-light border border-brand-accent rounded-lg text-xs font-semibold text-brand';
      }
    });
  });


  document.getElementById('tip-calc-btn')?.addEventListener('click', calculate);
</script>