---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Bill Total (₹)</label>
          <input type="number" id="tip-bill" step="0.5" min="0" placeholder="e.g. 64.50" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Tip Percentage (%)</label>
          <div class="grid grid-cols-4 gap-2 mb-2">
            <button type="button" data-tip="10" class="tip-preset px-3 py-1.5 bg-slate-100 hover:bg-slate-200 rounded-lg text-xs font-semibold text-slate-700">10%</button>
            <button type="button" data-tip="15" class="tip-preset px-3 py-1.5 bg-slate-100 hover:bg-slate-200 rounded-lg text-xs font-semibold text-slate-700">15%</button>
            <button type="button" data-tip="18" class="tip-preset px-3 py-1.5 bg-blue-50 border border-blue-200 rounded-lg text-xs font-semibold text-blue-600">18%</button>
            <button type="button" data-tip="20" class="tip-preset px-3 py-1.5 bg-slate-100 hover:bg-slate-200 rounded-lg text-xs font-semibold text-slate-700">20%</button>
          </div>
          <input type="number" id="tip-custom" step="1" min="0" max="100" placeholder="e.g. 18" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Number of People</label>
          <input type="number" id="tip-people" step="1" min="1" max="50" placeholder="e.g. 3" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <button id="tip-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Split
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Per Person Share</div>
          <div id="tip-per-person" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
          <div id="tip-per-person-tip" class="text-xs text-slate-400 mt-2">Per person breakdown appears here</div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 space-y-2 text-xs text-slate-600">
          <div class="flex justify-between">
            <span>Total Tip Amount:</span>
            <strong id="tip-total-tip" class="text-slate-800 font-bold">--</strong>
          </div>
          <div class="flex justify-between">
            <span>Total Bill With Tip:</span>
            <strong id="tip-total-bill" class="text-slate-800 font-bold">--</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const billIn = document.getElementById('tip-bill') as HTMLInputElement;
  const tipIn = document.getElementById('tip-custom') as HTMLInputElement;
  const peopleIn = document.getElementById('tip-people') as HTMLInputElement;
  const presets = document.querySelectorAll('.tip-preset');

  const perPersonEl = document.getElementById('tip-per-person');
  const perPersonTipEl = document.getElementById('tip-per-person-tip');
  const totalTipEl = document.getElementById('tip-total-tip');
  const totalBillEl = document.getElementById('tip-total-bill');

  function calculate() {
    const bill = parseFloat(billIn?.value || '0');
    const tipPct = parseFloat(tipIn?.value || '0') / 100;
    const people = parseInt(peopleIn?.value || '1', 10);

    if (people <= 0) return;

    const totalTip = bill * tipPct;
    const totalBill = bill + totalTip;
    const perPerson = totalBill / people;
    const perPersonTip = totalTip / people;

    const fmt = (v: number) => '₹' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    if (perPersonEl) perPersonEl.textContent = fmt(perPerson);
    if (perPersonTipEl) perPersonTipEl.textContent = 'includes ' + fmt(perPersonTip) + ' tip per person';
    if (totalTipEl) totalTipEl.textContent = fmt(totalTip);
    if (totalBillEl) totalBillEl.textContent = fmt(totalBill);
  }

  presets.forEach(btn => {
    btn.addEventListener('click', () => {
      const tipVal = btn.getAttribute('data-tip');
      if (tipVal && tipIn) {
        tipIn.value = tipVal;
        presets.forEach(b => b.className = 'tip-preset px-3 py-1.5 bg-slate-100 hover:bg-slate-200 rounded-lg text-xs font-semibold text-slate-700');
        btn.className = 'tip-preset px-3 py-1.5 bg-blue-50 border border-blue-200 rounded-lg text-xs font-semibold text-blue-600';
      }
    });
  });


  document.getElementById('tip-calc-btn')?.addEventListener('click', calculate);
</script>