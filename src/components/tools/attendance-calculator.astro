---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Classes Attended</label>
          <input type="number" id="att-attended" min="0" placeholder="e.g. 38" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Total Classes Held</label>
          <input type="number" id="att-total" min="1" placeholder="e.g. 45" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Target Attendance Requirement (%)</label>
          <input type="number" id="att-target" min="1" max="100" placeholder="e.g. 75" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <button id="att-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Attendance Status
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Current Attendance</div>
          <div id="att-curr-pct" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div id="att-status" class="text-xs text-emerald-600 font-medium mt-1">Enter details and calculate.</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 space-y-1.5 text-xs text-slate-muted">
          <div class="flex flex-wrap justify-between gap-2">
            <span id="att-advice-label">Bunk Safety / Required Classes:</span>
            <strong id="att-advice-val" class="text-brand font-bold">--</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const attendedIn = document.getElementById('att-attended') as HTMLInputElement;
  const totalIn = document.getElementById('att-total') as HTMLInputElement;
  const targetIn = document.getElementById('att-target') as HTMLInputElement;
  const pctEl = document.getElementById('att-curr-pct');
  const statusEl = document.getElementById('att-status');
  const adviceLabel = document.getElementById('att-advice-label');
  const adviceVal = document.getElementById('att-advice-val');

  function calculate() {
    const attended = parseInt(attendedIn?.value || '0', 10);
    const total = parseInt(totalIn?.value || '1', 10);
    const target = parseFloat(targetIn?.value || '75') / 100;

    if (total <= 0 || attended < 0 || attended > total) return;

    const currentPct = (attended / total) * 100;
    if (pctEl) pctEl.textContent = currentPct.toFixed(2) + '%';

    if (currentPct >= target * 100) {
      const canMiss = Math.floor((attended - target * total) / target);
      if (statusEl) {
        statusEl.textContent = 'You are currently above the target requirement.';
        statusEl.className = 'text-xs text-emerald-600 font-medium mt-1';
      }
      if (adviceLabel) adviceLabel.textContent = 'Safe to Miss:';
      if (adviceVal) adviceVal.textContent = canMiss > 0 ? canMiss + ' upcoming classes' : '0 classes (at boundary)';
    } else {
      const needed = Math.ceil((target * total - attended) / (1 - target));
      if (statusEl) {
        statusEl.textContent = 'Attendance is below requirement (Shortage Alert).';
        statusEl.className = 'text-xs text-rose-600 font-medium mt-1';
      }
      if (adviceLabel) adviceLabel.textContent = 'Classes Needed:';
      if (adviceVal) adviceVal.textContent = 'Must attend next ' + needed + ' consecutive classes';
    }
  }


  document.getElementById('att-calc-btn')?.addEventListener('click', calculate);
</script>