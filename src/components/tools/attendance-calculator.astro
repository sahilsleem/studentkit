---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Classes Attended</label>
          <input type="number" id="att-attended" min="0" placeholder="e.g. 38" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Total Classes Held</label>
          <input type="number" id="att-total" min="1" placeholder="e.g. 45" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Target Attendance Requirement (%)</label>
          <input type="number" id="att-target" min="1" max="100" placeholder="e.g. 75" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <button id="att-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Attendance Status
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Current Attendance</div>
          <div id="att-curr-pct" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
          <div id="att-status" class="text-xs text-emerald-600 font-medium mt-2">Enter details and calculate.</div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 space-y-2 text-xs text-slate-600">
          <div class="flex justify-between">
            <span id="att-advice-label">Bunk Safety / Required Classes:</span>
            <strong id="att-advice-val" class="text-blue-600 font-bold">--</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const attendedIn = document.getElementById('att-attended') as HTMLInputElement;
  const totalIn = document.getElementById('att-total') as HTMLInputElement;
  const targetIn = document.getElementById('att-target') as HTMLInputElement;
  const pctEl = document.getElementById('att-curr-pct');
  const statusEl = document.getElementById('att-status');
  const adviceLabel = document.getElementById('att-advice-label');
  const adviceVal = document.getElementById('att-advice-val');

  function calculate() {
    const attended = parseInt(attendedIn?.value || '0', 10);
    const total = parseInt(totalIn?.value || '1', 10);
    const target = parseFloat(targetIn?.value || '75') / 100;

    if (total <= 0 || attended < 0 || attended > total) return;

    const currentPct = (attended / total) * 100;
    if (pctEl) pctEl.textContent = currentPct.toFixed(2) + '%';

    if (currentPct >= target * 100) {
      const canMiss = Math.floor((attended - target * total) / target);
      if (statusEl) {
        statusEl.textContent = 'You are currently above the target requirement.';
        statusEl.className = 'text-xs text-emerald-600 font-medium mt-2';
      }
      if (adviceLabel) adviceLabel.textContent = 'Safe to Miss:';
      if (adviceVal) adviceVal.textContent = canMiss > 0 ? canMiss + ' upcoming classes' : '0 classes (at boundary)';
    } else {
      const needed = Math.ceil((target * total - attended) / (1 - target));
      if (statusEl) {
        statusEl.textContent = 'Attendance is below requirement (Shortage Alert).';
        statusEl.className = 'text-xs text-rose-600 font-medium mt-2';
      }
      if (adviceLabel) adviceLabel.textContent = 'Classes Needed:';
      if (adviceVal) adviceVal.textContent = 'Must attend next ' + needed + ' consecutive classes';
    }
  }


  document.getElementById('att-calc-btn')?.addEventListener('click', calculate);
</script>