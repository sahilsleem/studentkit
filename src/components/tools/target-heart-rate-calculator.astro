---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Age</label>
          <input type="number" id="thr-age" placeholder="e.g. 20" min="10" max="100" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Resting Heart Rate (BPM)</label>
          <input type="number" id="thr-rhr" placeholder="e.g. 65" min="40" max="120" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>

        <button id="thr-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Training Zones
        </button>
      </div>

      <div class="p-6 bg-slate-50 rounded-xl border border-slate-200/80 space-y-3">
        <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Heart Rate Training Zones</div>

        <div class="space-y-2 text-xs text-slate-600">
          <div class="flex justify-between bg-white p-2.5 rounded-lg border border-slate-200">
            <span>Fat Burn (50-60%):</span>
            <strong id="thr-z1" class="text-blue-600 font-mono font-bold">132 - 146 BPM</strong>
          </div>
          <div class="flex justify-between bg-white p-2.5 rounded-lg border border-slate-200">
            <span>Aerobic Cardio (60-70%):</span>
            <strong id="thr-z2" class="text-blue-600 font-mono font-bold">146 - 159 BPM</strong>
          </div>
          <div class="flex justify-between bg-white p-2.5 rounded-lg border border-slate-200">
            <span>Anaerobic Threshold (70-85%):</span>
            <strong id="thr-z3" class="text-blue-600 font-mono font-bold">159 - 180 BPM</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const age = parseFloat((document.getElementById('thr-age') as HTMLInputElement)?.value || '20');
    const rhr = parseFloat((document.getElementById('thr-rhr') as HTMLInputElement)?.value || '65');

    const maxHr = 220 - age;
    const hrr = maxHr - rhr;

    const calcZone = (pctLow: number, pctHigh: number) => {
      const low = Math.round(rhr + hrr * pctLow);
      const high = Math.round(rhr + hrr * pctHigh);
      return low + ' - ' + high + ' BPM';
    };

    document.getElementById('thr-z1')!.textContent = calcZone(0.5, 0.6);
    document.getElementById('thr-z2')!.textContent = calcZone(0.6, 0.7);
    document.getElementById('thr-z3')!.textContent = calcZone(0.7, 0.85);
  }


  document.getElementById('thr-calc-btn')?.addEventListener('click', calculate);
</script>