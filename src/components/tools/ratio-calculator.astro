---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Proportion Solver (A : B = C : D)</label>
        <div class="flex items-center gap-2">
          <input type="number" id="rat-a" placeholder="e.g. 3" class="w-16 px-2 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm text-center font-bold" />
          <span class="font-bold">:</span>
          <input type="number" id="rat-b" placeholder="e.g. 5" class="w-16 px-2 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm text-center font-bold" />
          <span class="font-bold">=</span>
          <input type="number" id="rat-c" placeholder="e.g. 12" class="w-16 px-2 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm text-center font-bold" />
          <span class="font-bold">:</span>
          <input type="number" id="rat-d" placeholder="?" class="w-16 px-2 py-2 bg-blue-50 border border-blue-300 rounded-lg text-sm text-center font-bold text-blue-600" />
        </div>

        <button id="rat-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Solve Ratio
        </button>
      </div>

      <div class="p-6 bg-slate-50 rounded-xl border border-slate-200/80 flex flex-col justify-between">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Solved Value (D)</div>
          <div id="rat-res" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
          <div id="rat-scaled" class="text-xs text-slate-500 mt-2">Scale Factor: 4.0×</div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 text-xs text-slate-600">
          <span>Simplified Ratio: </span>
          <strong id="rat-simp" class="text-slate-800">3 : 5</strong>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function gcd(a: number, b: number): number {
    return b === 0 ? Math.abs(a) : gcd(b, a % b);
  }

  function solve() {
    const a = parseFloat((document.getElementById('rat-a') as HTMLInputElement)?.value || '0');
    const b = parseFloat((document.getElementById('rat-b') as HTMLInputElement)?.value || '0');
    const c = parseFloat((document.getElementById('rat-c') as HTMLInputElement)?.value || '0');

    if (a === 0) return;
    const d = (b * c) / a;

    const resEl = document.getElementById('rat-res');
    const scaledEl = document.getElementById('rat-scaled');
    const simpEl = document.getElementById('rat-simp');

    if (resEl) resEl.textContent = 'D = ' + d.toFixed(3);
    if (scaledEl) scaledEl.textContent = 'Scale Factor: ' + (c / a).toFixed(2) + '×';

    const g = gcd(Math.round(a), Math.round(b));
    if (simpEl) simpEl.textContent = Math.round(a / g) + ' : ' + Math.round(b / g);
  }

  ['rat-a', 'rat-b', 'rat-c'].forEach(id => document.getElementById(id)?.addEventListener('input', solve));
  document.getElementById('rat-calc-btn')?.addEventListener('click', solve);
  solve();
</script>