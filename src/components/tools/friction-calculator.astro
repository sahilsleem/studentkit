---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Coefficient of Friction (μ)</label>
          <input type="number" id="fric-mu" placeholder="e.g. 0.35" min="0" max="2" step="0.05" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Mass of Object (m in kg)</label>
          <input type="number" id="fric-m" placeholder="e.g. 20" min="0" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Incline Angle (θ in degrees)</label>
          <input type="number" id="fric-angle" placeholder="e.g. 0" min="0" max="89" step="1" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>

        <button id="fric-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Friction Force
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Friction Force (f = μ · N)</div>
          <div id="fric-force" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 space-y-1.5 text-xs text-slate-muted">
          <div class="flex flex-wrap justify-between gap-2">
            <span>Normal Force (N = mg cos θ):</span>
            <strong id="fric-normal" class="text-ink font-mono break-words">196.13 N</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const mu = parseFloat((document.getElementById('fric-mu') as HTMLInputElement)?.value || '0');
    const m = parseFloat((document.getElementById('fric-m') as HTMLInputElement)?.value || '0');
    const deg = parseFloat((document.getElementById('fric-angle') as HTMLInputElement)?.value || '0');
    const g = 9.80665;

    const rad = (deg * Math.PI) / 180;
    const normal = m * g * Math.cos(rad);
    const friction = mu * normal;

    document.getElementById('fric-force')!.textContent = friction.toFixed(2) + ' N';
    document.getElementById('fric-normal')!.textContent = normal.toFixed(2) + ' N';
  }


  document.getElementById('fric-calc-btn')?.addEventListener('click', calculate);
</script>