---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Weight (kg)</label>
          <input type="number" id="bmi-weight" placeholder="e.g. 70" min="20" step="0.5" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Height (cm)</label>
          <input type="number" id="bmi-height" placeholder="e.g. 175" min="50" step="1" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>

        <button id="bmi-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate BMI
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Body Mass Index (BMI)</div>
          <div id="bmi-val" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div id="bmi-status" class="text-xs text-slate-muted font-semibold mt-1">Weight category appears here</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 text-xs text-slate-muted">
          <span>Healthy Weight Range for 175 cm: </span>
          <strong id="bmi-healthy" class="text-ink font-mono break-words">--</strong>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const w = parseFloat((document.getElementById('bmi-weight') as HTMLInputElement)?.value || '70');
    const hCm = parseFloat((document.getElementById('bmi-height') as HTMLInputElement)?.value || '175');

    const hM = hCm / 100;
    if (hM <= 0) return;

    const bmi = w / (hM * hM);
    const minW = 18.5 * (hM * hM);
    const maxW = 24.9 * (hM * hM);

    document.getElementById('bmi-val')!.textContent = bmi.toFixed(2);
    document.getElementById('bmi-healthy')!.textContent = minW.toFixed(1) + ' - ' + maxW.toFixed(1) + ' kg';

    const statEl = document.getElementById('bmi-status');
    if (statEl) {
      if (bmi < 18.5) { statEl.textContent = 'Underweight (< 18.5)'; statEl.className = 'text-xs text-amber-600 font-semibold mt-1'; }
      else if (bmi <= 24.9) { statEl.textContent = 'Normal Weight (18.5 - 24.9)'; statEl.className = 'text-xs text-emerald-600 font-semibold mt-1'; }
      else if (bmi <= 29.9) { statEl.textContent = 'Overweight (25.0 - 29.9)'; statEl.className = 'text-xs text-amber-600 font-semibold mt-1'; }
      else { statEl.textContent = 'Obese (≥ 30.0)'; statEl.className = 'text-xs text-rose-600 font-semibold mt-1'; }
    }
  }


  document.getElementById('bmi-calc-btn')?.addEventListener('click', calculate);
</script>