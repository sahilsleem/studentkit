---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Weight (kg)</label>
          <input type="number" id="bmi-weight" placeholder="e.g. 70" min="20" step="0.5" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Height (cm)</label>
          <input type="number" id="bmi-height" placeholder="e.g. 175" min="50" step="1" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>

        <button id="bmi-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate BMI
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Body Mass Index (BMI)</div>
          <div id="bmi-val" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
          <div id="bmi-status" class="text-xs text-slate-400 font-semibold mt-2">Weight category appears here</div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 text-xs text-slate-600">
          <span>Healthy Weight Range for 175 cm: </span>
          <strong id="bmi-healthy" class="text-slate-800 font-mono">--</strong>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const w = parseFloat((document.getElementById('bmi-weight') as HTMLInputElement)?.value || '70');
    const hCm = parseFloat((document.getElementById('bmi-height') as HTMLInputElement)?.value || '175');

    const hM = hCm / 100;
    if (hM <= 0) return;

    const bmi = w / (hM * hM);
    const minW = 18.5 * (hM * hM);
    const maxW = 24.9 * (hM * hM);

    document.getElementById('bmi-val')!.textContent = bmi.toFixed(2);
    document.getElementById('bmi-healthy')!.textContent = minW.toFixed(1) + ' - ' + maxW.toFixed(1) + ' kg';

    const statEl = document.getElementById('bmi-status');
    if (statEl) {
      if (bmi < 18.5) { statEl.textContent = 'Underweight (< 18.5)'; statEl.className = 'text-xs text-amber-600 font-semibold mt-2'; }
      else if (bmi <= 24.9) { statEl.textContent = 'Normal Weight (18.5 - 24.9)'; statEl.className = 'text-xs text-emerald-600 font-semibold mt-2'; }
      else if (bmi <= 29.9) { statEl.textContent = 'Overweight (25.0 - 29.9)'; statEl.className = 'text-xs text-amber-600 font-semibold mt-2'; }
      else { statEl.textContent = 'Obese (≥ 30.0)'; statEl.className = 'text-xs text-rose-600 font-semibold mt-2'; }
    }
  }


  document.getElementById('bmi-calc-btn')?.addEventListener('click', calculate);
</script>