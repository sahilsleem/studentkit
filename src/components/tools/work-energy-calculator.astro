---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Mass (kg)</label>
          <input type="number" id="we-m" placeholder="e.g. 5" min="0" step="any" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Velocity (v in m/s)</label>
          <input type="number" id="we-v" placeholder="e.g. 10" step="any" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Height (h in m)</label>
          <input type="number" id="we-h" placeholder="e.g. 4" step="any" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>

        <button id="we-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Kinetic & Potential Energy
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Kinetic Energy (KE = ½mv²)</div>
          <div id="we-ke" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 space-y-2 text-xs text-slate-600">
          <div class="flex justify-between">
            <span>Potential Energy (PE = mgh):</span>
            <strong id="we-pe" class="text-slate-800 font-mono">--</strong>
          </div>
          <div class="flex justify-between">
            <span>Total Mechanical Energy:</span>
            <strong id="we-total" class="text-slate-800 font-mono">--</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const m = parseFloat((document.getElementById('we-m') as HTMLInputElement)?.value || '0');
    const v = parseFloat((document.getElementById('we-v') as HTMLInputElement)?.value || '0');
    const h = parseFloat((document.getElementById('we-h') as HTMLInputElement)?.value || '0');
    const g = 9.80665;

    const ke = 0.5 * m * v * v;
    const pe = m * g * h;
    const tot = ke + pe;

    document.getElementById('we-ke')!.textContent = ke.toFixed(2) + ' J';
    document.getElementById('we-pe')!.textContent = pe.toFixed(2) + ' J';
    document.getElementById('we-total')!.textContent = tot.toFixed(2) + ' J';
  }


  document.getElementById('we-calc-btn')?.addEventListener('click', calculate);
</script>