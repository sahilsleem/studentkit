---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Mass (kg)</label>
          <input type="number" id="we-m" placeholder="e.g. 5" min="0" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Velocity (v in m/s)</label>
          <input type="number" id="we-v" placeholder="e.g. 10" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Height (h in m)</label>
          <input type="number" id="we-h" placeholder="e.g. 4" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>

        <button id="we-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Kinetic & Potential Energy
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Kinetic Energy (KE = ½mv²)</div>
          <div id="we-ke" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 space-y-1.5 text-xs text-slate-muted">
          <div class="flex flex-wrap justify-between gap-2">
            <span>Potential Energy (PE = mgh):</span>
            <strong id="we-pe" class="text-ink font-mono break-words">--</strong>
          </div>
          <div class="flex flex-wrap justify-between gap-2">
            <span>Total Mechanical Energy:</span>
            <strong id="we-total" class="text-ink font-mono break-words">--</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const m = parseFloat((document.getElementById('we-m') as HTMLInputElement)?.value || '0');
    const v = parseFloat((document.getElementById('we-v') as HTMLInputElement)?.value || '0');
    const h = parseFloat((document.getElementById('we-h') as HTMLInputElement)?.value || '0');
    const g = 9.80665;

    const ke = 0.5 * m * v * v;
    const pe = m * g * h;
    const tot = ke + pe;

    document.getElementById('we-ke')!.textContent = ke.toFixed(2) + ' J';
    document.getElementById('we-pe')!.textContent = pe.toFixed(2) + ' J';
    document.getElementById('we-total')!.textContent = tot.toFixed(2) + ' J';
  }


  document.getElementById('we-calc-btn')?.addEventListener('click', calculate);
</script>