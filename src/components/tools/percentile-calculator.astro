---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Dataset (comma separated)</label>
          <textarea id="prc-data" rows="3" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 font-mono" placeholder="e.g. 15, 20, 35, 40, 50, 65, 70, 75, 80, 90"></textarea>
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Percentile Rank (P%)</label>
          <input type="number" id="prc-rank" min="1" max="99" placeholder="e.g. 75" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <button id="prc-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Percentile Value
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">75th Percentile (Q₃)</div>
          <div id="prc-val" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
          <div class="text-xs text-slate-500 mt-2">75% of values fall below this point</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const raw = (document.getElementById('prc-data') as HTMLTextAreaElement)?.value || '';
    const p = parseFloat((document.getElementById('prc-rank') as HTMLInputElement)?.value || '50');
    const nums = raw.split(/[,\s]+/).map(s => parseFloat(s.trim())).filter(n => !isNaN(n)).sort((a, b) => a - b);

    if (nums.length === 0) return;

    const rank = (p / 100) * (nums.length - 1);
    const low = Math.floor(rank);
    const high = Math.ceil(rank);
    const weight = rank - low;

    const val = nums[low] + weight * (nums[high] - nums[low]);

    const valEl = document.getElementById('prc-val');
    if (valEl) valEl.textContent = val.toFixed(2);
  }


  document.getElementById('prc-calc-btn')?.addEventListener('click', calculate);
</script>