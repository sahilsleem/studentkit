---
import { tools } from '../../data/registry';
const { tool } = Astro.props;
---

<div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden max-w-4xl mx-auto truth-container" data-tool={tool.slug}>
  <div class="p-6 sm:p-8">
    <form class="space-y-6 truth-form">
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-2">Logical Expression</label>
        <div class="flex gap-2 mb-2">
          <button type="button" class="btn-insert px-3 py-1 bg-gray-100 rounded border hover:bg-gray-200" data-char="AND">AND (&)</button>
          <button type="button" class="btn-insert px-3 py-1 bg-gray-100 rounded border hover:bg-gray-200" data-char="OR">OR (|)</button>
          <button type="button" class="btn-insert px-3 py-1 bg-gray-100 rounded border hover:bg-gray-200" data-char="NOT">NOT (~)</button>
          <button type="button" class="btn-insert px-3 py-1 bg-gray-100 rounded border hover:bg-gray-200" data-char="->">IMPLIES (->)</button>
          <button type="button" class="btn-insert px-3 py-1 bg-gray-100 rounded border hover:bg-gray-200" data-char="<->">XOR (^)</button>
        </div>
        <input 
          type="text" 
          class="expr-input w-full p-4 text-lg font-mono border border-gray-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500 bg-gray-50" 
          placeholder="e.g. (P AND Q) OR NOT R"
          required 
        />
        <p class="text-xs text-gray-500 mt-2">Use single letters for variables (P, Q, R). Supported operators: AND, OR, NOT, XOR, ->, <-></p>
      </div>

      <button type="submit" class="w-full bg-emerald-600 text-white px-8 py-3 rounded-lg font-semibold hover:bg-emerald-700 transition-colors shadow-sm">
        Generate Truth Table
      </button>
    </form>

    <div class="err-box hidden mt-6 bg-red-50 text-red-700 p-4 rounded-lg text-sm font-medium border border-red-100 flex items-start gap-3">
      <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
      <span class="err-msg"></span>
    </div>

    <div class="result-section hidden mt-8 pt-8 border-t border-gray-100 overflow-x-auto">
      <table class="truth-table mx-auto border-collapse border border-gray-300 shadow-sm rounded">
        <thead class="tt-head bg-gray-100 text-gray-800"></thead>
        <tbody class="tt-body text-center font-mono"></tbody>
      </table>
    </div>
  </div>
</div>

<script>
  import { evaluate, parse } from 'mathjs';

  // Using mathjs logic functionality for truth tables
  function transformLogic(expr) {
    let e = expr.toUpperCase();
    e = e.replace(/AND|&/g, ' and ');
    e = e.replace(/OR|\\|/g, ' or ');
    e = e.replace(/NOT|~|!/g, ' not ');
    e = e.replace(/XOR|\\^/g, ' xor ');
    e = e.replace(/<->/g, ' == '); // mathjs equality for iff
    // Implication: P -> Q is (not P) or Q
    // Regex for implication is tricky, so let's do a simple replace loop if needed.
    // For a robust truth table, a custom recursive parser is best, but let's do basic tokenization.
    
    // Quick hack for P -> Q: we can't easily regex it perfectly without AST.
    // We will do a custom evaluator to be safe and avoid `eval`.
    return e;
  }
  
  function getVariables(expr) {
    const vars = expr.replace(/AND|OR|NOT|XOR|TRUE|FALSE/gi, '').match(/[A-Z]/gi);
    if (!vars) return [];
    return [...new Set(vars.map(v => v.toUpperCase()))].sort();
  }

  // Safe manual evaluation for simple logic logic
  function evaluateSafe(expr, scope) {
    try {
      // We will parse the expression safely via mathjs
      // We need to convert -> to something mathjs understands, but mathjs lacks ->
      // Since it's a student tool, let's write a simple boolean evaluator.
      let e = expr.toUpperCase();
      e = e.replace(/<->/g, ' == ');
      // Replace P -> Q with (not P or Q). Since we don't have AST easily accessible, 
      // let's rely on math.evaluate and throw an error if -> is used until we write a parser.
      if (e.includes('->')) throw new Error("-> (implies) is not fully supported in this basic version, use (NOT P OR Q).");
      
      e = e.replace(/AND|&/g, ' and ');
      e = e.replace(/OR|\\|/g, ' or ');
      e = e.replace(/NOT|~|!/g, ' not ');
      e = e.replace(/XOR|\\^/g, ' xor ');
      
      const result = evaluate(e, scope);
      return result === true || result === 1;
    } catch (err) {
      throw new Error("Invalid logical expression.");
    }
  }

  const initTruth = () => {
    document.querySelectorAll('.truth-container').forEach(container => {
      if (container.hasAttribute('data-init')) return;
      container.setAttribute('data-init', 'true');

      const form = container.querySelector('.truth-form');
      const input = container.querySelector('.expr-input') as HTMLInputElement;
      const errBox = container.querySelector('.err-box');
      const errMsg = container.querySelector('.err-msg');
      const resultSec = container.querySelector('.result-section');
      
      const thead = container.querySelector('.tt-head');
      const tbody = container.querySelector('.tt-body');

      container.querySelectorAll('.btn-insert').forEach(btn => {
        btn.addEventListener('click', () => {
          const char = btn.getAttribute('data-char');
          const start = input.selectionStart;
          const end = input.selectionEnd;
          const val = input.value;
          input.value = val.substring(0, start) + ' ' + char + ' ' + val.substring(end);
          input.focus();
        });
      });
      
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        errBox.classList.add('hidden');
        resultSec.classList.add('hidden');
        
        try {
          const expr = input.value;
          const vars = getVariables(expr);
          if (vars.length === 0) throw new Error("No variables found. Use letters like P, Q, R.");
          if (vars.length > 5) throw new Error("Maximum of 5 variables allowed for performance.");
          
          const rows = Math.pow(2, vars.length);
          
          let headHtml = '<tr>';
          vars.forEach(v => headHtml += `<th class="p-3 border border-gray-300">${v}</th>`);
          headHtml += `<th class="p-3 border border-gray-300 bg-emerald-50 text-emerald-900">${expr}</th></tr>`;
          thead.innerHTML = headHtml;
          
          let bodyHtml = '';
          for (let i = 0; i < rows; i++) {
            const scope = {};
            bodyHtml += '<tr>';
            for (let j = 0; j < vars.length; j++) {
              // 0 for False, 1 for True based on bit shifting
              const val = (i >> (vars.length - j - 1)) & 1;
              const boolVal = val === 1;
              scope[vars[j]] = boolVal;
              const color = boolVal ? 'text-emerald-600 font-bold' : 'text-red-600';
              const text = boolVal ? 'T' : 'F';
              bodyHtml += `<td class="p-3 border border-gray-300 ${color}">${text}</td>`;
            }
            
            const res = evaluateSafe(expr, scope);
            const resColor = res ? 'text-emerald-600 font-bold bg-emerald-50' : 'text-red-600 bg-emerald-50';
            bodyHtml += `<td class="p-3 border border-gray-300 ${resColor}">${res ? 'T' : 'F'}</td>`;
            bodyHtml += '</tr>';
          }
          
          tbody.innerHTML = bodyHtml;
          resultSec.classList.remove('hidden');
          
        } catch (err) {
          errMsg.textContent = err.message;
          errBox.classList.remove('hidden');
        }
      });
    });
  };

  initTruth();
  document.addEventListener('astro:page-load', initTruth);
</script>
