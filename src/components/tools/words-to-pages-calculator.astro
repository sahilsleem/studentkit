---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Word Count</label>
          <input type="number" id="wp-words" min="1" placeholder="e.g. 2500" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Line Spacing</label>
            <select id="wp-spacing" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option value="1">Single (1.0)</option>
              <option value="1.5">1.5 Spacing</option>
              <option value="2" selected>Double (2.0)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Font Size</label>
            <select id="wp-size" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option value="10">10 pt</option>
              <option value="11">11 pt</option>
              <option value="12" selected>12 pt (Standard)</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Font Family</label>
          <select id="wp-font" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="times">Times New Roman</option>
            <option value="arial">Arial / Helvetica</option>
            <option value="calibri">Calibri</option>
            <option value="courier">Courier New (Monospace)</option>
          </select>
        </div>

        <button id="wp-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Page Count
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Estimated Standard Pages</div>
          <div id="wp-pages" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
          <div id="wp-density" class="text-xs text-slate-500 mt-2">~250 words per double-spaced page</div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 space-y-2 text-xs text-slate-600">
          <div class="flex justify-between">
            <span>Single-Spaced Estimate:</span>
            <strong id="wp-single-est" class="text-slate-800">5.0 pages</strong>
          </div>
          <div class="flex justify-between">
            <span>Double-Spaced Estimate:</span>
            <strong id="wp-double-est" class="text-slate-800">10.0 pages</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const wordsIn = document.getElementById('wp-words') as HTMLInputElement;
  const spacingSelect = document.getElementById('wp-spacing') as HTMLSelectElement;
  const sizeSelect = document.getElementById('wp-size') as HTMLSelectElement;
  const fontSelect = document.getElementById('wp-font') as HTMLSelectElement;
  const pagesEl = document.getElementById('wp-pages');
  const densityEl = document.getElementById('wp-density');
  const singleEst = document.getElementById('wp-single-est');
  const doubleEst = document.getElementById('wp-double-est');

  function calculate() {
    const words = parseFloat(wordsIn?.value || '0');
    const spacing = parseFloat(spacingSelect.value || '2');
    const size = parseFloat(sizeSelect.value || '12');
    const font = fontSelect.value;

    let baseWordsPerPage = 500; // 12pt single spaced Times New Roman
    if (font === 'courier') baseWordsPerPage = 380;
    else if (font === 'arial') baseWordsPerPage = 480;
    else if (font === 'calibri') baseWordsPerPage = 520;

    const sizeFactor = 12 / size;
    const wordsPerPage = (baseWordsPerPage * sizeFactor) / spacing;

    const pages = words / wordsPerPage;
    const singlePages = words / (baseWordsPerPage * sizeFactor);
    const doublePages = words / ((baseWordsPerPage * sizeFactor) / 2);

    if (pagesEl) pagesEl.textContent = pages.toFixed(1) + ' pages';
    if (densityEl) densityEl.textContent = '~' + Math.round(wordsPerPage) + ' words per page with selected formatting';
    if (singleEst) singleEst.textContent = singlePages.toFixed(1) + ' pages';
    if (doubleEst) doubleEst.textContent = doublePages.toFixed(1) + ' pages';
  }


  document.getElementById('wp-calc-btn')?.addEventListener('click', calculate);
</script>