---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Word Count</label>
          <input type="number" id="wp-words" min="1" placeholder="e.g. 2500" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Line Spacing</label>
            <select id="wp-spacing" class="w-full px-3 py-2 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent">
              <option value="1">Single (1.0)</option>
              <option value="1.5">1.5 Spacing</option>
              <option value="2" selected>Double (2.0)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Font Size</label>
            <select id="wp-size" class="w-full px-3 py-2 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent">
              <option value="10">10 pt</option>
              <option value="11">11 pt</option>
              <option value="12" selected>12 pt (Standard)</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Font Family</label>
          <select id="wp-font" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent">
            <option value="times">Times New Roman</option>
            <option value="arial">Arial / Helvetica</option>
            <option value="calibri">Calibri</option>
            <option value="courier">Courier New (Monospace)</option>
          </select>
        </div>

        <button id="wp-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Page Count
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Estimated Standard Pages</div>
          <div id="wp-pages" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div id="wp-density" class="text-xs text-slate-muted mt-1">~250 words per double-spaced page</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 space-y-1.5 text-xs text-slate-muted">
          <div class="flex flex-wrap justify-between gap-2">
            <span>Single-Spaced Estimate:</span>
            <strong id="wp-single-est" class="text-ink">5.0 pages</strong>
          </div>
          <div class="flex flex-wrap justify-between gap-2">
            <span>Double-Spaced Estimate:</span>
            <strong id="wp-double-est" class="text-ink">10.0 pages</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const wordsIn = document.getElementById('wp-words') as HTMLInputElement;
  const spacingSelect = document.getElementById('wp-spacing') as HTMLSelectElement;
  const sizeSelect = document.getElementById('wp-size') as HTMLSelectElement;
  const fontSelect = document.getElementById('wp-font') as HTMLSelectElement;
  const pagesEl = document.getElementById('wp-pages');
  const densityEl = document.getElementById('wp-density');
  const singleEst = document.getElementById('wp-single-est');
  const doubleEst = document.getElementById('wp-double-est');

  function calculate() {
    const words = parseFloat(wordsIn?.value || '0');
    const spacing = parseFloat(spacingSelect.value || '2');
    const size = parseFloat(sizeSelect.value || '12');
    const font = fontSelect.value;

    let baseWordsPerPage = 500; // 12pt single spaced Times New Roman
    if (font === 'courier') baseWordsPerPage = 380;
    else if (font === 'arial') baseWordsPerPage = 480;
    else if (font === 'calibri') baseWordsPerPage = 520;

    const sizeFactor = 12 / size;
    const wordsPerPage = (baseWordsPerPage * sizeFactor) / spacing;

    const pages = words / wordsPerPage;
    const singlePages = words / (baseWordsPerPage * sizeFactor);
    const doublePages = words / ((baseWordsPerPage * sizeFactor) / 2);

    if (pagesEl) pagesEl.textContent = pages.toFixed(1) + ' pages';
    if (densityEl) densityEl.textContent = '~' + Math.round(wordsPerPage) + ' words per page with selected formatting';
    if (singleEst) singleEst.textContent = singlePages.toFixed(1) + ' pages';
    if (doubleEst) doubleEst.textContent = doublePages.toFixed(1) + ' pages';
  }


  document.getElementById('wp-calc-btn')?.addEventListener('click', calculate);
</script>