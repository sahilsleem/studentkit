---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Standard Decimal Number</label>
          <input type="text" id="sn-input" placeholder="e.g. 0.0000456" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent font-mono" />
        </div>

        <button id="sn-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Convert Formats
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Scientific Notation (a × 10ⁿ)</div>
          <div id="sn-result" class="text-3xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 space-y-1.5 text-xs text-slate-muted">
          <div class="flex flex-wrap justify-between gap-2">
            <span>Engineering Notation:</span>
            <strong id="sn-eng" class="text-ink font-mono break-words">45.6 × 10⁻⁶</strong>
          </div>
          <div class="flex flex-wrap justify-between gap-2">
            <span>E-Notation:</span>
            <strong id="sn-enot" class="text-ink font-mono break-words">4.56e-5</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function convert() {
    const raw = (document.getElementById('sn-input') as HTMLInputElement)?.value || '0';
    const num = parseFloat(raw);

    if (isNaN(num) || num === 0) return;

    const exp = Math.floor(Math.log10(Math.abs(num)));
    const coeff = num / Math.pow(10, exp);

    const engExp = Math.floor(exp / 3) * 3;
    const engCoeff = num / Math.pow(10, engExp);

    const resEl = document.getElementById('sn-result');
    const engEl = document.getElementById('sn-eng');
    const enotEl = document.getElementById('sn-enot');

    if (resEl) resEl.textContent = coeff.toFixed(4) + ' × 10^' + exp;
    if (engEl) engEl.textContent = engCoeff.toFixed(3) + ' × 10^' + engExp;
    if (enotEl) enotEl.textContent = num.toExponential(4);
  }

  document.getElementById('sn-input')?.addEventListener('input', convert);
  document.getElementById('sn-calc-btn')?.addEventListener('click', convert);
  convert();
</script>