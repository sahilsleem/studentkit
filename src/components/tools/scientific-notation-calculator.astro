---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Standard Decimal Number</label>
          <input type="text" id="sn-input" placeholder="e.g. 0.0000456" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 font-mono" />
        </div>

        <button id="sn-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Convert Formats
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Scientific Notation (a × 10ⁿ)</div>
          <div id="sn-result" class="text-3xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 space-y-2 text-xs text-slate-600">
          <div class="flex justify-between">
            <span>Engineering Notation:</span>
            <strong id="sn-eng" class="text-slate-800 font-mono">45.6 × 10⁻⁶</strong>
          </div>
          <div class="flex justify-between">
            <span>E-Notation:</span>
            <strong id="sn-enot" class="text-slate-800 font-mono">4.56e-5</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function convert() {
    const raw = (document.getElementById('sn-input') as HTMLInputElement)?.value || '0';
    const num = parseFloat(raw);

    if (isNaN(num) || num === 0) return;

    const exp = Math.floor(Math.log10(Math.abs(num)));
    const coeff = num / Math.pow(10, exp);

    const engExp = Math.floor(exp / 3) * 3;
    const engCoeff = num / Math.pow(10, engExp);

    const resEl = document.getElementById('sn-result');
    const engEl = document.getElementById('sn-eng');
    const enotEl = document.getElementById('sn-enot');

    if (resEl) resEl.textContent = coeff.toFixed(4) + ' × 10^' + exp;
    if (engEl) engEl.textContent = engCoeff.toFixed(3) + ' × 10^' + engExp;
    if (enotEl) enotEl.textContent = num.toExponential(4);
  }

  document.getElementById('sn-input')?.addEventListener('input', convert);
  document.getElementById('sn-calc-btn')?.addEventListener('click', convert);
  convert();
</script>