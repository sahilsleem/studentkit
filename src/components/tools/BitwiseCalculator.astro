<div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden mb-12 max-w-4xl mx-auto">
  <div class="p-6 sm:p-8">
    <div class="mb-6">
      <h2 class="text-xl font-bold text-gray-900 mb-2">Bitwise Calculator</h2>
      <p class="text-sm text-gray-600">Perform binary and bitwise operations (AND, OR, XOR, NOT, Shifts) with selectable 8, 16, 32, and 64-bit integer widths and two's-complement representations.</p>
    </div>

    <!-- Bit Width Selector -->
    <div class="flex flex-wrap items-center gap-3 mb-6 bg-gray-50 border border-gray-200/80 rounded-xl p-3">
      <span class="text-xs font-bold uppercase tracking-wider text-gray-600">Bit Width:</span>
      <div class="flex flex-wrap gap-2">
        <button type="button" class="bw-width-btn px-3 py-1.5 text-xs font-semibold rounded-lg bg-emerald-600 text-white transition-colors" data-width="8">8-bit</button>
        <button type="button" class="bw-width-btn px-3 py-1.5 text-xs font-semibold rounded-lg bg-white border border-gray-300 text-gray-700 hover:bg-gray-100 transition-colors" data-width="16">16-bit</button>
        <button type="button" class="bw-width-btn px-3 py-1.5 text-xs font-semibold rounded-lg bg-white border border-gray-300 text-gray-700 hover:bg-gray-100 transition-colors" data-width="32">32-bit</button>
        <button type="button" class="bw-width-btn px-3 py-1.5 text-xs font-semibold rounded-lg bg-white border border-gray-300 text-gray-700 hover:bg-gray-100 transition-colors" data-width="64">64-bit</button>
      </div>
    </div>

    <form id="bw-form" class="space-y-6">
      <!-- Operation Selector -->
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-gray-600 mb-2">Bitwise Operation</label>
        <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-2">
          <button type="button" class="bw-op-btn px-3 py-2 text-xs font-bold rounded-lg bg-emerald-600 text-white transition-colors text-center" data-op="AND">AND (&)</button>
          <button type="button" class="bw-op-btn px-3 py-2 text-xs font-bold rounded-lg bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors text-center" data-op="OR">OR (|)</button>
          <button type="button" class="bw-op-btn px-3 py-2 text-xs font-bold rounded-lg bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors text-center" data-op="XOR">XOR (^)</button>
          <button type="button" class="bw-op-btn px-3 py-2 text-xs font-bold rounded-lg bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors text-center" data-op="NOT">NOT (~)</button>
          <button type="button" class="bw-op-btn px-3 py-2 text-xs font-bold rounded-lg bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors text-center" data-op="LSHIFT">Left Shift (&lt;&lt;)</button>
          <button type="button" class="bw-op-btn px-3 py-2 text-xs font-bold rounded-lg bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors text-center" data-op="RSHIFT_LOGICAL">Logical &gt;&gt;&gt;</button>
          <button type="button" class="bw-op-btn px-3 py-2 text-xs font-bold rounded-lg bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors text-center" data-op="RSHIFT_ARITHMETIC">Arith &gt;&gt;</button>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <!-- Operand A -->
        <div>
          <div class="flex justify-between items-center mb-1">
            <label for="bw-a-val" class="block text-sm font-semibold text-gray-800">Operand A</label>
            <select id="bw-a-base" class="text-xs bg-white border border-gray-300 rounded px-2 py-0.5 text-gray-700">
              <option value="dec" selected>Decimal</option>
              <option value="bin">Binary</option>
              <option value="hex">Hex (0x)</option>
            </select>
          </div>
          <input
            type="text"
            id="bw-a-val"
            value="13"
            required
            class="block w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 font-mono text-base font-medium text-gray-900"
            placeholder="e.g. 13"
          />
        </div>

        <!-- Operand B (Hidden for NOT) -->
        <div id="bw-b-container">
          <div class="flex justify-between items-center mb-1">
            <label id="bw-b-label" for="bw-b-val" class="block text-sm font-semibold text-gray-800">Operand B</label>
            <select id="bw-b-base" class="text-xs bg-white border border-gray-300 rounded px-2 py-0.5 text-gray-700">
              <option value="dec" selected>Decimal</option>
              <option value="bin">Binary</option>
              <option value="hex">Hex (0x)</option>
            </select>
          </div>
          <input
            type="text"
            id="bw-b-val"
            value="7"
            class="block w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 font-mono text-base font-medium text-gray-900"
            placeholder="e.g. 7"
          />
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row gap-3 pt-2">
        <button type="submit" class="flex-1 bg-emerald-600 text-white px-6 py-3 rounded-xl font-semibold hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors shadow-sm min-h-[44px]">
          Compute Operation
        </button>
        <button type="button" id="reset-btn" class="px-6 py-3 border border-gray-300 rounded-xl text-gray-700 font-semibold hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors min-h-[44px]">
          Reset
        </button>
      </div>
    </form>

    <div id="error-box" class="hidden mt-6 bg-red-50 text-red-700 p-4 rounded-xl text-sm font-medium border border-red-200"></div>

    <!-- Results Section -->
    <div id="result-section" class="mt-8 pt-8 border-t border-gray-100" aria-live="polite">
      <!-- Main Result Card -->
      <div class="bg-gradient-to-br from-emerald-50 to-teal-50 border border-emerald-200/80 rounded-2xl p-6 sm:p-8 text-center relative mb-6">
        <div class="flex justify-end absolute top-4 right-4">
          <button
            type="button"
            id="copy-result-btn"
            class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg bg-white/90 hover:bg-white text-emerald-800 border border-emerald-200 shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-emerald-500 min-h-[36px]"
            title="Copy calculated binary result"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
            <span>Copy Result</span>
          </button>
        </div>
        <p id="bw-main-op-label" class="text-xs font-bold uppercase tracking-wider text-emerald-800 mb-1">Result (8-bit Binary)</p>
        <div id="bw-res-binary" class="text-3xl sm:text-4xl font-extrabold text-emerald-950 my-2 font-mono break-all tracking-wider">0000 0101</div>
        <p id="bw-res-expression" class="text-xs text-emerald-700 font-mono">13 AND 7 = 5</p>
      </div>

      <!-- Multi-Base Breakdown Table -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-6">
        <div class="bg-gray-50 rounded-xl p-4 border border-gray-200/70 text-center">
          <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Unsigned Decimal</p>
          <div id="bw-res-unsigned" class="text-xl font-bold font-mono text-gray-900">5</div>
        </div>
        <div class="bg-gray-50 rounded-xl p-4 border border-gray-200/70 text-center">
          <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Signed (Two's Comp)</p>
          <div id="bw-res-signed" class="text-xl font-bold font-mono text-gray-900">5</div>
        </div>
        <div class="bg-gray-50 rounded-xl p-4 border border-gray-200/70 text-center">
          <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Hexadecimal</p>
          <div id="bw-res-hex" class="text-xl font-bold font-mono text-gray-900">0x05</div>
        </div>
      </div>

      <!-- Bit-by-Bit Step Table -->
      <div class="bg-gray-50 rounded-xl p-5 border border-gray-200">
        <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-2">Bitwise Alignment</h3>
        <div class="overflow-x-auto">
          <div id="bw-steps-content" class="text-sm font-mono space-y-1 bg-white p-4 rounded-lg border border-gray-200/80">
            <!-- Populated by JS -->
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { copyToClipboard } from '../../utils/formatters';

  const initBitwise = () => {
    let currentWidth = 8;
    let currentOp = 'AND';

    const form = document.getElementById('bw-form') as HTMLFormElement;
    const widthBtns = document.querySelectorAll('.bw-width-btn');
    const opBtns = document.querySelectorAll('.bw-op-btn');

    const inputAVal = document.getElementById('bw-a-val') as HTMLInputElement;
    const inputABase = document.getElementById('bw-a-base') as HTMLSelectElement;
    const inputBVal = document.getElementById('bw-b-val') as HTMLInputElement;
    const inputBBase = document.getElementById('bw-b-base') as HTMLSelectElement;
    const containerB = document.getElementById('bw-b-container');
    const labelB = document.getElementById('bw-b-label');

    const resetBtn = document.getElementById('reset-btn');
    const copyBtn = document.getElementById('copy-result-btn');
    const errorBox = document.getElementById('error-box');

    const mainOpLabel = document.getElementById('bw-main-op-label');
    const resBinary = document.getElementById('bw-res-binary');
    const resExpr = document.getElementById('bw-res-expression');
    const resUnsigned = document.getElementById('bw-res-unsigned');
    const resSigned = document.getElementById('bw-res-signed');
    const resHex = document.getElementById('bw-res-hex');
    const stepsContent = document.getElementById('bw-steps-content');

    if (!form || !inputAVal) return;

    const parseInputBigInt = (rawStr: string, base: string, width: number): bigint | null => {
      let str = rawStr.trim();
      if (!str) return null;
      try {
        if (base === 'hex') {
          str = str.replace(/^0x/i, '');
          if (!/^[0-9a-fA-F]+$/.test(str)) return null;
          return BigInt('0x' + str);
        } else if (base === 'bin') {
          str = str.replace(/\s+/g, '');
          if (!/^[01]+$/.test(str)) return null;
          return BigInt('0b' + str);
        } else {
          // decimal (handles signed input like -5)
          if (!/^-?\d+$/.test(str)) return null;
          const val = BigInt(str);
          if (val < 0n) {
            const mask = (1n << BigInt(width)) - 1n;
            return (val + (1n << BigInt(width))) & mask;
          }
          return val;
        }
      } catch (e) {
        return null;
      }
    };

    const formatBinaryNibbles = (binStr: string): string => {
      const chunks: string[] = [];
      for (let i = 0; i < binStr.length; i += 4) {
        chunks.push(binStr.slice(i, i + 4));
      }
      return chunks.join(' ');
    };

    const calculate = () => {
      errorBox?.classList.add('hidden');

      const width = BigInt(currentWidth);
      const mask = (1n << width) - 1n;
      const signBit = 1n << (width - 1n);

      const aParsed = parseInputBigInt(inputAVal.value, inputABase.value, currentWidth);
      if (aParsed === null) {
        if (errorBox) {
          errorBox.textContent = `Invalid value for Operand A in ${inputABase.value.toUpperCase()} format.`;
          errorBox.classList.remove('hidden');
        }
        return;
      }

      const a = aParsed & mask;
      let b = 0n;

      if (currentOp !== 'NOT') {
        const bParsed = parseInputBigInt(inputBVal.value, inputBBase.value, currentWidth);
        if (bParsed === null) {
          if (errorBox) {
            errorBox.textContent = `Invalid value for Operand B in ${inputBBase.value.toUpperCase()} format.`;
            errorBox.classList.remove('hidden');
          }
          return;
        }
        b = bParsed & mask;
      }

      let res = 0n;
      let opSymbol = '&';

      if (currentOp === 'AND') {
        res = (a & b) & mask;
        opSymbol = '&';
      } else if (currentOp === 'OR') {
        res = (a | b) & mask;
        opSymbol = '|';
      } else if (currentOp === 'XOR') {
        res = (a ^ b) & mask;
        opSymbol = '^';
      } else if (currentOp === 'NOT') {
        res = (~a) & mask;
        opSymbol = '~';
      } else if (currentOp === 'LSHIFT') {
        const shiftAmt = b % width;
        res = (a << shiftAmt) & mask;
        opSymbol = '<<';
      } else if (currentOp === 'RSHIFT_LOGICAL') {
        const shiftAmt = b % width;
        res = (a >> shiftAmt) & mask;
        opSymbol = '>>>';
      } else if (currentOp === 'RSHIFT_ARITHMETIC') {
        const shiftAmt = b % width;
        const isNeg = (a & signBit) !== 0n;
        let shifted = a >> shiftAmt;
        if (isNeg) {
          const pad = (mask >> shiftAmt) ^ mask;
          shifted = shifted | pad;
        }
        res = shifted & mask;
        opSymbol = '>>';
      }

      const unsignedStr = res.toString(10);
      const isNegative = (res & signBit) !== 0n;
      const signedStr = isNegative ? (res - (1n << width)).toString(10) : unsignedStr;
      const rawBin = res.toString(2).padStart(currentWidth, '0');
      const binFormatted = formatBinaryNibbles(rawBin);
      const hexDigits = Math.ceil(currentWidth / 4);
      const hexStr = '0x' + res.toString(16).toUpperCase().padStart(hexDigits, '0');

      if (mainOpLabel) mainOpLabel.textContent = `Result (${currentWidth}-bit Binary)`;
      if (resBinary) resBinary.textContent = binFormatted;
      if (resExpr) {
        if (currentOp === 'NOT') {
          resExpr.textContent = `NOT ${a.toString(10)} = ${signedStr} (unsigned ${unsignedStr})`;
        } else {
          resExpr.textContent = `${a.toString(10)} ${currentOp} ${b.toString(10)} = ${signedStr}`;
        }
      }

      if (resUnsigned) resUnsigned.textContent = unsignedStr;
      if (resSigned) resSigned.textContent = signedStr;
      if (resHex) resHex.textContent = hexStr;

      // Step alignment display
      if (stepsContent) {
        const aBin = formatBinaryNibbles(a.toString(2).padStart(currentWidth, '0'));
        if (currentOp === 'NOT') {
          stepsContent.innerHTML = `
            <div class="flex justify-between py-0.5 border-b border-gray-100"><span>A (input):</span><span class="text-gray-900 font-bold">${aBin}</span></div>
            <div class="flex justify-between py-0.5 font-bold text-emerald-700"><span>~A (NOT):</span><span>${binFormatted}</span></div>
          `;
        } else {
          const bBin = formatBinaryNibbles(b.toString(2).padStart(currentWidth, '0'));
          stepsContent.innerHTML = `
            <div class="flex justify-between py-0.5"><span>A:</span><span class="text-gray-900 font-medium">${aBin}</span></div>
            <div class="flex justify-between py-0.5 border-b border-gray-200"><span>B (${opSymbol}):</span><span class="text-gray-900 font-medium">${bBin}</span></div>
            <div class="flex justify-between py-0.5 font-bold text-emerald-700"><span>Result:</span><span>${binFormatted}</span></div>
          `;
        }
      }
    };

    // Width buttons
    widthBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        currentWidth = parseInt(btn.getAttribute('data-width') || '8', 10);
        widthBtns.forEach(b => {
          b.className = 'bw-width-btn px-3 py-1.5 text-xs font-semibold rounded-lg bg-white border border-gray-300 text-gray-700 hover:bg-gray-100 transition-colors';
        });
        btn.className = 'bw-width-btn px-3 py-1.5 text-xs font-semibold rounded-lg bg-emerald-600 text-white transition-colors';
        calculate();
      });
    });

    // Op buttons
    opBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        currentOp = btn.getAttribute('data-op') || 'AND';
        opBtns.forEach(b => {
          b.className = 'bw-op-btn px-3 py-2 text-xs font-bold rounded-lg bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors text-center';
        });
        btn.className = 'bw-op-btn px-3 py-2 text-xs font-bold rounded-lg bg-emerald-600 text-white transition-colors text-center';

        if (currentOp === 'NOT') {
          containerB?.classList.add('hidden');
        } else {
          containerB?.classList.remove('hidden');
          if (labelB) {
            if (currentOp.includes('SHIFT')) labelB.textContent = 'Shift Count (bits)';
            else labelB.textContent = 'Operand B';
          }
        }
        calculate();
      });
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      calculate();
    });

    inputAVal.addEventListener('input', calculate);
    inputABase.addEventListener('change', calculate);
    inputBVal.addEventListener('input', calculate);
    inputBBase.addEventListener('change', calculate);

    resetBtn?.addEventListener('click', () => {
      currentWidth = 8;
      currentOp = 'AND';
      inputAVal.value = '13';
      inputABase.value = 'dec';
      inputBVal.value = '7';
      inputBBase.value = 'dec';
      containerB?.classList.remove('hidden');
      widthBtns.forEach((b, i) => {
        b.className = i === 0 ? 'bw-width-btn px-3 py-1.5 text-xs font-semibold rounded-lg bg-emerald-600 text-white transition-colors' : 'bw-width-btn px-3 py-1.5 text-xs font-semibold rounded-lg bg-white border border-gray-300 text-gray-700 hover:bg-gray-100 transition-colors';
      });
      opBtns.forEach((b, i) => {
        b.className = i === 0 ? 'bw-op-btn px-3 py-2 text-xs font-bold rounded-lg bg-emerald-600 text-white transition-colors text-center' : 'bw-op-btn px-3 py-2 text-xs font-bold rounded-lg bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors text-center';
      });
      calculate();
    });

    copyBtn?.addEventListener('click', async () => {
      const text = resBinary?.textContent || '';
      const success = await copyToClipboard(text);
      if (success) {
        const span = copyBtn.querySelector('span');
        if (span) {
          const original = span.textContent;
          span.textContent = 'Copied!';
          setTimeout(() => { span.textContent = original; }, 1500);
        }
      }
    });

    calculate();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBitwise);
  } else {
    initBitwise();
  }
</script>
