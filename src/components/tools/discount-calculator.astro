---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Original Price (₹)</label>
          <input type="number" id="dc-price" step="0.01" min="0" placeholder="e.g. 120" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Primary Discount (%)</label>
          <input type="number" id="dc-discount1" step="1" min="0" max="100" placeholder="e.g. 25" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Additional Coupon / Promo (%)</label>
          <input type="number" id="dc-discount2" step="1" min="0" max="100" placeholder="e.g. 10" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Sales Tax (%)</label>
          <input type="number" id="dc-tax" step="0.1" min="0" max="30" placeholder="e.g. 8" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <button id="dc-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Final Price
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Final Price After Tax</div>
          <div id="dc-final-price" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div id="dc-savings-badge" class="text-xs text-slate-muted font-semibold mt-1">Savings details will appear here</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 space-y-1.5 text-xs text-slate-muted">
          <div class="flex flex-wrap justify-between gap-2">
            <span>Discounted Subtotal:</span>
            <strong id="dc-subtotal" class="text-ink">--</strong>
          </div>
          <div class="flex flex-wrap justify-between gap-2">
            <span>Sales Tax Amount:</span>
            <strong id="dc-tax-amount" class="text-ink">--</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const priceIn = document.getElementById('dc-price') as HTMLInputElement;
  const d1In = document.getElementById('dc-discount1') as HTMLInputElement;
  const d2In = document.getElementById('dc-discount2') as HTMLInputElement;
  const taxIn = document.getElementById('dc-tax') as HTMLInputElement;

  const finalEl = document.getElementById('dc-final-price');
  const savingsEl = document.getElementById('dc-savings-badge');
  const subtotalEl = document.getElementById('dc-subtotal');
  const taxAmountEl = document.getElementById('dc-tax-amount');

  function calculate() {
    const price = parseFloat(priceIn?.value || '0');
    const d1 = parseFloat(d1In?.value || '0') / 100;
    const d2 = parseFloat(d2In?.value || '0') / 100;
    const taxRate = parseFloat(taxIn?.value || '0') / 100;

    const afterD1 = price * (1 - d1);
    const subtotal = afterD1 * (1 - d2);
    const tax = subtotal * taxRate;
    const finalPrice = subtotal + tax;
    const totalSavings = price - subtotal;
    const effectiveDiscountPct = price > 0 ? (totalSavings / price) * 100 : 0;

    const fmt = (v: number) => '₹' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    if (finalEl) finalEl.textContent = fmt(finalPrice);
    if (savingsEl) savingsEl.textContent = 'You Save ' + fmt(totalSavings) + ' (' + effectiveDiscountPct.toFixed(1) + '% effective discount)';
    if (subtotalEl) subtotalEl.textContent = fmt(subtotal);
    if (taxAmountEl) taxAmountEl.textContent = fmt(tax);
  }


  document.getElementById('dc-calc-btn')?.addEventListener('click', calculate);
</script>