---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Original Price ($)</label>
          <input type="number" id="dc-price" step="0.01" min="0" placeholder="e.g. 120" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Primary Discount (%)</label>
          <input type="number" id="dc-discount1" step="1" min="0" max="100" placeholder="e.g. 25" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Additional Coupon / Promo (%)</label>
          <input type="number" id="dc-discount2" step="1" min="0" max="100" placeholder="e.g. 10" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Sales Tax (%)</label>
          <input type="number" id="dc-tax" step="0.1" min="0" max="30" placeholder="e.g. 8" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <button id="dc-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Final Price
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Final Price After Tax</div>
          <div id="dc-final-price" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
          <div id="dc-savings-badge" class="text-xs text-slate-400 font-semibold mt-2">Savings details will appear here</div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 space-y-2 text-xs text-slate-600">
          <div class="flex justify-between">
            <span>Discounted Subtotal:</span>
            <strong id="dc-subtotal" class="text-slate-800">--</strong>
          </div>
          <div class="flex justify-between">
            <span>Sales Tax Amount:</span>
            <strong id="dc-tax-amount" class="text-slate-800">--</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const priceIn = document.getElementById('dc-price') as HTMLInputElement;
  const d1In = document.getElementById('dc-discount1') as HTMLInputElement;
  const d2In = document.getElementById('dc-discount2') as HTMLInputElement;
  const taxIn = document.getElementById('dc-tax') as HTMLInputElement;

  const finalEl = document.getElementById('dc-final-price');
  const savingsEl = document.getElementById('dc-savings-badge');
  const subtotalEl = document.getElementById('dc-subtotal');
  const taxAmountEl = document.getElementById('dc-tax-amount');

  function calculate() {
    const price = parseFloat(priceIn?.value || '0');
    const d1 = parseFloat(d1In?.value || '0') / 100;
    const d2 = parseFloat(d2In?.value || '0') / 100;
    const taxRate = parseFloat(taxIn?.value || '0') / 100;

    const afterD1 = price * (1 - d1);
    const subtotal = afterD1 * (1 - d2);
    const tax = subtotal * taxRate;
    const finalPrice = subtotal + tax;
    const totalSavings = price - subtotal;
    const effectiveDiscountPct = price > 0 ? (totalSavings / price) * 100 : 0;

    const fmt = (v: number) => '$' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    if (finalEl) finalEl.textContent = fmt(finalPrice);
    if (savingsEl) savingsEl.textContent = 'You Save ' + fmt(totalSavings) + ' (' + effectiveDiscountPct.toFixed(1) + '% effective discount)';
    if (subtotalEl) subtotalEl.textContent = fmt(subtotal);
    if (taxAmountEl) taxAmountEl.textContent = fmt(tax);
  }


  document.getElementById('dc-calc-btn')?.addEventListener('click', calculate);
</script>