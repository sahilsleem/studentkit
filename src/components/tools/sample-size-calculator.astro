---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Margin of Error (E %)</label>
          <input type="number" id="ss-me" min="0.5" max="20" step="0.5" placeholder="e.g. 5" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Confidence Level</label>
          <select id="ss-conf" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent">
            <option value="90">90% (z* = 1.645)</option>
            <option value="95" selected>95% (z* = 1.960)</option>
            <option value="99">99% (z* = 2.576)</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Total Population Size (Leave empty if infinite)</label>
          <input type="number" id="ss-pop" placeholder="e.g. 50000" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <button id="ss-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Required Sample Size
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Recommended Sample Size (n)</div>
          <div id="ss-result" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div class="text-xs text-slate-muted mt-1">Assumes 50% population proportion (maximum variance)</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const zMap: Record<string, number> = { '90': 1.645, '95': 1.96, '99': 2.576 };

  function calculate() {
    const e = parseFloat((document.getElementById('ss-me') as HTMLInputElement)?.value || '5') / 100;
    const conf = (document.getElementById('ss-conf') as HTMLSelectElement)?.value || '95';
    const popStr = (document.getElementById('ss-pop') as HTMLInputElement)?.value;
    const N = popStr ? parseFloat(popStr) : 0;

    const z = zMap[conf] || 1.96;
    const p = 0.5;

    let n = (z * z * p * (1 - p)) / (e * e);

    if (N > 0) {
      n = n / (1 + (n - 1) / N);
    }

    const finalN = Math.ceil(n);
    const resEl = document.getElementById('ss-result');
    if (resEl) resEl.textContent = finalN.toLocaleString() + ' respondents';
  }


  document.getElementById('ss-calc-btn')?.addEventListener('click', calculate);
</script>