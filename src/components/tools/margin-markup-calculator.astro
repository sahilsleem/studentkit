---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Cost Price (₹)</label>
          <input type="number" id="mm-cost" step="0.5" min="0" placeholder="e.g. 50" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Selling / Revenue Price (₹)</label>
          <input type="number" id="mm-revenue" step="0.5" min="0" placeholder="e.g. 80" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <button id="mm-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Margins
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Gross Profit</div>
          <div id="mm-profit" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 space-y-1.5 text-xs text-slate-muted">
          <div class="flex flex-wrap justify-between gap-2">
            <span>Profit Margin (Profit / Revenue):</span>
            <strong id="mm-margin" class="text-emerald-600 font-bold text-sm">37.50%</strong>
          </div>
          <div class="flex flex-wrap justify-between gap-2">
            <span>Markup Percentage (Profit / Cost):</span>
            <strong id="mm-markup" class="text-brand font-bold text-sm">60.00%</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const costIn = document.getElementById('mm-cost') as HTMLInputElement;
  const revIn = document.getElementById('mm-revenue') as HTMLInputElement;

  const profitEl = document.getElementById('mm-profit');
  const marginEl = document.getElementById('mm-margin');
  const markupEl = document.getElementById('mm-markup');

  function calculate() {
    const cost = parseFloat(costIn?.value || '0');
    const rev = parseFloat(revIn?.value || '0');

    const profit = rev - cost;
    const margin = rev > 0 ? (profit / rev) * 100 : 0;
    const markup = cost > 0 ? (profit / cost) * 100 : 0;

    const fmt = (v: number) => '₹' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    if (profitEl) profitEl.textContent = fmt(profit);
    if (marginEl) marginEl.textContent = margin.toFixed(2) + '%';
    if (markupEl) markupEl.textContent = markup.toFixed(2) + '%';
  }


  document.getElementById('mm-calc-btn')?.addEventListener('click', calculate);
</script>