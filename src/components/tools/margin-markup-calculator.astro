---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Cost Price ($)</label>
          <input type="number" id="mm-cost" step="0.5" min="0" placeholder="e.g. 50" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Selling / Revenue Price ($)</label>
          <input type="number" id="mm-revenue" step="0.5" min="0" placeholder="e.g. 80" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <button id="mm-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Margins
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Gross Profit</div>
          <div id="mm-profit" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 space-y-2 text-xs text-slate-600">
          <div class="flex justify-between">
            <span>Profit Margin (Profit / Revenue):</span>
            <strong id="mm-margin" class="text-emerald-600 font-bold text-sm">37.50%</strong>
          </div>
          <div class="flex justify-between">
            <span>Markup Percentage (Profit / Cost):</span>
            <strong id="mm-markup" class="text-blue-600 font-bold text-sm">60.00%</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const costIn = document.getElementById('mm-cost') as HTMLInputElement;
  const revIn = document.getElementById('mm-revenue') as HTMLInputElement;

  const profitEl = document.getElementById('mm-profit');
  const marginEl = document.getElementById('mm-margin');
  const markupEl = document.getElementById('mm-markup');

  function calculate() {
    const cost = parseFloat(costIn?.value || '0');
    const rev = parseFloat(revIn?.value || '0');

    const profit = rev - cost;
    const margin = rev > 0 ? (profit / rev) * 100 : 0;
    const markup = cost > 0 ? (profit / cost) * 100 : 0;

    const fmt = (v: number) => '$' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    if (profitEl) profitEl.textContent = fmt(profit);
    if (marginEl) marginEl.textContent = margin.toFixed(2) + '%';
    if (markupEl) markupEl.textContent = markup.toFixed(2) + '%';
  }


  document.getElementById('mm-calc-btn')?.addEventListener('click', calculate);
</script>