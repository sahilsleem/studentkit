---
import { tools } from '../../data/registry';
const { tool } = Astro.props;
---

<div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden max-w-4xl mx-auto dataset-container" data-tool={tool.slug}>
  <div class="p-6 sm:p-8">
    <form class="space-y-6 ds-form">
      <div>
        <label for="dataset-x" class="block text-sm font-semibold text-gray-700 mb-2">Data Set X (Comma or space separated numbers)</label>
        <textarea
          id="dataset-x"
          class="x-input w-full p-4 text-sm font-mono border border-gray-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500 bg-gray-50 placeholder-gray-400 h-24"
          placeholder="e.g. 10, 15, 20, 25, 30"
          required
        ></textarea>
      </div>

      <div class="y-input-group hidden">
        <label for="dataset-y" class="block text-sm font-semibold text-gray-700 mb-2">Data Set Y (For 2-variable stats like Correlation/Regression)</label>
        <textarea
          id="dataset-y"
          class="y-input w-full p-4 text-sm font-mono border border-gray-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500 bg-gray-50 placeholder-gray-400 h-24"
          placeholder="e.g. 2, 4, 6, 8, 10"
        ></textarea>
      </div>

      <div class="text-right">
        <label class="inline-flex items-center text-sm text-gray-600">
          <input type="checkbox" class="is-population mr-2 rounded text-emerald-600 focus:ring-emerald-500">
          Treat as Population (instead of Sample)
        </label>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 pt-2">
        <button type="submit" class="flex-1 bg-emerald-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors shadow-sm cursor-pointer">
          Calculate Statistics
        </button>
        <button type="button" class="ds-reset-btn px-6 py-3 border border-gray-300 rounded-lg text-gray-700 font-medium hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors cursor-pointer">
          Reset
        </button>
      </div>
    </form>

    <div class="err-box hidden mt-6 bg-red-50 text-red-700 p-4 rounded-lg text-sm font-medium border border-red-100 flex items-start gap-3">
      <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
      <span class="err-msg"></span>
    </div>

    <div class="result-section hidden mt-8 pt-8 border-t border-gray-100" aria-live="polite">

      <div class="primary-result mb-8 bg-emerald-50 p-6 rounded-xl border border-emerald-100 text-center relative">
        <div class="flex items-center justify-between mb-2">
          <h4 class="text-emerald-800 font-semibold text-sm" id="primary-label">Primary Result</h4>
          <button
            type="button"
            class="ds-copy-btn inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-emerald-700 bg-white hover:bg-emerald-50 active:bg-emerald-100 border border-emerald-200 rounded-md transition-colors shadow-xs focus:outline-none focus:ring-2 focus:ring-emerald-500 cursor-pointer"
            aria-label="Copy primary statistical result to clipboard"
          >
            <svg class="w-3.5 h-3.5 copy-icon text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
            </svg>
            <span class="copy-text">Copy Result</span>
          </button>
        </div>
        <p class="text-4xl font-bold text-emerald-900 font-mono" id="primary-value">--</p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8 basic-stats">
        <div class="bg-gray-50 p-4 rounded-lg text-center border border-gray-200">
          <p class="text-xs text-gray-500 font-semibold uppercase">Count (N)</p>
          <p class="res-n text-xl font-bold text-gray-900 font-mono"></p>
        </div>
        <div class="bg-gray-50 p-4 rounded-lg text-center border border-gray-200">
          <p class="text-xs text-gray-500 font-semibold uppercase">Mean</p>
          <p class="res-mean text-xl font-bold text-gray-900 font-mono"></p>
        </div>
        <div class="bg-gray-50 p-4 rounded-lg text-center border border-gray-200">
          <p class="text-xs text-gray-500 font-semibold uppercase">Median</p>
          <p class="res-median text-xl font-bold text-gray-900 font-mono"></p>
        </div>
        <div class="bg-gray-50 p-4 rounded-lg text-center border border-gray-200">
          <p class="text-xs text-gray-500 font-semibold uppercase">Std Dev</p>
          <p class="res-sd text-xl font-bold text-gray-900 font-mono"></p>
        </div>
      </div>

      <div class="advanced-stats grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <h4 class="font-bold text-gray-700 border-b pb-2 mb-3">Five Number Summary</h4>
          <ul class="space-y-2 text-sm">
            <li class="flex justify-between p-2 bg-gray-50 rounded"><span>Minimum:</span> <span class="res-min font-mono font-bold"></span></li>
            <li class="flex justify-between p-2 bg-gray-50 rounded"><span>Q1 (25th):</span> <span class="res-q1 font-mono font-bold"></span></li>
            <li class="flex justify-between p-2 bg-gray-50 rounded"><span>Median (Q2):</span> <span class="res-q2 font-mono font-bold"></span></li>
            <li class="flex justify-between p-2 bg-gray-50 rounded"><span>Q3 (75th):</span> <span class="res-q3 font-mono font-bold"></span></li>
            <li class="flex justify-between p-2 bg-gray-50 rounded"><span>Maximum:</span> <span class="res-max font-mono font-bold"></span></li>
            <li class="flex justify-between p-2 bg-emerald-50 text-emerald-900 rounded font-semibold mt-1"><span>IQR:</span> <span class="res-iqr font-mono font-bold"></span></li>
          </ul>
        </div>
        <div>
          <h4 class="font-bold text-gray-700 border-b pb-2 mb-3">Additional Metrics</h4>
          <ul class="space-y-2 text-sm">
            <li class="flex justify-between p-2 bg-gray-50 rounded"><span>Sum:</span> <span class="res-sum font-mono font-bold"></span></li>
            <li class="flex justify-between p-2 bg-gray-50 rounded"><span>Variance:</span> <span class="res-var font-mono font-bold"></span></li>
            <li class="flex justify-between p-2 bg-gray-50 rounded"><span>Std Error (SE):</span> <span class="res-se font-mono font-bold"></span></li>
            <li class="flex justify-between p-2 bg-gray-50 rounded"><span>Mean Abs Dev (MAD):</span> <span class="res-mad font-mono font-bold"></span></li>
            <li class="flex justify-between p-2 bg-gray-50 rounded"><span>Geom Mean:</span> <span class="res-geom font-mono font-bold"></span></li>
            <li class="flex justify-between p-2 bg-gray-50 rounded"><span>Harmonic Mean:</span> <span class="res-harm font-mono font-bold"></span></li>
          </ul>
        </div>
      </div>

      <div class="regression-stats hidden mt-6 pt-6 border-t border-gray-100">
        <h4 class="font-bold text-gray-700 border-b pb-2 mb-3">2-Variable Statistics (X & Y)</h4>
        <ul class="space-y-2 text-sm grid grid-cols-1 sm:grid-cols-2 gap-4">
          <li class="flex justify-between p-2 bg-emerald-50 text-emerald-900 rounded"><span>Correlation (r):</span> <span class="res-r font-mono font-bold"></span></li>
          <li class="flex justify-between p-2 bg-emerald-50 text-emerald-900 rounded"><span>Covariance:</span> <span class="res-cov font-mono font-bold"></span></li>
          <li class="flex justify-between p-2 bg-purple-50 text-purple-900 rounded"><span>Linear Eq (y = mx + b):</span> <span class="res-eq font-mono font-bold"></span></li>
          <li class="flex justify-between p-2 bg-purple-50 text-purple-900 rounded"><span>R-Squared (R²):</span> <span class="res-r2 font-mono font-bold"></span></li>
        </ul>
      </div>

    </div>
  </div>
</div>

<script>
  import { parseDataset, mean, median, standardDeviation, variance, percentiles, fiveNumberSummary, meanAbsoluteDeviation, geometricMean, harmonicMean, standardError, sum, correlation, covariance, linearRegression } from '../../utils/statistics';
  import { formatResultNumber, copyToClipboard } from '../../utils/formatters';

  const initDataset = () => {
    document.querySelectorAll('.dataset-container').forEach(container => {
      if (container.hasAttribute('data-init')) return;
      container.setAttribute('data-init', 'true');

      const slug = container.getAttribute('data-tool') || '';

      // Determine if we need Y input
      const needsY = ['covariance-calculator', 'correlation-coefficient', 'linear-regression-calculator', 'regression-equation-calculator', 'r-squared-calculator'].includes(slug);

      const form = container.querySelector('.ds-form') as HTMLFormElement;
      const xInput = container.querySelector('.x-input') as HTMLTextAreaElement;
      const yInputGroup = container.querySelector('.y-input-group');
      const yInput = container.querySelector('.y-input') as HTMLTextAreaElement;
      const popCheck = container.querySelector('.is-population') as HTMLInputElement;
      const resetBtn = container.querySelector('.ds-reset-btn');
      const copyBtn = container.querySelector('.ds-copy-btn');

      if (needsY && yInputGroup) {
        yInputGroup.classList.remove('hidden');
        yInput.required = true;
      }

      const errBox = container.querySelector('.err-box');
      const errMsg = container.querySelector('.err-msg');
      const resultSec = container.querySelector('.result-section');
      const regStats = container.querySelector('.regression-stats');
      const primaryLabelEl = container.querySelector('#primary-label');
      const primaryValueEl = container.querySelector('#primary-value');

      // Copy result functionality
      if (copyBtn) {
        copyBtn.addEventListener('click', async () => {
          if (!primaryValueEl || !primaryValueEl.textContent || primaryValueEl.textContent === '--') return;
          const label = primaryLabelEl ? primaryLabelEl.textContent?.trim() : 'Result';
          const val = primaryValueEl.textContent.trim();
          const copyText = `${label}: ${val}`;

          const success = await copyToClipboard(copyText);
          if (success) {
            const copyTextEl = copyBtn.querySelector('.copy-text');
            const originalText = copyTextEl ? copyTextEl.textContent : 'Copy Result';
            if (copyTextEl) copyTextEl.textContent = 'Copied!';
            copyBtn.classList.add('bg-emerald-100', 'text-emerald-800');
            setTimeout(() => {
              if (copyTextEl) copyTextEl.textContent = originalText;
              copyBtn.classList.remove('bg-emerald-100', 'text-emerald-800');
            }, 2000);
          }
        });
      }

      // Reset functionality
      resetBtn?.addEventListener('click', () => {
        form.reset();
        errBox?.classList.add('hidden');
        resultSec?.classList.add('hidden');
        regStats?.classList.add('hidden');
        if (primaryValueEl) primaryValueEl.textContent = '--';
      });

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        errBox?.classList.add('hidden');
        resultSec?.classList.add('hidden');
        regStats?.classList.add('hidden');

        try {
          const X = parseDataset(xInput.value);
          if (X.length === 0) throw new Error("Dataset X must contain at least one valid number.");

          let Y: number[] = [];
          if (needsY) {
             Y = parseDataset(yInput.value);
             if (Y.length === 0) throw new Error("Dataset Y must contain at least one valid number.");
             if (X.length !== Y.length) throw new Error(`Datasets must be the same length. X has ${X.length}, Y has ${Y.length}.`);
          }

          const isPop = popCheck.checked;

          // Compute basics
          const m = mean(X);
          const med = median(X);
          const sd = standardDeviation(X, isPop);
          const v = variance(X, isPop);
          const sumX = sum(X);
          const fn = fiveNumberSummary(X);

          const setField = (selector: string, val: number | string) => {
            const el = container.querySelector(selector);
            if (el) el.textContent = typeof val === 'number' ? formatResultNumber(val) : String(val);
          };

          setField('.res-n', X.length);
          setField('.res-mean', m);
          setField('.res-median', med);
          setField('.res-sd', sd);

          if (fn) {
            setField('.res-min', fn.min);
            setField('.res-q1', fn.q1);
            setField('.res-q2', fn.median);
            setField('.res-q3', fn.q3);
            setField('.res-max', fn.max);
            setField('.res-iqr', fn.q3 - fn.q1);
          }

          setField('.res-sum', sumX);
          setField('.res-var', v);
          setField('.res-se', standardError(X));
          setField('.res-mad', meanAbsoluteDeviation(X));
          setField('.res-geom', geometricMean(X));
          setField('.res-harm', harmonicMean(X));

          let primaryLabel = "Mean";
          let primaryVal = formatResultNumber(m);

          // Set Primary based on tool slug
          if (slug.includes('median')) { primaryLabel = "Median"; primaryVal = formatResultNumber(med); }
          if (slug.includes('variance')) { primaryLabel = "Variance"; primaryVal = formatResultNumber(v); }
          if (slug.includes('standard-deviation')) { primaryLabel = "Standard Deviation"; primaryVal = formatResultNumber(sd); }
          if (slug.includes('percentile') || slug.includes('quartile') || slug.includes('iqr')) { primaryLabel = "IQR"; primaryVal = fn ? formatResultNumber(fn.q3 - fn.q1) : '0'; }
          if (slug.includes('five-number')) { primaryLabel = "Five Number Summary"; primaryVal = `Min:${fn.min} Q1:${fn.q1} Med:${fn.median} Q3:${fn.q3} Max:${fn.max}`; }
          if (slug.includes('geometric')) { primaryLabel = "Geometric Mean"; primaryVal = formatResultNumber(geometricMean(X)); }
          if (slug.includes('harmonic')) { primaryLabel = "Harmonic Mean"; primaryVal = formatResultNumber(harmonicMean(X)); }
          if (slug.includes('absolute-deviation')) { primaryLabel = "Mean Absolute Deviation"; primaryVal = formatResultNumber(meanAbsoluteDeviation(X)); }
          if (slug.includes('standard-error')) { primaryLabel = "Standard Error (SE)"; primaryVal = formatResultNumber(standardError(X)); }

          if (needsY) {
            regStats?.classList.remove('hidden');
            const corr = correlation(X, Y);
            const cov = covariance(X, Y, isPop);
            const reg = linearRegression(X, Y);

            setField('.res-r', corr);
            setField('.res-cov', cov);
            if (reg) {
               const slopeFormatted = formatResultNumber(reg.slope);
               const interceptFormatted = formatResultNumber(Math.abs(reg.intercept));
               const sign = reg.intercept >= 0 ? '+' : '-';
               setField('.res-eq', `y = ${slopeFormatted}x ${sign} ${interceptFormatted}`);
               setField('.res-r2', reg.rSquared);

               if (slug.includes('correlation')) { primaryLabel = "Correlation Coefficient (r)"; primaryVal = formatResultNumber(corr); }
               if (slug.includes('covariance')) { primaryLabel = "Covariance"; primaryVal = formatResultNumber(cov); }
               if (slug.includes('linear-regression') || slug.includes('equation')) { primaryLabel = "Regression Equation"; primaryVal = `y = ${slopeFormatted}x ${sign} ${interceptFormatted}`; }
               if (slug.includes('r-squared')) { primaryLabel = "R-Squared (R²)"; primaryVal = formatResultNumber(reg.rSquared); }
            }
          }

          if (primaryLabelEl) primaryLabelEl.textContent = primaryLabel;
          if (primaryValueEl) primaryValueEl.textContent = primaryVal;

          resultSec?.classList.remove('hidden');
          resultSec?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

        } catch (err: any) {
          if (errMsg) errMsg.textContent = err.message;
          errBox?.classList.remove('hidden');
        }
      });
    });
  };

  initDataset();
  document.addEventListener('astro:page-load', initDataset);
</script>
