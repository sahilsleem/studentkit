---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Drop Height (h in meters)</label>
          <input type="number" id="ff-height" placeholder="e.g. 45" min="0.1" step="any" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-sm" />
        </div>

        <button id="ff-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Free Fall Metrics
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Impact Velocity (v = √(2gh))</div>
          <div id="ff-vel" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div id="ff-kmh" class="text-xs text-slate-muted mt-1">106.95 km/h (66.46 mph)</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 text-xs text-slate-muted">
          <span>Fall Duration (t = √(2h/g)): </span>
          <strong id="ff-time" class="text-ink font-mono break-words">3.03 seconds</strong>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const h = parseFloat((document.getElementById('ff-height') as HTMLInputElement)?.value || '0');
    const g = 9.80665;

    const v = Math.sqrt(2 * g * h);
    const t = Math.sqrt((2 * h) / g);
    const kmh = v * 3.6;

    document.getElementById('ff-vel')!.textContent = v.toFixed(2) + ' m/s';
    document.getElementById('ff-kmh')!.textContent = kmh.toFixed(2) + ' km/h (' + (kmh * 0.621371).toFixed(2) + ' mph)';
    document.getElementById('ff-time')!.textContent = t.toFixed(2) + ' seconds';
  }


  document.getElementById('ff-calc-btn')?.addEventListener('click', calculate);
</script>