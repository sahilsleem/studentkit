---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Drop Height (h in meters)</label>
          <input type="number" id="ff-height" placeholder="e.g. 45" min="0.1" step="any" class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm" />
        </div>

        <button id="ff-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Free Fall Metrics
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Impact Velocity (v = √(2gh))</div>
          <div id="ff-vel" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
          <div id="ff-kmh" class="text-xs text-slate-500 mt-2">106.95 km/h (66.46 mph)</div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 text-xs text-slate-600">
          <span>Fall Duration (t = √(2h/g)): </span>
          <strong id="ff-time" class="text-slate-800 font-mono">3.03 seconds</strong>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const h = parseFloat((document.getElementById('ff-height') as HTMLInputElement)?.value || '0');
    const g = 9.80665;

    const v = Math.sqrt(2 * g * h);
    const t = Math.sqrt((2 * h) / g);
    const kmh = v * 3.6;

    document.getElementById('ff-vel')!.textContent = v.toFixed(2) + ' m/s';
    document.getElementById('ff-kmh')!.textContent = kmh.toFixed(2) + ' km/h (' + (kmh * 0.621371).toFixed(2) + ' mph)';
    document.getElementById('ff-time')!.textContent = t.toFixed(2) + ' seconds';
  }


  document.getElementById('ff-calc-btn')?.addEventListener('click', calculate);
</script>