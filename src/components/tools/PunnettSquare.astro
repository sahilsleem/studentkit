---
import { tools } from '../../data/registry';
const { tool } = Astro.props;
---

<div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden max-w-4xl mx-auto punnett-container" data-tool={tool.slug}>
  <div class="p-6 sm:p-8">
    <div class="mb-6 border-b border-gray-100 pb-4 text-center">
      <h3 class="text-2xl font-bold text-gray-900">{tool.title}</h3>
      <p class="text-gray-500 mt-2">{tool.description}</p>
    </div>

    <form class="space-y-6 ps-form">
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-2">Parent Genotypes</label>
        <div class="flex items-center gap-4">
          <input 
            type="text" 
            class="p1-input w-full p-4 text-lg font-mono text-center border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 bg-gray-50 placeholder-gray-400" 
            placeholder="e.g. Aa"
            required 
          />
          <span class="text-xl font-bold text-gray-400">×</span>
          <input 
            type="text" 
            class="p2-input w-full p-4 text-lg font-mono text-center border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 bg-gray-50 placeholder-gray-400" 
            placeholder="e.g. Aa"
            required 
          />
        </div>
        <button type="submit" class="w-full mt-4 bg-blue-600 text-white px-8 py-3 rounded-lg font-semibold hover:bg-blue-700 transition-colors shadow-sm">
          Generate Punnett Square
        </button>
        <p class="text-xs text-gray-500 mt-2 text-center">Supports Monohybrid (Aa) and Dihybrid (AaBb) crosses.</p>
      </div>
    </form>

    <div class="err-box hidden mt-6 bg-red-50 text-red-700 p-4 rounded-lg text-sm font-medium border border-red-100 flex items-start gap-3">
      <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
      <span class="err-msg"></span>
    </div>

    <div class="result-section hidden mt-8 pt-8 border-t border-gray-100">
      <h3 class="text-lg font-semibold mb-4 text-center text-gray-800">Punnett Square</h3>
      
      <div class="overflow-x-auto pb-4">
        <table class="punnett-table mx-auto border-collapse border border-gray-300 shadow-sm rounded">
          <thead class="pt-thead bg-blue-50"></thead>
          <tbody class="pt-tbody"></tbody>
        </table>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-8">
        <div>
           <h4 class="font-bold text-gray-700 border-b pb-2 mb-3">Genotype Probabilities</h4>
           <ul class="pt-genotypes space-y-2"></ul>
        </div>
        <div>
           <h4 class="font-bold text-gray-700 border-b pb-2 mb-3">Phenotype Probabilities</h4>
           <ul class="pt-phenotypes space-y-2"></ul>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { generatePunnettSquare } from '../../utils/genetics';

  const initPunnett = () => {
    document.querySelectorAll('.punnett-container').forEach(container => {
      if (container.hasAttribute('data-init')) return;
      container.setAttribute('data-init', 'true');

      const form = container.querySelector('.ps-form');
      const p1Input = container.querySelector('.p1-input') as HTMLInputElement;
      const p2Input = container.querySelector('.p2-input') as HTMLInputElement;
      const errBox = container.querySelector('.err-box');
      const errMsg = container.querySelector('.err-msg');
      const resultSec = container.querySelector('.result-section');
      
      const thead = container.querySelector('.pt-thead');
      const tbody = container.querySelector('.pt-tbody');
      const genoList = container.querySelector('.pt-genotypes');
      const phenoList = container.querySelector('.pt-phenotypes');

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        errBox.classList.add('hidden');
        resultSec.classList.add('hidden');
        
        try {
          const p1 = p1Input.value.replace(/\s+/g, '');
          const p2 = p2Input.value.replace(/\s+/g, '');
          
          if (!/^[a-zA-Z]+$/.test(p1) || !/^[a-zA-Z]+$/.test(p2)) throw new Error("Genotypes must contain only letters.");
          
          const result = generatePunnettSquare(p1, p2);
          
          // Build table
          let headHtml = `<tr><th class="p-3 border border-gray-300 bg-gray-100"></th>`;
          result.gametes2.forEach(g => {
             headHtml += `<th class="p-3 border border-gray-300 font-mono text-blue-800 text-lg">${g}</th>`;
          });
          headHtml += `</tr>`;
          thead.innerHTML = headHtml;
          
          let bodyHtml = '';
          for (let r = 0; r < result.gametes1.length; r++) {
             bodyHtml += `<tr><th class="p-3 border border-gray-300 bg-blue-50 font-mono text-blue-800 text-lg">${result.gametes1[r]}</th>`;
             for (let c = 0; c < result.gametes2.length; c++) {
                 bodyHtml += `<td class="p-3 border border-gray-300 text-center font-mono font-bold text-gray-800 text-lg bg-white">${result.grid[r][c]}</td>`;
             }
             bodyHtml += `</tr>`;
          }
          tbody.innerHTML = bodyHtml;
          
          // Lists
          genoList.innerHTML = '';
          Object.entries(result.genotypeCounts).sort((a,b)=>b[1]-a[1]).forEach(([geno, count]) => {
             const pct = ((count / result.total) * 100).toFixed(1);
             genoList.innerHTML += `<li class="flex justify-between font-mono bg-gray-50 p-2 rounded"><span>${geno}</span> <span class="font-bold text-gray-700">${pct}% (${count}/${result.total})</span></li>`;
          });
          
          phenoList.innerHTML = '';
          Object.entries(result.phenotypeCounts).sort((a,b)=>b[1]-a[1]).forEach(([pheno, count]) => {
             const pct = ((count / result.total) * 100).toFixed(1);
             phenoList.innerHTML += `<li class="flex justify-between font-mono bg-emerald-50 p-2 rounded text-emerald-900"><span>${pheno}</span> <span class="font-bold">${pct}% (${count}/${result.total})</span></li>`;
          });
          
          resultSec.classList.remove('hidden');
          
        } catch (err) {
          errMsg.textContent = err.message;
          errBox.classList.remove('hidden');
        }
      });
    });
  };

  initPunnett();
  document.addEventListener('astro:page-load', initPunnett);
</script>
