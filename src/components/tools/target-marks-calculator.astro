---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Target Overall Percentage (%)</label>
          <input type="number" id="tm-target" min="0" max="100" placeholder="e.g. 85" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Total Academic Marks / Max Score</label>
          <input type="number" id="tm-total-marks" min="1" placeholder="e.g. 500" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Marks Scored So Far</label>
          <input type="number" id="tm-scored" min="0" placeholder="e.g. 260" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Max Marks of Completed Assessments</label>
          <input type="number" id="tm-completed-max" min="1" placeholder="e.g. 300" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <button id="tm-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Target Marks
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Required Score on Remaining Tests</div>
          <div id="tm-needed-pct" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
          <div id="tm-needed-raw" class="text-xs text-slate-muted mt-1">Remaining marks breakdown appears here</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 space-y-1.5 text-xs text-slate-muted">
          <div class="flex flex-wrap justify-between gap-2">
            <span>Current Running Average:</span>
            <strong id="tm-curr-avg">--</strong>
          </div>
          <div class="flex flex-wrap justify-between gap-2">
            <span>Total Target Marks Needed:</span>
            <strong id="tm-total-needed">--</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const targetIn = document.getElementById('tm-target') as HTMLInputElement;
  const totalMarksIn = document.getElementById('tm-total-marks') as HTMLInputElement;
  const scoredIn = document.getElementById('tm-scored') as HTMLInputElement;
  const compMaxIn = document.getElementById('tm-completed-max') as HTMLInputElement;
  const neededPctEl = document.getElementById('tm-needed-pct');
  const neededRawEl = document.getElementById('tm-needed-raw');
  const currAvgEl = document.getElementById('tm-curr-avg');
  const totalNeededEl = document.getElementById('tm-total-needed');

  function calculate() {
    const targetPct = parseFloat(targetIn?.value || '0');
    const totalMarks = parseFloat(totalMarksIn?.value || '1');
    const scored = parseFloat(scoredIn?.value || '0');
    const compMax = parseFloat(compMaxIn?.value || '1');

    const totalTargetNeeded = (targetPct / 100) * totalMarks;
    const remainingMarksNeeded = totalTargetNeeded - scored;
    const remainingMax = totalMarks - compMax;

    if (totalNeededEl) totalNeededEl.textContent = totalTargetNeeded.toFixed(1) + ' / ' + totalMarks;
    if (currAvgEl) currAvgEl.textContent = compMax > 0 ? ((scored / compMax) * 100).toFixed(2) + '%' : '--';

    if (remainingMax <= 0) {
      if (neededPctEl) neededPctEl.textContent = scored >= totalTargetNeeded ? 'Target Met!' : 'Target Missed';
      if (neededRawEl) neededRawEl.textContent = 'No remaining assessments';
      return;
    }

    const neededPct = (remainingMarksNeeded / remainingMax) * 100;
    if (neededPctEl) neededPctEl.textContent = neededPct <= 0 ? '0%' : neededPct.toFixed(1) + '%';
    if (neededRawEl) neededRawEl.textContent = Math.max(0, remainingMarksNeeded).toFixed(1) + ' / ' + remainingMax + ' marks remaining';
  }


  document.getElementById('tm-calc-btn')?.addEventListener('click', calculate);
</script>