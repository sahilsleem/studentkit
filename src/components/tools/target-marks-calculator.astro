---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Target Overall Percentage (%)</label>
          <input type="number" id="tm-target" min="0" max="100" placeholder="e.g. 85" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Total Academic Marks / Max Score</label>
          <input type="number" id="tm-total-marks" min="1" placeholder="e.g. 500" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Marks Scored So Far</label>
          <input type="number" id="tm-scored" min="0" placeholder="e.g. 260" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Max Marks of Completed Assessments</label>
          <input type="number" id="tm-completed-max" min="1" placeholder="e.g. 300" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <button id="tm-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Target Marks
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Required Score on Remaining Tests</div>
          <div id="tm-needed-pct" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
          <div id="tm-needed-raw" class="text-xs text-slate-400 mt-2">Remaining marks breakdown appears here</div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 space-y-2 text-xs text-slate-600">
          <div class="flex justify-between">
            <span>Current Running Average:</span>
            <strong id="tm-curr-avg">--</strong>
          </div>
          <div class="flex justify-between">
            <span>Total Target Marks Needed:</span>
            <strong id="tm-total-needed">--</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const targetIn = document.getElementById('tm-target') as HTMLInputElement;
  const totalMarksIn = document.getElementById('tm-total-marks') as HTMLInputElement;
  const scoredIn = document.getElementById('tm-scored') as HTMLInputElement;
  const compMaxIn = document.getElementById('tm-completed-max') as HTMLInputElement;
  const neededPctEl = document.getElementById('tm-needed-pct');
  const neededRawEl = document.getElementById('tm-needed-raw');
  const currAvgEl = document.getElementById('tm-curr-avg');
  const totalNeededEl = document.getElementById('tm-total-needed');

  function calculate() {
    const targetPct = parseFloat(targetIn?.value || '0');
    const totalMarks = parseFloat(totalMarksIn?.value || '1');
    const scored = parseFloat(scoredIn?.value || '0');
    const compMax = parseFloat(compMaxIn?.value || '1');

    const totalTargetNeeded = (targetPct / 100) * totalMarks;
    const remainingMarksNeeded = totalTargetNeeded - scored;
    const remainingMax = totalMarks - compMax;

    if (totalNeededEl) totalNeededEl.textContent = totalTargetNeeded.toFixed(1) + ' / ' + totalMarks;
    if (currAvgEl) currAvgEl.textContent = compMax > 0 ? ((scored / compMax) * 100).toFixed(2) + '%' : '--';

    if (remainingMax <= 0) {
      if (neededPctEl) neededPctEl.textContent = scored >= totalTargetNeeded ? 'Target Met!' : 'Target Missed';
      if (neededRawEl) neededRawEl.textContent = 'No remaining assessments';
      return;
    }

    const neededPct = (remainingMarksNeeded / remainingMax) * 100;
    if (neededPctEl) neededPctEl.textContent = neededPct <= 0 ? '0%' : neededPct.toFixed(1) + '%';
    if (neededRawEl) neededRawEl.textContent = Math.max(0, remainingMarksNeeded).toFixed(1) + ' / ' + remainingMax + ' marks remaining';
  }


  document.getElementById('tm-calc-btn')?.addEventListener('click', calculate);
</script>