---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Number (x &gt; 0)</label>
          <input type="number" id="log-x" min="0.000001" step="any" placeholder="e.g. 1000" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">Base (b)</label>
          <input type="number" id="log-base" min="0.000001" step="any" placeholder="e.g. 10" class="w-full px-3.5 py-2.5 bg-page border border-border-line rounded-xl text-ink text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent" />
        </div>

        <button id="log-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Logarithm
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Logarithm Result (log_b(x))</div>
          <div id="log-res" class="text-4xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 space-y-1.5 text-xs text-slate-muted">
          <div class="flex flex-wrap justify-between gap-2">
            <span>Natural Log ln(x):</span>
            <strong id="log-ln" class="text-ink font-mono break-words">6.9078</strong>
          </div>
          <div class="flex flex-wrap justify-between gap-2">
            <span>Binary Log log₂(x):</span>
            <strong id="log-log2" class="text-ink font-mono break-words">9.9658</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const x = parseFloat((document.getElementById('log-x') as HTMLInputElement)?.value || '1');
    const b = parseFloat((document.getElementById('log-base') as HTMLInputElement)?.value || '10');

    if (x <= 0 || b <= 0 || b === 1) return;

    const res = Math.log(x) / Math.log(b);
    const ln = Math.log(x);
    const log2 = Math.log2(x);

    const resEl = document.getElementById('log-res');
    const lnEl = document.getElementById('log-ln');
    const log2El = document.getElementById('log-log2');

    if (resEl) resEl.textContent = res.toFixed(4);
    if (lnEl) lnEl.textContent = ln.toFixed(4);
    if (log2El) log2El.textContent = log2.toFixed(4);
  }


  document.getElementById('log-calc-btn')?.addEventListener('click', calculate);
</script>