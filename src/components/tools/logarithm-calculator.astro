---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Number (x &gt; 0)</label>
          <input type="number" id="log-x" min="0.000001" step="any" placeholder="e.g. 1000" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Base (b)</label>
          <input type="number" id="log-base" min="0.000001" step="any" placeholder="e.g. 10" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <button id="log-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Logarithm
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Logarithm Result (log_b(x))</div>
          <div id="log-res" class="text-4xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 space-y-2 text-xs text-slate-600">
          <div class="flex justify-between">
            <span>Natural Log ln(x):</span>
            <strong id="log-ln" class="text-slate-800 font-mono">6.9078</strong>
          </div>
          <div class="flex justify-between">
            <span>Binary Log log₂(x):</span>
            <strong id="log-log2" class="text-slate-800 font-mono">9.9658</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const x = parseFloat((document.getElementById('log-x') as HTMLInputElement)?.value || '1');
    const b = parseFloat((document.getElementById('log-base') as HTMLInputElement)?.value || '10');

    if (x <= 0 || b <= 0 || b === 1) return;

    const res = Math.log(x) / Math.log(b);
    const ln = Math.log(x);
    const log2 = Math.log2(x);

    const resEl = document.getElementById('log-res');
    const lnEl = document.getElementById('log-ln');
    const log2El = document.getElementById('log-log2');

    if (resEl) resEl.textContent = res.toFixed(4);
    if (lnEl) lnEl.textContent = ln.toFixed(4);
    if (log2El) log2El.textContent = log2.toFixed(4);
  }


  document.getElementById('log-calc-btn')?.addEventListener('click', calculate);
</script>