<div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden mb-12 max-w-4xl mx-auto">
  <div class="p-6 sm:p-8">
    <div class="mb-6">
      <h2 class="text-xl font-bold text-gray-900 mb-2">Confidence Interval Calculator</h2>
      <p class="text-sm text-gray-600">Calculate confidence intervals for population means (Z-interval, T-interval) and population proportions with exact critical values and margins of error.</p>
    </div>

    <!-- Mode Selector Tabs -->
    <div class="flex flex-wrap gap-2 mb-6 border-b border-gray-100 pb-4">
      <button type="button" id="ci-tab-zmean" class="ci-mode-btn px-4 py-2 text-sm font-medium rounded-lg bg-emerald-600 text-white transition-colors" data-mode="zmean">
        Mean (Known σ, Z-Interval)
      </button>
      <button type="button" id="ci-tab-tmean" class="ci-mode-btn px-4 py-2 text-sm font-medium rounded-lg bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors" data-mode="tmean">
        Mean (Unknown σ, T-Interval)
      </button>
      <button type="button" id="ci-tab-prop" class="ci-mode-btn px-4 py-2 text-sm font-medium rounded-lg bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors" data-mode="prop">
        Population Proportion
      </button>
    </div>

    <form id="ci-calc-form" class="space-y-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Input 1: Mean / Successes -->
        <div id="ci-input1-group">
          <label id="ci-input1-label" for="ci-input1" class="block text-sm font-semibold text-gray-800 mb-1">
            Sample Mean (x̄)
          </label>
          <input
            type="number"
            id="ci-input1"
            step="any"
            value="50"
            required
            inputmode="decimal"
            class="block w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-base font-medium text-gray-900"
            placeholder="50"
          />
        </div>

        <!-- Input 2: Std Dev (Hidden in Proportion mode) -->
        <div id="ci-input2-group">
          <label id="ci-input2-label" for="ci-input2" class="block text-sm font-semibold text-gray-800 mb-1">
            Population Std Dev (σ)
          </label>
          <input
            type="number"
            id="ci-input2"
            min="0.000001"
            step="any"
            value="10"
            required
            inputmode="decimal"
            class="block w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-base font-medium text-gray-900"
            placeholder="10"
          />
        </div>

        <!-- Input 3: Sample Size (n) -->
        <div>
          <label for="ci-n" class="block text-sm font-semibold text-gray-800 mb-1">
            Sample Size (n)
          </label>
          <input
            type="number"
            id="ci-n"
            min="2"
            max="1000000"
            step="1"
            value="25"
            required
            inputmode="numeric"
            class="block w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-base font-medium text-gray-900"
            placeholder="25"
          />
        </div>

        <!-- Input 4: Confidence Level (%) -->
        <div>
          <label for="ci-conf-level" class="block text-sm font-semibold text-gray-800 mb-1">
            Confidence Level (%)
          </label>
          <select id="ci-conf-level" class="block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-xl text-base text-gray-800 focus:ring-emerald-500 focus:border-emerald-500">
            <option value="90">90% (z* = 1.645)</option>
            <option value="95" selected>95% (z* = 1.960)</option>
            <option value="98">98% (z* = 2.326)</option>
            <option value="99">99% (z* = 2.576)</option>
            <option value="99.9">99.9%</option>
          </select>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row gap-3 pt-2">
        <button type="submit" class="flex-1 bg-emerald-600 text-white px-6 py-3 rounded-xl font-semibold hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors shadow-sm min-h-[44px]">
          Calculate Interval
        </button>
        <button type="button" id="reset-btn" class="px-6 py-3 border border-gray-300 rounded-xl text-gray-700 font-semibold hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors min-h-[44px]">
          Reset
        </button>
      </div>
    </form>

    <div id="error-box" class="hidden mt-6 bg-red-50 text-red-700 p-4 rounded-xl text-sm font-medium border border-red-200"></div>

    <!-- Results Section -->
    <div id="result-section" class="mt-8 pt-8 border-t border-gray-100" aria-live="polite">
      <!-- Main Result Card -->
      <div class="bg-gradient-to-br from-emerald-50 to-teal-50 border border-emerald-200/80 rounded-2xl p-6 sm:p-8 text-center relative mb-6">
        <div class="flex justify-end absolute top-4 right-4">
          <button
            type="button"
            id="copy-result-btn"
            class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg bg-white/90 hover:bg-white text-emerald-800 border border-emerald-200 shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-emerald-500 min-h-[36px]"
            title="Copy confidence interval"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
            <span>Copy Result</span>
          </button>
        </div>
        <p id="ci-main-title" class="text-xs font-bold uppercase tracking-wider text-emerald-800 mb-1">95% Confidence Interval</p>
        <div id="ci-main-interval" class="text-3xl sm:text-5xl font-extrabold text-emerald-950 my-2 font-mono break-all">[46.08, 53.92]</div>
        <p id="ci-main-center" class="text-sm text-emerald-700 font-medium">Point Estimate: 50.00 ± 3.92 (Margin of Error)</p>
      </div>

      <!-- Statistical Metrics Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
        <div class="bg-gray-50 rounded-xl p-4 border border-gray-200/70 text-center">
          <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Lower Limit</p>
          <div id="ci-stat-lower" class="text-lg font-bold text-gray-900">46.08</div>
        </div>
        <div class="bg-gray-50 rounded-xl p-4 border border-gray-200/70 text-center">
          <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Upper Limit</p>
          <div id="ci-stat-upper" class="text-lg font-bold text-gray-900">53.92</div>
        </div>
        <div class="bg-gray-50 rounded-xl p-4 border border-gray-200/70 text-center">
          <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Margin of Error (E)</p>
          <div id="ci-stat-margin" class="text-lg font-bold text-emerald-700">±3.92</div>
        </div>
        <div class="bg-gray-50 rounded-xl p-4 border border-gray-200/70 text-center">
          <p id="ci-stat-crit-label" class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Critical Value (z*)</p>
          <div id="ci-stat-crit" class="text-lg font-bold text-gray-900">1.960</div>
        </div>
      </div>

      <!-- Plain-English Interpretation Banner -->
      <div class="bg-emerald-50/70 border border-emerald-200 rounded-xl p-4 mb-6">
        <p class="text-xs font-bold uppercase tracking-wider text-emerald-800 mb-1">Statistical Interpretation</p>
        <p id="ci-interpretation" class="text-sm text-emerald-950 font-medium leading-relaxed">
          We are 95% confident that the true population mean lies between 46.08 and 53.92.
        </p>
      </div>

      <!-- Step-by-Step Derivation -->
      <div class="bg-gray-50 rounded-xl p-5 border border-gray-200">
        <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-2">Detailed Calculation Steps</h3>
        <div id="ci-steps-content" class="text-sm text-gray-700 font-mono space-y-1.5 bg-white p-4 rounded-lg border border-gray-200/80">
          <!-- Populated by JS -->
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { copyToClipboard } from '../../utils/formatters';

  const initConfidenceInterval = () => {
    let mode = 'zmean'; // 'zmean', 'tmean', 'prop'

    const form = document.getElementById('ci-calc-form') as HTMLFormElement;
    const modeBtns = document.querySelectorAll('.ci-mode-btn');

    const group1 = document.getElementById('ci-input1-group');
    const label1 = document.getElementById('ci-input1-label');
    const input1 = document.getElementById('ci-input1') as HTMLInputElement;

    const group2 = document.getElementById('ci-input2-group');
    const label2 = document.getElementById('ci-input2-label');
    const input2 = document.getElementById('ci-input2') as HTMLInputElement;

    const inputN = document.getElementById('ci-n') as HTMLInputElement;
    const selectConf = document.getElementById('ci-conf-level') as HTMLSelectElement;

    const resetBtn = document.getElementById('reset-btn');
    const copyBtn = document.getElementById('copy-result-btn');
    const errorBox = document.getElementById('error-box');

    const mainTitle = document.getElementById('ci-main-title');
    const mainInterval = document.getElementById('ci-main-interval');
    const mainCenter = document.getElementById('ci-main-center');

    const statLower = document.getElementById('ci-stat-lower');
    const statUpper = document.getElementById('ci-stat-upper');
    const statMargin = document.getElementById('ci-stat-margin');
    const statCritLabel = document.getElementById('ci-stat-crit-label');
    const statCrit = document.getElementById('ci-stat-crit');
    const interpretationEl = document.getElementById('ci-interpretation');
    const stepsContent = document.getElementById('ci-steps-content');

    if (!form || !input1) return;

    // Inverse Normal CDF (Acklam algorithm)
    const invNormalCdf = (p: number): number => {
      if (p <= 0 || p >= 1) return 0;
      const a1 = -3.969683028665376e+01, a2 = 2.209460984245205e+02, a3 = -2.759285104469687e+02;
      const a4 = 1.383577518672690e+02, a5 = -3.066479806614716e+01, a6 = 2.506628277459239e+00;
      const b1 = -5.447609879822406e+01, b2 = 1.615858368580409e+02, b3 = -1.556989798598866e+02;
      const b4 = 6.680131188771972e+01, b5 = -1.328068155288572e+01;
      const c1 = -7.784894002430293e-03, c2 = -3.223964580411365e-01, c3 = -2.400758277161838e+00;
      const c4 = -2.549732539343734e+00, c5 = 4.374664141464968e+00, c6 = 2.938163982698783e+00;
      const d1 = 7.784695709041462e-03, d2 = 3.224671290700398e-01, d3 = 2.445134137142996e+00;
      const d4 = 3.754408661907416e+00;

      const p_low = 0.02425, p_high = 1 - p_low;
      let q: number;

      if (p < p_low) {
        q = Math.sqrt(-2 * Math.log(p));
        return (((((c1 * q + c2) * q + c3) * q + c4) * q + c5) * q + c6) /
               ((((d1 * q + d2) * q + d3) * q + d4) * q + 1);
      } else if (p <= p_high) {
        q = p - 0.5;
        const r = q * q;
        return (((((a1 * r + a2) * r + a3) * r + a4) * r + a5) * r + a6) * q /
               (((((b1 * r + b2) * r + b3) * r + b4) * r + b5) * r + 1);
      } else {
        q = Math.sqrt(-2 * Math.log(1 - p));
        return -(((((c1 * q + c2) * q + c3) * q + c4) * q + c5) * q + c6) /
                ((((d1 * q + d2) * q + d3) * q + d4) * q + 1);
      }
    };

    // 1. Log-gamma function (Lanczos approximation)
    const logGamma = (z: number): number => {
      const g = 7;
      const C = [
        0.99999999999980993,
        676.5203681218851,
        -1259.1392167224028,
        771.32342877765313,
        -176.61502916214059,
        12.507343278686905,
        -0.13857109583652625,
        9.9843695780195716e-6,
        1.5056327351493116e-7
      ];
      if (z < 0.5) {
        return Math.log(Math.PI / Math.sin(Math.PI * z)) - logGamma(1 - z);
      }
      z -= 1;
      let x = C[0];
      for (let i = 1; i < g + 2; i++) {
        x += C[i] / (z + i);
      }
      const t = z + g + 0.5;
      return 0.5 * Math.log(2 * Math.PI) + (z + 0.5) * Math.log(t) - t + Math.log(x);
    };

    // 2. Regularized Incomplete Beta Function via Continued Fraction
    const betacf = (a: number, b: number, x: number): number => {
      const MAXIT = 200;
      const EPS = 3.0e-14;
      const FPMIN = 1.0e-30;
      const qab = a + b;
      const qap = a + 1.0;
      const qam = a - 1.0;
      let c = 1.0;
      let d = 1.0 - qab * x / qap;
      if (Math.abs(d) < FPMIN) d = FPMIN;
      d = 1.0 / d;
      let h = d;

      for (let m = 1; m <= MAXIT; m++) {
        const m2 = 2 * m;
        let aa = m * (b - m) * x / ((qam + m2) * (a + m2));
        d = 1.0 + aa * d;
        if (Math.abs(d) < FPMIN) d = FPMIN;
        c = 1.0 + aa / c;
        if (Math.abs(c) < FPMIN) c = FPMIN;
        d = 1.0 / d;
        h *= d * c;

        aa = -(a + m) * (qab + m) * x / ((a + m2) * (qap + m2));
        d = 1.0 + aa * d;
        if (Math.abs(d) < FPMIN) d = FPMIN;
        c = 1.0 + aa / c;
        if (Math.abs(c) < FPMIN) c = FPMIN;
        d = 1.0 / d;
        const del = d * c;
        h *= del;
        if (Math.abs(del - 1.0) < EPS) break;
      }
      return h;
    };

    const ibeta = (a: number, b: number, x: number): number => {
      if (x <= 0) return 0;
      if (x >= 1) return 1;
      const bt = Math.exp(logGamma(a + b) - logGamma(a) - logGamma(b) + a * Math.log(x) + b * Math.log(1.0 - x));
      if (x < (a + 1.0) / (a + b + 2.0)) {
        return bt * betacf(a, b, x) / a;
      } else {
        return 1.0 - bt * betacf(b, a, 1.0 - x) / b;
      }
    };

    // Student-t CDF & PDF
    const studentT_cdf = (t: number, df: number): number => {
      if (t === 0) return 0.5;
      const x = df / (df + t * t);
      const prob = 0.5 * ibeta(df / 2, 0.5, x);
      return t > 0 ? 1 - prob : prob;
    };

    const studentT_pdf = (t: number, df: number): number => {
      const logCoef = logGamma((df + 1) / 2) - logGamma(df / 2) - 0.5 * Math.log(Math.PI * df);
      return Math.exp(logCoef) * Math.pow(1 + (t * t) / df, -(df + 1) / 2);
    };

    // Inverse Student-t CDF with exact closed-forms and Halley refinement
    const invStudentT = (p: number, df: number): number => {
      if (df <= 0) return 0;
      if (p <= 0) return -Infinity;
      if (p >= 1) return Infinity;
      if (p === 0.5) return 0;

      // Exact closed forms for df = 1 (Cauchy) and df = 2
      if (df === 1) {
        return Math.tan(Math.PI * (p - 0.5));
      }
      if (df === 2) {
        return (2 * p - 1) / Math.sqrt(2 * p * (1 - p));
      }

      const isUpper = p > 0.5;
      const targetP = isUpper ? p : 1 - p;

      // Cornish-Fisher initial estimate
      const z = invNormalCdf(targetP);
      const z2 = z * z;
      const z3 = z2 * z;
      const z5 = z3 * z2;
      const z7 = z5 * z2;
      const z9 = z7 * z2;

      const g1 = (z3 + z) / (4 * df);
      const g2 = (5 * z5 + 16 * z3 + 3 * z) / (96 * df * df);
      const g3 = (3 * z7 + 19 * z5 + 17 * z3 - 15 * z) / (384 * df * df * df);
      const g4 = (79 * z9 + 776 * z7 + 1482 * z5 - 1920 * z3 - 945 * z) / (92160 * df * df * df * df);

      let t = z + g1 + g2 + g3 + g4;
      if (t <= 0) t = 0.1;

      // Halley's method iterations for machine precision
      for (let iter = 0; iter < 5; iter++) {
        const cdf = studentT_cdf(t, df);
        const err = cdf - targetP;
        if (Math.abs(err) < 1e-13) break;

        const pdf = studentT_pdf(t, df);
        if (pdf <= 0) break;

        const d2_ratio = -(df + 1) * t / (df + t * t);
        const step = err / (pdf * (1 - 0.5 * (err / pdf) * d2_ratio));
        t -= step;
        if (t <= 0) t = 0.001;
      }

      return isUpper ? t : -t;
    };

    const calculate = () => {
      errorBox?.classList.add('hidden');

      const confLevelPct = parseFloat(selectConf.value);
      const cl = confLevelPct / 100;
      const alpha = 1 - cl;
      const tailP = 1 - alpha / 2;

      const n = parseInt(inputN.value, 10);
      if (isNaN(n) || n < 1) {
        if (errorBox) {
          errorBox.textContent = 'Please enter a valid sample size (n ≥ 1).';
          errorBox.classList.remove('hidden');
        }
        return;
      }

      if (mode === 'zmean') {
        const xbar = parseFloat(input1.value);
        const sigma = parseFloat(input2.value);

        if (isNaN(xbar) || isNaN(sigma) || sigma <= 0 || n < 2) {
          if (errorBox) {
            errorBox.textContent = 'Please enter valid values. Sample size n must be ≥ 2 and standard deviation σ must be > 0.';
            errorBox.classList.remove('hidden');
          }
          return;
        }

        const zStar = invNormalCdf(tailP);
        const se = sigma / Math.sqrt(n);
        const margin = zStar * se;
        const lower = xbar - margin;
        const upper = xbar + margin;

        if (mainTitle) mainTitle.textContent = `${confLevelPct}% Confidence Interval (Z-Interval)`;
        if (mainInterval) mainInterval.textContent = `[${lower.toFixed(2)}, ${upper.toFixed(2)}]`;
        if (mainCenter) mainCenter.textContent = `Point Estimate (x̄): ${xbar.toFixed(2)} ± ${margin.toFixed(2)} (Margin of Error)`;

        if (statLower) statLower.textContent = lower.toFixed(2);
        if (statUpper) statUpper.textContent = upper.toFixed(2);
        if (statMargin) statMargin.textContent = `±${margin.toFixed(2)}`;
        if (statCritLabel) statCritLabel.textContent = 'Critical Value (z*)';
        if (statCrit) statCrit.textContent = zStar.toFixed(3);

        if (interpretationEl) {
          interpretationEl.textContent = `We are ${confLevelPct}% confident that the true population mean (μ) lies between ${lower.toFixed(2)} and ${upper.toFixed(2)}.`;
        }

        if (stepsContent) {
          stepsContent.innerHTML = `
            <p>1. Formula: <strong>CI = x̄ ± z* × (σ / √n)</strong></p>
            <p>2. Critical Value for ${confLevelPct}%: <strong>z* = ${zStar.toFixed(4)}</strong></p>
            <p>3. Standard Error: <strong>SE = σ / √n = ${sigma} / √${n} = ${se.toFixed(4)}</strong></p>
            <p>4. Margin of Error: <strong>E = ${zStar.toFixed(4)} × ${se.toFixed(4)} = ${margin.toFixed(4)}</strong></p>
            <p>5. Interval Bounds: <strong>[${xbar} - ${margin.toFixed(4)}, ${xbar} + ${margin.toFixed(4)}] = [${lower.toFixed(2)}, ${upper.toFixed(2)}]</strong></p>
          `;
        }
      } else if (mode === 'tmean') {
        const xbar = parseFloat(input1.value);
        const s = parseFloat(input2.value);
        const df = n - 1;

        if (isNaN(xbar) || isNaN(s) || s <= 0 || n < 2) {
          if (errorBox) {
            errorBox.textContent = 'Please enter valid values. Sample size n must be ≥ 2 (df ≥ 1) and sample standard deviation s must be > 0.';
            errorBox.classList.remove('hidden');
          }
          return;
        }

        const tStar = invStudentT(tailP, df);
        const se = s / Math.sqrt(n);
        const margin = tStar * se;
        const lower = xbar - margin;
        const upper = xbar + margin;

        if (mainTitle) mainTitle.textContent = `${confLevelPct}% Confidence Interval (T-Interval, df = ${df})`;
        if (mainInterval) mainInterval.textContent = `[${lower.toFixed(2)}, ${upper.toFixed(2)}]`;
        if (mainCenter) mainCenter.textContent = `Point Estimate (x̄): ${xbar.toFixed(2)} ± ${margin.toFixed(2)} (Margin of Error)`;

        if (statLower) statLower.textContent = lower.toFixed(2);
        if (statUpper) statUpper.textContent = upper.toFixed(2);
        if (statMargin) statMargin.textContent = `±${margin.toFixed(2)}`;
        if (statCritLabel) statCritLabel.textContent = `Critical Value (t*, df=${df})`;
        if (statCrit) statCrit.textContent = tStar.toFixed(3);

        if (interpretationEl) {
          interpretationEl.textContent = `We are ${confLevelPct}% confident that the true population mean (μ) lies between ${lower.toFixed(2)} and ${upper.toFixed(2)}.`;
        }

        if (stepsContent) {
          stepsContent.innerHTML = `
            <p>1. Formula: <strong>CI = x̄ ± t* × (s / √n)</strong></p>
            <p>2. Degrees of Freedom: <strong>df = n - 1 = ${n} - 1 = ${df}</strong></p>
            <p>3. Critical Value for ${confLevelPct}% (df=${df}): <strong>t* = ${tStar.toFixed(4)}</strong></p>
            <p>4. Standard Error: <strong>SE = s / √n = ${s} / √${n} = ${se.toFixed(4)}</strong></p>
            <p>5. Margin of Error: <strong>E = ${tStar.toFixed(4)} × ${se.toFixed(4)} = ${margin.toFixed(4)}</strong></p>
            <p>6. Interval: <strong>[${lower.toFixed(2)}, ${upper.toFixed(2)}]</strong></p>
          `;
        }
      } else if (mode === 'prop') {
        const x = parseFloat(input1.value);

        if (isNaN(x) || x < 0 || x > n || n < 1) {
          if (errorBox) {
            errorBox.textContent = 'Please enter valid values. Number of successes (x) must satisfy 0 ≤ x ≤ n.';
            errorBox.classList.remove('hidden');
          }
          return;
        }

        const pHat = x / n;
        const zStar = invNormalCdf(tailP);
        const se = Math.sqrt((pHat * (1 - pHat)) / n);
        const margin = zStar * se;
        const lower = Math.max(0, pHat - margin);
        const upper = Math.min(1, pHat + margin);

        if (mainTitle) mainTitle.textContent = `${confLevelPct}% Proportion Confidence Interval`;
        if (mainInterval) mainInterval.textContent = `[${(lower * 100).toFixed(2)}%, ${(upper * 100).toFixed(2)}%]`;
        if (mainCenter) mainCenter.textContent = `Sample Proportion (p̂): ${(pHat * 100).toFixed(2)}% ± ${(margin * 100).toFixed(2)}%`;

        if (statLower) statLower.textContent = `${(lower * 100).toFixed(2)}%`;
        if (statUpper) statUpper.textContent = `${(upper * 100).toFixed(2)}%`;
        if (statMargin) statMargin.textContent = `±${(margin * 100).toFixed(2)}%`;
        if (statCritLabel) statCritLabel.textContent = 'Critical Value (z*)';
        if (statCrit) statCrit.textContent = zStar.toFixed(3);

        if (interpretationEl) {
          interpretationEl.textContent = `We are ${confLevelPct}% confident that the true population proportion (p) lies between ${(lower * 100).toFixed(2)}% and ${(upper * 100).toFixed(2)}%.`;
        }

        if (stepsContent) {
          stepsContent.innerHTML = `
            <p>1. Formula: <strong>CI = p̂ ± z* × √(p̂(1 - p̂) / n)</strong></p>
            <p>2. Sample Proportion: <strong>p̂ = x / n = ${x} / ${n} = ${pHat.toFixed(4)}</strong></p>
            <p>3. Standard Error: <strong>SE = √(${pHat.toFixed(4)} × ${(1 - pHat).toFixed(4)} / ${n}) = ${se.toFixed(4)}</strong></p>
            <p>4. Margin of Error: <strong>E = ${zStar.toFixed(4)} × ${se.toFixed(4)} = ${margin.toFixed(4)}</strong></p>
            <p>5. Proportion Interval: <strong>[${(lower * 100).toFixed(2)}%, ${(upper * 100).toFixed(2)}%]</strong></p>
          `;
        }
      }
    };

    modeBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        mode = btn.getAttribute('data-mode') || 'zmean';
        modeBtns.forEach(b => {
          b.className = 'ci-mode-btn px-4 py-2 text-sm font-medium rounded-lg bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors';
        });
        btn.className = 'ci-mode-btn px-4 py-2 text-sm font-medium rounded-lg bg-emerald-600 text-white transition-colors';

        if (mode === 'zmean') {
          group2?.classList.remove('hidden');
          if (label1) label1.textContent = 'Sample Mean (x̄)';
          if (label2) label2.textContent = 'Population Std Dev (σ)';
          input1.value = '50';
          input2.value = '10';
          inputN.value = '25';
        } else if (mode === 'tmean') {
          group2?.classList.remove('hidden');
          if (label1) label1.textContent = 'Sample Mean (x̄)';
          if (label2) label2.textContent = 'Sample Std Dev (s)';
          input1.value = '50';
          input2.value = '10';
          inputN.value = '25';
        } else if (mode === 'prop') {
          group2?.classList.add('hidden');
          if (label1) label1.textContent = 'Number of Successes (x)';
          input1.value = '60';
          inputN.value = '100';
        }
        calculate();
      });
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      calculate();
    });

    input1.addEventListener('input', calculate);
    input2.addEventListener('input', calculate);
    inputN.addEventListener('input', calculate);
    selectConf.addEventListener('change', calculate);

    resetBtn?.addEventListener('click', () => {
      mode = 'zmean';
      group2?.classList.remove('hidden');
      if (label1) label1.textContent = 'Sample Mean (x̄)';
      if (label2) label2.textContent = 'Population Std Dev (σ)';
      input1.value = '50';
      input2.value = '10';
      inputN.value = '25';
      selectConf.value = '95';
      modeBtns.forEach((b, i) => {
        b.className = i === 0 ? 'ci-mode-btn px-4 py-2 text-sm font-medium rounded-lg bg-emerald-600 text-white transition-colors' : 'ci-mode-btn px-4 py-2 text-sm font-medium rounded-lg bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors';
      });
      calculate();
    });

    copyBtn?.addEventListener('click', async () => {
      const text = mainInterval?.textContent || '';
      const success = await copyToClipboard(text);
      if (success) {
        const span = copyBtn.querySelector('span');
        if (span) {
          const original = span.textContent;
          span.textContent = 'Copied!';
          setTimeout(() => { span.textContent = original; }, 1500);
        }
      }
    });

    calculate();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initConfidenceInterval);
  } else {
    initConfidenceInterval();
  }
</script>
