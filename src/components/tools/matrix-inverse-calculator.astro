---
export interface Props {
  tool?: any;
}
---

<div class="space-y-3 sm:space-y-3.5">
  <div class="bg-card rounded-2xl border border-border-line/90 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="space-y-3.5">
        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-muted mb-1">2×2 Matrix A</label>
        <div class="grid grid-cols-2 gap-2">
          <input type="number" id="mi-a" placeholder="e.g. 4" class="px-3 py-2 bg-page border border-border-line rounded-lg text-center font-bold" />
          <input type="number" id="mi-b" placeholder="e.g. 7" class="px-3 py-2 bg-page border border-border-line rounded-lg text-center font-bold" />
          <input type="number" id="mi-c" placeholder="e.g. 2" class="px-3 py-2 bg-page border border-border-line rounded-lg text-center font-bold" />
          <input type="number" id="mi-d" placeholder="e.g. 6" class="px-3 py-2 bg-page border border-border-line rounded-lg text-center font-bold" />
        </div>

        <button id="mi-calc-btn" type="button" class="w-full px-5 sm:px-6 py-3.5 sm:py-4 text-base bg-brand hover:bg-brand-accent text-card font-semibold rounded-xl shadow-sm transition-all">
          Calculate Inverse Matrix
        </button>
      </div>

      <div class="flex flex-col justify-between p-4 sm:p-5 bg-page rounded-xl border border-border-line/80">
        <div>
          <div class="text-xs font-semibold text-slate-muted uppercase tracking-wider">Inverse Matrix A⁻¹</div>
          <div id="mi-result" class="text-2xl font-extrabold text-brand mt-1 font-mono break-words">--</div>
        </div>

        <div class="pt-3 border-t border-border-line/80 mt-4 text-xs text-slate-muted">
          <span>Determinant det(A): </span>
          <strong id="mi-det" class="text-ink font-mono break-words">10.00</strong>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const a = parseFloat((document.getElementById('mi-a') as HTMLInputElement)?.value || '0');
    const b = parseFloat((document.getElementById('mi-b') as HTMLInputElement)?.value || '0');
    const c = parseFloat((document.getElementById('mi-c') as HTMLInputElement)?.value || '0');
    const d = parseFloat((document.getElementById('mi-d') as HTMLInputElement)?.value || '0');

    const det = a * d - b * c;
    const detEl = document.getElementById('mi-det');
    const resEl = document.getElementById('mi-result');

    if (detEl) detEl.textContent = det.toFixed(2);

    if (Math.abs(det) < 1e-9) {
      if (resEl) resEl.textContent = 'Non-Invertible (Singular Matrix, det = 0)';
    } else {
      const invA = d / det;
      const invB = -b / det;
      const invC = -c / det;
      const invD = a / det;
      if (resEl) resEl.textContent = '[' + invA.toFixed(2) + ', ' + invB.toFixed(2) + ']  |  [' + invC.toFixed(2) + ', ' + invD.toFixed(2) + ']';
    }
  }


  document.getElementById('mi-calc-btn')?.addEventListener('click', calculate);
</script>