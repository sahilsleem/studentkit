---
export interface Props {
  tool?: any;
}
---

<div class="space-y-4 sm:space-y-5">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <div class="space-y-4">
        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">2×2 Matrix A</label>
        <div class="grid grid-cols-2 gap-2">
          <input type="number" id="mi-a" placeholder="e.g. 4" class="px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-center font-bold" />
          <input type="number" id="mi-b" placeholder="e.g. 7" class="px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-center font-bold" />
          <input type="number" id="mi-c" placeholder="e.g. 2" class="px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-center font-bold" />
          <input type="number" id="mi-d" placeholder="e.g. 6" class="px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-center font-bold" />
        </div>

        <button id="mi-calc-btn" type="button" class="w-full px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all">
          Calculate Inverse Matrix
        </button>
      </div>

      <div class="flex flex-col justify-between p-6 bg-slate-50 rounded-xl border border-slate-200/80">
        <div>
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Inverse Matrix A⁻¹</div>
          <div id="mi-result" class="text-2xl font-extrabold text-blue-600 mt-2 font-mono">--</div>
        </div>

        <div class="pt-4 border-t border-slate-200/80 mt-6 text-xs text-slate-600">
          <span>Determinant det(A): </span>
          <strong id="mi-det" class="text-slate-800 font-mono">10.00</strong>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculate() {
    const a = parseFloat((document.getElementById('mi-a') as HTMLInputElement)?.value || '0');
    const b = parseFloat((document.getElementById('mi-b') as HTMLInputElement)?.value || '0');
    const c = parseFloat((document.getElementById('mi-c') as HTMLInputElement)?.value || '0');
    const d = parseFloat((document.getElementById('mi-d') as HTMLInputElement)?.value || '0');

    const det = a * d - b * c;
    const detEl = document.getElementById('mi-det');
    const resEl = document.getElementById('mi-result');

    if (detEl) detEl.textContent = det.toFixed(2);

    if (Math.abs(det) < 1e-9) {
      if (resEl) resEl.textContent = 'Non-Invertible (Singular Matrix, det = 0)';
    } else {
      const invA = d / det;
      const invB = -b / det;
      const invC = -c / det;
      const invD = a / det;
      if (resEl) resEl.textContent = '[' + invA.toFixed(2) + ', ' + invB.toFixed(2) + ']  |  [' + invC.toFixed(2) + ', ' + invD.toFixed(2) + ']';
    }
  }


  document.getElementById('mi-calc-btn')?.addEventListener('click', calculate);
</script>