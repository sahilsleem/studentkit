---
export interface Props {
  variant?: 'horizontal' | 'rectangle' | 'mobile';
  class?: string;
}

const { variant = 'horizontal', class: className = '' } = Astro.props;

// To be populated when AdSense is approved
const publisherId = ""; 
const isAdSenseActive = false;

// Reserve stable dimensions to prevent CLS (Cumulative Layout Shift)
const layoutMap = {
  horizontal: "w-full max-w-[728px] min-h-[90px]",
  rectangle: "w-full max-w-[300px] min-h-[250px]",
  mobile: "w-full max-w-[320px] min-h-[50px]"
};

const dimensionClasses = layoutMap[variant];
---

<div class={`ad-wrapper flex justify-center items-center mx-auto ${className || 'my-8'} ${dimensionClasses}`}>
  {isAdSenseActive ? (
    // Future AdSense implementation
    <div class="ad-content w-full h-full"></div>
  ) : (
    // Subtle space reservation for CLS prevention
    <div class="w-full h-full bg-gray-50/50 border border-gray-100/50 rounded flex items-center justify-center text-[10px] text-gray-300 uppercase tracking-widest select-none pointer-events-none transition-colors">
      <span class="sr-only">Advertisement</span>
    </div>
  )}
</div>
