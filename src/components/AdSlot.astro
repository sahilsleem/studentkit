---
export interface Props {
  variant?: 'horizontal' | 'rectangle' | 'mobile';
  class?: string;
}

const { variant = 'horizontal', class: className = '' } = Astro.props;

// AdSense active flag
const isAdSenseActive = false;

// Strict layout constraints to prevent CLS
const layoutMap = {
  horizontal: "w-full max-w-[728px] min-h-[90px]",
  rectangle: "w-full max-w-[300px] min-h-[250px]",
  mobile: "w-full max-w-[320px] min-h-[50px]"
};

const dimensionClasses = layoutMap[variant];
---

{isAdSenseActive && (
  <div class={`ad-wrapper flex justify-center items-center mx-auto ${className || 'my-6'} ${dimensionClasses}`}>
    <div class="ad-content w-full h-full"></div>
  </div>
)}
