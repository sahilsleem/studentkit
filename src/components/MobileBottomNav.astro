---
const pathname = new URL(Astro.request.url).pathname;

const navItems = [
  {
    label: 'Home',
    href: '/',
    exact: true,
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />`
  },
  {
    label: 'Tools',
    href: '/tools',
    exact: false,
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.07a4.5 4.5 0 0 0 4.486-6.32l-3.27 3.27-2.54-2.54 3.27-3.27a4.5 4.5 0 0 0-6.32 4.486c.118.58.094 1.193-.07 1.743m0 0a5.002 5.002 0 0 1-.41 1.278l-2.496 3.03" />`
  },
  {
    label: 'Search',
    href: '#search',
    isSearch: true,
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />`
  },
  {
    label: 'About',
    href: '/about',
    exact: false,
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />`
  }
];
---

<nav
  class="sm:hidden fixed bottom-0 left-0 right-0 z-40 bg-card/95 backdrop-blur-md border-t border-border-line px-2 py-1 shadow-lg shadow-slate-900/5 safe-area-pb"
  aria-label="Mobile Navigation Bar"
>
  <div class="grid grid-cols-4 gap-1 max-w-md mx-auto">
    {navItems.map((item) => {
      const isActive = item.exact
        ? pathname === item.href
        : pathname.startsWith(item.href);

      if (item.isSearch) {
        return (
          <button
            type="button"
            id="mobile-bottom-search-trigger"
            class="flex flex-col items-center justify-center py-2 px-1 text-slate-muted hover:text-brand active:scale-95 transition-all cursor-pointer min-h-[48px]"
            aria-label="Open global search"
          >
            <svg class="w-5 h-5 mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" set:html={item.icon} />
            <span class="text-[11px] font-medium tracking-tight leading-none">{item.label}</span>
          </button>
        );
      }

      return (
        <a
          href={item.href}
          class={`flex flex-col items-center justify-center py-2 px-1 rounded-lg transition-all min-h-[48px] ${
            isActive
              ? 'text-brand font-semibold'
              : 'text-slate-muted hover:text-ink'
          }`}
          aria-current={isActive ? 'page' : undefined}
        >
          <svg
            class={`w-5 h-5 mb-1 ${isActive ? 'text-brand' : 'text-slate-muted'}`}
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width={isActive ? '2.2' : '1.8'}
            set:html={item.icon}
          />
          <span class="text-[11px] tracking-tight leading-none">{item.label}</span>
        </a>
      );
    })}
  </div>
</nav>

<style>
  .safe-area-pb {
    padding-bottom: max(0.375rem, env(safe-area-inset-bottom));
  }
</style>
