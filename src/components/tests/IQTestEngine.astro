---
import { iqQuestions } from '../../data/tests/iqQuestions';

// Inject questions as a JSON string to be parsed on client
const questionsJson = JSON.stringify(iqQuestions);
---

<div id="iq-engine" class="relative bg-white" data-questions={questionsJson}>
  
  <!-- INTRO SCREEN -->
  <div id="screen-intro" class="p-6 sm:p-10 flex flex-col items-center text-center space-y-6">
    <div class="w-full max-w-2xl">
      <h2 class="text-2xl sm:text-3xl font-semibold text-text-main mb-4">Before you begin</h2>
      <p class="text-text-muted mb-6">
        This is an online reasoning assessment designed to challenge your cognitive skills across six distinct categories. 
        It is not a clinical or professionally administered IQ test, and the results should be viewed as an engaging cognitive exercise rather than a formal medical or psychological diagnosis.
      </p>
      
      <div class="grid grid-cols-2 gap-4 mb-8 text-left">
        <div class="p-4 bg-slate-50 border border-slate-100 rounded-xl">
          <span class="block text-sm font-semibold text-slate-500 uppercase tracking-wider mb-1">Duration</span>
          <span class="text-lg text-text-main font-medium">~20 Minutes</span>
        </div>
        <div class="p-4 bg-slate-50 border border-slate-100 rounded-xl">
          <span class="block text-sm font-semibold text-slate-500 uppercase tracking-wider mb-1">Format</span>
          <span class="text-lg text-text-main font-medium">30 Questions</span>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <button id="btn-start" class="w-full sm:w-auto px-8 py-3 bg-primary text-white font-medium rounded-xl hover:bg-primary/90 transition-colors focus-ring has-ripple">
          Start Assessment
        </button>
        <button id="btn-resume" class="hidden w-full sm:w-auto px-8 py-3 bg-slate-900 text-white font-medium rounded-xl hover:bg-slate-800 transition-colors focus-ring has-ripple">
          Resume Assessment
        </button>
      </div>
    </div>
  </div>

  <!-- TEST SCREEN -->
  <div id="screen-test" class="hidden flex-col h-full min-h-[500px]" aria-live="polite">
    <!-- Top Bar -->
    <div class="flex items-center justify-between p-4 sm:p-6 border-b border-border-line/40 bg-slate-50/50">
      <div class="flex flex-col">
        <span class="text-xs font-semibold uppercase tracking-wider text-text-muted mb-1">Progress</span>
        <span class="text-sm font-medium text-text-main" id="progress-text">Question 1 of 30</span>
      </div>
      <div class="flex flex-col items-end">
        <span class="text-xs font-semibold uppercase tracking-wider text-text-muted mb-1">Time Remaining</span>
        <span class="text-sm font-medium font-mono text-text-main" id="timer-text" aria-live="off">20:00</span>
      </div>
    </div>
    
    <!-- Progress Bar -->
    <div class="h-1.5 w-full bg-slate-100" role="progressbar" id="progress-bar-container" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
      <div id="progress-bar" class="h-full bg-primary transition-all duration-300 w-0"></div>
    </div>

    <!-- Question Area -->
    <div class="flex-1 p-6 sm:p-8 md:p-10">
      <div class="max-w-3xl mx-auto">
        <span id="q-category" class="inline-block px-3 py-1 bg-primary/10 text-primary text-xs font-semibold rounded-full mb-4">Category</span>
        
        <h3 id="q-text" class="text-xl sm:text-2xl font-medium text-text-main mb-8 leading-relaxed" tabindex="-1">
          Question text goes here
        </h3>

        <div id="options-container" class="space-y-3" role="radiogroup" aria-labelledby="q-text">
          <!-- Options dynamically injected here -->
        </div>
      </div>
    </div>

    <!-- Bottom Navigation Bar -->
    <div class="p-4 sm:p-6 border-t border-border-line/40 bg-slate-50/50 flex flex-col-reverse sm:flex-row items-stretch sm:items-center justify-between mt-auto gap-4">
      <button id="btn-prev" class="px-5 py-3 sm:py-2.5 text-text-muted hover:text-text-main font-medium rounded-lg hover:bg-slate-200/50 transition-colors focus-ring disabled:opacity-50 disabled:cursor-not-allowed">
        Previous
      </button>
      <button id="btn-next" class="px-6 py-3 sm:py-2.5 bg-slate-900 text-white font-medium rounded-lg hover:bg-slate-800 transition-colors focus-ring has-ripple disabled:opacity-50 disabled:cursor-not-allowed">
        Next
      </button>
    </div>
  </div>

  <!-- RESULTS SCREEN -->
  <div id="screen-results" class="hidden p-6 sm:p-10">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-10">
        <h2 class="text-3xl sm:text-4xl font-semibold text-text-main mb-4">Your Reasoning Result</h2>
        <div class="inline-flex items-end justify-center gap-2 mb-2">
          <span id="score-correct" class="text-5xl font-bold text-primary">0</span>
          <span class="text-2xl text-text-muted font-medium mb-1">/ 30</span>
        </div>
        <p id="score-percentage" class="text-lg text-text-muted font-medium">0% Accuracy</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
        <div class="bg-slate-50 border border-slate-100 p-6 rounded-2xl">
          <h4 class="text-sm font-semibold uppercase tracking-wider text-text-muted mb-4">Performance by Category</h4>
          <div id="category-bars" class="space-y-4">
            <!-- Bars injected here -->
          </div>
        </div>
        
        <div class="space-y-4">
          <div class="bg-emerald-50/50 border border-emerald-100 p-6 rounded-2xl">
            <h4 class="text-sm font-semibold uppercase tracking-wider text-emerald-600/80 mb-2">Strongest Area</h4>
            <p id="strongest-area" class="text-lg font-medium text-emerald-900">Logical Reasoning</p>
          </div>
          <div class="bg-amber-50/50 border border-amber-100 p-6 rounded-2xl">
            <h4 class="text-sm font-semibold uppercase tracking-wider text-amber-600/80 mb-2">Needs Improvement</h4>
            <p id="needs-improvement" class="text-lg font-medium text-amber-900">Spatial Reasoning</p>
          </div>
          <div class="bg-slate-50 border border-slate-100 p-6 rounded-2xl flex items-center justify-between">
            <h4 class="text-sm font-semibold uppercase tracking-wider text-text-muted">Time Taken</h4>
            <p id="time-taken" class="text-lg font-medium text-text-main">00:00</p>
          </div>
        </div>
      </div>

      <div class="p-6 bg-blue-50/50 border border-blue-100 rounded-2xl mb-8">
        <h4 class="text-base font-semibold text-blue-900 mb-2">What does this mean?</h4>
        <p class="text-sm text-blue-800/80 leading-relaxed">
          This assessment measured your performance across six cognitive domains. A higher score in a specific area indicates a strong natural aptitude for that type of reasoning. Remember that cognitive skills can be trained, and this online exercise is meant for personal enrichment and benchmarking rather than clinical diagnosis.
        </p>
      </div>

      <div class="text-center">
        <button id="btn-restart" class="px-6 py-3 bg-slate-100 text-text-main font-medium rounded-xl hover:bg-slate-200 transition-colors focus-ring">
          Start Fresh Test
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const engine = document.getElementById('iq-engine');
    if (!engine) return;

    const questions = JSON.parse(engine.getAttribute('data-questions') || '[]');
    if (!questions.length) return;

    const SESSION_KEY = 'studentkit_iq_state_v1';
    
    let currentIndex = 0;
    let answers = new Array(questions.length).fill(null);
    let timeRemaining = 20 * 60; // 20 minutes in seconds
    let timeTaken = 0;
    let timerInterval = null;

    // DOM Elements
    const screenIntro = document.getElementById('screen-intro');
    const screenTest = document.getElementById('screen-test');
    const screenResults = document.getElementById('screen-results');
    
    const btnStart = document.getElementById('btn-start');
    const btnResume = document.getElementById('btn-resume');
    const btnNext = document.getElementById('btn-next');
    const btnPrev = document.getElementById('btn-prev');
    const btnRestart = document.getElementById('btn-restart');
    
    const qCategory = document.getElementById('q-category');
    const qText = document.getElementById('q-text');
    const optionsContainer = document.getElementById('options-container');
    const progressText = document.getElementById('progress-text');
    const progressBar = document.getElementById('progress-bar');
    const progressBarContainer = document.getElementById('progress-bar-container');
    const timerText = document.getElementById('timer-text');

    // Check for existing session
    function checkSession() {
      try {
        const stored = sessionStorage.getItem(SESSION_KEY);
        if (stored) {
          const parsed = JSON.parse(stored);
          if (parsed && Array.isArray(parsed.answers) && parsed.answers.length === questions.length) {
            btnResume.classList.remove('hidden');
            return parsed;
          }
        }
      } catch(e) {
        sessionStorage.removeItem(SESSION_KEY);
      }
      return null;
    }

    const existingSession = checkSession();

    function saveSession() {
      try {
        sessionStorage.setItem(SESSION_KEY, JSON.stringify({
          currentIndex,
          answers,
          timeRemaining,
          timeTaken
        }));
      } catch(e) {}
    }

    function clearSession() {
      try {
        sessionStorage.removeItem(SESSION_KEY);
      } catch(e) {}
    }

    // Initialization
    btnStart.addEventListener('click', () => {
      clearSession();
      currentIndex = 0;
      answers = new Array(questions.length).fill(null);
      timeRemaining = 20 * 60;
      timeTaken = 0;
      startTest();
    });

    btnResume.addEventListener('click', () => {
      if (existingSession) {
        currentIndex = existingSession.currentIndex || 0;
        answers = existingSession.answers;
        timeRemaining = typeof existingSession.timeRemaining === 'number' ? existingSession.timeRemaining : 20 * 60;
        timeTaken = typeof existingSession.timeTaken === 'number' ? existingSession.timeTaken : 0;
      }
      startTest();
    });

    btnNext.addEventListener('click', handleNext);
    btnPrev.addEventListener('click', handlePrev);
    btnRestart.addEventListener('click', () => {
      clearSession();
      window.location.reload();
    });

    function startTest() {
      screenIntro.classList.add('hidden');
      screenTest.classList.remove('hidden');
      screenTest.classList.add('flex');
      
      renderQuestion();
      startTimer();
      saveSession();
    }

    function startTimer() {
      // update immediately
      updateTimerUI();
      timerInterval = setInterval(() => {
        timeRemaining--;
        timeTaken++;
        updateTimerUI();

        if (timeRemaining % 5 === 0) saveSession(); // Save state every 5 seconds to reduce blocking

        if (timeRemaining <= 0) {
          clearInterval(timerInterval);
          finishTest();
        }
      }, 1000);
    }

    function updateTimerUI() {
      if (timeRemaining < 0) timeRemaining = 0;
      const m = Math.floor(timeRemaining / 60).toString().padStart(2, '0');
      const s = (timeRemaining % 60).toString().padStart(2, '0');
      timerText.textContent = `${m}:${s}`;
    }

    function formatTime(seconds) {
      const m = Math.floor(seconds / 60);
      const s = seconds % 60;
      return `${m}m ${s}s`;
    }

    function renderQuestion() {
      const q = questions[currentIndex];
      
      qCategory.textContent = q.category;
      qText.textContent = q.question;
      
      progressText.textContent = `Question ${currentIndex + 1} of ${questions.length}`;
      const pct = ((currentIndex + 1) / questions.length) * 100;
      progressBar.style.width = `${pct}%`;
      progressBarContainer.setAttribute('aria-valuenow', pct.toString());

      btnPrev.disabled = currentIndex === 0;
      
      if (currentIndex === questions.length - 1) {
        btnNext.textContent = 'Finish Assessment';
        btnNext.classList.remove('bg-slate-900', 'hover:bg-slate-800');
        btnNext.classList.add('bg-primary', 'hover:bg-primary/90');
      } else {
        btnNext.textContent = 'Next';
        btnNext.classList.add('bg-slate-900', 'hover:bg-slate-800');
        btnNext.classList.remove('bg-primary', 'hover:bg-primary/90');
      }

      btnNext.disabled = answers[currentIndex] === null;

      // Render options
      optionsContainer.innerHTML = '';
      q.options.forEach((opt, idx) => {
        const isSelected = answers[currentIndex] === idx;
        const btn = document.createElement('button');
        btn.setAttribute('role', 'radio');
        btn.setAttribute('aria-checked', isSelected.toString());
        btn.className = `w-full text-left p-4 sm:p-5 rounded-xl border-2 transition-all duration-200 flex items-center gap-4 focus-ring ${isSelected ? 'border-primary bg-primary/5 text-primary' : 'border-slate-200 bg-white hover:border-slate-300 text-text-main'}`;
        
        const circle = document.createElement('div');
        circle.className = `w-5 h-5 flex-shrink-0 rounded-full border-2 flex items-center justify-center ${isSelected ? 'border-primary' : 'border-slate-300'}`;
        if (isSelected) {
          const dot = document.createElement('div');
          dot.className = 'w-2.5 h-2.5 rounded-full bg-primary';
          circle.appendChild(dot);
        }

        const span = document.createElement('span');
        span.className = 'font-medium leading-tight';
        span.textContent = opt;

        btn.appendChild(circle);
        btn.appendChild(span);

        btn.addEventListener('click', () => {
          answers[currentIndex] = idx;
          saveSession();
          renderQuestion();
        });

        optionsContainer.appendChild(btn);
      });
      
      if (timeTaken > 0) {
        qText.focus({ preventScroll: true });
      }
    }

    function handleNext() {
      if (answers[currentIndex] === null) return; // Guard
      if (currentIndex < questions.length - 1) {
        currentIndex++;
        saveSession();
        renderQuestion();
      } else {
        finishTest();
      }
    }

    function handlePrev() {
      if (currentIndex > 0) {
        currentIndex--;
        saveSession();
        renderQuestion();
      }
    }

    function finishTest() {
      clearInterval(timerInterval);
      clearSession(); // Remove volatile state when completely finished
      
      screenTest.classList.remove('flex');
      screenTest.classList.add('hidden');
      screenResults.classList.remove('hidden');

      calculateResults();
    }

    function calculateResults() {
      let correct = 0;
      const categoryStats = {};
      
      questions.forEach((q, idx) => {
        if (!categoryStats[q.category]) {
          categoryStats[q.category] = { total: 0, correct: 0 };
        }
        categoryStats[q.category].total++;
        
        if (answers[idx] === q.correctAnswer) {
          correct++;
          categoryStats[q.category].correct++;
        }
      });

      document.getElementById('score-correct').textContent = correct;
      document.getElementById('score-percentage').textContent = `${Math.round((correct / questions.length) * 100)}% Accuracy`;
      document.getElementById('time-taken').textContent = formatTime(timeTaken);

      const barsContainer = document.getElementById('category-bars');
      barsContainer.innerHTML = '';

      let bestCat = { name: 'None', score: -1 };
      let worstCat = { name: 'None', score: 101 };

      for (const [cat, stats] of Object.entries(categoryStats)) {
        const pct = (stats.correct / stats.total) * 100;
        
        if (pct > bestCat.score) bestCat = { name: cat, score: pct };
        if (pct < worstCat.score) worstCat = { name: cat, score: pct };

        const blocks = Math.round((pct / 100) * 10);
        const barStr = '█'.repeat(blocks) + '░'.repeat(10 - blocks);

        const row = document.createElement('div');
        row.className = 'flex flex-col sm:flex-row sm:items-center justify-between gap-1 sm:gap-4';
        
        const label = document.createElement('span');
        label.className = 'text-sm font-medium text-text-main sm:w-40 flex-shrink-0';
        label.textContent = cat;

        const bar = document.createElement('span');
        bar.className = 'font-mono text-primary text-sm tracking-widest hidden sm:inline-block';
        bar.textContent = barStr;
        
        const barMobile = document.createElement('span');
        barMobile.className = 'font-mono text-primary text-xs tracking-widest sm:hidden mb-1';
        barMobile.textContent = barStr;

        const val = document.createElement('span');
        val.className = 'text-sm text-text-muted font-medium sm:text-right w-12 flex-shrink-0';
        val.textContent = `${stats.correct}/${stats.total}`;

        const wrapper = document.createElement('div');
        wrapper.className = 'flex items-center gap-3 flex-1 justify-between sm:justify-start';
        
        wrapper.appendChild(bar);
        wrapper.appendChild(val);

        row.appendChild(label);
        row.appendChild(barMobile);
        row.appendChild(wrapper);
        barsContainer.appendChild(row);
      }

      document.getElementById('strongest-area').textContent = bestCat.name;
      document.getElementById('needs-improvement').textContent = worstCat.name;
    }
  });
</script>
