---
export interface Props {
  title?: string;
  class?: string;
}

const { title, class: className = '' } = Astro.props;
---

<div class={`bg-card rounded-2xl border border-border-line/90 shadow-sm overflow-hidden p-4 sm:p-5 sm:p-8 ${className}`}>
  {title && <h2 class="text-xl font-bold text-ink mb-6 pb-4 border-b border-border-line">{title}</h2>}
  <slot />
</div>
