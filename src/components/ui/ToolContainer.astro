---
export interface Props {
  title?: string;
  class?: string;
}

const { title, class: className = '' } = Astro.props;
---

<div class={`bg-white rounded-2xl border border-slate-200/90 shadow-sm overflow-hidden p-6 sm:p-8 ${className}`}>
  {title && <h2 class="text-xl font-bold text-slate-900 mb-6 pb-4 border-b border-slate-100">{title}</h2>}
  <slot />
</div>
