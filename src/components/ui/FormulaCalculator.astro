---
export interface Props {
  config: {
    inputs: { id: string; label: string; placeholder?: string; type?: string }[];
    expression: string;
    outputLabel: string;
    outputUnit?: string;
  };
  toolId: string;
}

const { config, toolId } = Astro.props;
const configJson = JSON.stringify(config);
---

<div class="bg-white rounded-xl sm:rounded-2xl shadow-xs border border-slate-200 overflow-hidden max-w-xl mx-auto formula-calc-container" data-config={configJson} data-toolid={toolId}>
  <div class="p-4 sm:p-6">
    <form class="space-y-3.5 sm:space-y-4 calc-form" novalidate>
      {config.inputs.map(input => (
        <div>
          <label for={input.id} class="block text-xs sm:text-sm font-semibold text-slate-700 mb-1">{input.label}</label>
          <input
            type={input.type || "number"}
            id={input.id}
            step="any"
            inputmode={input.type === 'text' ? undefined : 'decimal'}
            required
            class="block w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-blue-600 text-sm sm:text-base transition-all calc-input shadow-2xs"
            placeholder={input.placeholder || ""}
            data-id={input.id}
          />
        </div>
      ))}

      <div class="flex flex-col sm:flex-row gap-2.5 pt-2">
        <button
          type="submit"
          class="flex-1 bg-blue-600 text-white px-4 py-2.5 rounded-lg font-semibold hover:bg-blue-700 active:bg-blue-800 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-blue-600 transition-all cursor-pointer shadow-xs min-h-[42px] flex items-center justify-center text-sm sm:text-base"
        >
          Calculate
        </button>
        <button
          type="button"
          class="px-4 py-2.5 border border-slate-200 rounded-lg text-slate-700 font-medium hover:bg-slate-50 active:bg-slate-100 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-blue-600 transition-all calc-reset-btn cursor-pointer min-h-[42px] flex items-center justify-center text-sm sm:text-base"
        >
          Reset
        </button>
      </div>
    </form>

    <div class="mt-4 pt-4 border-t border-slate-100 hidden calc-result-section" aria-live="polite">
      <div class="bg-slate-50/80 border border-slate-200/80 rounded-lg p-4 text-center">
        <div class="flex items-center justify-between mb-1.5">
          <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider calc-output-label">{config.outputLabel}</span>
          <button
            type="button"
            class="calc-copy-btn inline-flex items-center gap-1.5 px-2 py-0.5 text-xs font-medium text-blue-700 bg-white hover:bg-blue-50 border border-blue-200 rounded-md transition-colors shadow-2xs cursor-pointer"
            aria-label="Copy result"
          >
            <svg class="w-3.5 h-3.5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" />
            </svg>
            <span class="copy-text">Copy</span>
          </button>
        </div>
        <div class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight font-mono">
          <span class="calc-result-value">--</span>
          {config.outputUnit && <span class="text-lg sm:text-xl text-slate-500 font-sans font-normal ml-1.5 calc-output-unit">{config.outputUnit}</span>}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { formatResultNumber, copyToClipboard } from '../../utils/formatters';

  const initFormulaCalculators = () => {
    document.querySelectorAll('.formula-calc-container').forEach((container) => {
      if (container.hasAttribute('data-initialized')) return;
      container.setAttribute('data-initialized', 'true');

      const configStr = container.getAttribute('data-config');
      if (!configStr) return;

      const config = JSON.parse(configStr);
      const form = container.querySelector('.calc-form') as HTMLFormElement;
      const inputs = container.querySelectorAll('.calc-input') as NodeListOf<HTMLInputElement>;
      const resetBtn = container.querySelector('.calc-reset-btn');
      const resultSection = container.querySelector('.calc-result-section');
      const resultValue = container.querySelector('.calc-result-value');
      const copyBtn = container.querySelector('.calc-copy-btn');

      const paramNames = config.inputs.map((i: any) => i.id);
      let calcFn: Function;
      try {
        calcFn = new Function(...paramNames, `return ${config.expression};`);
      } catch (e) {
        console.error("Invalid formula expression in config", e);
      }

      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const args = [];
          for (const input of inputs) {
            const val = parseFloat(input.value);
            if (isNaN(val)) {
              input.focus();
              return;
            }
            args.push(val);
          }

          if (calcFn && resultValue && resultSection) {
            try {
              const res = calcFn(...args);
              resultValue.textContent = formatResultNumber(res);
              resultSection.classList.remove('hidden');
            } catch (err) {
              resultValue.textContent = "Error";
              resultSection.classList.remove('hidden');
            }
          }
        });
      }

      if (resetBtn && form && resultSection) {
        resetBtn.addEventListener('click', () => {
          form.reset();
          resultSection.classList.add('hidden');
          if (inputs[0]) inputs[0].focus();
        });
      }

      if (copyBtn && resultValue) {
        copyBtn.addEventListener('click', async () => {
          const text = resultValue.textContent || '';
          const ok = await copyToClipboard(text);
          if (ok) {
            const label = copyBtn.querySelector('.copy-text');
            if (label) {
              const old = label.textContent;
              label.textContent = "Copied!";
              setTimeout(() => { label.textContent = old; }, 2000);
            }
          }
        });
      }
    });
  };

  initFormulaCalculators();
  document.addEventListener('astro:page-load', initFormulaCalculators);
</script>
