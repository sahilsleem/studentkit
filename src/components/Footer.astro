---
const currentYear = new Date().getFullYear();
---

<footer class="relative mt-auto border-t border-border-line/40 bg-white/80 md:bg-white/40 backdrop-blur-none md:backdrop-blur-xl">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-8">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-6 sm:gap-8 mb-6 md:mb-8">

      <!-- Brand & Mission -->
      <div style="--stagger: 0" class="reveal col-span-2 space-y-3 pr-2 md:pr-4">
        <div class="flex/items-center gap-2 md:gap-2.5">
          <div class="w-6 h-6 md:w-7 md:h-7 rounded-md md:rounded-lg bg-brand flex items-center justify-center text-card shrink-0 shadow-sm shadow-brand/20">
            <svg class="w-4 h-4 md:w-4 md:h-4" fill="none" viewBox="0 0 128 128" aria-hidden="true">
              <defs>
                <linearGradient id="footer-cap" x1="24" y1="18" x2="104" y2="46" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#C7D2FE" />
                  <stop offset="50%" stop-color="#A5B4FC" />
                  <stop offset="100%" stop-color="#818CF8" />
                </linearGradient>
              </defs>
              <g id="footer-graduation-cap">
                <polygon points="64,18 104,32 64,46 24,32" fill="url(#footer-cap)" />
                <path d="M42,37 V41 C42,45.5 52,48.5 64,48.5 C76,48.5 86,45.5 86,41 V37 L64,44 Z" fill="#312E81" />
                <path d="M104,32 V44" stroke="#2DD4BF" stroke-width="2.75" stroke-linecap="round" />
                <circle cx="104" cy="46.5" r="2.75" fill="#2DD4BF" />
              </g>
              <path d="M86,53 C78,45 72,44 64,44 C46,44 33,56 33,68 C33,82 46,87 64,76 C82,65 95,70 95,84 C95,96 82,108 64,108 C56,108 50,107 42,99" stroke="#FFFFFF" stroke-width="15" stroke-linecap="round" stroke-linejoin="round" />
              <g id="footer-open-book" transform="translate(64, 76)">
                <path d="M-20,-6 C-13,-10 -3,-10 0,-7 C3,-10 13,-10 20,-6 V9 C13,5 3,5 0,8 C-3,5 -13,5 -20,9 Z" fill="#1E1B4B" opacity="0.75" />
                <path d="M-18,-4 C-11,-8 -4,-8 0,-5 V6 C-4,3 -11,3 -18,7 Z" fill="#2DD4BF" />
                <path d="M0,-5 C4,-8 11,-8 18,-4 V7 C11,3 4,3 0,6 Z" fill="#14B8A6" />
                <line x1="0" y1="-5" x2="0" y2="6" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" />
              </g>
            </svg>
          </div>
          <span class="text-base md:text-lg font-bold tracking-tight text-ink select-none"><span class="letter-blip inline-block cursor-default">S</span><span class="letter-blip inline-block cursor-default">t</span><span class="letter-blip inline-block cursor-default">u</span><span class="letter-blip inline-block cursor-default">d</span><span class="letter-blip inline-block cursor-default">e</span><span class="letter-blip inline-block cursor-default">n</span><span class="letter-blip inline-block cursor-default">t</span><span class="text-brand-accent"><span class="letter-blip letter-blip-brand inline-block cursor-default">K</span><span class="letter-blip letter-blip-brand inline-block cursor-default">i</span><span class="letter-blip letter-blip-brand inline-block cursor-default">t</span></span></span>
        </div>
        <p class="text-[11px] md:text-sm text-slate-muted max-w-sm leading-relaxed">
          Free online tools, calculators, tests, and study utilities designed to make everyday student tasks simpler.
        </p>
      </div>

      <!-- Explore Navigation -->
      <div style="--stagger: 1" class="reveal col-span-1">
        <nav aria-label="Explore StudentKit" class="group bg-card border border-border-line/60 shadow-xs rounded-2xl p-4 sm:p-0 sm:bg-transparent sm:border-transparent sm:shadow-none sm:rounded-none hover:border-brand hover:shadow-xl hover:-translate-y-1.5 hover:scale-[1.02] sm:hover:border-transparent sm:hover:shadow-none sm:hover:translate-y-0 sm:hover:scale-100 transition-all duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)]">
          <h2 class="text-[10px] md:text-xs font-semibold text-ink uppercase tracking-wider mb-2 md:mb-3 group-hover:text-brand sm:group-hover:text-ink transition-colors">Explore</h2>
          <ul class="space-y-1.5 md:space-y-2 text-[11px] md:text-sm text-slate-muted">
            <li><a href="/tools" class="hover:text-brand transition-colors block py-0.5 md:py-0">Tools Directory</a></li>
            <li><a href="/tests" class="hover:text-brand transition-colors block py-0.5 md:py-0">Tests & Assessments</a></li>
            <li><a href="/anti-brainrot" class="hover:text-brand transition-colors block py-0.5 md:py-0">Anti-Brainrot</a></li>
          </ul>
        </nav>
      </div>

      <!-- Popular Categories -->
      <div style="--stagger: 2" class="reveal col-span-1">
        <nav aria-label="Popular Categories" class="group bg-card border border-border-line/60 shadow-xs rounded-2xl p-4 sm:p-0 sm:bg-transparent sm:border-transparent sm:shadow-none sm:rounded-none hover:border-brand hover:shadow-xl hover:-translate-y-1.5 hover:scale-[1.02] sm:hover:border-transparent sm:hover:shadow-none sm:hover:translate-y-0 sm:hover:scale-100 transition-all duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)]">
          <h2 class="text-[10px] md:text-xs font-semibold text-ink uppercase tracking-wider mb-2 md:mb-3 group-hover:text-brand sm:group-hover:text-ink transition-colors">Categories</h2>
          <ul class="space-y-1.5 md:space-y-2 text-[11px] md:text-sm text-slate-muted">
            <li><a href="/category/mathematics" class="hover:text-brand transition-colors block py-0.5 md:py-0">Mathematics</a></li>
            <li><a href="/category/physics" class="hover:text-brand transition-colors block py-0.5 md:py-0">Physics</a></li>
            <li><a href="/category/chemistry" class="hover:text-brand transition-colors block py-0.5 md:py-0">Chemistry</a></li>
            <li><a href="/category/academic-grades" class="hover:text-brand transition-colors block py-0.5 md:py-0">Academic & Grades</a></li>
          </ul>
        </nav>
      </div>

      <!-- Information -->
      <div style="--stagger: 3" class="reveal col-span-2 sm:col-span-1 md:col-span-1">
        <nav aria-label="Legal and Information" class="group bg-card border border-border-line/60 shadow-xs rounded-2xl p-4 sm:p-0 sm:bg-transparent sm:border-transparent sm:shadow-none sm:rounded-none hover:border-brand hover:shadow-xl hover:-translate-y-1.5 hover:scale-[1.02] sm:hover:border-transparent sm:hover:shadow-none sm:hover:translate-y-0 sm:hover:scale-100 transition-all duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)]">
          <h2 class="text-[10px] md:text-xs font-semibold text-ink uppercase tracking-wider mb-2 md:mb-3 group-hover:text-brand sm:group-hover:text-ink transition-colors">Information</h2>
          <ul class="grid grid-rows-2 grid-flow-col gap-x-4 gap-y-1.5 sm:block sm:space-y-1.5 md:space-y-2 text-[11px] md:text-sm text-slate-muted">
            <li><a href="/about" class="hover:text-brand transition-colors block py-0.5 md:py-0">About StudentKit</a></li>
            <li><a href="/contact" class="hover:text-brand transition-colors block py-0.5 md:py-0">Contact & Feedback</a></li>
            <li><a href="/privacy" class="hover:text-brand transition-colors block py-0.5 md:py-0">Privacy Policy</a></li>
            <li><a href="/terms" class="hover:text-brand transition-colors block py-0.5 md:py-0">Terms of Service</a></li>
          </ul>
        </nav>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div style="--stagger: 4" class="reveal pt-4 md:pt-6 border-t border-border-line flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] md:text-xs text-slate-muted">
      <p class="sm:flex-1 text-center sm:text-left">&copy; {currentYear} StudentKit. Free student tools.</p>
      
      <div class="flex items-center justify-center gap-5 sm:flex-1">
        <a href="https://instagram.com/sahilsleem" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="hover:text-brand hover:scale-110 transition-all duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)]">
          <svg class="w-[18px] h-[18px]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
          </svg>
        </a>
        <a href="https://x.com/sahilsleem" target="_blank" rel="noopener noreferrer" aria-label="X" class="hover:text-brand hover:scale-110 transition-all duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)]">
          <svg class="w-[18px] h-[18px]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4l11.733 16h4.267l-11.733 -16z" />
            <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772" />
          </svg>
        </a>
        <a href="https://t.me/sahilsleem" target="_blank" rel="noopener noreferrer" aria-label="Telegram" class="hover:text-brand hover:scale-110 transition-all duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)]">
          <svg class="w-[18px] h-[18px]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 10l-4 4l6 6l4 -16l-18 7l4 2l2 6l3 -4" />
          </svg>
        </a>
      </div>

      <div class="hidden sm:block sm:flex-1"></div>
    </div>
  </div>
</footer>
