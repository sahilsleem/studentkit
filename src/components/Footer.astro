---
const currentYear = new Date().getFullYear();
---

<footer class="bg-card border-t border-border-line mt-auto">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6 md:py-8">
    <!-- Mobile View (< 768px): Balanced 2-Column Structure -->
    <div class="grid grid-cols-2 gap-4 sm:gap-6 mb-4 md:hidden">
      <!-- Left Column: Branding -->
      <div class="space-y-1.5 pr-2">
        <div class="flex items-center gap-1.5">
          <div class="w-5 h-5 rounded-md bg-brand flex items-center justify-center text-card shrink-0">
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
            </svg>
          </div>
          <span class="text-sm font-bold tracking-tight text-ink">Student<span class="text-brand-accent">Kit</span></span>
        </div>
        <p class="text-[11px] text-slate-muted leading-snug">
          Simple, fast tools and study calculators for everyday student life. Free and open for everyone.
        </p>
      </div>

      <!-- Right Column: Navigation & Legal -->
      <div class="space-y-2.5">
        <div>
          <h3 class="text-[10px] font-semibold text-ink uppercase tracking-wider mb-1">Navigation</h3>
          <ul class="space-y-1 text-[11px] text-slate-muted">
            <li><a href="/" class="hover:text-brand transition-colors">Home</a></li>
            <li><a href="/tools" class="hover:text-brand transition-colors">Tools Directory</a></li>
            <li><a href="/about" class="hover:text-brand transition-colors">About StudentKit</a></li>
            <li><a href="/contact" class="hover:text-brand transition-colors">Contact & Feedback</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-[10px] font-semibold text-ink uppercase tracking-wider mb-1">Legal</h3>
          <ul class="space-y-1 text-[11px] text-slate-muted">
            <li><a href="/privacy" class="hover:text-brand transition-colors">Privacy Policy</a></li>
            <li><a href="/terms" class="hover:text-brand transition-colors">Terms of Service</a></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Desktop View (>= 768px): Original 4-Column Layout Unchanged -->
    <div class="hidden md:grid md:grid-cols-4 gap-8 mb-6">
      <!-- Brand & Mission -->
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-2.5">
          <div class="w-7 h-7 rounded-lg bg-brand flex items-center justify-center text-card shrink-0">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
            </svg>
          </div>
          <span class="text-lg font-bold tracking-tight text-ink">Student<span class="text-brand-accent">Kit</span></span>
        </div>
        <p class="text-sm text-slate-muted max-w-sm leading-relaxed">
          Clean, instant, and privacy-first utilities for student life. All calculations run client-side in your browser with zero paywalls.
        </p>
      </div>

      <!-- Quick Navigation -->
      <div>
        <h3 class="text-xs font-semibold text-ink uppercase tracking-wider mb-3">Navigation</h3>
        <ul class="space-y-2 text-sm text-slate-muted">
          <li><a href="/" class="hover:text-brand transition-colors">Home</a></li>
          <li><a href="/tools" class="hover:text-brand transition-colors">Tools Directory</a></li>
          <li><a href="/about" class="hover:text-brand transition-colors">About StudentKit</a></li>
          <li><a href="/contact" class="hover:text-brand transition-colors">Contact & Feedback</a></li>
        </ul>
      </div>

      <!-- Legal & Privacy -->
      <div>
        <h3 class="text-xs font-semibold text-ink uppercase tracking-wider mb-3">Legal</h3>
        <ul class="space-y-2 text-sm text-slate-muted">
          <li><a href="/privacy" class="hover:text-brand transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-brand transition-colors">Terms of Service</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar (Both Mobile and Desktop) -->
    <div class="pt-3 md:pt-6 border-t border-border-line flex items-center justify-between text-[11px] sm:text-xs text-slate-muted">
      <p>&copy; {currentYear} StudentKit. Free student tools.</p>
    </div>
  </div>
</footer>
